@model DocumentGlossary.ViewModels.TermListVM

@{
    ViewBag.Title = "Terimler";
}

<h2>Terimler</h2>

@using (Html.BeginForm("Index", "Terms", FormMethod.Get))
{
    <div>
        <input type="text" name="search" value="@Model?.SearchTerm" placeholder="Ara..." />
        <select name="category">
            <option value="All">Tüm Kategoriler</option>
            @foreach (var c in Model?.Categories ?? new List<string>())
            {
                <option value="@c" @(c == Model?.CurrentCategory ? "selected" : "")>@c</option>
            }
        </select>
        <button type="submit">Ara</button>
    </div>
}

<table>
    <thead>
        <tr>
            <th>Görsel</th>
            <th>Terim</th>
            <th>Kategori</th>
            <th>Açýklama</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Terms != null && Model.Terms.Any())
        {
            foreach (var item in Model.Terms)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Term" style="max-width:100px;max-height:60px;" />
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Details", "Terms", new { slug = item.Slug })">@item.Term</a>
                    </td>
                    <td>@item.Category</td>
                    <td>
                        @Html.Raw((item.Definition != null && item.Definition.Length > 200)
                                 ? item.Definition.Substring(0, 200) + "…"
                                 : item.Definition)
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4">Kayýt bulunamadý.</td></tr>
        }
    </tbody>
</table>

<div>
    @if (Model != null && Model.TotalPages > 1)
    {
        var prev = Model.CurrentPage > 1 ? Model.CurrentPage - 1 : 1;
        var next = Model.CurrentPage < Model.TotalPages ? Model.CurrentPage + 1 : Model.TotalPages;

        <a href="@Url.Action("Index", new { search = Model.SearchTerm, category = Model.CurrentCategory, page = prev })">« Önceki</a>
        <span> Sayfa @Model.CurrentPage / @Model.TotalPages </span>
        <a href="@Url.Action("Index", new { search = Model.SearchTerm, category = Model.CurrentCategory, page = next })">Sonraki »</a>
    }
</div>