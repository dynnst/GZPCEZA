@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>T.C. İçişleri Bakanlığı Emniyet Genel Müdürlüğü</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="@Url.Content("~/files/logo/favicon-egm-32.png")" type="image/x-icon">
    <link rel="stylesheet" href="@Url.Content("~/vendor/bootstrap/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/vendor/font-awesome/css/fontawesome-all.min.css")" />

    <style>
        :root {
            --night-0: #020817;
            --night-1: #071426;
            --night-2: #102a43;
            --glass: rgba(8, 18, 34, .64);
            --glass-border: rgba(255, 255, 255, .18);
            --gold: #f7c873;
            --cyan: #52d7ff;
            --red: #db334d;
            --text-soft: rgba(255, 255, 255, .72);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Arial, Helvetica, sans-serif;
            color: #fff;
            background: var(--night-0);
        }

        body {
            overflow: hidden;
        }

        .login-scene {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 34px 18px;
            /* Yedek görsel: video yüklenemezse bayrak3.jpg gösterilir */
            background:
                url('@Url.Content("~/img/bayrak3.jpg")') center/cover no-repeat,
                radial-gradient(circle at 18% 20%, rgba(82, 215, 255, .18), transparent 31%),
                radial-gradient(circle at 82% 16%, rgba(219, 51, 77, .20), transparent 34%),
                linear-gradient(135deg, #010510 0%, #071426 44%, #112b43 100%);
        }

        .bgvid {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .58;
            filter: saturate(1.08) contrast(1.08) brightness(.72);
            transform: scale(1.025);
            z-index: 0;
        }

        .scene-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background:
                linear-gradient(90deg, rgba(1, 5, 16, .94) 0%, rgba(1, 5, 16, .58) 34%, rgba(1, 5, 16, .84) 100%),
                radial-gradient(circle at 50% 48%, transparent 0%, rgba(0, 0, 0, .46) 72%);
        }

        .scene-overlay::before {
            content: "";
            position: absolute;
            inset: -18%;
            background:
                conic-gradient(from 145deg at 48% 54%, transparent 0 18%, rgba(82, 215, 255, .14) 21%, transparent 29% 54%, rgba(247, 200, 115, .12) 58%, transparent 68% 100%);
            animation: slowSweep 18s linear infinite;
            opacity: .75;
            will-change: transform;
        }

        .scene-overlay::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, .025) 1px, transparent 1px);
            background-size: 52px 52px;
            mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 82%, transparent);
            animation: gridDrift 12s ease-in-out infinite alternate;
            will-change: transform, opacity;
        }

        .cinema-beam {
            position: absolute;
            top: -40%;
            left: -28%;
            width: 44%;
            height: 190%;
            transform: rotate(22deg);
            z-index: 2;
            pointer-events: none;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .16), transparent);
            filter: blur(20px);
            animation: lightPass 8.5s ease-in-out infinite;
            will-change: transform, opacity;
        }

        .security-frame {
            position: absolute;
            inset: 24px;
            z-index: 2;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, .10);
            border-radius: 28px;
            box-shadow: inset 0 0 70px rgba(82, 215, 255, .06);
        }

        .security-frame::before,
        .security-frame::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            border-color: rgba(247, 200, 115, .55);
            border-style: solid;
        }

        .security-frame::before {
            top: -1px;
            left: -1px;
            border-width: 2px 0 0 2px;
            border-top-left-radius: 28px;
        }

        .security-frame::after {
            right: -1px;
            bottom: -1px;
            border-width: 0 2px 2px 0;
            border-bottom-right-radius: 28px;
        }

        .login-shell {
            position: relative;
            z-index: 5;
            width: min(1080px, 100%);
            display: grid;
            grid-template-columns: 1.15fr 430px;
            gap: 34px;
            align-items: center;
        }

        .hero-copy {
            padding: 28px;
            text-shadow: 0 10px 34px rgba(0, 0, 0, .46);
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 13px;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 999px;
            color: rgba(255, 255, 255, .82);
            background: rgba(255, 255, 255, .06);
            letter-spacing: .12em;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            backdrop-filter: blur(10px);
        }

        .eyebrow i {
            color: var(--gold);
        }

        .hero-copy h1 {
            margin: 24px 0 14px;
            font-size: clamp(34px, 5vw, 62px);
            line-height: .98;
            font-weight: 800;
            letter-spacing: -.055em;
        }

        .hero-copy h1 span {
            display: block;
            color: var(--gold);
        }

        .hero-copy p {
            max-width: 620px;
            margin: 0;
            color: var(--text-soft);
            font-size: 16px;
            line-height: 1.75;
        }

        .status-strip {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 28px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 13px;
            border-radius: 14px;
            background: rgba(1, 10, 23, .56);
            border: 1px solid rgba(255, 255, 255, .11);
            color: rgba(255, 255, 255, .76);
            backdrop-filter: blur(10px);
            font-size: 12px;
            font-weight: 600;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #35f0a1;
            box-shadow: 0 0 18px rgba(53, 240, 161, .8);
        }

        .login-card {
            position: relative;
            overflow: hidden;
            padding: 30px;
            border-radius: 26px;
            background: linear-gradient(145deg, rgba(7, 18, 35, .92), rgba(7, 18, 35, .82));
            border: 1px solid var(--glass-border);
            box-shadow:
                0 28px 90px rgba(0, 0, 0, .52),
                inset 0 1px 0 rgba(255, 255, 255, .16);
            transform: translateZ(0);
            isolation: isolate;
        }

        .login-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(120deg, rgba(255, 255, 255, .18), transparent 28%),
                radial-gradient(circle at 92% 8%, rgba(82, 215, 255, .17), transparent 34%);
            pointer-events: none;
        }

        .login-card::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--cyan), var(--gold), transparent);
            animation: scanTop 4s ease-in-out infinite;
        }

        .brand-mark {
            position: relative;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 24px;
        }

        .brand-emblem {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            background: linear-gradient(145deg, rgba(247, 200, 115, .22), rgba(82, 215, 255, .10));
            border: 1px solid rgba(247, 200, 115, .36);
            box-shadow: 0 14px 28px rgba(0, 0, 0, .24);
            overflow: hidden;
        }

        .brand-emblem img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 8px;
        }

        .brand-emblem i {
            color: var(--gold);
            font-size: 23px;
        }

        .brand-text small {
            display: block;
            color: rgba(255, 255, 255, .58);
            font-size: 11px;
            letter-spacing: .10em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .brand-text strong {
            display: block;
            font-size: 19px;
            line-height: 1.15;
        }

        .login-title {
            position: relative;
            margin-bottom: 22px;
        }

        .login-title h2 {
            margin: 0;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -.03em;
        }

        .login-title p {
            margin: 7px 0 0;
            color: rgba(255, 255, 255, .62);
            font-size: 13px;
        }

        .input-group {
            position: relative;
            margin-bottom: 14px;
            border-radius: 15px;
            overflow: hidden;
            background: rgba(0, 0, 0, .28);
            border: 1px solid rgba(255, 255, 255, .13);
            transition: border-color .18s ease, box-shadow .18s ease;
            will-change: border-color, box-shadow;
        }

        .input-group:focus-within {
            border-color: rgba(82, 215, 255, .60);
            box-shadow: 0 0 0 4px rgba(82, 215, 255, .10);
        }

        .input-group-text {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, .72);
            padding-left: 16px;
        }

        .form-control {
            height: 50px;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 15px;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, .48);
        }

        .form-control:focus {
            background: transparent;
            color: #fff;
            box-shadow: none;
            outline: none;
        }

        .toggle-pwd {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, .60);
            cursor: pointer;
            padding: 0 16px;
            height: 50px;
            transition: color .18s ease;
        }

        .toggle-pwd:hover,
        .toggle-pwd:focus {
            color: var(--gold);
            outline: none;
        }

        .checkbox-custom {
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 12px 0 16px;
            color: rgba(255, 255, 255, .72);
            font-size: 13px;
            line-height: 1.45;
        }

        .checkbox-custom input {
            margin-top: 3px;
            accent-color: var(--gold);
        }

        .checkbox-custom a {
            color: #ffe2a6;
            text-decoration: none;
            border-bottom: 1px solid rgba(255, 226, 166, .35);
        }

        .caps-warning {
            display: none;
            margin: -6px 0 12px;
            padding: 8px 12px;
            border-radius: 10px;
            background: rgba(219, 51, 77, .18);
            border: 1px solid rgba(219, 51, 77, .45);
            color: #ffb3bf;
            font-size: 12px;
            font-weight: 600;
        }

        .caps-warning i {
            margin-right: 6px;
        }

        .btn-login {
            position: relative;
            width: 100%;
            border: none;
            border-radius: 16px;
            overflow: hidden;
            padding: 14px 18px;
            color: #071426;
            font-size: 15px;
            font-weight: 900;
            letter-spacing: .08em;
            background: linear-gradient(135deg, #ffe2a6, #f7c873 48%, #d99843);
            box-shadow: 0 16px 34px rgba(247, 200, 115, .22);
            cursor: pointer;
            transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
        }

        .btn-login::after {
            content: "";
            position: absolute;
            inset: 0;
            transform: translateX(-120%);
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .55), transparent);
            transition: transform .55s ease;
        }

        .btn-login:hover,
        .btn-login:focus {
            transform: translateY(-2px);
            box-shadow: 0 22px 44px rgba(247, 200, 115, .30);
            filter: brightness(1.04);
            outline: none;
        }

        .btn-login:hover::after,
        .btn-login:focus::after {
            transform: translateX(120%);
        }

        .btn-login:disabled {
            opacity: .78;
            cursor: wait;
            transform: none;
            filter: brightness(.95);
        }

        .secondary-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 12px;
        }

        .btn-soft,
        .home-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 43px;
            border-radius: 14px;
            color: rgba(255, 255, 255, .82);
            background: rgba(255, 255, 255, .07);
            border: 1px solid rgba(255, 255, 255, .13);
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            transition: transform .18s ease, background .18s ease, border-color .18s ease;
        }

        .btn-soft:hover,
        .btn-soft:focus,
        .home-link:hover,
        .home-link:focus {
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
            background: rgba(82, 215, 255, .12);
            border-color: rgba(82, 215, 255, .34);
            outline: none;
        }

        .home-link {
            width: 100%;
            margin-top: 10px;
        }

        .error-text {
            min-height: 22px;
            margin: 15px 0 0;
            text-align: center;
            color: #ff8d9d;
            font-size: 13px;
        }

        .system-note {
            position: relative;
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, .10);
            color: rgba(255, 255, 255, .50);
            font-size: 11px;
            line-height: 1.5;
        }

        @@keyframes slowSweep {
            0% { transform: rotate(0deg) scale(1); }
            100% { transform: rotate(360deg) scale(1); }
        }

        @@keyframes lightPass {
            0%, 18% { transform: translateX(-30%) rotate(22deg); opacity: 0; }
            40%, 56% { opacity: .75; }
            100% { transform: translateX(340%) rotate(22deg); opacity: 0; }
        }

        @@keyframes gridDrift {
            from { transform: translate3d(0, 0, 0); opacity: .45; }
            to { transform: translate3d(18px, 14px, 0); opacity: .70; }
        }

        @@keyframes scanTop {
            0%, 100% { opacity: .35; transform: scaleX(.45); }
            50% { opacity: 1; transform: scaleX(1); }
        }

        @@media (max-width: 960px) {
            body {
                overflow: auto;
            }

            .login-scene {
                align-items: flex-start;
                padding-top: 28px;
                padding-bottom: 28px;
            }

            .login-shell {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .hero-copy {
                padding: 10px 4px;
                text-align: center;
            }

            .hero-copy p {
                margin-left: auto;
                margin-right: auto;
            }

            .status-strip {
                justify-content: center;
            }

            .login-card {
                width: min(430px, 100%);
                margin: 0 auto;
            }
        }

        @@media (max-width: 520px) {
            .security-frame {
                inset: 12px;
                border-radius: 20px;
            }

            .login-card {
                padding: 22px;
                border-radius: 22px;
            }

            .secondary-actions {
                grid-template-columns: 1fr;
            }

            .brand-emblem {
                width: 50px;
                height: 50px;
                border-radius: 16px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
            }
        }
    </style>
</head>
<body>
    <main class="login-scene">
        <!-- Arka plan videosu: yüklenemezse bayrak3.jpg fallback görünür -->
        <video class="bgvid" autoplay muted loop playsinline preload="metadata"
               poster="@Url.Content("~/img/bayrak3.jpg")"
               aria-hidden="true"
               disablepictureinpicture>
            <source src="@Url.Content("~/files/girisvideo.mp4")" type="video/mp4">
        </video>

        <div class="scene-overlay"></div>
        <div class="cinema-beam"></div>
        <div class="security-frame"></div>

        <section class="login-shell" aria-label="Sistem giriş ekranı">
            <div class="hero-copy">
                <div class="eyebrow">
                    <i class="fas fa-shield-alt"></i>
                    Güvenli Eğitim Platformu
                </div>
                <h1>
                    Hudut ve belge eğitimlerinde
                    <span>operasyonel hazırlık.</span>
                </h1>
                <p>
                    Yetkili kullanıcı girişiyle eğitim, sınav, belge analizi ve duyuru yönetimi modüllerine güvenli erişim sağlayın.
                </p>
                <div class="status-strip" aria-hidden="true">
                    <span class="status-pill"><span class="status-dot"></span> Sistem çevrimiçi</span>
                    <span class="status-pill"><i class="fas fa-lock"></i> Güvenli oturum</span>
                    <span class="status-pill"><i class="fas fa-database"></i> Yerel ağ uyumlu</span>
                </div>
            </div>

            <div class="login-card">
                <div class="brand-mark">
                    <div class="brand-emblem">
                        <!-- Logonuz varsa buraya: <img src="@Url.Content("~/files/logo/logo.png")" alt="EGM" /> -->
                        <i class="fas fa-fingerprint"></i>
                    </div>
                    <div class="brand-text">
                        <small>T.C. İçişleri Bakanlığı</small>
                        <strong>Emniyet Eğitim Sistemi</strong>
                    </div>
                </div>

                <div class="login-title">
                    <h2>Giriş Yap</h2>
                    <p>Sicil numaranız ve şifrenizle oturum açın.</p>
                </div>

                <form id="login" action="@Url.Content("~/Login")" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                        </div>
                        <input id="username" name="username" placeholder="Sicil Numarası" type="text"
                               class="form-control" required autocomplete="username"
                               inputmode="numeric" pattern="[0-9]*" maxlength="10"
                               autofocus aria-label="Sicil Numarası" />
                    </div>

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        </div>
                        <input id="pwd" name="pwd" placeholder="Şifre" type="password"
                               class="form-control" required autocomplete="current-password"
                               aria-label="Şifre" />
                        <button type="button" class="toggle-pwd" onclick="togglePassword()"
                                aria-label="Şifreyi göster veya gizle" tabindex="-1">
                            <i id="pwdEye" class="fas fa-eye"></i>
                        </button>
                    </div>

                    <div id="capsWarning" class="caps-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i> Caps Lock açık!
                    </div>

                    <div class="checkbox-custom">
                        <input id="AgreeTerms" name="agreeterms" type="checkbox" required />
                        <label for="AgreeTerms">
                            <a href="@Url.Content("~/kosullar")" target="_blank" rel="noopener">
                                Kullanım koşullarını
                            </a> kabul ediyorum.
                        </label>
                    </div>

                    <button type="submit" class="btn-login" id="btnLogin">
                        GİRİŞ YAP
                    </button>

                    <div class="secondary-actions">
                        <a href="@Url.Action("ResetPasswordPage", "Giris")" class="btn-soft"
                           role="button" aria-label="Şifremi Unuttum">
                            <i class="fas fa-key"></i> Şifremi Unuttum
                        </a>
                        <a href="@Url.Content("~/kayit")" class="btn-soft"
                           role="button" aria-label="Kayıt Ol">
                            <i class="fas fa-user-plus"></i> Kayıt Ol
                        </a>
                    </div>

                    <a href="@Url.Action("Index", "Landing")" class="home-link"
                       role="button" aria-label="Eğitim Anasayfasına Git">
                        <i class="fas fa-home"></i> Eğitim Anasayfasına Git
                    </a>
                </form>

                <p class="error-text" role="alert" aria-live="polite">
                    <strong>@ViewBag.Error</strong>
                </p>
                <div class="system-note">
                    Yetkisiz erişim girişimleri kayıt altına alınır. Oturum güvenliği için ortak bilgisayarlarda işlem sonrası çıkış yapınız.
                </div>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/vendor/jquery/jquery.js")"></script>
    <script src="@Url.Content("~/vendor/bootstrap/js/bootstrap.js")"></script>

    <script>
        /* =========================
           ŞİFRE GÖSTER / GİZLE
        ========================= */
        function togglePassword() {
            var pwd = document.getElementById('pwd');
            var eye = document.getElementById('pwdEye');
            if (!pwd || !eye) return;

            if (pwd.type === 'password') {
                pwd.type = 'text';
                eye.classList.remove('fa-eye');
                eye.classList.add('fa-eye-slash');
            } else {
                pwd.type = 'password';
                eye.classList.remove('fa-eye-slash');
                eye.classList.add('fa-eye');
            }
        }

        /* =========================
           CAPS LOCK UYARISI
        ========================= */
        (function () {
            var pwdInput = document.getElementById('pwd');
            var warning = document.getElementById('capsWarning');
            if (!pwdInput || !warning) return;

            function checkCaps(e) {
                if (e.getModifierState && e.getModifierState('CapsLock')) {
                    warning.style.display = 'block';
                } else {
                    warning.style.display = 'none';
                }
            }

            pwdInput.addEventListener('keyup', checkCaps);
            pwdInput.addEventListener('keydown', checkCaps);
            pwdInput.addEventListener('blur', function () {
                warning.style.display = 'none';
            });
        })();

        /* =========================
           ÇİFT GÖNDERİM KORUMASI
        ========================= */
        (function () {
            var form = document.getElementById('login');
            var btn = document.getElementById('btnLogin');
            if (!form || !btn) return;

            form.addEventListener('submit', function () {
                // HTML5 validasyonu geçtiyse butonu kilitle
                if (form.checkValidity()) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> GİRİŞ YAPILIYOR...';
                }
            });
        })();
    </script>
</body>
</html>