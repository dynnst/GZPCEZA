@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Şifre Sıfırlama</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="@Url.Content("~/files/logo/favicon-egm-32.png")" type="image/x-icon">
    <link rel="stylesheet" href="@Url.Content("~/vendor/bootstrap/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/vendor/font-awesome/css/fontawesome-all.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/giris-resetpassword.css")?v=1.0" />
</head>
<body>
    <main class="login-scene">
        <section class="login-shell" aria-label="Şifre sıfırlama ekranı">
            <div class="hero-copy">
                <h1>Şifrenizi<span>sıfırlayın.</span></h1>
                <p>Sicil numaranız ve e-posta adresiniz ile şifrenizi anında sıfırlayabilirsiniz.</p>
                <div class="info-note" style="max-width:620px;">
                    <strong><i class="fas fa-info-circle"></i> Bilgilendirme:</strong>
                    <ul>
                        <li>Kayıtlı sicil ve e-posta bilgilerinizi doğru giriniz.</li>
                        <li>Yeni şifreniz ekranda <strong>bir kez</strong> gösterilir.</li>
                        <li>Geçici şifreniz sicil numaranızdır ve yönetici onayından sonra kullanılabilir.</li>
                        <li>Şifreyi güvenli bir yere kaydediniz.</li>
                    </ul>
                </div>
            </div>

            <div class="login-card">
                <div class="login-title">
                    <h2>Şifre Sıfırlama</h2>
                    <p>Lütfen aşağıdaki bilgileri giriniz</p>
                </div>

                <form id="resetForm" autocomplete="on">
                    @Html.AntiForgeryToken()

                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                        <input type="text"
                               class="form-control"
                               id="sicil"
                               name="sicil"
                               placeholder="Sicil Numarası"
                               required
                               autocomplete="username"
                               inputmode="numeric"
                               maxlength="10"
                               aria-label="Sicil Numarası" />
                    </div>

                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email"
                               class="form-control"
                               id="email"
                               name="email"
                               placeholder="E-posta Adresi"
                               required
                               autocomplete="email"
                               aria-label="E-posta Adresi" />
                    </div>

                    <div class="loading-spinner" id="loadingSpinner" role="status" aria-live="polite">
                        <div class="spinner"></div>
                        <p style="margin: 8px 0 0; font-size: 13px;">İşleniyor...</p>
                    </div>

                    <button type="submit" class="btn-reset" id="submitBtn">
                        <i class="fas fa-sync-alt"></i> Şifreyi Sıfırla
                    </button>

                    <div class="result-box" id="resultBox" role="alert" aria-live="assertive">
                        <div class="result-box-title" id="resultTitle"></div>
                        <div id="resultContent"></div>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <!-- Toast bildirim alanı -->
    <div class="toast-container" id="toastContainer" aria-live="polite"></div>

    <script src="@Url.Content("~/vendor/jquery/jquery.js")"></script>
    <div id="reset-config" data-reset-url="@Url.Action("ResetPassword", "Giris")" data-login-url="@Url.Action("Index", "Giris")" style="display:none;"></div>
    <script src="@Url.Content("~/js/giris-resetpassword.js")?v=1.0"></script>
</body>
</html>
