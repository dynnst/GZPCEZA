@section Scripts {
    <script>
        $(function () {
            // Tam Ekran Oku Butonu
            $('#btnFullscreenIframe').on('click', function () {
                var $container = $('#htmlReaderWrapper');
                $container.toggleClass('is-fullscreen');
                var isFs = $container.hasClass('is-fullscreen');
                $(this).html(isFs ? '<i class="fas fa-compress mr-1"></i> Tam Ekrandan Çık' : '<i class="fas fa-expand mr-1"></i> Tam Ekran');
                if (isFs) {
                    $('body').css('overflow', 'hidden');
                } else {
                    $('body').css('overflow', '');
                }
            });

            // ESC tuşuna basınca tam ekrandan çık
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    if ($('#htmlReaderWrapper').hasClass('is-fullscreen')) {
                        $('#btnFullscreenIframe').click();
                    }
                    if ($('#imageLightboxModal').is(':visible')) {
                        closeLightbox();
                    }
                }
            });

            // Yazdır Butonu
            $('#btnPrintIframe').on('click', function () {
                var frame = document.getElementById('htmlContentFrame');
                if (frame && frame.contentWindow) {
                    frame.contentWindow.focus();
                    frame.contentWindow.print();
                } else {
                    window.print();
                }
            });

            // Resim Lightbox
            function openLightbox(src) {
                if (!src) return;
                $('#imageLightboxTarget').attr('src', src);
                $('#imageLightboxModal').fadeIn(150);
                $('body').css('overflow', 'hidden');
            }

            function closeLightbox() {
                $('#imageLightboxModal').fadeOut(150);
                $('body').css('overflow', '');
                $('#imageLightboxTarget').attr('src', '');
            }

            $('.content-image-preview, img[data-fullscreen-image="true"]').on('click', function () {
                var src = $(this).attr('src');
                openLightbox(src);
            });

            $('.image-lightbox-close-btn, #imageLightboxModal').on('click', function (e) {
                if (e.target !== document.getElementById('imageLightboxTarget')) {
                    closeLightbox();
                }
            });

            // HTML Görsel vs Kaynak Editör Sekmeleri
            var $sourceEditor = $('#htmlSourceEditor');
            var visualFrame = document.getElementById('htmlVisualEditor');

            if ($sourceEditor.length && visualFrame) {
                var currentMode = 'visual';

                function getFrameDoc() {
                    return visualFrame.contentDocument || visualFrame.contentWindow.document;
                }

                function loadVisualFromSource() {
                    var doc = getFrameDoc();
                    if (!doc) return;
                    doc.open();
                    doc.write($sourceEditor.val() || '<!doctype html><html><head><meta charset="utf-8"></head><body></body></html>');
                    doc.close();
                    doc.designMode = 'on';
                    if (doc.body) {
                        doc.body.setAttribute('contenteditable', 'true');
                    }
                }

                function syncSourceFromVisual() {
                    var doc = getFrameDoc();
                    if (!doc || !doc.documentElement) return;
                    $sourceEditor.val('<!doctype html>\n' + doc.documentElement.outerHTML);
                }

                $('.html-editor-tab').on('click', function () {
                    var mode = $(this).data('target');
                    if (mode === currentMode) return;

                    if (currentMode === 'visual') {
                        syncSourceFromVisual();
                    } else {
                        loadVisualFromSource();
                    }

                    currentMode = mode;
                    $('#htmlVisualPane').toggleClass('d-none', mode !== 'visual');
                    $('#htmlSourcePane').toggleClass('d-none', mode !== 'source');

                    $('.html-editor-tab').each(function () {
                        var isActive = $(this).data('target') === mode;
                        $(this).toggleClass('btn-primary', isActive).toggleClass('btn-outline-secondary', !isActive);
                    });
                });

                $('.html-command').on('click', function () {
                    var doc = getFrameDoc();
                    if (!doc) return;
                    var cmd = $(this).data('command');
                    var val = $(this).data('value') || null;
                    visualFrame.contentWindow.focus();
                    doc.execCommand(cmd, false, val);
                    syncSourceFromVisual();
                });

                $sourceEditor.closest('form').on('submit', function () {
                    if (currentMode === 'visual') {
                        syncSourceFromVisual();
                    }
                });

                loadVisualFromSource();
            }
        });
    </script>
}
