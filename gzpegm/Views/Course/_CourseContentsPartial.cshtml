@model IEnumerable<gzpegm.Models.CourseContents>
@{
    var courseId = ViewBag.CourseId;
    var user = ViewBag.CurrentUser as gzpegm.Models.E_User;
    bool hasContents = false;

    if (Model != null)
    {
        foreach (var item in Model)
        {
            hasContents = true;
            break;
        }
    }
}

<div class="content-management-area">
    <!-- Mesaj Alanı -->
    <div id="contentMessage"></div>

    <!-- İçerik Listesi -->
    <div class="card">
        <div class="card-header">
            <h6 class="mb-0"><i class="fa fa-list"></i> Kurs İçerikleri</h6>
        </div>
        <div class="card-body">
            @if (hasContents)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Başlık</th>
                                <th>Tür</th>
                                <th>Dosya</th>
                                <th>Tarih</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var content in Model)
                            {
                                var fp = content.FilePath;
                                var isImage = !string.IsNullOrEmpty(fp) && (
                                    fp.ToLower().EndsWith(".jpg") || fp.ToLower().EndsWith(".jpeg") ||
                                    fp.ToLower().EndsWith(".png") || fp.ToLower().EndsWith(".gif") ||
                                    fp.ToLower().EndsWith(".bmp")
                                );
                                var isHtml = (!string.IsNullOrEmpty(content.ContentType) && content.ContentType.IndexOf("html", StringComparison.OrdinalIgnoreCase) >= 0)
                                    || (!string.IsNullOrEmpty(fp) && (fp.ToLower().EndsWith(".html") || fp.ToLower().EndsWith(".htm")));
                                <tr id="contentRow_@content.ContentId">
                                    <td>@content.ContentTitle</td>
                                    <td>
                                        <span class="badge bg-info">@content.ContentType</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(content.FilePath))
                                        {
                                            if (isHtml)
                                            {
                                                <a href="@Url.Content("~/files/Egitim/" + content.FilePath)" target="_blank" class="btn btn-sm btn-outline-primary mb-1">
                                                    <i class="fa fa-eye"></i> HTML Görüntüle
                                                </a>
                                                <br />
                                                <small class="text-muted">@content.FilePath</small>
                                            }
                                            else if (isImage)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <a href="@Url.Content("~/files/Egitim/" + content.FilePath)" target="_blank" class="mr-2">
                                                        <img src="@Url.Content("~/files/Egitim/" + content.FilePath)" alt="resim" class="img-thumbnail" style="max-width:120px; max-height:80px;" />
                                                    </a>
                                                    <div>
                                                        <a href="@Url.Content("~/files/Egitim/" + content.FilePath)" target="_blank" class="btn btn-sm btn-outline-primary mb-1">
                                                            <i class="fa fa-eye"></i> Görüntüle
                                                        </a>
                                                        <br />
                                                        <a href="@Url.Content("~/files/Egitim/" + content.FilePath)" download class="btn btn-sm btn-outline-secondary">
                                                            <i class="fa fa-download"></i> İndir
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <a href="@Url.Content("~/files/Egitim/" + content.FilePath)"
                                                   target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-download"></i> İndir / Aç
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Dosya yok</span>
                                        }
                                    </td>
                                    <td>
                                        @if (content.CreatedDate.HasValue)
                                        {
                                            @content.CreatedDate.Value.ToString("dd.MM.yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }
                                    </td>
                                    <td>
                                        @if (user != null && (user.Role == "Admin" || user.Role == "Teacher"))
                                        {
                                            <button type="button" class="btn btn-sm btn-warning edit-content-btn"
                                                    data-contentid="@content.ContentId"
                                                    data-is-html="@(isHtml ? "true" : "false")"
                                                    title="İçeriği Düzenle">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger delete-content-btn"
                                                    data-contentid="@content.ContentId"
                                                    title="İçeriği Sil">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Düzenleme yok</span>
                                        }
                                    </td>
                                </tr>
                                <tr id="editContentRow_@content.ContentId" class="edit-content-row" style="display:none; background:#fff8e1;" data-is-html="@(isHtml ? "true" : "false")">
                                    <td colspan="5">
                                        <form class="edit-content-form" enctype="multipart/form-data">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ContentId" value="@content.ContentId" />
                                            <input type="hidden" name="CourseId" value="@courseId" />
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">İçerik Başlığı *</label>
                                                    <input type="text" name="ContentTitle" value="@content.ContentTitle" class="form-control" required maxlength="200" />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">İçerik Türü</label>
                                                    <select name="ContentType" class="form-control content-type-select">
                                                        @foreach (var type in new[] { "HTML", "PDF", "Video", "Doküman", "Sunum", "Resim" })
                                                        { 
                                                            <option value="@type" @(string.Equals(content.ContentType, type, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@type</option> 
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-12 mb-3">
                                                    <label class="form-label">İçerik Açıklaması</label>
                                                    <textarea name="ContentDescription" class="form-control" rows="3" maxlength="500" placeholder="İçeriğe açıklama ekleyebilirsiniz...">@content.ContentDescription</textarea>
                                                </div>
                                                <div class="col-md-12 mb-3 html-editor-section" style="@(isHtml ? "" : "display:none;")">
                                                    <label class="form-label">HTML İçerik *</label>
                                                    <div class="html-loading-placeholder text-muted mb-2" style="@(isHtml ? "" : "display:none;")">
                                                        <i class="fa fa-spinner fa-spin"></i> HTML içerik yükleniyor...
                                                    </div>
                                                    <textarea name="ContentHtml" class="form-control resource-editor content-html-editor" rows="12"
                                                              data-contentid="@content.ContentId" placeholder="HTML içeriği burada düzenlenir..."></textarea>
                                                    <small class="text-muted">Eğitim paketinden yüklenen HTML sayfasını burada düzenleyebilirsiniz.</small>
                                                    @if (!string.IsNullOrEmpty(content.FilePath))
                                                    {
                                                        <div class="mt-2">
                                                            <a href="@Url.Content("~/files/Egitim/" + content.FilePath)" target="_blank" class="btn btn-sm btn-outline-info">
                                                                <i class="fa fa-external-link"></i> Mevcut HTML'i Önizle
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-12 mb-3 file-upload-section" style="@(isHtml ? "display:none;" : "")">
                                                    <label class="form-label">Yeni Dosya (isteğe bağlı)</label>
                                                    <input type="file" name="FileUpload" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.rar,.mp4,.avi,.mov,.wmv,.flv,.webm,.mkv,.m4v,.3gp,.jpg,.jpeg,.png,.gif,.bmp,.html,.htm" />
                                                    <small class="text-muted">Yeni bir dosya yüklediğinizde mevcut dosya değiştirilecektir.</small>
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-success btn-sm"><i class="fa fa-save"></i> Değişiklikleri Kaydet</button>
                                            <button type="button" class="btn btn-secondary btn-sm cancel-edit-content" data-contentid="@content.ContentId">İptal</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> Bu derse henüz içerik eklenmemiş.
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var courseId = @courseId;

        function isHtmlType(value) {
            return (value || '').toString().toUpperCase() === 'HTML';
        }

        function toggleContentTypeSections($form) {
            var isHtml = isHtmlType($form.find('.content-type-select').val());
            $form.find('.html-editor-section').toggle(isHtml);
            $form.find('.file-upload-section').toggle(!isHtml);
        }

        function destroyEditors($container) {
            $container.find('.resource-editor').each(function () {
                try {
                    if ($(this).data('sn-init') && $(this).summernote) {
                        $(this).summernote('destroy');
                    }
                } catch (e) { }
                $(this).removeData('sn-init').removeData('html-loaded');
            });
        }

        function loadHtmlIntoEditor($form, contentId) {
            var $editor = $form.find('.content-html-editor');
            var $placeholder = $form.find('.html-loading-placeholder');

            if (!$editor.length || $editor.data('html-loaded')) {
                if (typeof window.initResourceEditors === 'function') {
                    window.initResourceEditors($form);
                }
                return;
            }

            $placeholder.show();
            $.get('@Url.Action("GetContentHtml", "Course")', { contentId: contentId })
                .done(function (response) {
                    if (response && response.success) {
                        $editor.val(response.html || '');
                        $editor.data('html-loaded', true);
                        $placeholder.hide();
                        if (typeof window.initResourceEditors === 'function') {
                            window.initResourceEditors($form);
                        }
                    } else {
                        $placeholder.html('<span class="text-danger">' + ((response && response.message) ? response.message : 'HTML içerik yüklenemedi.') + '</span>');
                        showContentMessage((response && response.message) ? response.message : 'HTML içerik yüklenemedi.', 'danger');
                    }
                })
                .fail(function () {
                    $placeholder.html('<span class="text-danger">HTML içerik yüklenirken sunucu hatası oluştu.</span>');
                    showContentMessage('HTML içerik yüklenirken sunucu hatası oluştu.', 'danger');
                });
        }

        function prepareFormBeforeSubmit($form) {
            $form.find('.resource-editor').each(function () {
                var $el = $(this);
                if ($el.data('sn-init') && $el.summernote) {
                    try { $el.val($el.summernote('code')); } catch (e) { }
                }
            });
        }

        $(document).off('click.courseContents', '.edit-content-btn').on('click.courseContents', '.edit-content-btn', function () {
            var contentId = $(this).data('contentid');
            var isHtml = String($(this).data('is-html')) === 'true';
            var $row = $('#editContentRow_' + contentId);
            var $form = $row.find('.edit-content-form');
            var willShow = !$row.is(':visible');

            $('.edit-content-row:visible').not($row).each(function () {
                destroyEditors($(this));
                $(this).hide();
            });

            $row.toggle();

            if (willShow) {
                toggleContentTypeSections($form);
                if (isHtml || isHtmlType($form.find('.content-type-select').val())) {
                    loadHtmlIntoEditor($form, contentId);
                } else if (typeof window.initResourceEditors === 'function') {
                    window.initResourceEditors($form);
                }
            } else {
                destroyEditors($row);
            }
        });

        $(document).off('change.courseContents', '.edit-content-form .content-type-select')
            .on('change.courseContents', '.edit-content-form .content-type-select', function () {
                var $form = $(this).closest('.edit-content-form');
                toggleContentTypeSections($form);
                if (isHtmlType($(this).val())) {
                    var contentId = $form.find('[name="ContentId"]').val();
                    loadHtmlIntoEditor($form, contentId);
                } else {
                    destroyEditors($form.find('.html-editor-section'));
                }
            });

        $(document).off('click.courseContents', '.cancel-edit-content').on('click.courseContents', '.cancel-edit-content', function () {
            var contentId = $(this).data('contentid');
            var $row = $('#editContentRow_' + contentId);
            destroyEditors($row);
            $row.hide();
        });

        $(document).off('submit.courseContents', '.edit-content-form').on('submit.courseContents', '.edit-content-form', function (e) {
            e.preventDefault();
            var form = $(this);
            prepareFormBeforeSubmit(form);

            if (isHtmlType(form.find('.content-type-select').val()) && !$.trim(form.find('[name="ContentHtml"]').val())) {
                showContentMessage('HTML içeriği boş olamaz.', 'danger');
                return;
            }

            var button = form.find('button[type="submit"]');
            button.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Kaydediliyor...');
            $.ajax({
                url: '@Url.Action("EditContentFromModal", "Course")',
                type: 'POST', data: new FormData(this), processData: false, contentType: false,
                success: function (response) {
                    if (response && response.success) {
                        loadCourseContents(@courseId);
                    } else {
                        showContentMessage(response && response.message ? response.message : 'İçerik güncellenemedi.', 'danger');
                        button.prop('disabled', false).html('<i class="fa fa-save"></i> Değişiklikleri Kaydet');
                    }
                },
                error: function () {
                    showContentMessage('İçerik güncellenirken sunucu hatası oluştu.', 'danger');
                    button.prop('disabled', false).html('<i class="fa fa-save"></i> Değişiklikleri Kaydet');
                }
            });
        });

        $(document).off('click.courseContents', '.delete-content-btn').on('click.courseContents', '.delete-content-btn', function () {
            var contentId = $(this).data('contentid');
            var contentTitle = $(this).closest('tr').find('td:first').text();

            if (confirm('"' + contentTitle + '" içeriğini silmek istediğinizden emin misiniz?')) {
                $.post('@Url.Action("DeleteContentFromModal", "Course")',
                    {
                        contentId: contentId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    function (response) {
                        if (response.success) {
                            showContentMessage(response.message, 'success');
                            $('#contentRow_' + contentId).remove();

                            // Eğer tüm içerikler silindiyse sayfayı yenile
                            if ($('.delete-content-btn').length === 0) {
                                loadCourseContents(@courseId);
                            }
                        } else {
                            showContentMessage(response.message, 'danger');
                        }
                    }
                );
            }
        });

        window.loadCourseContents = function (targetCourseId) {
            $.get('@Url.Action("GetCourseContents", "Course")', { courseId: targetCourseId || courseId }, function (data) {
                $('#contentManagementArea').html(data);
                if (typeof window.executePartialScripts === 'function') {
                    window.executePartialScripts($('#contentManagementArea'));
                }
            });
        };
    })();

    window.initResourceEditors = function (container) {
        var $container = $(container);
        $container.find('.resource-editor').each(function () {
            var $editor = $(this);

            // Zaten başlatılmış ise atla
            if ($editor.data('sn-init')) return;

            try {
                $editor.summernote({
                    lang: 'tr-TR',
                    height: 300,
                    minHeight: 300,
                    maxHeight: 600,
                    toolbar: [
                        ['style', ['style']],
                        ['font', ['bold', 'underline', 'clear']],
                        ['fontsize', ['fontsize']],
                        ['color', ['color']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['table', ['table']],
                        ['insert', ['link', 'hr']],
                        ['view', ['fullscreen', 'codeview', 'help']],
                        ['history', ['undo', 'redo']]
                    ],
                    fontNames: ['Arial', 'Courier New', 'Helvetica', 'Times New Roman', 'verdana'],
                    disableDragAndDrop: false,
                    callbacks: {
                        onImageUpload: function (files) {
                            console.log('Image upload intercepted - disabled for security');
                            // Resim yüklemesi devre dışı bırakıldı - sadece mevcut resimleri bağlayabilir
                        },
                        onMediaDelete: function ($target) {
                            console.log('Media deleted');
                        }
                    }
                });

                $editor.data('sn-init', true);
            } catch (e) {
                console.error('Summernote initialization error:', e);
            }
        });
    };

    window.executePartialScripts = function (container) {
        // Partial yüklenirken çalıştırılacak komutlar
        if (typeof window.initResourceEditors === 'function') {
            window.initResourceEditors(container);
        }
    };

    function showContentMessage(message, type) {
        var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        $('#contentMessage').html('<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
            '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>' +
            message + '</div>');

        setTimeout(function () {
            $('#contentMessage .alert').alert('close');
        }, 5000);
    }
</script>
