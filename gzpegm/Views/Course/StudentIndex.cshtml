@model List<gzpegm.Models.ViewModels.CourseViewModel>
@using gzpegm.Models.ViewModels
@using System.Text.RegularExpressions
@using System.Net

@functions {
    private string PlainText(string html, int maxLen = 95)
    {
        if (string.IsNullOrWhiteSpace(html)) return string.Empty;
        string withoutImg = Regex.Replace(html, @"<img[^>]*>", string.Empty, RegexOptions.IgnoreCase);
        string withoutTags = Regex.Replace(withoutImg, "<.*?>", string.Empty);
        string decoded = WebUtility.HtmlDecode(withoutTags).Trim();
        if (decoded.Length <= maxLen) return decoded;
        return decoded.Substring(0, maxLen) + "...";
    }
}

@{
    ViewBag.Title = "Kurs Kataloğu";
    Layout = "~/Views/Shared/_Master.cshtml";

    List<int> enrolledIds = ViewBag.EnrolledCourseIds as List<int> ?? new List<int>();
    List<CourseViewModel> enrolledCourses = ViewBag.EnrolledCourses as List<CourseViewModel> ?? new List<CourseViewModel>();

    // Kategori ve kurs adetlerini hesapla
    var categoryCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    if (Model != null)
    {
        foreach (var c in Model)
        {
            var cat = !string.IsNullOrWhiteSpace(c.CategoryName) ? c.CategoryName.Trim() : "Genel";
            if (!categoryCounts.ContainsKey(cat))
            {
                categoryCounts[cat] = 0;
            }
            categoryCounts[cat]++;
        }
    }
    var sortedCategories = categoryCounts.OrderBy(x => x.Key).ToList();
    int totalCourseCount = Model != null ? Model.Count : 0;
    string defaultCourseImage = Url.Content("~/files/Egitim/91a7dd7d-56dc-41d3-a9bf-296a421966e2_155.jpg");
}

<div class="student-catalog-wrapper">
    <!-- EGM HERO BANNER -->
    <div class="egm-hero-card mb-4">
        <div class="egm-hero-watermark">
            <i class="fas fa-shield-alt"></i>
        </div>
        <div class="egm-hero-content">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div class="hero-text-block">
                    <div class="hero-department-pill">
                        <i class="fas fa-shield-alt text-warning mr-1"></i> EGM HUDUT KAPILARI DAİRE BAŞKANLIĞI
                    </div>
                    <h1 class="hero-main-title">
                        <i class="fas fa-graduation-cap mr-2"></i>Personel Eğitim &amp; Kurs Kataloğu
                    </h1>
                    <p class="hero-description">
                        Hudut kapıları personeli için hazırlanmış interaktif mesleki gelişim, mevzuat ve operasyonel eğitim modülleri.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.UserFirstName as string))
                    {
                        <div class="hero-user-badge">
                            <i class="fas fa-user-circle mr-1 text-info"></i>
                            Sayın <strong>@ViewBag.UserFirstName @ViewBag.UserLastName</strong>, iyi çalışmalar dileriz.
                        </div>
                    }
                </div>

                <div class="hero-actions-block">
                    <!-- Hızlı İstatistik Kartları -->
                    <div class="hero-stats-row mb-3">
                        <div class="hero-stat-box">
                            <span class="hero-stat-val">@totalCourseCount</span>
                            <span class="hero-stat-lbl">Aktif Kurs</span>
                        </div>
                        <div class="hero-stat-box">
                            <span class="hero-stat-val text-success">@enrolledCourses.Count</span>
                            <span class="hero-stat-lbl">Kayıtlı Kursum</span>
                        </div>
                        <div class="hero-stat-box">
                            <span class="hero-stat-val text-info">@categoryCounts.Count</span>
                            <span class="hero-stat-lbl">Kategori</span>
                        </div>
                    </div>

                    <!-- Hızlı Navigasyon Butonları -->
                    <div class="hero-nav-buttons">
                        <a href="@Url.Action("AvailableExams", "StudentExam")" class="btn btn-hero-pill">
                            <i class="fas fa-clipboard-check mr-1 text-warning"></i> Mevcut Sınavlar
                        </a>
                        <a href="@Url.Action("MyExamResults", "StudentExam")" class="btn btn-hero-pill">
                            <i class="fas fa-chart-line mr-1 text-info"></i> Sınav Geçmişim
                        </a>
                        <a href="@Url.Action("AllInstructors", "Course")" class="btn btn-hero-pill">
                            <i class="fas fa-chalkboard-teacher mr-1"></i> Eğitmenler
                        </a>
                        <a href="@Url.Action("Index", "EducationQuality")" class="btn btn-hero-pill">
                            <i class="fas fa-star mr-1 text-warning"></i> Kalite Raporu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KAYITLI OLDUĞUM KURSLAR (ÖĞRENME MASASI) -->
    @if (enrolledCourses.Any())
    {
        <div class="enrolled-section-wrapper mb-5">
            <div class="section-title-bar d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <div class="section-icon-badge bg-emerald-soft mr-3">
                        <i class="fas fa-user-graduate text-success"></i>
                    </div>
                    <div>
                        <h3 class="section-heading mb-0">Kayıtlı Olduğum Kurslar</h3>
                        <p class="section-subtext mb-0">Eğitiminize kaldığınız yerden hızla devam edin</p>
                    </div>
                </div>
                <span class="badge badge-emerald-pill">
                    <i class="fas fa-check-circle mr-1"></i> @enrolledCourses.Count Aktif Eğitim
                </span>
            </div>

            <div class="catalog-grid-layout">
                @foreach (var course in enrolledCourses)
                {
                    string enrolledImg = string.IsNullOrEmpty(course.CoverImage) || course.CoverImage.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)
                        ? defaultCourseImage
                        : Url.Content("~/files/Egitim/" + course.CoverImage);

                    var desc = PlainText(course.CourseDescription, 90);

                    <div class="catalog-card-shell enrolled-highlight">
                        <article class="modern-catalog-card">
                            <!-- Medya Alanı -->
                            <div class="card-media-wrapper">
                                <img src="@enrolledImg" alt="@course.CourseTitle" class="card-media-img" loading="lazy" onerror="this.onerror=null;this.src='@defaultCourseImage';" />
                                <div class="card-media-overlay"></div>
                                
                                <div class="card-badge-top-left">
                                    <span class="category-tag-pill">
                                        <i class="fas fa-tag mr-1"></i>@(string.IsNullOrWhiteSpace(course.CategoryName) ? "Genel" : course.CategoryName)
                                    </span>
                                </div>
                                
                                <div class="card-badge-top-right">
                                    <span class="status-badge-enrolled">
                                        <i class="fas fa-check-circle mr-1"></i>Kayıtlı
                                    </span>
                                </div>

                                <div class="card-media-hover-action">
                                    <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn-media-play">
                                        <i class="fas fa-play"></i>
                                    </a>
                                </div>
                            </div>

                            <!-- İçerik Alanı -->
                            <div class="card-body-wrapper">
                                <div class="card-meta-row">
                                    <span class="card-meta-date">
                                        <i class="far fa-calendar-alt mr-1"></i>@(course.CreatedDate.HasValue ? course.CreatedDate.Value.ToString("dd.MM.yyyy") : "Güncel")
                                    </span>
                                    <span class="card-meta-badge text-success">
                                        <i class="fas fa-bolt mr-1"></i>Devam Ediyor
                                    </span>
                                </div>

                                <h5 class="card-course-title" title="@course.CourseTitle">
                                    <a href="@Url.Action("Details", "Course", new { id = course.CourseId })">@course.CourseTitle</a>
                                </h5>

                                <p class="card-course-desc">
                                    @(string.IsNullOrWhiteSpace(desc) ? "Bu eğitim modülü için personel çalışma notları ve sınav materyalleri mevcuttur." : desc)
                                </p>

                                <div class="card-action-bar mt-auto">
                                    <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn-modern-card btn-enrolled-continue">
                                        <span><i class="fas fa-play-circle mr-2"></i>Eğitime Devam Et</span>
                                        <i class="fas fa-arrow-right action-arrow"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </div>
    }

    <!-- FİLTRE VE ARAMA KONTROL PANELİ -->
    <div class="filter-control-panel mb-4">
        <div class="row align-items-center mb-3">
            <div class="col-lg-8 col-md-7 mb-3 mb-md-0">
                <div class="search-input-group">
                    <i class="fas fa-search search-lens-icon"></i>
                    <input type="text" id="txtSearch" class="form-control modern-search-input" placeholder="Kurs başlığı, açıklama veya konu arayın..." autocomplete="off">
                    <button type="button" id="btnClearSearch" class="btn-clear-search" title="Aramayı Temizle" style="display:none;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4 col-md-5">
                <div class="category-select-group">
                    <i class="fas fa-filter select-filter-icon"></i>
                    <select id="ddlCategory" class="form-control modern-select-input">
                        <option value="">Tüm Kategoriler (@totalCourseCount)</option>
                        @foreach (var cat in sortedCategories)
                        {
                            <option value="@cat.Key">@cat.Key (@cat.Value)</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Hızlı Kategori Seçim Hapları (Chips) -->
        <div class="category-chips-bar">
            <div class="chips-scroll-container">
                <button type="button" class="category-chip active" data-category="">
                    <i class="fas fa-layer-group mr-1"></i> Tümü <span class="chip-count">@totalCourseCount</span>
                </button>
                @foreach (var cat in sortedCategories)
                {
                    <button type="button" class="category-chip" data-category="@cat.Key.ToLowerInvariant()">
                        @cat.Key <span class="chip-count">@cat.Value</span>
                    </button>
                }
            </div>
            <div class="filter-results-indicator">
                <span id="searchResultCount" class="badge-results-count">
                    <i class="fas fa-book-open mr-1"></i> <strong id="visibleCountText">@totalCourseCount</strong> kurs listeleniyor
                </span>
            </div>
        </div>
    </div>

    <!-- TÜM KURSLAR BÖLÜM BAŞLIĞI -->
    <div class="section-title-bar d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <div class="section-icon-badge bg-navy-soft mr-3">
                <i class="fas fa-book text-primary"></i>
            </div>
            <div>
                <h3 class="section-heading mb-0">Tüm Kurs Kataloğu</h3>
                <p class="section-subtext mb-0">Yetkinlik kazanmak ve sınavlara hazırlanmak için kursları inceleyin</p>
            </div>
        </div>
    </div>

    <!-- KURS KARTLARI IZGARASI -->
    <div class="catalog-grid-layout" id="courseList">
        @if (Model != null && Model.Any())
        {
            foreach (var course in Model)
            {
                string img = string.IsNullOrEmpty(course.CoverImage) || course.CoverImage.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)
                    ? defaultCourseImage
                    : Url.Content("~/files/Egitim/" + course.CoverImage);

                bool enrolled = enrolledIds.Contains(course.CourseId);
                var desc = PlainText(course.CourseDescription, 95);
                var searchText = ((course.CourseTitle ?? "") + " " + (course.CourseDescription ?? "") + " " + (course.CategoryName ?? "")).ToLowerInvariant();
                var catKey = (course.CategoryName ?? "Genel").ToLowerInvariant();

                <div class="course-item catalog-card-shell @(enrolled ? "enrolled-item" : "")"
                     data-search="@searchText"
                     data-category="@catKey"
                     data-enrolled="@(enrolled ? "true" : "false")">

                    <article class="modern-catalog-card @(enrolled ? "is-enrolled" : "")">
                        <!-- Medya Alanı (16:9 Thumbnail) -->
                        <div class="card-media-wrapper">
                            <img src="@img" alt="@course.CourseTitle" class="card-media-img" loading="lazy" onerror="this.onerror=null;this.src='@defaultCourseImage';" />
                            <div class="card-media-overlay"></div>

                            <div class="card-badge-top-left">
                                <span class="category-tag-pill">
                                    <i class="fas fa-tag mr-1"></i>@(string.IsNullOrWhiteSpace(course.CategoryName) ? "Genel" : course.CategoryName)
                                </span>
                            </div>

                            <div class="card-badge-top-right">
                                @if (enrolled)
                                {
                                    <span class="status-badge-enrolled">
                                        <i class="fas fa-check-circle mr-1"></i>Kayıtlı
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge-available">
                                        <i class="fas fa-graduation-cap mr-1"></i>Eğitim
                                    </span>
                                }
                            </div>

                            <div class="card-media-hover-action">
                                <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn-media-preview" title="Detaylı İncele">
                                    <i class="fas fa-search-plus mr-1"></i> İncele
                                </a>
                            </div>
                        </div>

                        <!-- Kart Gövdesi -->
                        <div class="card-body-wrapper">
                            <div class="card-meta-row">
                                <span class="card-meta-date">
                                    <i class="far fa-calendar-alt mr-1"></i>@(course.CreatedDate.HasValue ? course.CreatedDate.Value.ToString("dd.MM.yyyy") : "Güncel")
                                </span>
                                @if (enrolled)
                                {
                                    <span class="card-meta-badge text-success">
                                        <i class="fas fa-check mr-1"></i>Kayıtlısınız
                                    </span>
                                }
                                else
                                {
                                    <span class="card-meta-badge text-primary">
                                        <i class="fas fa-lock-open mr-1"></i>Serbest Kayıt
                                    </span>
                                }
                            </div>

                            <h5 class="card-course-title" title="@course.CourseTitle">
                                <a href="@Url.Action("Details", "Course", new { id = course.CourseId })">@course.CourseTitle</a>
                            </h5>

                            <p class="card-course-desc">
                                @(string.IsNullOrWhiteSpace(desc) ? "Bu eğitim modülü personelimizin bilgi seviyesini yükseltmek üzere hazırlanmıştır." : desc)
                            </p>

                            <div class="card-action-bar mt-auto">
                                @if (enrolled)
                                {
                                    <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn-modern-card btn-enrolled-continue">
                                        <span><i class="fas fa-play-circle mr-2"></i>Eğitime Git</span>
                                        <i class="fas fa-arrow-right action-arrow"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Enroll", "Course", new { id = course.CourseId, returnUrl = Request.RawUrl })" class="btn-modern-card btn-enroll-action">
                                        <span><i class="fas fa-user-plus mr-2"></i>Kursa Kayıt Ol</span>
                                        <i class="fas fa-chevron-right action-arrow"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        }
    </div>

    <!-- BOŞ ARAMA DURUMU -->
    <div id="courseEmptyState" class="empty-results-box py-5 my-4" style="display:none;">
        <div class="empty-icon-circle mb-3">
            <i class="fas fa-search"></i>
        </div>
        <h4 class="empty-title mb-2">Aramanıza Uygun Kurs Bulunamadı</h4>
        <p class="empty-desc mb-3">Arama kriterlerinizi değiştirerek tekrar deneyebilir veya filtreleri sıfırlayabilirsiniz.</p>
        <button type="button" id="btnResetFilters" class="btn btn-outline-primary px-4 py-2 font-weight-bold">
            <i class="fas fa-redo-alt mr-2"></i>Filtreleri Temizle
        </button>
    </div>

    <!-- SAYFALAMA -->
    <div id="coursePagination" class="modern-pagination-container"></div>
</div>

@section Scripts {
    <script>
        $(function () {
            var pageSize = 9; // 3 sütunlu ızgara için kusursuz 9 kartlık sayfa yapısı
            var currentPage = 1;

            function getFilteredCourses() {
                var text = ($('#txtSearch').val() || '').toLocaleLowerCase('tr-TR').trim();
                var cat = ($('#ddlCategory').val() || '').toLocaleLowerCase('tr-TR').trim();

                return $('.course-item').filter(function () {
                    var searchText = ($(this).data('search') || '').toString().toLocaleLowerCase('tr-TR');
                    var category = ($(this).data('category') || '').toString().toLocaleLowerCase('tr-TR');
                    var matchText = !text || searchText.indexOf(text) !== -1;
                    var matchCat = !cat || category === cat;
                    return matchText && matchCat;
                });
            }

            function updateChipsAndDropdown(selectedCat) {
                // Dropdown güncelle
                $('#ddlCategory').val(selectedCat);

                // Chip aktifliğini güncelle
                var normCat = (selectedCat || '').toLocaleLowerCase('tr-TR').trim();
                $('.category-chip').removeClass('active');
                if (!normCat) {
                    $('.category-chip[data-category=""]').addClass('active');
                } else {
                    $('.category-chip').each(function () {
                        if ($(this).data('category') === normCat) {
                            $(this).addClass('active');
                        }
                    });
                }
            }

            function renderCourses(shouldScroll) {
                var $items = $('.course-item');
                var $filtered = getFilteredCourses();
                var totalCount = $filtered.length;
                var totalPages = Math.max(1, Math.ceil(totalCount / pageSize));

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                // Arama temizle butonunun durumunu güncelle
                var hasSearchText = !!$('#txtSearch').val().trim();
                $('#btnClearSearch').toggle(hasSearchText);

                // Gösterilen kurs adedini güncelle
                $('#visibleCountText').text(totalCount);

                $items.hide();
                $('#courseEmptyState').toggle(totalCount === 0);

                if (totalCount > 0) {
                    var start = (currentPage - 1) * pageSize;
                    $filtered.slice(start, start + pageSize).fadeIn(200);
                }

                renderPagination(totalPages, totalCount);

                if (shouldScroll) {
                    var targetOffset = $('#courseList').offset();
                    if (targetOffset) {
                        $('html, body').animate({ scrollTop: targetOffset.top - 120 }, 300);
                    }
                }
            }

            function renderPagination(totalPages, totalCount) {
                var $pagination = $('#coursePagination').empty();
                if (totalPages <= 1) return;

                var $wrapper = $('<div class="pagination-inner"></div>');

                // Önceki Butonu
                $('<button type="button" class="page-nav-btn prev-btn" title="Önceki Sayfa"><i class="fas fa-chevron-left mr-1"></i> Önceki</button>')
                    .prop('disabled', currentPage === 1)
                    .on('click', function () {
                        if (currentPage > 1) {
                            currentPage--;
                            renderCourses(true);
                        }
                    })
                    .appendTo($wrapper);

                // Sayfa Numaraları
                var maxVisibleButtons = 5;
                var startPage = Math.max(1, currentPage - 2);
                var endPage = Math.min(totalPages, startPage + maxVisibleButtons - 1);
                if (endPage - startPage < maxVisibleButtons - 1) {
                    startPage = Math.max(1, endPage - maxVisibleButtons + 1);
                }

                if (startPage > 1) {
                    $('<button type="button" class="page-num-btn">1</button>')
                        .on('click', function () { currentPage = 1; renderCourses(true); })
                        .appendTo($wrapper);
                    if (startPage > 2) {
                        $('<span class="page-dots">&hellip;</span>').appendTo($wrapper);
                    }
                }

                for (var i = startPage; i <= endPage; i++) {
                    (function (page) {
                        $('<button type="button" class="page-num-btn ' + (page === currentPage ? 'active' : '') + '">' + page + '</button>')
                            .on('click', function () {
                                currentPage = page;
                                renderCourses(true);
                            })
                            .appendTo($wrapper);
                    })(i);
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        $('<span class="page-dots">&hellip;</span>').appendTo($wrapper);
                    }
                    $('<button type="button" class="page-num-btn">' + totalPages + '</button>')
                        .on('click', function () { currentPage = totalPages; renderCourses(true); })
                        .appendTo($wrapper);
                }

                // Sonraki Butonu
                $('<button type="button" class="page-nav-btn next-btn" title="Sonraki Sayfa">Sonraki <i class="fas fa-chevron-right ml-1"></i></button>')
                    .prop('disabled', currentPage === totalPages)
                    .on('click', function () {
                        if (currentPage < totalPages) {
                            currentPage++;
                            renderCourses(true);
                        }
                    })
                    .appendTo($wrapper);

                $wrapper.appendTo($pagination);
            }

            function resetAndRenderCourses() {
                currentPage = 1;
                renderCourses(false);
            }

            // Arama kutusu olayı
            $('#txtSearch').on('input', function () {
                resetAndRenderCourses();
            });

            // Arama temizleme butonu
            $('#btnClearSearch').on('click', function () {
                $('#txtSearch').val('').focus();
                resetAndRenderCourses();
            });

            // Dropdown filtre olayı
            $('#ddlCategory').on('change', function () {
                var selectedVal = $(this).val();
                updateChipsAndDropdown(selectedVal);
                resetAndRenderCourses();
            });

            // Kategori chip butonlarına tıklama
            $('.category-chip').on('click', function () {
                var cat = $(this).data('category') || '';
                var originalCat = '';

                // Eşleşen dropdown opsiyonunu bul
                if (cat) {
                    $('#ddlCategory option').each(function () {
                        if ($(this).val().toLocaleLowerCase('tr-TR') === cat) {
                            originalCat = $(this).val();
                        }
                    });
                }

                updateChipsAndDropdown(originalCat);
                resetAndRenderCourses();
            });

            // Filtreleri sıfırlama butonu (boş durum için)
            $('#btnResetFilters').on('click', function () {
                $('#txtSearch').val('');
                updateChipsAndDropdown('');
                resetAndRenderCourses();
            });

            // İlk yükleme
            renderCourses(false);
        });
    </script>
}

@section Styles {
    <style>
        /* ========================================================
           GENEL DÜZEN VE KONTEYNER
           ======================================================== */
        .student-catalog-wrapper {
            padding: 8px 0 32px 0;
            color: #1e293b;
        }

        /* ========================================================
           EGM HERO BANNER (POLİS KURUMSAL KİMLİK)
           ======================================================== */
        .egm-hero-card {
            position: relative;
            background: linear-gradient(135deg, #071739 0%, #112959 50%, #1e3c72 100%);
            border-radius: 16px;
            padding: 32px 36px;
            color: #ffffff;
            box-shadow: 0 10px 30px rgba(7, 23, 57, 0.25);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .egm-hero-watermark {
            position: absolute;
            right: -20px;
            bottom: -35px;
            font-size: 240px;
            color: rgba(255, 255, 255, 0.04);
            pointer-events: none;
            z-index: 1;
        }
        .egm-hero-content {
            position: relative;
            z-index: 2;
        }
        .hero-department-pill {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #f8fafc;
            margin-bottom: 12px;
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .hero-main-title {
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
