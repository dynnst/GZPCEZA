@model gzpegm.Models.ViewModels.CourseContentViewModel
@using System
@{
    ViewBag.Title = "İçerik Yönetimi - " + (ViewBag.CourseTitle ?? "Ders");
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseSummernote = true;
    ViewBag.UseBootstrapFileUpload = true;

    var contents = Model.Contents ?? new List<gzpegm.Models.ViewModels.CourseContentItemViewModel>();
    int totalContents = contents.Count;
}

<div class="manage-contents-container">

    <!-- ÜST BİLGİ VE AKSİYON BANNERI -->
    <div class="contents-hero-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-7">
                <div class="d-flex align-items-center">
                    <div class="hero-icon-box mr-3">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center flex-wrap mb-1">
                            <span class="badge badge-light text-primary font-weight-bold mr-2">Ders #@Model.CourseId</span>
                            <span class="badge badge-warning text-dark font-weight-bold">Toplam @totalContents İçerik</span>
                        </div>
                        <h2 class="hero-title mb-1">@ViewBag.CourseTitle</h2>
                        <p class="hero-desc mb-0">Bu kursa ait dokümanları, videoları, ders notlarını ve zengin HTML içeriklerini yönetin.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-5 text-md-right mt-3 mt-md-0">
                <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                    <a href="@Url.Action("Details", "Course", new { id = Model.CourseId })" class="btn btn-outline-light hero-action-btn mr-2" title="Kursu Önizle">
                        <i class="fas fa-eye mr-1"></i> Kursu İncele
                    </a>
                    <a href="@Url.Action("Index", "Course")" class="btn btn-outline-light hero-action-btn mr-2" title="Tüm Derslere Dön">
                        <i class="fas fa-arrow-left mr-1"></i> Dersler
                    </a>
                    <button type="button" class="btn btn-warning hero-action-btn font-weight-bold shadow-sm" data-toggle="modal" data-target="#addContentModal">
                        <i class="fas fa-plus-circle mr-1"></i> Yeni İçerik Ekle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BİLDİRİM ALANI -->
    @if (TempData["msgSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle fa-lg mr-2 text-success"></i>
                <div>
                    <strong>Başarılı!</strong> @TempData["msgSuccess"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["msgError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-lg mr-2 text-danger"></i>
                <div>
                    <strong>Hata!</strong> @TempData["msgError"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- İÇERİKLER TABLOSU VEYA BOŞ DURUM -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex align-items-center">
                <h5 class="card-title font-weight-bold text-dark mb-0 mr-3">
                    <i class="fas fa-list-ul mr-2 text-primary"></i>Kursa Ait İçerik Listesi
                </h5>
                <span class="badge badge-primary px-2 py-1" id="totalCountBadge">@totalContents Materyal</span>
            </div>
            <div class="mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm font-weight-bold" data-toggle="modal" data-target="#addContentModal">
                    <i class="fas fa-plus mr-1"></i> Yeni İçerik Ekle
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (totalContents == 0)
            {
                <div class="empty-state-box text-center py-5">
                    <div class="empty-icon-box mb-3 text-muted">
                        <i class="fas fa-folder-open fa-4x"></i>
                    </div>
                    <h4 class="font-weight-bold text-dark">Bu Kursa Henüz İçerik Eklenmemiş</h4>
                    <p class="text-muted max-w-500 mx-auto mb-4">
                        Kursiyerlerin eğitim alabilmesi için video, mevzuat dokümanı (PDF/Word) veya zengin HTML ders notları ekleyebilirsiniz.
                    </p>
                    <button type="button" class="btn btn-primary shadow-sm" data-toggle="modal" data-target="#addContentModal">
                        <i class="fas fa-plus-circle mr-1"></i> İlk İçeriği Ekle
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="contentsTable">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 70px;" class="text-center">Sıra</th>
                                <th style="width: 140px;">İçerik Türü</th>
                                <th>Başlık ve Kısa Açıklama</th>
                                <th>Bağlı Dosya</th>
                                <th style="width: 120px;">Eklenme Tarihi</th>
                                <th class="text-right" style="width: 230px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                                foreach (var content in contents)
                                {
                                    var type = (content.ContentType ?? "HTML").ToUpperInvariant();
                                    string badgeClass = "badge-primary";
                                    string iconClass = "fa-file-code";
                                    string typeLabel = "HTML Ders Notu";

                                    if (type.Contains("PDF"))
                                    {
                                        badgeClass = "badge-danger";
                                        iconClass = "fa-file-pdf";
                                        typeLabel = "PDF Dokümanı";
                                    }
                                    else if (type.Contains("VIDEO") || type.Contains("MP4") || type.Contains("WEBM"))
                                    {
                                        badgeClass = "badge-info";
                                        iconClass = "fa-video";
                                        typeLabel = "Video Dersi";
                                    }
                                    else if (type.Contains("DOK") || type.Contains("DOC") || type.Contains("WORD") || type.Contains("XLS"))
                                    {
                                        badgeClass = "badge-dark";
                                        iconClass = "fa-file-word";
                                        typeLabel = "Belge / Doküman";
                                    }
                                    else if (type.Contains("SUNUM") || type.Contains("PPT"))
                                    {
                                        badgeClass = "badge-warning text-dark";
                                        iconClass = "fa-file-powerpoint";
                                        typeLabel = "Sunum (PPT)";
                                    }
                                    else if (type.Contains("RESIM") || type.Contains("IMAGE") || type.Contains("JPG") || type.Contains("PNG"))
                                    {
                                        badgeClass = "badge-success";
                                        iconClass = "fa-image";
                                        typeLabel = "Görsel / Şema";
                                    }

                                    var rawDesc = content.ContentDescription ?? "";
                                    var plainDesc = System.Text.RegularExpressions.Regex.Replace(rawDesc, "<[^>]*>", "").Trim();
                                    if (plainDesc.Length > 100) { plainDesc = plainDesc.Substring(0, 97) + "..."; }
                                    if (string.IsNullOrWhiteSpace(plainDesc)) { plainDesc = "Açıklama belirtilmemiş."; }

                                    <tr id="contentRow_@content.ContentId" class="content-table-row">
                                        <td class="text-center font-weight-bold text-muted">
                                            <span class="badge badge-light border">#@counter</span>
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass py-1 px-2 font-weight-semibold">
                                                <i class="fas @iconClass mr-1"></i>@typeLabel
                                            </span>
                                        </td>
                                        <td>
                                            <div class="font-weight-bold text-dark mb-1">
                                                @content.ContentTitle
                                            </div>
                                            <div class="text-muted small text-truncate max-w-450" title="@plainDesc">
                                                @plainDesc
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(content.FilePath))
                                            {
                                                var fileName = System.IO.Path.GetFileName(content.FilePath);
                                                <div class="d-flex align-items-center text-truncate max-w-220">
                                                    <i class="fas fa-paperclip text-muted mr-1"></i>
                                                    <span class="text-truncate mr-2 font-weight-500" title="@fileName">@fileName</span>
                                                    <a href="@Url.Content("~/files/Egitim/" + content.FilePath)" target="_blank" class="btn btn-xs btn-outline-secondary" title="Dosyayı Görüntüle / İndir">
                                                        <i class="fas fa-external-link-alt"></i>
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><i class="fas fa-file-alt mr-1"></i>HTML Metin İçeriği</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @(content.CreatedDate.HasValue ? content.CreatedDate.Value.ToString("dd.MM.yyyy") : "—")
                                        </td>
                                        <td class="text-right">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <!-- Önizle / Görüntüle Butonu -->
                                                <a href="@Url.Action("ContentDetail", "Course", new { id = content.ContentId })"
                                                   class="btn btn-outline-info" title="İçeriği Kursiyer Gözüyle Görüntüle / Oku">
                                                    <i class="fas fa-eye mr-1"></i> Önizle
                                                </a>

                                                <!-- Düzenle Butonu (Modal Açar) -->
                                                <button type="button" class="btn btn-outline-primary btn-edit-content"
                                                        data-id="@content.ContentId" title="Bu İçeriği Düzenle">
                                                    <i class="fas fa-edit mr-1"></i> Düzenle
                                                </button>

                                                <!-- Sil Butonu (AJAX ile onaylı siler) -->
                                                <button type="button" class="btn btn-outline-danger btn-delete-content"
                                                        data-id="@content.ContentId" data-title="@content.ContentTitle" title="İçeriği Sil">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    counter++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: YENİ İÇERİK EKLE                                        -->
<!-- ============================================================== -->
<div class="modal fade" id="addContentModal" tabindex="-1" role="dialog" aria-labelledby="addContentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-extra-wide" style="max-width: 90vw; width: 1400px;" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header modal-hero-header text-white">
                <div class="d-flex align-items-center">
                    <div class="modal-icon-badge mr-3">
                        <i class="fas fa-plus-circle fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0" id="addContentModalLabel">Yeni Ders İçeriği Ekle</h5>
                        <small class="text-white-50">Ders: @ViewBag.CourseTitle</small>
                    </div>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="addContentForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@Model.CourseId" />

                <div class="modal-body p-4 bg-light">
                    <div id="addContentAlert" class="alert alert-dismissible fade show" style="display:none;" role="alert"></div>

                    <!-- 1. KART: TEMEL BİLGİLER & TÜR -->
                    <div class="card border-0 shadow-xs mb-3">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="font-weight-bold mb-0 text-primary">
                                <i class="fas fa-info-circle mr-2"></i>1. İçerik Künyesi ve Türü
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label class="form-label font-weight-semibold">
                                        İçerik Başlığı <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white"><i class="fas fa-heading text-muted"></i></span>
                                        </div>
                                        <input type="text" id="ac_title" name="ContentTitle" class="form-control" placeholder="Örn: 1. Bölüm - Pasaport Çeşitleri ve Güvenlik Özellikleri" required maxlength="200" />
                                    </div>
                                    <small class="form-text text-muted">Kursiyerlerin içerik listesinde göreceği başlık.</small>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label font-weight-semibold">
                                        İçerik Türü <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white"><i class="fas fa-tag text-muted"></i></span>
                                        </div>
                                        <select id="ac_type" name="ContentType" class="form-control">
                                            <option value="HTML" selected>📄 HTML / Zengin Ders Notu</option>
                                            <option value="PDF">📕 PDF Dokümanı</option>
                                            <option value="Video">🎥 Video Dersi (MP4 / WebM)</option>
                                            <option value="Doküman">📝 Word / Excel Dokümanı</option>
                                            <option value="Sunum">📊 PowerPoint Sunumu</option>
                                            <option value="Resim">🖼️ Görsel / Şema / İnfografik</option>
                                        </select>
                                    </div>
                                    <small class="form-text text-muted">İçeriğin niteliğini belirler.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. KART: DOSYA YÜKLEME & KISA ÖZET -->
                    <div class="card border-0 shadow-xs mb-3">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="font-weight-bold mb-0 text-primary">
                                <i class="fas fa-paperclip mr-2"></i>2. Bağlı Dosya & Kısa Özet
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label font-weight-semibold">
                                        Dosya Yükle (PDF, Video, Doküman, Resim)
                                    </label>
                                    <div class="custom-file mb-2">
                                        <input type="file" id="ac_file" name="FileUpload" class="custom-file-input" onchange="updateCustomFileLabel(this, 'ac_file_label')">
                                        <label class="custom-file-label text-truncate" id="ac_file_label" for="ac_file">Dosya Seçiniz...</label>
                                    </div>
                                    <small class="form-text text-muted">
                                        <i class="fas fa-shield-alt mr-1"></i>İzin verilenler: PDF, MP4, AVI, MOV, DOC, DOCX, PPT, PPTX, XLS, XLSX, JPG, PNG (Video: 100MB, Diğer: 10MB)
                                    </small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label font-weight-semibold">Kısa Açıklama / Not</label>
                                    <textarea id="ac_desc" name="ContentDescription" class="form-control" rows="3" maxlength="500" placeholder="Bu içerik hakkında kursiyerlere gösterilecek kısa not veya özet..."></textarea>
                                    <small class="form-text text-muted">İçerik listesinde başlığın altında görüntülenir.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. KART: ZENGİN DERS METNİ (SUMMERNOTE) -->
                    <div class="card border-0 shadow-xs">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="font-weight-bold mb-0 text-primary">
                                <i class="fas fa-file-code mr-2"></i>3. Detaylı Eğitim Metni & Zengin HTML (Summernote)
                            </h6>
                            <span class="badge badge-light border">HTML Dersler İçin Temel Alan</span>
                        </div>
                        <div class="card-body">
                            <textarea id="ac_html" name="ContentHtml" class="form-control" rows="10"></textarea>
                            <small class="form-text text-muted mt-2">
                                <i class="fas fa-info-circle mr-1"></i>Buraya doğrudan ders metnini yazabilir, görsel yükleyebilir, mevzuat maddelerini tablo veya listelerle zenginleştirebilirsiniz.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-white border-top px-4 py-3">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Vazgeç
                    </button>
                    <button type="button" class="btn btn-primary px-4 font-weight-bold" id="saveAddContentBtn">
                        <i class="fas fa-check-circle mr-1"></i> İçeriği Kaydet ve Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: İÇERİK DÜZENLE                                         -->
<!-- ============================================================== -->
<div class="modal fade" id="editContentModal" tabindex="-1" role="dialog" aria-labelledby="editContentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-extra-wide" style="max-width: 90vw; width: 1400px;" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header modal-hero-header text-white">
                <div class="d-flex align-items-center">
                    <div class="modal-icon-badge mr-3">
                        <i class="fas fa-edit fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0" id="editContentModalLabel">İçeriği Düzenle</h5>
                        <small class="text-white-50" id="editContentModalSub">İçerik bilgilerini güncelleyin.</small>
                    </div>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- YÜKLENİYOR İNDİKATÖRÜ -->
            <div id="editLoadingState" class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="sr-only">Yükleniyor...</span>
                </div>
                <h5 class="text-muted mt-3">İçerik bilgileri yükleniyor, lütfen bekleyiniz...</h5>
            </div>

            <form id="editContentForm" enctype="multipart/form-data" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ec_contentId" name="ContentId" value="" />
                <input type="hidden" id="ec_courseId" name="CourseId" value="@Model.CourseId" />

                <div class="modal-body p-4 bg-light">
                    <div id="editContentAlert" class="alert alert-dismissible fade show" style="display:none;" role="alert"></div>

                    <!-- 1. KART: TEMEL BİLGİLER -->
                    <div class="card border-0 shadow-xs mb-3">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="font-weight-bold mb-0 text-primary">
                                <i class="fas fa-info-circle mr-2"></i>1. İçerik Başlığı & Türü
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label class="form-label font-weight-semibold">
                                        İçerik Başlığı <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white"><i class="fas fa-heading text-muted"></i></span>
                                        </div>
                                        <input type="text" id="ec_title" name="ContentTitle" class="form-control" required maxlength="200" />
                                    </div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label font-weight-semibold">
                                        İçerik Türü <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white"><i class="fas fa-tag text-muted"></i></span>
                                        </div>
                                        <select id="ec_type" name="ContentType" class="form-control">
                                            <option value="HTML">📄 HTML / Zengin Ders Notu</option>
                                            <option value="PDF">📕 PDF Dokümanı</option>
                                            <option value="Video">🎥 Video Dersi (MP4 / WebM)</option>
                                            <option value="Doküman">📝 Word / Excel Dokümanı</option>
                                            <option value="Sunum">📊 PowerPoint Sunumu</option>
                                            <option value="Resim">🖼️ Görsel / Şema / İnfografik</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. KART: DOSYA VE KISA ÖZET -->
                    <div class="card border-0 shadow-xs mb-3">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="font-weight-bold mb-0 text-primary">
                                <i class="fas fa-paperclip mr-2"></i>2. Bağlı Dosya & Kısa Açıklama
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label font-weight-semibold">Mevcut Dosya & Değiştirme</label>
                                    <div class="alert alert-light border p-2 mb-2 d-flex align-items-center justify-content-between" id="ec_currentFileWrap">
                                        <div class="text-truncate mr-2">
                                            <i class="fas fa-file text-primary mr-1"></i>
                                            <span id="ec_currentFileName" class="font-weight-500">Mevcut dosya yok</span>
                                        </div>
                                        <a href="#" id="ec_currentFileLink" target="_blank" class="btn btn-xs btn-outline-primary" style="display:none;">
                                            <i class="fas fa-external-link-alt mr-1"></i>Aç
                                        </a>
                                    </div>
                                    <div class="custom-file mb-1">
                                        <input type="file" id="ec_file" name="FileUpload" class="custom-file-input" onchange="updateCustomFileLabel(this, 'ec_file_label')">
                                        <label class="custom-file-label text-truncate" id="ec_file_label" for="ec_file">Yeni Dosya Seç (Opsiyonel)...</label>
                                    </div>
                                    <small class="form-text text-muted">Dosyayı değiştirmek istemiyorsanız bu alanı boş bırakınız.</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label font-weight-semibold">Kısa Açıklama / Not</label>
                                    <textarea id="ec_desc" name="ContentDescription" class="form-control" rows="3" maxlength="500"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. KART: SUMMERNOTE DETAYLI METİN -->
                    <div class="card border-0 shadow-xs">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="font-weight-bold mb-0 text-primary">
                                <i class="fas fa-file-code mr-2"></i>3. Detaylı Ders İçeriği (Summernote)
                            </h6>
                        </div>
                        <div class="card-body">
                            <textarea id="ec_html" name="ContentHtml" class="form-control" rows="10"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-white border-top px-4 py-3">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> İptal
                    </button>
                    <button type="button" class="btn btn-success px-4 font-weight-bold" id="saveEditContentBtn">
                        <i class="fas fa-save mr-1"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

