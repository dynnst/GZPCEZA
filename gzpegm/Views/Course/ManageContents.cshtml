@section Scripts {
    <script>
        // Dosya seçildiğinde input etiketini güncelle
        window.updateCustomFileLabel = function (input, labelId) {
            if (input.files && input.files[0]) {
                var file = input.files[0];
                var sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                $('#' + labelId).html(file.name + ' (' + sizeMb + ' MB)');

                // Tür tahminleme (Dosya uzantısına göre türü otomatik eşle)
                var ext = file.name.split('.').pop().toLowerCase();
                var targetSelect = $(input).attr('id') === 'ac_file' ? $('#ac_type') : $('#ec_type');
                if (ext === 'pdf') {
                    targetSelect.val('PDF');
                } else if (['mp4', 'avi', 'mov', 'wmv', 'webm'].indexOf(ext) !== -1) {
                    targetSelect.val('Video');
                } else if (['doc', 'docx', 'xls', 'xlsx'].indexOf(ext) !== -1) {
                    targetSelect.val('Doküman');
                } else if (['ppt', 'pptx'].indexOf(ext) !== -1) {
                    targetSelect.val('Sunum');
                } else if (['jpg', 'jpeg', 'png', 'gif', 'bmp'].indexOf(ext) !== -1) {
                    targetSelect.val('Resim');
                }
            }
        };

        $(document).ready(function () {
            var token = $('input[name="__RequestVerificationToken"]').first().val();
            var uploadUrl = '@Url.Action("UploadImage", "Course")';

            // ==========================================
            // SUMMERNOTE BAŞLATICI (LAZY INIT)
            // ==========================================
            function initModalSummernote($textarea) {
                if (!$textarea.length || $textarea.data('sn-init')) return;

                try {
                    $textarea.summernote({
                        lang: 'tr-TR',
                        height: 320,
                        minHeight: 200,
                        maxHeight: 600,
                        dialogsInBody: true,
                        toolbar: [
                            ['style', ['style']],
                            ['font', ['bold', 'italic', 'underline', 'clear']],
                            ['fontname', ['fontname']],
                            ['color', ['color']],
                            ['para', ['ul', 'ol', 'paragraph']],
                            ['table', ['table']],
                            ['insert', ['link', 'picture', 'video']],
                            ['view', ['fullscreen', 'codeview']]
                        ],
                        callbacks: {
                            onImageUpload: function (files) {
                                for (var i = 0; i < files.length; i++) {
                                    uploadEditorImage(files[i], this);
                                }
                            }
                        }
                    });
                    $textarea.data('sn-init', true);
                } catch (e) {
                    console.warn('Summernote init hatası:', e);
                }
            }

            function uploadEditorImage(file, editor) {
                var fd = new FormData();
                fd.append('file', file);
                fd.append('__RequestVerificationToken', token);

                $.ajax({
                    url: uploadUrl,
                    type: 'POST',
                    data: fd,
                    cache: false,
                    contentType: false,
                    processData: false
                }).done(function (res) {
                    if (res && res.success) {
                        $(editor).summernote('insertImage', res.url);
                    } else {
                        alert((res && res.message) ? res.message : 'Resim yüklenemedi.');
                    }
                }).fail(function () {
                    alert('Resim yüklenirken sunucu hatası oluştu.');
                });
            }

            // ==========================================
            // 1. YENİ İÇERİK EKLEME (ADD CONTENT)
            // ==========================================
            $('#addContentModal').on('shown.bs.modal', function () {
                initModalSummernote($('#ac_html'));
            });

            $('#addContentModal').on('hidden.bs.modal', function () {
                $('#addContentForm')[0].reset();
                $('#ac_file_label').html('Dosya Seçiniz...');
                $('#addContentAlert').hide().removeClass('alert-success alert-danger');
                if ($('#ac_html').data('sn-init') && $('#ac_html').summernote) {
                    try { $('#ac_html').summernote('reset'); } catch (e) { }
                }
                $('#saveAddContentBtn').prop('disabled', false).html('<i class="fas fa-check-circle mr-1"></i> İçeriği Kaydet ve Ekle');
            });

            $('#saveAddContentBtn').on('click', function () {
                var title = $.trim($('#ac_title').val());
                if (!title) {
                    $('#addContentAlert')
                        .removeClass('alert-success')
                        .addClass('alert-danger')
                        .html('<i class="fas fa-exclamation-circle mr-1"></i> Lütfen içerik başlığını giriniz.')
                        .show();
                    $('#ac_title').focus();
                    return;
                }

                var btn = $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Kaydediliyor...');
                var htmlContent = $('#ac_html').data('sn-init') && $('#ac_html').summernote ? $('#ac_html').summernote('code') : $('#ac_html').val();

                var fd = new FormData();
                fd.append('CourseId', '@Model.CourseId');
                fd.append('ContentTitle', title);
                fd.append('ContentType', $('#ac_type').val());
                fd.append('ContentDescription', $('#ac_desc').val());
                fd.append('ContentHtml', htmlContent);
                fd.append('__RequestVerificationToken', token);

                var fileInput = $('#ac_file')[0];
                if (fileInput && fileInput.files && fileInput.files[0]) {
                    fd.append('FileUpload', fileInput.files[0]);
                }

                $.ajax({
                    url: '@Url.Action("CreateContentFromModal", "Course")',
                    type: 'POST',
                    data: fd,
                    cache: false,
                    contentType: false,
                    processData: false
                }).done(function (res) {
                    if (res && res.success) {
                        $('#addContentAlert')
                            .removeClass('alert-danger')
                            .addClass('alert-success')
                            .html('<i class="fas fa-check-circle mr-1"></i> ' + (res.message || 'İçerik başarıyla eklendi!') + ' Sayfa yenileniyor...')
                            .show();
                        setTimeout(function () {
                            window.location.reload();
                        }, 900);
                    } else {
                        $('#addContentAlert')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .html('<i class="fas fa-exclamation-triangle mr-1"></i> ' + (res.message || 'Hata oluştu.'))
                            .show();
                        btn.prop('disabled', false).html('<i class="fas fa-check-circle mr-1"></i> İçeriği Kaydet ve Ekle');
                    }
                }).fail(function () {
                    $('#addContentAlert')
                        .removeClass('alert-success')
                        .addClass('alert-danger')
                        .html('<i class="fas fa-exclamation-triangle mr-1"></i> Sunucu ile iletişim kurulamadı.')
                        .show();
                    btn.prop('disabled', false).html('<i class="fas fa-check-circle mr-1"></i> İçeriği Kaydet ve Ekle');
                });
            });

            // ==========================================
            // 2. İÇERİK DÜZENLEME (EDIT CONTENT)
            // ==========================================
            $('.btn-edit-content').on('click', function () {
                var contentId = $(this).data('id');
                $('#editContentModal').modal('show');
                $('#editLoadingState').show();
                $('#editContentForm').hide();
                $('#editContentAlert').hide();

                $.getJSON('@Url.Action("GetContentData", "Course")', { id: contentId })
                    .done(function (res) {
                        $('#editLoadingState').hide();
                        if (res && res.success) {
                            $('#editContentForm').show();
                            $('#ec_contentId').val(res.contentId);
                            $('#ec_title').val(res.title);
                            $('#ec_type').val(res.contentType);
                            $('#ec_desc').val(res.description);
                            $('#editContentModalSub').text('İçerik #' + res.contentId + ' - ' + res.title);

                            // Mevcut dosya bilgisi
                            if (res.fileName) {
                                $('#ec_currentFileName').text(res.fileName);
                                $('#ec_currentFileLink').attr('href', '@Url.Content("~/files/Egitim/")' + res.filePath).show();
                            } else {
                                $('#ec_currentFileName').text('Bağlı dosya yok (Sadece HTML metin)');
                                $('#ec_currentFileLink').hide();
                            }
                            $('#ec_file_label').html('Yeni Dosya Seç (Opsiyonel)...');
                            $('#ec_file').val('');

                            // Summernote init & set code
                            initModalSummernote($('#ec_html'));
                            if ($('#ec_html').summernote) {
                                $('#ec_html').summernote('code', res.contentHtml || '');
                            } else {
                                $('#ec_html').val(res.contentHtml || '');
                            }
                        } else {
                            alert((res && res.message) ? res.message : 'İçerik bilgisi alınamadı.');
                            $('#editContentModal').modal('hide');
                        }
                    })
                    .fail(function () {
                        $('#editLoadingState').hide();
                        alert('İçerik yüklenirken sunucu hatası oluştu.');
                        $('#editContentModal').modal('hide');
                    });
            });

            $('#saveEditContentBtn').on('click', function () {
                var title = $.trim($('#ec_title').val());
                if (!title) {
                    $('#editContentAlert')
                        .removeClass('alert-success')
                        .addClass('alert-danger')
                        .html('<i class="fas fa-exclamation-circle mr-1"></i> Lütfen içerik başlığını giriniz.')
                        .show();
                    $('#ec_title').focus();
                    return;
                }

                var btn = $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Güncelleniyor...');
                var htmlContent = $('#ec_html').data('sn-init') && $('#ec_html').summernote ? $('#ec_html').summernote('code') : $('#ec_html').val();

                var fd = new FormData();
                fd.append('ContentId', $('#ec_contentId').val());
                fd.append('CourseId', '@Model.CourseId');
                fd.append('ContentTitle', title);
                fd.append('ContentType', $('#ec_type').val());
                fd.append('ContentDescription', $('#ec_desc').val());
                fd.append('ContentHtml', htmlContent);
                fd.append('__RequestVerificationToken', token);

                var fileInput = $('#ec_file')[0];
                if (fileInput && fileInput.files && fileInput.files[0]) {
                    fd.append('FileUpload', fileInput.files[0]);
                }

                $.ajax({
                    url: '@Url.Action("UpdateContentFromModal", "Course")',
                    type: 'POST',
                    data: fd,
                    cache: false,
                    contentType: false,
                    processData: false
                }).done(function (res) {
                    if (res && res.success) {
                        $('#editContentAlert')
                            .removeClass('alert-danger')
                            .addClass('alert-success')
                            .html('<i class="fas fa-check-circle mr-1"></i> ' + (res.message || 'İçerik başarıyla güncellendi!') + ' Sayfa yenileniyor...')
                            .show();
                        setTimeout(function () {
                            window.location.reload();
                        }, 900);
                    } else {
                        $('#editContentAlert')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .html('<i class="fas fa-exclamation-triangle mr-1"></i> ' + (res.message || 'Güncelleme sırasında hata oluştu.'))
                            .show();
                        btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Değişiklikleri Kaydet');
                    }
                }).fail(function () {
                    $('#editContentAlert')
                        .removeClass('alert-success')
                        .addClass('alert-danger')
                        .html('<i class="fas fa-exclamation-triangle mr-1"></i> Sunucu ile iletişim kurulamadı.')
                        .show();
                    btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Değişiklikleri Kaydet');
                });
            });

            // ==========================================
            // 3. İÇERİK SİLME (DELETE CONTENT)
            // ==========================================
            $('.btn-delete-content').on('click', function () {
                var contentId = $(this).data('id');
                var contentTitle = $(this).data('title') || 'Bu içerik';

                if (!confirm('⚠️ Dikkat!\n\n"' + contentTitle + '" başlıklı içeriği silmek istediğinizden emin misiniz?\n\nVarsa sunucudaki bağlı dosyası da kalıcı olarak silinecektir.')) {
                    return;
                }

                var $row = $('#contentRow_' + contentId);
                var $btn = $(this).prop('disabled', true);

                $.post('@Url.Action("DeleteContentFromModal", "Course")', {
                    contentId: contentId,
                    __RequestVerificationToken: token
                }).done(function (res) {
                    if (res && res.success) {
                        $row.fadeOut(300, function () {
                            $(this).remove();
                            var remaining = $('#contentsTable tbody tr').length;
                            $('#totalCountBadge').text(remaining + ' Materyal');
                            if (remaining === 0) {
                                window.location.reload();
                            }
                        });
                    } else {
                        alert((res && res.message) ? res.message : 'İçerik silinemedi.');
                        $btn.prop('disabled', false);
                    }
                }).fail(function () {
                    alert('İçerik silinirken sunucu hatası oluştu.');
                    $btn.prop('disabled', false);
                });
            });

            // Otomatik alert kapatma
            setTimeout(function () {
                $('.alert.alert-dismissible').fadeOut(400);
            }, 5000);
        });
    </script>
}
