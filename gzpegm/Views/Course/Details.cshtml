                    systemAlert: "ŞÜPHELİ BELGE BİLDİRİMİ: Interpol Çalıntı/Kayıp Belge veri tabanında (SLTD) benzer seri uyarısı ve vize sayfasında tahrifat şüphesi.",
                    correctDecision: "SECOND_LINE",
                    legalRationale: "DOĞRU TAKTİK KARAR! Hudut Kapıları Genelgesi ve YUKK Md. 9 uyarınca belgesinde tahrifat/çalıntı şüphesi bulunan yolcular birinci hat kulübesinde bekletilmeksizin detaylı adli inceleme için derhal İKİNCİ HAT (Mülakat & Belge Lab) birimine sevk edilir."
                },
                {
                    name: "Giorgos Vlachos",
                    details: "Yunanistan Uyruklu • Uçuş: GQ720 Girit - Antalya",
                    purpose: "Kongre Katılımı",
                    stay: "7 Gün",
                    hotel: "Kundu Titanik Otel",
                    visa: "Vize Muafiyeti",
                    docNum: "AO6610293",
                    docExpiry: "10.10.2031",
                    docCountry: "Yunanistan (GRC)",
                    docAuthority: "Hellenic Police",
                    mrz1: "P<GRCVLACHOS<<GIORGOS<<<<<<<<<<<<<<<<<<<<<<<",
                    mrz2: "AO66102934GRC7911043M3110107<<<<<<<<<<<<<<08",
                    systemAlert: "ALARM: POLNET Veri Tabanında 'G-87 (Genel Güvenlik Açısından Tehlike Arz Eden Kişi)' TAHDİT KODU bulunmaktadır!",
                    correctDecision: "INAD_REJECT",
                    legalRationale: "HAYATİ POLİS REFLEKSİ! YUKK Md. 9 ve Md. 15 gereğince kamu düzeni ve kamu güvenliği açısından hakkında Türkiye'ye giriş yasağı (G-87 tahditi) bulunan yabancılara kesinlikle geçiş verilmez, derhal INAD işlemi uygulanarak muhafaza altına alınır."
                }
            ];

            var currentBoothPaxIdx = 0;
            var boothStreak = 0;
            var boothScore = 0;
            var boothTimerInterval = null;
            var boothSecondsLeft = 15;
            var isBoothDecided = false;
            var boothLoupeActive = false;

            function initBoothGame() {
                if (!isDataLoaded) return;
                loadBoothPassenger(currentBoothPaxIdx);
            }

            function loadBoothPassenger(idx) {
                if (idx >= boothPassengers.length) {
                    $('#boothWinBanner').removeClass('d-none');
                    playSound('fanfare');
                    return;
                }

                var p = boothPassengers[idx];
                isBoothDecided = false;
                $('#boothPassengerNumText').text('Yolcu ' + (idx + 1) + '/' + boothPassengers.length);
                $('#boothPaxName').text(p.name);
                $('#boothPaxDetails').text(p.details);
                $('#boothPaxPurpose').text(p.purpose);
                $('#boothPaxStay').text(p.stay);
                $('#boothPaxHotel').text(p.hotel);
                $('#boothPaxVisa').text(p.visa);
                $('#boothMetaDocNum').text(p.docNum);
                $('#boothMetaDocExpiry').text(p.docExpiry);
                $('#boothMetaDocCountry').text(p.docCountry);
                $('#boothMetaDocAuthority').text(p.docAuthority);
                $('#boothMrzLine1').text(p.mrz1);
                $('#boothMrzLine2').text(p.mrz2);
                $('#boothSystemAlertText').text(p.systemAlert);

                // Hudut Masasında Biyoveri (Kimlik) Sayfası Gösterilir (Kapak değil!)
                var docImg = forensicAssets.biodata ? forensicAssets.biodata.url : '/AdminTemplate/img/landing/default-course.jpg';
                $('#boothPassportImg').attr('src', docImg);
                $('#boothLoupe').css({ 'background-image': 'url("' + docImg + '")' });

                // Kaşe ve Karar Panellerini Sıfırla
                $('#boothStampSeal').addClass('d-none').attr('class', 'booth-stamp-seal d-none');
                $('#boothVerdictBox').addClass('d-none').removeClass('alert-success alert-danger');
                $('#boothButtonsRow').removeClass('d-none');
                $('#btnNextPassenger').addClass('d-none');

                startBoothTimer();
            }

            // Booth Loupe Butonu
            $('#btnBoothZoomToggle').on('click', function (e) {
                e.stopPropagation();
                boothLoupeActive = !boothLoupeActive;
                $(this).toggleClass('btn-warning text-dark active', boothLoupeActive);
                if (!boothLoupeActive) $('#boothLoupe').hide();
                playSound('snap');
            });

            $('#boothPassportFrame').on('mousemove', function (e) {
                if (!boothLoupeActive) return;
                var $frame = $(this);
                var offset = $frame.offset();
                var relX = e.pageX - offset.left;
                var relY = e.pageY - offset.top;
                var frameW = $frame.width();
                var frameH = $frame.height();

                var $loupe = $('#boothLoupe');
                $loupe.css({ left: relX + 'px', top: relY + 'px', display: 'block' });

                var zoomFactor = 2.5;
                var bgX = (relX / frameW) * 100;
                var bgY = (relY / frameH) * 100;

                $loupe.css({
                    'background-size': (frameW * zoomFactor) + 'px ' + (frameH * zoomFactor) + 'px',
                    'background-position': bgX + '% ' + bgY + '%'
                });
            });

            $('#boothPassportFrame').on('mouseleave', function () {
                if (boothLoupeActive) $('#boothLoupe').hide();
            });

            function startBoothTimer() {
                clearInterval(boothTimerInterval);
                boothSecondsLeft = 15;
                $('#boothTimerDigits').text('15s');
                $('#boothProgressBar')
                    .css('width', '100%')
                    .removeClass('urgent');

                boothTimerInterval = setInterval(function () {
                    boothSecondsLeft--;
                    var pct = (boothSecondsLeft / 15) * 100;
                    $('#boothProgressBar').css('width', pct + '%');
                    $('#boothTimerDigits').text(boothSecondsLeft + 's');

                    if (boothSecondsLeft <= 5 && boothSecondsLeft > 0) {
                        $('#boothProgressBar').addClass('urgent');
                        playSound('heartbeat');
                    }

                    if (boothSecondsLeft <= 0) {
                        clearInterval(boothTimerInterval);
                        onBoothTimeOut();
                    }
                }, 1000);
            }

            function onBoothTimeOut() {
                if (isBoothDecided) return;
                isBoothDecided = true;
                boothStreak = 0;
                $('#boothStreakText').text('0x');
                playSound('buzz');

                $('#boothVerdictIcon').attr('class', 'fas fa-hourglass-end fa-lg mr-2 text-danger');
                $('#boothVerdictTitle').text('Süre Doldu! (15 Saniye Sınırı Aşıldı)');
                $('#boothVerdictDesc').text('Hudut kontrol masasında her yolcu için ortalama 15 saniyede karar verilmelidir. Şüpheli durumları hızla tespit edip 2. Hatta veya INAD kararına yönlendirmelisiniz.');
                $('#boothVerdictBox')
                    .removeClass('d-none alert-success')
                    .addClass('alert-danger animate__animated animate__shakeX');

                $('#boothButtonsRow').addClass('d-none');
                $('#btnNextPassenger').removeClass('d-none');
            }

            // Karar Butonlarına Tıklama
            $('.booth-decision-btn').off('click').on('click', function () {
                if (isBoothDecided) return;
                isBoothDecided = true;
                clearInterval(boothTimerInterval);
                initAudio();

                var decision = $(this).data('decision');
                var p = boothPassengers[currentBoothPaxIdx];

                // Kaşe Damgası Animasyonu
                var $stamp = $('#boothStampSeal');
                $stamp.removeClass('d-none accept second reject');

                if (decision === 'ACCEPT') {
                    $stamp.text('KABUL').addClass('accept');
                } else if (decision === 'SECOND_LINE') {
                    $stamp.text('İKİNCİ HAT').addClass('second');
                } else if (decision === 'INAD_REJECT') {
                    $stamp.text('INAD GİRİŞ RET').addClass('reject');
                }
                playSound('stamp');

                // Karar Doğruluk Kontrolü & Yan Yana Mukayese Masası
                var decisionLabels = {
                    'ACCEPT': 'KABUL (Giriş İzni)',
                    'SECOND_LINE': '2. HAT (Detaylı Belge İnceleme)',
                    'INAD_REJECT': 'INAD RED (Giriş Ret)'
                };

                var isCorrect = (decision === p.correctDecision);

                $('#boothUserDecisionText').text(decisionLabels[decision] || decision);
                $('#boothCorrectDecisionText').text(decisionLabels[p.correctDecision] || p.correctDecision);

                if (isCorrect) {
                    setTimeout(function () {
                        playSound('ding');
                    }, 250);
                    boothStreak++;
                    boothScore += 100;
                    $('#boothStreakText').text(boothStreak + 'x 🔥');
                    $('#boothScoreText').text(boothScore);

                    $('#boothUserDecisionCol').removeClass('wrong').addClass('correct');
                    $('#boothUserDecisionImpact').html('<span class="text-success font-weight-bold"><i class="fas fa-check-circle mr-1"></i> Kusursuz Polis Refleksi!</span> Mevzuata ve risk kriterlerine tam uygun hareket ettiniz.');

                    $('#boothVerdictIcon').attr('class', 'fas fa-check-circle fa-lg mr-2 text-success');
                    $('#boothVerdictTitle').text('Tebrikler! Doğru Hudut Kararı');
                    $('#boothVerdictXpBadge').text('+100 XP').attr('class', 'badge badge-success');
                    $('#boothVerdictDesc').text(p.legalRationale);
                    $('#boothVerdictBox')
                        .removeClass('d-none alert-danger')
                        .addClass('alert-success animate__animated animate__fadeIn');
                } else {
                    setTimeout(function () {
                        playSound('buzz');
                    }, 250);
                    boothStreak = 0;
                    $('#boothStreakText').text('0x');

                    $('#boothUserDecisionCol').removeClass('correct').addClass('wrong');
                    var impactText = '';
                    if (decision === 'ACCEPT') {
                        impactText = '<span class="text-danger font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> Sınır İhlali Riski!</span> Kusurlu/tahrifatlı veya tahditli yolcuya giriş verildi; YUKK ve sınır güvenliği zaafı doğdu.';
                    } else if (decision === 'INAD_REJECT') {
                        impactText = '<span class="text-danger font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> Hatalı Ret Kararı!</span> Haksız INAD düzenlenmesi uluslararası seyahat hakkı ihlali veya delilsiz işlem riski doğurur.';
                    } else {
                        impactText = '<span class="text-warning font-weight-bold"><i class="fas fa-info-circle mr-1"></i> Operasyonel Gecikme!</span> Birinci hatta doğrudan çözülmesi gereken açık bir durum için yolcu gereksiz 2. hatta sevk edildi.';
                    }
                    $('#boothUserDecisionImpact').html(impactText);

                    $('#boothVerdictIcon').attr('class', 'fas fa-times-circle fa-lg mr-2 text-danger');
                    $('#boothVerdictTitle').text('Hatalı Hudut Kararı!');
                    $('#boothVerdictXpBadge').text('0 XP').attr('class', 'badge badge-danger');
                    $('#boothVerdictDesc').text('Bu yolcu için doğru karar ' + (decisionLabels[p.correctDecision] || p.correctDecision) + ' olmalıydı. ' + p.legalRationale);
                    $('#boothVerdictBox')
                        .removeClass('d-none alert-success')
                        .addClass('alert-danger animate__animated animate__shakeX');
                }

                $('#boothButtonsRow').addClass('d-none');
                $('#btnNextPassenger').removeClass('d-none');
            });

            $('#btnRetryCurrentPax').on('click', function (e) {
                e.stopPropagation();
                initAudio();
                playSound('snap');
                loadBoothPassenger(currentBoothPaxIdx);
            });

            $('#btnNextPassenger').on('click', function () {
                initAudio();
                playSound('snap');
                currentBoothPaxIdx++;
                loadBoothPassenger(currentBoothPaxIdx);
            });

            $('#btnRestartBooth, #btnPlayAgainBooth').on('click', function () {
                initAudio();
                playSound('snap');
                currentBoothPaxIdx = 0;
                boothStreak = 0;
                boothScore = 0;
                $('#boothStreakText').text('0x');
                $('#boothScoreText').text('0');
                $('#boothWinBanner').addClass('d-none');
                loadBoothPassenger(0);
            });


            // ============================================================
            // 🔬 TAM EKRAN ADLİ MİKROSKOP (HD LIGHTBOX ENGINE)
            // ============================================================
            var lightboxZoom = 1.0;
            var lbPanX = 0, lbPanY = 0;
            var lbDragging = false;
            var lbStartX = 0, lbStartY = 0;
            var lbLoupeActive = false;

            function openForensicLightbox(imgUrl, title) {
                $('#lightboxImg').attr('src', imgUrl);
                $('#lightboxDocTitle').text(title || 'Yüksek Çözünürlüklü Belge İnceleme');
                $('#lightboxLoupe').css({ 'background-image': 'url("' + imgUrl + '")' });
                if (!lbLoupeActive) $('#lightboxLoupe').hide();
                lightboxZoom = 1.0;
                lbPanX = 0; lbPanY = 0;
                updateLightboxTransform();
                $('#modalForensicLightbox').modal('show');
                playSound('pling');
            }

            function updateLightboxTransform() {
                $('#lightboxImg').css({
                    'transform': 'translate(' + lbPanX + 'px, ' + lbPanY + 'px) scale(' + lightboxZoom + ')'
                });
                $('#lightboxZoomLevel').text(Math.round(lightboxZoom * 100) + '%');
                $('#lightboxViewport').css('cursor', lightboxZoom > 1.05 ? 'grab' : 'default');
            }

            // Vitrindeki kompakt kartlara tıklandığında HD Lightbox aç
            $(document).on('click', '.doc-gallery-item', function (e) {
                e.preventDefault();
                var imgUrl = $(this).data('img-url');
                var imgTitle = $(this).data('img-title') || 'Belge Detayı';
                if (imgUrl) {
                    openForensicLightbox(imgUrl, imgTitle + ' - HD Adli İnceleme');
                }
            });

            // Lightbox 3x Mercek Modu
            $('#btnLightboxLoupe').on('click', function (e) {
                e.stopPropagation();
                lbLoupeActive = !lbLoupeActive;
                $(this).toggleClass('btn-warning text-dark active', lbLoupeActive);
                if (!lbLoupeActive) {
                    $('#lightboxLoupe').hide();
                } else {
                    var currentSrc = $('#lightboxImg').attr('src');
                    $('#lightboxLoupe').css({ 'background-image': 'url("' + currentSrc + '")' });
                }
                playSound('switch');
            });

            $('#btnOpenHdLightbox').on('click', function (e) {
                e.stopPropagation();
                var currentSrc = $('#forgeryDocImg').attr('src');
                var currentTitle = $('#forgeryCaseTitle').text();
                openForensicLightbox(currentSrc, currentTitle + ' - HD Adli İnceleme');
            });

            $('#btnBoothHdOpen').on('click', function (e) {
                e.stopPropagation();
                var currentSrc = $('#boothPassportImg').attr('src');
                var currentTitle = $('#boothPaxName').text();
                openForensicLightbox(currentSrc, currentTitle + ' - Pasaport HD İnceleme');
            });

            $('#btnOpenUvHdLightbox').on('click', function (e) {
                e.stopPropagation();
                var currentSrc = $('#uvReactionImage').attr('src');
                if (!currentSrc) currentSrc = $('#uvBaseImage').attr('src');
                openForensicLightbox(currentSrc, '365 nm UV Spektral Floresan İnceleme');
            });

            $('#btnLightboxZoomIn').on('click', function () {
                if (lightboxZoom < 5.0) {
                    lightboxZoom += 0.5;
                    updateLightboxTransform();
                    playSound('snap');
                }
            });

            $('#btnLightboxZoomOut').on('click', function () {
                if (lightboxZoom > 0.8) {
                    lightboxZoom -= 0.5;
                    if (lightboxZoom < 1.0) { lightboxZoom = 1.0; lbPanX = 0; lbPanY = 0; }
                    updateLightboxTransform();
                    playSound('snap');
                }
            });

            $('#btnLightboxReset').on('click', function () {
                lightboxZoom = 1.0;
                lbPanX = 0; lbPanY = 0;
                updateLightboxTransform();
                playSound('snap');
            });

            $('#lightboxViewport').on('wheel', function (e) {
                e.preventDefault();
                var delta = e.originalEvent.deltaY;
                if (delta < 0) {
                    if (lightboxZoom < 5.0) lightboxZoom += 0.3;
                } else {
                    if (lightboxZoom > 1.0) lightboxZoom -= 0.3;
                    if (lightboxZoom <= 1.0) { lightboxZoom = 1.0; lbPanX = 0; lbPanY = 0; }
                }
                updateLightboxTransform();
            });

            $('#lightboxViewport').on('mousedown', function (e) {
                if (lightboxZoom > 1.05 && e.button === 0) {
                    lbDragging = true;
                    lbStartX = e.pageX - lbPanX;
                    lbStartY = e.pageY - lbPanY;
                    $('#lightboxViewport').css('cursor', 'grabbing');
                }
            });

            $(document).on('mouseup', function () {
                if (lbDragging) {
                    lbDragging = false;
                    $('#lightboxViewport').css('cursor', lightboxZoom > 1.05 ? 'grab' : 'default');
                }
            });

            $('#lightboxViewport').on('mousemove', function (e) {
                if (lbDragging) {
                    lbPanX = e.pageX - lbStartX;
                    lbPanY = e.pageY - lbStartY;
                    updateLightboxTransform();
                    return;
                }

                if (lbLoupeActive) {
                    var $viewport = $(this);
                    var offset = $viewport.offset();
                    var relX = e.pageX - offset.left;
                    var relY = e.pageY - offset.top;
                    var vW = $viewport.width();
                    var vH = $viewport.height();

                    var $loupe = $('#lightboxLoupe');
                    $loupe.css({ left: relX + 'px', top: relY + 'px', display: 'block' });

                    var zoomFactor = 2.8;
                    var bgX = (relX / vW) * 100;
                    var bgY = (relY / vH) * 100;
                    $loupe.css({
                        'background-size': (vW * zoomFactor) + 'px ' + (vH * zoomFactor) + 'px',
                        'background-position': bgX + '% ' + bgY + '%'
                    });
                }
            });

            $('#lightboxViewport').on('mouseleave', function () {
                if (lbLoupeActive) $('#lightboxLoupe').hide();
                if (lbDragging) lbDragging = false;
            });
        });
    </script>
}
