@model gzpegm.Models.ViewModels.CourseViewModel
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Text.RegularExpressions
@using System.Web

@functions {
    public string ToPlainText(string html, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        text = System.Web.HttpUtility.HtmlDecode(text ?? "");
        text = System.Text.RegularExpressions.Regex.Replace(text, "\\s+", " ").Trim();
        if (text.Length <= maxLength)
            return text;
        return text.Substring(0, Math.Max(0, maxLength - 3)).TrimEnd() + "...";
    }

    public string GetContentBadgeClass(string contentType)
    {
        if (string.IsNullOrEmpty(contentType))
            return "badge-icon-default";

        string type = contentType.ToLowerInvariant();

        if (type == "video" || type == "mp4") return "badge-icon-purple";
        if (type == "pdf") return "badge-icon-red";
        if (type.Contains("doc") || type.Contains("word")) return "badge-icon-blue";
        if (type.Contains("ppt") || type.Contains("presentation")) return "badge-icon-yellow";
        if (type.Contains("xls") || type.Contains("sheet") || type.Contains("excel")) return "badge-icon-green";
        if (type.Contains("image") || type == "jpg" || type == "png" || type == "jpeg") return "badge-icon-cyan";
        if (type.Contains("audio") || type == "mp3") return "badge-icon-teal";
        if (type.Contains("zip") || type.Contains("rar")) return "badge-icon-dark";

        return "badge-icon-default";
    }

    public string GetContentTypeName(string contentType)
    {
        if (string.IsNullOrEmpty(contentType))
            return "Doküman / Belge";

        string type = contentType.ToLowerInvariant();

        if (type == "video") return "Video Ders";
        if (type == "pdf") return "PDF Dokümanı";
        if (type.Contains("doc") || type.Contains("word")) return "Word Belgesi";
        if (type.Contains("ppt") || type.Contains("presentation")) return "Sunum";
        if (type.Contains("xls") || type.Contains("sheet") || type.Contains("excel")) return "Excel Tablosu";
        if (type.Contains("image") || type == "jpg" || type == "png" || type == "jpeg") return "Görsel Materyal";
        if (type.Contains("audio") || type == "mp3") return "Ses Kaydı";
        if (type.Contains("zip") || type.Contains("rar")) return "Arşiv Paketi";

        return contentType.ToUpperInvariant();
    }

    public string GetContentIcon(string contentType)
    {
        if (string.IsNullOrEmpty(contentType))
            return "fa-file-alt";

        string type = contentType.ToLowerInvariant();

        if (type == "video") return "fa-video";
        if (type == "pdf") return "fa-file-pdf";
        if (type.Contains("doc") || type.Contains("word")) return "fa-file-word";
        if (type.Contains("ppt") || type.Contains("presentation")) return "fa-file-powerpoint";
        if (type.Contains("xls") || type.Contains("sheet") || type.Contains("excel")) return "fa-file-excel";
        if (type.Contains("image") || type == "jpg" || type == "png" || type == "jpeg") return "fa-file-image";
        if (type.Contains("audio") || type == "mp3") return "fa-file-audio";
        if (type.Contains("zip") || type.Contains("rar")) return "fa-file-archive";

        return "fa-file-alt";
    }
}
@{
    ViewBag.Title = (Model != null ? Model.CourseTitle : "Kurs") + " - Kurs Detayı";
    Layout = "~/Views/Shared/_Master.cshtml";

    var currentUser = ViewBag.CurrentUser as gzpegm.Models.E_User;
    bool canManage = ViewBag.CanManageCourse is bool && (bool)ViewBag.CanManageCourse;
    if (!canManage && currentUser != null)
    {
        canManage = string.Equals(currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    (string.Equals(currentUser.Role, "Teacher", StringComparison.OrdinalIgnoreCase) && Model.CreatedBy == currentUser.fldId);
    }

    var detailExams = new List<gzpegm.Models.ViewModels.ExamViewModel>();
    if (ViewBag.CourseExams is IEnumerable<gzpegm.Models.ViewModels.ExamViewModel> detailExamSource)
    {
        detailExams = detailExamSource as List<gzpegm.Models.ViewModels.ExamViewModel> ?? new List<gzpegm.Models.ViewModels.ExamViewModel>(detailExamSource);
    }

    var detailContents = Model.Contents ?? new List<gzpegm.Models.CourseContents>();
    var sortedContents = detailContents.OrderBy(c => c.CreatedDate ?? DateTime.MinValue).ToList();
    var firstContent = sortedContents.FirstOrDefault();

    var detailQuestionCount = detailExams.Sum(e => e.QuestionCount);
    var detailCompletedExamCount = detailExams.Count(e => e.ExamResultId.HasValue);
    var detailIntro = ToPlainText(Model.CourseDescription, 320);

    bool allExamsDone = ViewBag.AllExamsCompleted is bool && (bool)ViewBag.AllExamsCompleted;
    byte certStatus = ViewBag.CertificateStatus is byte ? (byte)ViewBag.CertificateStatus : (byte)255;
}

<div class="course-details-container">

    <!-- ÜST NAVİGASYON / BREADCRUMB -->
    <div class="details-nav-bar mb-3">
        <div class="row align-items-center">
            <div class="col-md-7">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")"><i class="fas fa-home"></i> Ana Sayfa</a></li>
                        @if (canManage)
                        {
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Course")">Eğitim Yönetimi</a></li>
                        }
                        else
                        {
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Landing")">Eğitimler</a></li>
                        }
                        <li class="breadcrumb-item active text-truncate" style="max-width: 320px;" aria-current="page">@Model.CourseTitle</li>
                    </ol>
                </nav>
            </div>
            <div class="col-md-5 text-right">
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- HERO / BAŞLIK KARTI -->
    <div class="hero-detail-card mb-4 position-relative overflow-hidden text-white shadow-lg">
        <div class="hero-backdrop-glow"></div>
        <div class="row align-items-center position-relative p-4 p-md-5">
            <div class="col-lg-8 col-md-7">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <span class="badge badge-warning text-dark font-weight-bold px-3 py-2 mr-2">
                            <i class="fas fa-folder-open mr-1"></i> @Model.CategoryName
                        </span>
                    }
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success px-3 py-2 mr-2">
                            <i class="fas fa-check-circle mr-1"></i> Aktif Eğitim
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-secondary px-3 py-2 mr-2">
                            <i class="fas fa-pause-circle mr-1"></i> Pasif
                        </span>
                    }
                    <span class="badge badge-info px-3 py-2">
                        <i class="fas fa-shield-alt mr-1"></i> Hudut Güvenlik Standardı
                    </span>
                </div>

                <h1 class="hero-course-title font-weight-bold mb-3">@Model.CourseTitle</h1>

                @if (!string.IsNullOrWhiteSpace(detailIntro))
                {
                    <p class="hero-course-intro text-white-50 mb-4">@detailIntro</p>
                }

                <div class="hero-meta-row d-flex flex-wrap align-items-center mb-4">
                    <div class="meta-item mr-4 mb-2">
                        <i class="fas fa-star text-warning mr-1"></i>
                        <span class="font-weight-bold text-white">5.0</span>
                        <span class="text-white-50 small">(@(Model.ApprovedReviews != null ? Model.ApprovedReviews.Count : 0) Değerlendirme)</span>
                    </div>
                    <div class="meta-item mr-4 mb-2">
                        <i class="fas fa-book-open text-success mr-1"></i>
                        <span class="font-weight-bold text-white">@detailContents.Count</span>
                        <span class="text-white-50 small">Ders Modülü</span>
                    </div>
                    <div class="meta-item mb-2">
                        <i class="fas fa-clipboard-check text-warning mr-1"></i>
                        <span class="font-weight-bold text-white">@detailExams.Count</span>
                        <span class="text-white-50 small">Sınav</span>
                    </div>
                </div>

                <!-- Aksiyon Butonları -->
                <div class="hero-actions-container d-flex flex-wrap align-items-center gap-3">
                    @if (firstContent != null)
                    {
                        <a href="@Url.Action("ContentDetail", "Course", new { id = firstContent.ContentId })" class="btn btn-warning btn-lg btn-start-course shadow-sm mr-2 mb-2">
                            <i class="fas fa-play-circle mr-2"></i> Eğitime Başla
                        </a>
                    }

                    <!-- KURSA ÖZEL ADLİ BELGE & HUDUT SİMÜLATÖRÜ BUTONU -->
                    <button type="button" class="btn btn-emerald btn-lg btn-practice-trigger shadow-sm mr-2 mb-2" id="btnLaunchPracticeGame" data-course-id="@Model.CourseId">
                        <i class="fas fa-shield-alt mr-2 text-warning"></i> Adli Belge &amp; Hudut Simülatörü
                        <span class="badge badge-light text-dark ml-2 font-weight-bold">3 Taktik Görev</span>
                    </button>

                    @if (canManage)
                    {
                        <a href="@Url.Action("ManageContents", "Course", new { courseId = Model.CourseId })" class="btn btn-outline-light btn-sm mb-2">
                            <i class="fas fa-edit mr-1"></i> İçerikleri Düzenle (@detailContents.Count)
                        </a>
                    }

                    @if (currentUser != null && !string.Equals(currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase) && !string.Equals(currentUser.Role, "Teacher", StringComparison.OrdinalIgnoreCase))
                    {
                        <form id="teacherRequestFormCourse" style="display:inline;">@Html.AntiForgeryToken()</form>
                        <button id="teacherRequestBtnCourse" type="button" class="btn btn-outline-light btn-sm mb-2">
                            <i class="fas fa-user-tie mr-1"></i> Eğitmen Başvurusu
                        </button>
                    }
                </div>
            </div>

            <!-- SAĞ SÜTUN: 3D PASAPORT / BELGE VİTRİNİ -->
            <div class="col-lg-4 col-md-5 text-center text-md-right mt-4 mt-md-0">
                <div class="doc-showcase-wrapper">
                    <div class="doc-3d-card" id="docShowcaseCard">
                        @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                        {
                            <img src="@Model.CoverImagePath" alt="@Model.CourseTitle" class="doc-card-img" onerror="this.src='/AdminTemplate/img/landing/default-course.jpg';" />
                        }
                        else
                        {
                            <div class="doc-placeholder-box">
                                <i class="fas fa-book-reader fa-4x text-white-50"></i>
                            </div>
                        }
                        <div class="doc-3d-shine"></div>
                        <div class="doc-badge-pill">
                            <i class="fas fa-certificate text-warning mr-1"></i> Resmi Adli Belge
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- İSTATİSTİK METRİK KARTLARI -->
    <div class="row stat-cards-row mb-4">
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-blue">
                <div class="metric-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@detailContents.Count</div>
                    <div class="metric-label">Ders &amp; İçerik Sayısı</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-purple">
                <div class="metric-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@detailExams.Count</div>
                    <div class="metric-label">Kursa Ait Sınav</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-teal">
                <div class="metric-icon">
                    <i class="fas fa-question-circle"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@detailQuestionCount</div>
                    <div class="metric-label">Toplam Soru Sayısı</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-emerald">
                <div class="metric-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@detailCompletedExamCount / @Math.Max(1, detailExams.Count)</div>
                    <div class="metric-label">Tamamlanan Sınav</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================================== -->
    <!-- 🎮 İNTERAKTİF ADLİ BELGE İNCELEME & HUDUT KONTROL SİMÜLATÖRÜ (3 TAKTİK GÖREV) -->
    <!-- ============================================================================== -->
    <div class="police-game-arena mb-5 shadow-lg" id="policeGameArena" data-course-id="@Model.CourseId">
        <!-- ARENA ÜST KONTROL & BİLGİ ŞERİDİ -->
        <div class="arena-header d-flex flex-wrap align-items-center justify-content-between p-3 border-bottom">
            <div class="d-flex align-items-center">
                <span class="arena-radar-pill mr-2"><i class="fas fa-user-shield"></i> HUDUT TAKTİK MERKEZİ</span>
                <div>
                    <h5 class="arena-title mb-0 font-weight-bold text-white">
                        <i class="fas fa-shield-alt text-warning mr-2"></i> Adli Belge İnceleme &amp; Hudut Kontrol Simülatörü
                    </h5>
                    <small class="text-white-50">@Model.CourseTitle - Tahrifat Avcısı, 365 nm UV Spektral Tarama &amp; 15s Hudut Karar Simülatörü</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 mt-2 mt-md-0">
                <button type="button" class="btn btn-xs btn-outline-light arena-sound-btn" id="btnToggleSound" title="Sesi Aç/Kapat">
                    <i class="fas fa-volume-up" id="soundIcon"></i> <span id="soundText">Ses Açık</span>
                </button>
            </div>
        </div>

        <!-- OYUN MODU SEÇİCİ SEKMELER (3 TAKTİK POLİS MODÜLÜ) -->
        <div class="game-mode-nav d-flex flex-wrap align-items-center justify-content-center p-2 border-bottom">
            <button type="button" class="btn game-mode-btn active" data-game-mode="forgery">
                <i class="fas fa-search-plus mr-2 text-warning"></i> 1. Sahtecilik &amp; Tahrifat Avcısı
            </button>
            <button type="button" class="btn game-mode-btn" data-game-mode="uv">
                <i class="fas fa-flashlight mr-2 text-info"></i> 2. 365 nm UV Kriminal Görev
            </button>
            <button type="button" class="btn game-mode-btn" data-game-mode="booth">
                <i class="fas fa-passport mr-2 text-success"></i> 3. Hudut Masası 15s Karar Simülatörü
            </button>
        </div>

        <!-- ARENA GÖVDE -->
        <div class="arena-body p-4 position-relative">

            <!-- ======================================================== -->
            <!-- MODÜL 1: SAHTECİLİK & TAHRİFAT AVCISI (FORENSIC DETECTIVE) -->
            <!-- ======================================================== -->
            <div id="gameScreenForgery" class="game-screen-panel">
                <!-- Üst Kontrol & Skor HUD -->
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 p-3 rounded arena-hud-bar">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2 mb-md-0">
                        <span class="hud-item-pill" id="forgeryCasePill">
                            <i class="fas fa-folder-open text-warning mr-1"></i> <span id="forgeryCaseNumText">Vaka 1/4</span>
                        </span>
                        <span class="hud-item-pill score">
                            <i class="fas fa-bullseye text-info mr-1"></i> Doğru Tespit: <span id="forgerySuccessCount">0</span>/4
                        </span>
                        <span class="hud-item-pill">
                            <i class="fas fa-star text-warning mr-1"></i> <span id="forgeryXpCount">0</span> XP
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-warning font-weight-bold px-3" id="btnNextForgeryCase">
                            <i class="fas fa-forward mr-1"></i> Sonraki Vaka
                        </button>
                    </div>
                </div>

                <!-- Vaka Sahası: Sol Belge İnceleme Masası, Sağ Kriminal Dosya -->
                <div class="row align-items-stretch">
                    <!-- SOL: BELGE İNCELEME MASASI (RADAR, ZOOM & BÜYÜTEÇ) -->
                    <div class="col-lg-7 col-md-12 mb-4 mb-lg-0">
                        <div class="forgery-stage-box position-relative rounded shadow text-center" id="forgeryStageBox">
                            <!-- ZOOM & ADLİ BÜYÜTEÇ KONTROL ÇUBUĞU -->
                            <div class="forensic-zoom-toolbar">
                                <button type="button" class="btn btn-xs btn-dark forensic-tool-btn" id="btnToggleLoupe" title="3x Büyüteç Lensini Aç/Kapat">
                                    <i class="fas fa-search-plus text-warning mr-1"></i> <span class="d-none d-sm-inline">Büyüteç</span>
                                </button>
                                <button type="button" class="btn btn-xs btn-dark forensic-tool-btn" id="btnZoomIn" title="Yakınlaştır (+)">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <span class="zoom-level-badge" id="zoomLevelBadge">100%</span>
                                <button type="button" class="btn btn-xs btn-dark forensic-tool-btn" id="btnZoomOut" title="Uzaklaştır (-)">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-dark forensic-tool-btn" id="btnResetZoom" title="Sıfırla">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-warning text-dark font-weight-bold forensic-tool-btn ml-1" id="btnOpenHdLightbox" title="Tam Ekran HD Kriminal Mikroskop">
                                    <i class="fas fa-expand mr-1"></i> <span class="d-none d-sm-inline">Tam Ekran</span>
                                </button>
                            </div>

                            <div class="forgery-scanner-line" id="forgeryScannerLine"></div>

                            <!-- Belge Katmanı (Pan & Zoom Destekli) -->
                            <div class="forgery-canvas-wrapper" id="forgeryCanvasWrapper">
                                <img src="" id="forgeryDocImg" class="forgery-doc-img img-fluid rounded" alt="İncelenen Belge" />
                                <!-- Şüpheli Hedef Alanı (Doğru Bölge) -->
                                <div class="forgery-target-zone" id="forgeryTargetZone"></div>
                                <!-- Tıklama Dalga Efekti -->
                                <div class="forgery-radar-pulse" id="forgeryRadarPulse"></div>
                            </div>

                            <!-- 3x Kriminal Büyüteç Lensi (Loupe) -->
                            <div class="forensic-loupe" id="forgeryLoupe"></div>

                            <!-- Crosshair & Kontrol İpucu -->
                            <div class="forgery-magnifier-hint" id="forgeryHintText">
                                <i class="fas fa-mouse text-warning mr-1"></i> Tekerlek ile Yakınlaştır / Sürükle / Şüpheli Noktaya Tıkla
                            </div>
                        </div>
                        <small class="text-white-50 d-block mt-2 text-center">
                            <i class="fas fa-info-circle text-info mr-1"></i> Fare tekerleğiyle veya sağ üstteki butonlarla mikro-desenlere kadar yaklaşabilir, basılı tutup sürükleyerek gezebilirsiniz.
                        </small>
                    </div>

                    <!-- SAĞ: KRİMİNAL İSTİHBARAT & BRİFİNG DOSYASI -->
                    <div class="col-lg-5 col-md-12">
                        <div class="forgery-dossier-card p-4 rounded h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <span class="badge badge-warning text-dark font-weight-bold px-2 py-1" id="forgeryCaseBadge">
                                        <i class="fas fa-exclamation-triangle mr-1"></i> ŞÜPHELİ VAKA #1
                                    </span>
                                    <span class="small text-white-50"><i class="fas fa-fingerprint"></i> Adli Belge Lab</span>
                                </div>

                                <h5 class="text-white font-weight-bold mb-2" id="forgeryCaseTitle">
                                    Dikiş İpliği &amp; Sayfa Bütünlüğü Tahrifatı
                                </h5>

                                <div class="forgery-intel-box p-3 rounded mb-3">
                                    <div class="text-warning small font-weight-bold mb-1">
                                        <i class="fas fa-satellite-dish mr-1"></i> HUDUT İSTİHBARAT BRİFİ:
                                    </div>
                                    <p class="text-white-50 small mb-0" id="forgeryCaseIntel">
                                        Yolcunun sunduğu pasaportun orta cilt dikişinde mekanik müdahale şüphesi bulunmaktadır. Orijinal belgede çift renkli sentetik kordon kullanılmalıdır.
                                    </p>
                                </div>

                                <!-- PRADO Orijinal Numune Referansı (Karşılaştırma Masası) -->
                                <div class="forgery-reference-box p-3 rounded mb-3 border border-secondary" style="background: rgba(15, 23, 42, 0.9);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-success small font-weight-bold">
                                            <i class="fas fa-shield-alt mr-1"></i> PRADO ORİJİNAL NUMUNE REFERANSI:
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-info font-weight-bold" id="btnInspectRefHd" title="Orijinal Referansı Mikroskopta Aç">
                                            <i class="fas fa-search-plus mr-1"></i> Referansı Büyüt
                                        </button>
                                    </div>
                                    <div class="row no-gutters align-items-center">
                                        <div class="col-4 text-center pr-2">
                                            <div class="position-relative rounded border border-success overflow-hidden" style="height: 80px; background: #000; cursor: pointer;" id="refImgWrapper" title="Orijinali Büyütmek İçin Tıklayın">
                                                <img src="" id="forgeryRefImg" class="w-100 h-100" style="object-fit: contain;" alt="Orijinal Numune" />
                                                <div class="position-absolute text-success" style="bottom: 2px; right: 4px; font-size: 9px;"><i class="fas fa-check-circle"></i> Orijinal</div>
                                            </div>
                                        </div>
                                        <div class="col-8 pl-1">
                                            <p class="text-white-50 small mb-0" id="forgeryCaseStandard" style="font-size: 11.5px; line-height: 1.4;">
                                                Dikiş iplikleri UV ışık altında mavi-sarı floresan vermeli ve sayfa delikleri mikroskop altında düzgün, simetrik olmalıdır.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Geri Bildirim Alert (Doğru / Yanlış) -->
                                <div class="forgery-result-alert alert d-none p-3 rounded" id="forgeryResultAlert">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fas fa-check-circle fa-lg mr-2" id="forgeryResultIcon"></i>
                                        <strong id="forgeryResultTitle">Kusursuz Tespit!</strong>
                                    </div>
                                    <p class="small mb-0" id="forgeryResultMsg">Tahrifat bölgesini tam isabetle kilitlediniz.</p>
                                </div>
