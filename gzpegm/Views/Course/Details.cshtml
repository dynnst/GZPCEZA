                    <div class="col-lg-7 col-md-12 mb-4 mb-lg-0">
                        <div class="booth-doc-stage position-relative rounded shadow p-3 text-center" id="boothDocStage">
                            <!-- Kaşe Damga Animasyonu Overlay -->
                            <div class="booth-stamp-seal d-none" id="boothStampSeal">KABUL</div>

                            <div class="booth-passport-frame mb-3 position-relative" id="boothPassportFrame">
                                <!-- Zoom & Büyütme Butonları -->
                                <div class="booth-zoom-btn-overlay">
                                    <button type="button" class="btn btn-xs btn-dark shadow-sm border border-secondary text-white mr-1" id="btnBoothZoomToggle" title="Büyüteç Modu">
                                        <i class="fas fa-search-plus text-warning mr-1"></i> Büyüteç
                                    </button>
                                    <button type="button" class="btn btn-xs btn-warning text-dark font-weight-bold shadow-sm" id="btnBoothHdOpen" title="Tam Ekran HD Pasaport">
                                        <i class="fas fa-expand mr-1"></i> Tam Ekran
                                    </button>
                                </div>
                                <img src="" id="boothPassportImg" class="img-fluid rounded border border-secondary shadow-sm" alt="Yolcu Pasaportu" />
                                <div class="forensic-loupe booth-loupe" id="boothLoupe"></div>
                            </div>

                            <!-- MRZ Bandı -->
                            <div class="booth-mrz-box p-2 rounded text-left font-monospace" id="boothMrzBox">
                                <div class="mrz-line" id="boothMrzLine1">P&lt;GRCKONSTANTINIDIS&lt;&lt;NIKOLAOS&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</div>
                                <div class="mrz-line" id="boothMrzLine2">AK19482014GRC8204128M3301015&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;06</div>
                            </div>

                            <!-- Belge Hızlı Öznitelik Tablosu -->
                            <div class="row mt-2 text-left small text-white-50">
                                <div class="col-6"><strong>Pasaport No:</strong> <span class="text-white" id="boothMetaDocNum">AK1948201</span></div>
                                <div class="col-6"><strong>Geçerlilik:</strong> <span class="text-white" id="boothMetaDocExpiry">01.01.2033</span></div>
                                <div class="col-6 mt-1"><strong>Ülke:</strong> <span class="text-white" id="boothMetaDocCountry">Yunanistan (GRC)</span></div>
                                <div class="col-6 mt-1"><strong>Düzenleyen:</strong> <span class="text-white" id="boothMetaDocAuthority">Hellenic Police</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- SAĞ: YOLCU MÜRACAATI & KARAR BUTONLARI -->
                    <div class="col-lg-5 col-md-12">
                        <div class="booth-control-dossier p-4 rounded h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <span class="badge badge-success text-dark font-weight-bold px-2 py-1" id="boothPassengerBadge">
                                        <i class="fas fa-passport mr-1"></i> YOLCU MÜRACAAT DOSYASI
                                    </span>
                                    <span class="small text-white-50"><i class="fas fa-desktop"></i> POLNET Hudut Sorgusu</span>
                                </div>

                                <!-- Yolcu Profili -->
                                <div class="passenger-profile-row mb-3 d-flex align-items-center">
                                    <div class="passenger-avatar-circle mr-3">
                                        <i class="fas fa-user-tie fa-2x text-warning"></i>
                                    </div>
                                    <div>
                                        <h5 class="text-white font-weight-bold mb-0" id="boothPaxName">Nikolaos Konstantinidis</h5>
                                        <small class="text-white-50" id="boothPaxDetails">Yunanistan Uyruklu • Uçuş: OA314 Atina-Antalya</small>
                                    </div>
                                </div>

                                <!-- Seyahat & Beyan Bilgisi -->
                                <div class="passenger-travel-box p-3 rounded mb-3">
                                    <div class="row small">
                                        <div class="col-6 mb-2"><strong>Seyahat Amacı:</strong> <span class="text-white d-block" id="boothPaxPurpose">Turistik Tatil</span></div>
                                        <div class="col-6 mb-2"><strong>Kalış Süresi:</strong> <span class="text-white d-block" id="boothPaxStay">10 Gün</span></div>
                                        <div class="col-6"><strong>Konaklama:</strong> <span class="text-white d-block" id="boothPaxHotel">Lara Otel Rezervasyonu</span></div>
                                        <div class="col-6"><strong>Vize / Muafiyet:</strong> <span class="text-white d-block" id="boothPaxVisa">90 Gün Vize Muafiyeti</span></div>
                                    </div>
                                </div>

                                <!-- Sistem İstihbarat & Tahdit Uyarısı -->
                                <div class="booth-system-alert alert alert-secondary p-3 rounded mb-3" id="boothSystemAlert">
                                    <div class="text-warning small font-weight-bold mb-1">
                                        <i class="fas fa-search mr-1"></i> MERKEZİ KONTROL &amp; TAHDİT SORGUSU:
                                    </div>
                                    <p class="small mb-0 text-white" id="boothSystemAlertText">
                                        Polnet Tahdit Kaydı: Temiz. Pasaport geçerlilik süresi ve ICAO 9303 optik okuma standartlara uygundur.
                                    </p>
                                </div>

                                <!-- Mevzuat & Karar Sonuç Paneli (Geri Bildirim) -->
                                <div class="booth-verdict-box alert d-none p-3 rounded mb-3" id="boothVerdictBox">
                                    <div class="d-flex align-items-center justify-content-between mb-2 border-bottom pb-2">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-balance-scale fa-lg mr-2" id="boothVerdictIcon"></i>
                                            <strong id="boothVerdictTitle">Karar Değerlendirmesi</strong>
                                        </div>
                                        <span class="badge badge-dark" id="boothVerdictXpBadge">+0 XP</span>
                                    </div>

                                    <!-- YAN YANA KARAR KIYASLAMASI (ÖĞRENCİ KARARI VS MEVZUAT KARARI) -->
                                    <div class="row g-2 mb-2">
                                        <!-- SOL: ÖĞRENCİNİN KARARI -->
                                        <div class="col-6">
                                            <div class="booth-comparison-col h-100" id="boothUserDecisionCol">
                                                <small class="text-white-50 d-block mb-1"><strong>SİZİN KARARINIZ:</strong></small>
                                                <h6 class="font-weight-bold mb-1" id="boothUserDecisionText">KABUL</h6>
                                                <div class="small" id="boothUserDecisionImpact" style="font-size: 11px; line-height: 1.3;">
                                                    Risk değerlendirmesi...
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SAĞ: DOĞRU MEVZUAT KARARI -->
                                        <div class="col-6">
                                            <div class="booth-comparison-col correct h-100" id="boothCorrectDecisionCol">
                                                <small class="text-success d-block mb-1"><strong>DOĞRU ADLİ KARAR:</strong></small>
                                                <h6 class="font-weight-bold text-success mb-1" id="boothCorrectDecisionText">INAD RET</h6>
                                                <div class="small text-white-50" id="boothCorrectLegalBadge" style="font-size: 11px; line-height: 1.3;">
                                                    YUKK &amp; Pasaport Kanunu Dayanağı
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- MEVZUAT VE ADLİ DELİL AÇIKLAMASI -->
                                    <div class="p-2 rounded mt-2" style="background: rgba(0,0,0,0.3); border-left: 3px solid #38bdf8;">
                                        <div class="text-info small font-weight-bold mb-1"><i class="fas fa-gavel mr-1"></i> Kriminal &amp; Hukuki Gerekçe:</div>
                                        <p class="small mb-0 text-white" id="boothVerdictDesc" style="line-height: 1.4;"></p>
                                    </div>

                                    <!-- TEKRAR DENE BUTONU -->
                                    <div class="mt-2 text-right">
                                        <button type="button" class="btn btn-xs btn-outline-warning" id="btnRetryCurrentPax">
                                            <i class="fas fa-redo mr-1"></i> Bu Yolcuyu Tekrar Değerlendir
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- 3 Taktik Karar Butonu -->
                            <div class="booth-action-buttons-wrap mt-2">
                                <div class="row g-2" id="boothButtonsRow">
                                    <div class="col-4">
                                        <button type="button" class="btn btn-success btn-block font-weight-bold py-2 booth-decision-btn" data-decision="ACCEPT">
                                            <i class="fas fa-check-circle d-block mb-1 fa-lg"></i>
                                            <span class="small">KABUL</span>
                                        </button>
                                    </div>
                                    <div class="col-4">
                                        <button type="button" class="btn btn-warning btn-block font-weight-bold py-2 text-dark booth-decision-btn" data-decision="SECOND_LINE">
                                            <i class="fas fa-user-clock d-block mb-1 fa-lg"></i>
                                            <span class="small">2. HAT</span>
                                        </button>
                                    </div>
                                    <div class="col-4">
                                        <button type="button" class="btn btn-danger btn-block font-weight-bold py-2 booth-decision-btn" data-decision="INAD_REJECT">
                                            <i class="fas fa-ban d-block mb-1 fa-lg"></i>
                                            <span class="small">INAD RED</span>
                                        </button>
                                    </div>
                                </div>

                                <button type="button" class="btn btn-primary btn-block font-weight-bold py-2 mt-2 d-none" id="btnNextPassenger">
                                    <i class="fas fa-arrow-right mr-1"></i> Sonraki Yolcuya Geç
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hudut Simülatörü Tamamlanma Bannerı -->
                <div id="boothWinBanner" class="puzzle-win-banner p-4 rounded mt-4 text-center d-none animate__animated animate__zoomIn">
                    <div class="win-trophy mb-2"><i class="fas fa-medal text-success fa-3x"></i></div>
                    <h4 class="text-white font-weight-bold mb-1">Hudut Vardiyası Başarıyla Tamamlandı!</h4>
                    <p class="text-white-50 mb-3" id="boothWinSummary">Tüm yolcular için uluslararası mevzuata (YUKK ve Pasaport Kanunu) tam uygun kararlar verdiniz.</p>
                    <button type="button" class="btn btn-success font-weight-bold px-4" id="btnPlayAgainBooth">
                        <i class="fas fa-redo mr-1"></i> Yeni Hudut Nöbeti Başlat
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 🔬 TAM EKRAN ADLİ MİKROSKOP & HD İNCELEME MODALI            -->
    <!-- ============================================================ -->
    <div class="modal fade forensic-lightbox-modal" id="modalForensicLightbox" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-custom" role="document">
            <div class="modal-content bg-dark text-white border-warning">
                <div class="modal-header border-bottom border-secondary py-2 px-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <span class="badge badge-warning text-dark mr-2 font-weight-bold"><i class="fas fa-microscope"></i> HD ADLİ MİKROSKOP</span>
                        <h6 class="modal-title mb-0 font-weight-bold text-white" id="lightboxDocTitle">Yüksek Çözünürlüklü Belge İnceleme</h6>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-xs btn-outline-warning mr-2" id="btnLightboxLoupe" title="3x Adli Mercek / Büyüteç">
                            <i class="fas fa-search-plus mr-1"></i> <span class="d-none d-sm-inline">Mercek 3x</span>
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-light" id="btnLightboxZoomOut" title="Uzaklaştır"><i class="fas fa-minus"></i></button>
                        <span class="text-warning font-weight-bold small px-2" id="lightboxZoomLevel">100%</span>
                        <button type="button" class="btn btn-xs btn-outline-light" id="btnLightboxZoomIn" title="Yakınlaştır"><i class="fas fa-plus"></i></button>
                        <button type="button" class="btn btn-xs btn-outline-warning ml-2" id="btnLightboxReset" title="Sıfırla"><i class="fas fa-sync-alt mr-1"></i> Sıfırla</button>
                        <button type="button" class="close text-white ml-3" data-dismiss="modal" aria-label="Kapat">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body p-0 position-relative overflow-hidden text-center d-flex align-items-center justify-content-center" id="lightboxViewport" style="min-height: 75vh; max-height: 85vh; background: #000000; cursor: grab;">
                    <img src="" id="lightboxImg" class="img-fluid" style="max-height: 80vh; transition: transform 0.15s ease-out; user-select: none; pointer-events: none;" alt="HD Belge" />
                    <!-- 3x Kriminal Mercek Lensi -->
                    <div class="forensic-loupe lightbox-loupe" id="lightboxLoupe"></div>
                    <div class="lightbox-hint-bar">
                        <i class="fas fa-mouse text-warning mr-1"></i> Fare Tekerleği ile %100 - %500 Zoom | Sürükleyerek Pan | <strong>Mercek 3x</strong> ile Mikro-Detay İnceleme
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ANA İÇERİK IZGARASI: SOL (8 KOLON) - SAĞ (4 KOLON) -->
    <div class="row">
        <!-- SOL KOLON: KURS DETAYI, MÜFREDAT VE YORUMLAR -->
        <div class="col-lg-8">

            <!-- KURS AÇIKLAMASI KARTI -->
            <div class="card detail-content-card mb-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="card-title mb-0 font-weight-bold text-dark">
                            <i class="fas fa-info-circle text-primary mr-2"></i> Kurs Hakkında ve Açıklama
                        </h5>
                        @if (!string.IsNullOrEmpty(Model.ResourceFilePath))
                        {
                            <a href="@Model.ResourceFilePath" target="_blank" class="btn btn-xs btn-outline-info" download>
                                <i class="fas fa-download mr-1"></i> Kaynak Dosyayı İndir
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="course-description-text">
                        @if (!string.IsNullOrWhiteSpace(Model.CourseDescription))
                        {
                            @Html.Raw(Model.CourseDescription)
                        }
                        else
                        {
                            <p class="text-muted font-italic mb-0">Bu kurs için henüz detaylı bir açıklama girilmemiş.</p>
                        }
                    </div>
                </div>
            </div>

            @{
                var galleryImages = sortedContents.Where(c => !string.IsNullOrWhiteSpace(c.FilePath) &&
                    ((c.ContentType ?? "").IndexOf("image", StringComparison.OrdinalIgnoreCase) >= 0 ||
                     c.FilePath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                     c.FilePath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                     c.FilePath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                     c.FilePath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))).ToList();
            }

            @if (galleryImages.Count > 0)
            {
                <div class="card detail-content-card mb-4 shadow-sm doc-gallery-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <h5 class="card-title mb-0 font-weight-bold text-dark">
                                <i class="fas fa-images text-warning mr-2"></i> Belge Fotoğraf Vitrini &amp; Spektral Detaylar
                            </h5>
                            <span class="badge badge-pill badge-warning text-dark ml-2 px-2 py-1 font-weight-bold">
                                @galleryImages.Count Belge Fotoğrafı
                            </span>
                        </div>
                        <small class="text-muted d-none d-sm-inline">
                            <i class="fas fa-search-plus text-primary mr-1"></i> Büyütüp mercekle incelemek için karta tıklayın
                        </small>
                    </div>
                    <div class="card-body p-3">
                        <div class="row" id="docPhotoGalleryGrid">
                            @foreach (var gImg in galleryImages)
                            {
                                var imgUrl = gImg.FilePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? gImg.FilePath : VirtualPathUtility.ToAbsolute("~/files/Egitim/" + gImg.FilePath);
                                var isUv = (gImg.ContentTitle ?? "").IndexOf("uv", StringComparison.OrdinalIgnoreCase) >= 0 || (gImg.ContentDescription ?? "").IndexOf("uv", StringComparison.OrdinalIgnoreCase) >= 0;
                                var isWatermark = (gImg.ContentTitle ?? "").IndexOf("filigran", StringComparison.OrdinalIgnoreCase) >= 0 || (gImg.ContentTitle ?? "").IndexOf("watermark", StringComparison.OrdinalIgnoreCase) >= 0;
                                var isStitching = (gImg.ContentTitle ?? "").IndexOf("dikiş", StringComparison.OrdinalIgnoreCase) >= 0 || (gImg.ContentTitle ?? "").IndexOf("stitching", StringComparison.OrdinalIgnoreCase) >= 0;

                                <div class="col-6 col-sm-4 col-md-3 mb-3">
                                    <div class="doc-gallery-item position-relative rounded border overflow-hidden shadow-sm h-100"
                                         role="button"
                                         data-img-url="@imgUrl"
                                         data-img-title="@gImg.ContentTitle"
                                         title="@gImg.ContentTitle - Büyütüp mercekle incelemek için tıklayın">
                                        <div class="doc-gallery-thumb-container position-relative">
                                            <img src="@imgUrl" alt="@gImg.ContentTitle" class="doc-gallery-thumb" loading="lazy" onerror="this.src='/AdminTemplate/img/landing/default-course.jpg';" />
                                            <div class="doc-gallery-overlay">
                                                <span class="badge badge-warning text-dark font-weight-bold shadow-sm px-2 py-1">
                                                    <i class="fas fa-search-plus mr-1"></i> Mercekle İncele
                                                </span>
                                            </div>
                                            @if (isUv)
                                            {
                                                <span class="badge badge-info position-absolute" style="top: 5px; left: 5px; font-size: 10px; z-index: 2;">
                                                    <i class="fas fa-bolt"></i> UV 365nm
                                                </span>
                                            }
                                            else if (isWatermark)
                                            {
                                                <span class="badge badge-primary position-absolute" style="top: 5px; left: 5px; font-size: 10px; z-index: 2;">
                                                    <i class="fas fa-water"></i> Filigran
                                                </span>
                                            }
                                            else if (isStitching)
                                            {
                                                <span class="badge badge-secondary position-absolute" style="top: 5px; left: 5px; font-size: 10px; z-index: 2;">
                                                    <i class="fas fa-bezier-curve"></i> Dikiş
                                                </span>
                                            }
                                        </div>
                                        <div class="p-2 bg-white">
                                            <div class="small font-weight-bold text-truncate text-dark" style="font-size: 11.5px;" title="@gImg.ContentTitle">
                                                @gImg.ContentTitle
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mt-1 text-muted" style="font-size: 10px;">
                                                <span><i class="fas fa-microscope text-warning mr-1"></i> HD Adli</span>
                                                <span class="text-primary font-weight-bold">Büyüt <i class="fas fa-expand-arrows-alt ml-1"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- EĞİTİM PAKETİ İÇERİĞİ / MÜFREDAT -->
            <div class="card detail-content-card mb-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <h5 class="card-title mb-0 font-weight-bold text-dark">
                                <i class="fas fa-list-ul text-primary mr-2"></i> Eğitim Paketi İçeriği
                            </h5>
                            <span class="badge badge-pill badge-primary ml-2 px-2 py-1 font-weight-normal">@sortedContents.Count Ders</span>
                        </div>
                        @if (canManage)
                        {
                            <a href="@Url.Action("ManageContents", "Course", new { courseId = Model.CourseId })" class="btn btn-xs btn-primary font-weight-bold">
                                <i class="fas fa-plus-circle mr-1"></i> Yeni İçerik Ekle
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body p-3">
                    @if (sortedContents.Count > 0)
                    {
                        <div class="content-curriculum-list">
                            @{ int counter = 1; }
                            @foreach (var item in sortedContents)
                            {
                                var badgeClass = GetContentBadgeClass(item.ContentType);
                                var typeName = GetContentTypeName(item.ContentType);
                                var iconClass = GetContentIcon(item.ContentType);

                                var itemImgUrl = "";
                                if (!string.IsNullOrWhiteSpace(item.FilePath) &&
                                    ((item.ContentType ?? "").IndexOf("image", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                     item.FilePath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                     item.FilePath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                     item.FilePath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)))
                                {
                                    itemImgUrl = item.FilePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? item.FilePath : VirtualPathUtility.ToAbsolute("~/files/Egitim/" + item.FilePath);
                                }

                                <div class="curriculum-item d-flex align-items-center justify-content-between p-3 mb-2 rounded border">
                                    <div class="d-flex align-items-center flex-grow-1 mr-3">
                                        <div class="curriculum-number-box mr-3 text-muted font-weight-bold">
                                            #@counter
                                        </div>
                                        @if (!string.IsNullOrEmpty(itemImgUrl))
                                        {
                                            <div class="curriculum-thumb-box mr-3">
                                                <img src="@itemImgUrl" alt="@item.ContentTitle" class="curriculum-thumb-img" onerror="this.parentElement.style.display='none';" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="curriculum-icon-badge mr-3 @badgeClass">
                                                <i class="fas @iconClass"></i>
                                            </div>
                                        }
                                        <div class="curriculum-text-info">
                                            <a href="@Url.Action("ContentDetail", "Course", new { id = item.ContentId })" class="curriculum-link text-dark font-weight-bold text-decoration-none d-block">
                                                @item.ContentTitle
                                            </a>
                                            <div class="curriculum-meta small text-muted mt-1">
                                                <span class="badge badge-light border mr-2">@typeName</span>
                                                @if (item.CreatedDate.HasValue)
                                                {
                                                    <span class="mr-2"><i class="far fa-clock mr-1"></i> @item.CreatedDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.ContentDescription))
                                                {
                                                    <span class="d-none d-md-inline text-truncate" style="max-width: 320px;">
                                                        - @ToPlainText(item.ContentDescription, 80)
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="curriculum-action flex-shrink-0">
                                        <a href="@Url.Action("ContentDetail", "Course", new { id = item.ContentId })" class="btn btn-sm btn-outline-primary px-3 font-weight-bold">
                                            <i class="fas fa-external-link-alt mr-1"></i> İncele
                                        </a>
                                    </div>
                                </div>
                                counter++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3 text-muted">
                                <i class="fas fa-folder-open fa-3x"></i>
                            </div>
                            <h6 class="font-weight-bold text-dark">Bu kursta henüz eğitim içeriği bulunmuyor.</h6>
                            <p class="text-muted small mb-3">Bu kursa ait ders metinleri, mevzuat maddeleri veya multimedya materyalleri eklendiğinde burada listelenecektir.</p>
                            @if (canManage)
                            {
                                <a href="@Url.Action("ManageContents", "Course", new { courseId = Model.CourseId })" class="btn btn-primary btn-sm font-weight-bold">
                                    <i class="fas fa-plus-circle mr-1"></i> İlk İçeriği Ekle
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- KURS YORUMLARI VE DEĞERLENDİRME -->
            <div class="card detail-content-card mb-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <h5 class="card-title mb-0 font-weight-bold text-dark">
                                <i class="fas fa-comments text-primary mr-2"></i> Kurs Değerlendirmeleri
                            </h5>
                            @if (Model.ApprovedReviews != null && Model.ApprovedReviews.Count > 0)
                            {
                                <span class="badge badge-pill badge-warning text-dark ml-2 px-2 py-1 font-weight-bold">
                                    <i class="fas fa-star mr-1"></i> @Model.ApprovedReviews.Count Yorum
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- YORUM EKLEME FORMU -->
                    <div class="review-form-wrapper p-3 mb-4 rounded bg-light border">
                        <h6 class="font-weight-bold text-dark mb-2">
                            <i class="fas fa-pen-alt text-muted mr-1"></i> Bu Kursu Değerlendirin
                        </h6>
                        <p class="small text-muted mb-3">
                            <i class="fas fa-info-circle text-info"></i> Yaptığınız değerlendirmeler sistem yöneticisi onayından sonra diğer kursiyerlere görünür.
                        </p>

                        <form method="post" action="@Url.Action("AddReview", "Course")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.CourseId" />

                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label for="rating" class="small font-weight-bold text-dark">Puanınız <span class="text-danger">*</span></label>
                                    <select name="rating" id="rating" class="form-control form-control-sm custom-select" required>
                                        <option value="">Puan Seçiniz...</option>
                                        <option value="5" selected>⭐⭐⭐⭐⭐ 5 - Mükemmel</option>
                                        <option value="4">⭐⭐⭐⭐ 4 - Çok İyi</option>
                                        <option value="3">⭐⭐⭐ 3 - İyi</option>
                                        <option value="2">⭐⭐ 2 - Orta</option>
                                        <option value="1">⭐ 1 - Geliştirilmeli</option>
                                    </select>
                                </div>
                                <div class="form-group col-md-8">
                                    <label for="comment" class="small font-weight-bold text-dark">Yorumunuz <span class="text-danger">*</span></label>
                                    <textarea name="comment" id="comment" class="form-control form-control-sm" rows="3" maxlength="1000" placeholder="Eğitim içeriği, faydası ve anlatımı hakkındaki görüşleriniz..." required></textarea>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <small class="text-muted">En az 10, en fazla 1000 karakter</small>
                                        <button type="submit" class="btn btn-sm btn-primary px-3 font-weight-bold">
                                            <i class="fas fa-paper-plane mr-1"></i> Gönder
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- YAYINLANAN YORUMLAR LİSTESİ -->
                    @if (Model.ApprovedReviews != null && Model.ApprovedReviews.Count > 0)
                    {
                        <div class="reviews-list">
                            @foreach (var r in Model.ApprovedReviews)
                            {
                                var replyMarker = "[[ADMIN_REPLY]]";
                                string fullComment = r.Comment ?? "";
                                string mainComment = fullComment;
                                string replyMeta = null;
                                if (fullComment.Contains(replyMarker))
                                {
                                    var parts = fullComment.Split(new[] { replyMarker }, 2, System.StringSplitOptions.None);
                                    mainComment = parts[0].Trim();
                                    replyMeta = parts[1];
                                }

                                <div class="review-item card mb-3 border-left-primary shadow-none bg-white">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar-circle mr-2">
                                                    @(string.IsNullOrWhiteSpace(r.UserFullName) ? "U" : r.UserFullName.Substring(0, 1).ToUpper())
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 font-weight-bold text-dark" style="font-size: 0.95rem;">@r.UserFullName</h6>
                                                    <small class="text-muted">
                                                        <i class="far fa-calendar-alt mr-1"></i> @r.CreatedDate.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="rating-stars text-warning small font-weight-bold">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= r.Rating)
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-muted"></i>
                                                    }
                                                }
                                                <span class="ml-1 text-dark">@r.Rating.0</span>
                                            </div>
                                        </div>
                                        <p class="card-text text-dark mb-1" style="font-size: 0.92rem; line-height: 1.5;">@mainComment</p>

                                        @if (!string.IsNullOrEmpty(replyMeta))
                                        {
                                            var metaParts = replyMeta.Split(new[] { '|' }, 3);
                                            var adminName = metaParts.Length > 0 ? metaParts[0] : "Yönetici";
                                            var dateStr = metaParts.Length > 1 ? metaParts[1] : "";
                                            var replyText = metaParts.Length > 2 ? metaParts[2] : "";
                                            DateTime replyDate;
                                            bool parsed = DateTime.TryParse(dateStr, out replyDate);

                                            <div class="admin-reply-box p-2 mt-2 rounded border bg-light">
                                                <div class="d-flex align-items-center mb-1 text-primary small font-weight-bold">
                                                    <i class="fas fa-reply fa-flip-horizontal mr-1"></i>
                                                    <span>@adminName</span>
                                                    <span class="text-muted font-weight-normal ml-2">(@(parsed ? replyDate.ToString("dd.MM.yyyy HH:mm") : dateStr))</span>
                                                </div>
                                                <p class="mb-0 text-dark small">
                                                    @Html.Raw(System.Web.HttpUtility.HtmlEncode(replyText).Replace("\n", "<br/>"))
                                                </p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="far fa-comment-dots fa-2x mb-2 text-muted"></i>
                            <p class="small mb-0">Bu kurs için henüz değerlendirme yapılmamış. İlk değerlendiren siz olun!</p>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- SAĞ KOLON: KURS METRİKLERİ, EĞİTMEN VE SINAVLAR -->
        <div class="col-lg-4">

            <!-- KURS ÖZET VE SERTİFİKA KARTI -->
            <div class="card detail-content-card mb-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 font-weight-bold text-dark">
                        <i class="fas fa-award text-warning mr-2"></i> Eğitim İlerlemesi &amp; Sertifika
                    </h5>
                </div>
                <div class="card-body">
                    @if (certStatus == 1)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-3 p-3">
                            <i class="fas fa-check-circle fa-2x text-success mr-3"></i>
                            <div>
                                <strong class="d-block">Tebrikler! Sertifikanız Onaylandı.</strong>
                                <span class="small">Tüm sınavları başarıyla tamamladınız.</span>
                            </div>
                        </div>
                        <a href="@Url.Action("MyCertificates", "Profile")" class="btn btn-success btn-block font-weight-bold shadow-sm">
                            <i class="fas fa-download mr-1"></i> Sertifikamı Görüntüle
                        </a>
                    }
                    else if (certStatus == 0)
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-3 p-3">
                            <i class="fas fa-clock fa-2x text-warning mr-3"></i>
                            <div>
                                <strong class="d-block">Sertifika Onayı Bekleniyor</strong>
                                <span class="small">Sınavlarınız inceleniyor, onaylandığında hazır olacaktır.</span>
                            </div>
                        </div>
                    }
                    else if (allExamsDone)
                    {
                        <div class="alert alert-info d-flex align-items-center mb-3 p-3">
                            <i class="fas fa-info-circle fa-2x text-info mr-3"></i>
                            <div>
                                <strong class="d-block">Sınavlar Tamamlandı!</strong>
                                <span class="small">Sertifikanızı talep etmek için başvurabilirsiniz.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 mb-3 rounded bg-light border text-center">
                            <div class="mb-2 text-warning">
                                <i class="fas fa-medal fa-3x"></i>
                            </div>
                            <h6 class="font-weight-bold text-dark mb-1">Eğitim Başarı Sertifikası</h6>
                            <p class="small text-muted mb-0">
                                Bu eğitime ait değerlendirme sınavlarını tamamlayarak sertifika kazanabilirsiniz.
                            </p>
                        </div>
                    }

                    <div class="course-meta-checklist mt-3">
                        <div class="checklist-item d-flex align-items-center justify-content-between py-2 border-bottom">
                            <span class="small text-muted"><i class="fas fa-chalkboard-teacher text-primary mr-2"></i> Eğitmen:</span>
                            <span class="small font-weight-bold text-dark">@(string.IsNullOrWhiteSpace(Model.InstructorName) ? "Sistem Eğitmeni" : Model.InstructorName)</span>
                        </div>
                        <div class="checklist-item d-flex align-items-center justify-content-between py-2 border-bottom">
                            <span class="small text-muted"><i class="far fa-calendar-alt text-primary mr-2"></i> Eklenme Tarihi:</span>
                            <span class="small font-weight-bold text-dark">@(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd.MM.yyyy") : "-")</span>
                        </div>
                        <div class="checklist-item d-flex align-items-center justify-content-between py-2 border-bottom">
                            <span class="small text-muted"><i class="fas fa-language text-primary mr-2"></i> Dil:</span>
                            <span class="small font-weight-bold text-dark">Türkçe (Orijinal Belge)</span>
                        </div>
                        <div class="checklist-item d-flex align-items-center justify-content-between py-2">
                            <span class="small text-muted"><i class="fas fa-shield-alt text-primary mr-2"></i> Yetki &amp; Erişim:</span>
                            <span class="badge badge-light border text-dark font-weight-bold">Tüm EGM Personeli</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KURSA BAĞLI SINAVLAR KARTI -->
            <div class="card detail-content-card mb-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 font-weight-bold text-dark">
                        <i class="fas fa-file-signature text-danger mr-2"></i> Değerlendirme Sınavları
                    </h5>
                    <span class="badge badge-pill badge-danger font-weight-normal px-2 py-1">@detailExams.Count Sınav</span>
                </div>
                <div class="card-body p-3">
                    @if (detailExams.Count > 0)
                    {
                        <div class="exams-list">
                            @foreach (var ex in detailExams)
                            {
                                var isExamCompleted = ex.ExamResultId.HasValue;

                                <div class="exam-card-item p-3 mb-2 rounded border @(isExamCompleted ? "border-success bg-light" : "bg-white")">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="mb-0 font-weight-bold text-dark text-truncate" style="max-width: 220px;" title="@ex.ExamTitle">
                                            @ex.ExamTitle
                                        </h6>
                                        @if (isExamCompleted)
                                        {
                                            <span class="badge badge-success"><i class="fas fa-check mr-1"></i> Tamamlandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning text-dark font-weight-bold">Bekliyor</span>
                                        }
                                    </div>

                                    <div class="small text-muted d-flex justify-content-between align-items-center mb-3">
                                        <span><i class="far fa-question-circle mr-1"></i> @ex.QuestionCount Soru</span>
                                        <span><i class="far fa-clock mr-1"></i> @ex.Duration Dakika</span>
                                        <span><i class="fas fa-bullseye mr-1"></i> Baraj: % @ex.PassingScore</span>
                                    </div>

                                    <div class="exam-action-wrap">
                                        @if (isExamCompleted)
                                        {
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("ExamResult", "Exam", new { id = ex.ExamResultId.Value })" class="btn btn-xs btn-outline-info flex-fill font-weight-bold">
                                                    <i class="fas fa-poll mr-1"></i> Sonucu Gör
                                                </a>
                                                <a href="@Url.Action("Take", "Exam", new { id = ex.ExamId })" class="btn btn-xs btn-outline-secondary flex-fill">
                                                    <i class="fas fa-redo mr-1"></i> Tekrarla
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Take", "Exam", new { id = ex.ExamId })" class="btn btn-sm btn-danger btn-block font-weight-bold shadow-sm">
                                                <i class="fas fa-pen-alt mr-1"></i> Sınava Başla
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3 p-2 bg-light rounded border text-muted small text-center">
                            <i class="fas fa-lightbulb text-warning mr-1"></i> Sınava başlamadan önce yukarıdaki <strong>"Adli Belge &amp; Hudut Simülatörü"</strong> ile reflekslerinizi test edebilirsiniz.
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-clipboard-list fa-2x mb-2 text-muted"></i>
                            <p class="small mb-0">Bu kurs için henüz aktif bir sınav tanımlanmamış.</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

</div>

@section Styles {
    <style>
        /* ============================================================ */
        /* POLİS AKADEMİSİ: ADLİ BELGE & HUDUT KONTROL SİMÜLATÖRÜ       */
        /* ============================================================ */
        .police-game-arena {
            background: radial-gradient(circle at 50% 20%, #142850 0%, #091326 65%, #050b17 100%);
            border: 2px solid rgba(245, 158, 11, 0.5);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(245, 158, 11, 0.2);
            transition: all 0.3s ease;
        }

        .arena-header {
            background: rgba(7, 20, 38, 0.95);
            border-bottom: 1px solid rgba(245, 158, 11, 0.3) !important;
        }

        .arena-radar-pill {
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.6);
            color: #38bdf8;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .arena-sound-btn {
            border-radius: 20px;
            font-size: 11px;
            padding: 4px 12px;
            border-color: rgba(255, 255, 255, 0.25);
            transition: all 0.2s ease;
        }

        .arena-sound-btn:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* OYUN MODU SEÇİCİ SEKMELER */
        .game-mode-nav {
            background: rgba(5, 11, 23, 0.9);
            gap: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        .game-mode-btn {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            padding: 9px 18px;
            font-weight: 700;
            font-size: 0.92rem;
            transition: all 0.25s ease;
        }

        .game-mode-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .game-mode-btn.active {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #ffffff;
            border-color: #f59e0b;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.25);
        }

        .arena-hud-bar {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .hud-item-pill {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            padding: 5px 14px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.88rem;
        }

        .hud-item-pill.score {
            border-color: rgba(16, 185, 129, 0.5);
            background: rgba(16, 185, 129, 0.12);
            color: #34d399;
        }

        .hud-item-pill.time {
            border-color: rgba(245, 158, 11, 0.5);
            background: rgba(245, 158, 11, 0.12);
            color: #fbbf24;
        }

        /* ---------------------------------------------------- */
        /* 🎯 MODÜL 1: SAHTECİLİK & TAHRİFAT AVCISI STILLERI   */
        /* ---------------------------------------------------- */
        .forgery-stage-box {
            background: #000000;
            border: 2px solid rgba(245, 158, 11, 0.4);
            border-radius: 16px;
            overflow: hidden;
            position: relative;
            min-height: 420px;
            max-height: 480px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: crosshair;
            user-select: none;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8), inset 0 0 50px rgba(0, 0, 0, 0.9);
        }

        .forgery-canvas-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            transform-origin: center center;
            transition: transform 0.15s ease-out;
        }

        .forgery-doc-img {
            max-height: 430px;
            max-width: 100%;
            object-fit: contain;
            pointer-events: none;
            user-select: none;
        }

        .forgery-scanner-line {
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, #38bdf8, #f59e0b, transparent);
            box-shadow: 0 0 14px #38bdf8;
            pointer-events: none;
            z-index: 10;
            animation: scannerSweep 3.5s infinite ease-in-out;
        }

        @@keyframes scannerSweep {
            0% { top: 4%; opacity: 0.2; }
            50% { top: 92%; opacity: 0.9; }
            100% { top: 4%; opacity: 0.2; }
        }

        .forgery-target-zone {
            position: absolute;
            width: 65px;
            height: 65px;
            border-radius: 50%;
            border: 2px solid transparent;
            transform: translate(-50%, -50%);
            z-index: 15;
            pointer-events: none;
            transition: all 0.25s ease;
            opacity: 0;
        }

        .forgery-target-zone.revealed {
            border: 3px solid #10b981 !important;
            background: rgba(16, 185, 129, 0.35) !important;
            box-shadow: 0 0 30px #10b981, inset 0 0 15px rgba(16, 185, 129, 0.5) !important;
            opacity: 1 !important;
            animation: targetFoundPulse 1.2s infinite alternate;
        }

        .forgery-wrong-marker {
            position: absolute;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #ef4444;
            background: rgba(239, 68, 68, 0.4);
            color: #ffffff;
            font-size: 13px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translate(-50%, -50%);
            z-index: 25;
            pointer-events: none;
            animation: wrongMarkerAnim 1.4s forwards;
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.8);
        }

        @@keyframes wrongMarkerAnim {
            0% { transform: translate(-50%, -50%) scale(0.6); opacity: 1; }
            50% { transform: translate(-50%, -50%) scale(1.15); opacity: 0.95; }
            100% { transform: translate(-50%, -50%) scale(1.35); opacity: 0; }
        }

        @@keyframes targetFoundPulse {
            0% { transform: translate(-50%, -50%) scale(0.95); }
            100% { transform: translate(-50%, -50%) scale(1.1); }
        }

        .forgery-radar-pulse {
            position: absolute;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid #ef4444;
            transform: translate(-50%, -50%) scale(0.2);
            opacity: 0;
            pointer-events: none;
            z-index: 25;
            transition: opacity 0.1s ease;
        }

        .forgery-radar-pulse.active {
            opacity: 1;
            animation: radarPing 0.6s ease-out forwards;
        }

        @@keyframes radarPing {
            0% { transform: translate(-50%, -50%) scale(0.3); opacity: 1; border-color: #ef4444; }
            100% { transform: translate(-50%, -50%) scale(3.5); opacity: 0; border-color: #f59e0b; }
        }

        .forgery-magnifier-hint {
            position: absolute;
            bottom: 10px;
            left: 12px;
            background: rgba(0, 0, 0, 0.75);
            color: #ffffff;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            pointer-events: none;
            z-index: 20;
        }

        /* ZOOM & BÜYÜTEÇ TOOLBAR */
        .forensic-zoom-toolbar {
            position: absolute;
            top: 10px;
            right: 12px;
            z-index: 30;
            display: flex;
            align-items: center;
            gap: 4px;
            background: rgba(5, 11, 23, 0.85);
            padding: 4px 8px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(6px);
        }

        .forensic-tool-btn {
            border-radius: 12px;
            padding: 3px 8px;
            font-size: 11px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.2s ease;
        }

        .forensic-tool-btn.active {
            background: #f59e0b !important;
            color: #071739 !important;
            border-color: #f59e0b !important;
            font-weight: 700;
        }

