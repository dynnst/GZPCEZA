        /* ---------------------------------------------------- */
        /* 🔬 OYUN 2: UV MOR IŞIK SİMÜLATÖRÜ STILLERI           */
        /* ---------------------------------------------------- */
        .uv-inspection-stage-wrapper {
            width: 100%;
        }

        .uv-inspection-desk {
            width: 100%;
            max-width: 540px;
            height: 380px;
            background: #000000;
            border: 3px solid #1e3a5f;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8), inset 0 0 60px rgba(0, 0, 0, 0.9);
            cursor: crosshair;
            user-select: none;
            touch-action: none;
        }

        .uv-base-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: brightness(0.35) contrast(1.1);
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .uv-glow-layer {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            clip-path: circle(0px at 0px 0px);
            transition: clip-path 0.03s linear;
        }

        .uv-reaction-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: saturate(1.8) brightness(1.2) drop-shadow(0 0 12px #38bdf8);
        }

        .uv-torch-lens {
            position: absolute;
            width: 170px;
            height: 170px;
            border-radius: 50%;
            border: 2px dashed rgba(168, 85, 247, 0.8);
            box-shadow: 0 0 35px rgba(168, 85, 247, 0.6), inset 0 0 25px rgba(168, 85, 247, 0.35);
            pointer-events: none;
            transform: translate(-50%, -50%);
            display: none;
            z-index: 20;
            transition: border-color 0.2s ease;
        }

        .uv-hotspot {
            position: absolute;
            width: 44px;
            height: 44px;
            transform: translate(-50%, -50%);
            z-index: 15;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hotspot-ping {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid #a855f7;
            animation: hotspotPulse 1.4s infinite cubic-bezier(0, 0, 0.2, 1);
            opacity: 0.6;
            display: none;
        }

        .hotspot-ring {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(168, 85, 247, 0.2);
            border: 2px solid #a855f7;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 12px;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .uv-hotspot.in-beam .hotspot-ping {
            display: block;
        }

        .uv-hotspot.in-beam .hotspot-ring {
            opacity: 0.85;
            background: rgba(168, 85, 247, 0.5);
            box-shadow: 0 0 16px #a855f7;
        }

        .uv-hotspot.found .hotspot-ping {
            display: none !important;
        }

        .uv-hotspot.found .hotspot-ring {
            opacity: 1 !important;
            background: #10b981 !important;
            border-color: #34d399 !important;
            box-shadow: 0 0 20px #10b981 !important;
            transform: scale(1.15);
        }

        @@keyframes hotspotPulse {
            0% { transform: scale(0.6); opacity: 1; }
            100% { transform: scale(1.6); opacity: 0; }
        }

        .uv-dossier-card {
            background: rgba(0, 0, 0, 0.45);
            border: 1px solid rgba(56, 189, 248, 0.25);
        }

        .uv-task-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .uv-task-item .task-check-circle {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: transparent;
            font-size: 11px;
            transition: all 0.3s ease;
