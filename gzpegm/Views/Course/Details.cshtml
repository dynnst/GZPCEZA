            });

            // 3x Büyüteç Modu Aç/Kapa
            $('#btnToggleLoupe').on('click', function (e) {
                e.stopPropagation();
                loupeEnabled = !loupeEnabled;
                $(this).toggleClass('active', loupeEnabled);
                if (!loupeEnabled) {
                    $('#forgeryLoupe').hide();
                    $('#forgeryStageBox').css('cursor', 'crosshair');
                } else {
                    resetCanvasZoom();
                    $('#forgeryStageBox').css('cursor', 'none');
                }
                playSound('snap');
            });

            // Fare Tekerleği ile Zoom (Wheel Zoom)
            $('#forgeryStageBox').on('wheel', function (e) {
                e.preventDefault();
                var delta = e.originalEvent.deltaY;
                if (delta < 0) {
                    // Zoom In
                    if (currentZoom < 4.0) currentZoom += 0.25;
                } else {
                    // Zoom Out
                    if (currentZoom > 1.0) currentZoom -= 0.25;
                    if (currentZoom <= 1.0) { currentZoom = 1.0; panX = 0; panY = 0; }
                }
                updateCanvasTransform();
            });

            // Zoom Yapıldığında Belgeyi Sürükleme (Drag to Pan)
            $('#forgeryStageBox').on('mousedown', function (e) {
                if (currentZoom > 1.05 && e.button === 0) {
                    isDragging = true;
                    startX = e.pageX - panX;
                    startY = e.pageY - panY;
                    $('#forgeryStageBox').css('cursor', 'grabbing');
                }
            });

            $(document).on('mouseup', function () {
                if (isDragging) {
                    isDragging = false;
                    $('#forgeryStageBox').css('cursor', currentZoom > 1.05 ? 'grab' : (loupeEnabled ? 'none' : 'crosshair'));
                }
            });

            // Büyüteç & Fare Hareketi
            $('#forgeryStageBox').on('mousemove', function (e) {
                var $box = $(this);
                var offset = $box.offset();
                var relX = e.pageX - offset.left;
                var relY = e.pageY - offset.top;
                var boxW = $box.width();
                var boxH = $box.height();

                // Eğer pan yapılıyorsa
                if (isDragging) {
                    panX = e.pageX - startX;
                    panY = e.pageY - startY;
                    updateCanvasTransform();
                    return;
                }

                // 3x Büyüteç Lensinin Hareketi
                if (loupeEnabled && currentZoom === 1.0) {
                    var $loupe = $('#forgeryLoupe');
                    $loupe.css({ left: relX + 'px', top: relY + 'px', display: 'block' });

                    var zoomFactor = 2.8;
                    var bgX = (relX / boxW) * 100;
                    var bgY = (relY / boxH) * 100;

                    $loupe.css({
                        'background-size': (boxW * zoomFactor) + 'px ' + (boxH * zoomFactor) + 'px',
                        'background-position': bgX + '% ' + bgY + '%'
                    });
                }
            });

            $('#forgeryStageBox').on('mouseleave', function () {
                if (loupeEnabled) $('#forgeryLoupe').hide();
                isDragging = false;
            });

            // Belge Sahnesi Tıklama Olayı (Hedef Tespiti)
            $('#forgeryStageBox').off('click').on('click', function (e) {
                if (isCurrentForgerySolved || isDragging) return;
                initAudio();

                var $box = $(this);
                var offset = $box.offset();
                var clickX = e.pageX - offset.left;
                var clickY = e.pageY - offset.top;
                var boxW = $box.width();
                var boxH = $box.height();

                // Eğer zoom varsa tıklanan noktayı un-transform et
                var normX = (clickX - panX - (boxW / 2)) / currentZoom + (boxW / 2);
                var normY = (clickY - panY - (boxH / 2)) / currentZoom + (boxH / 2);

                // Radar Ping Animasyonu
                $('#forgeryRadarPulse')
                    .removeClass('active')
                    .css({ left: (normX / boxW * 100) + '%', top: (normY / boxH * 100) + '%' });
                setTimeout(function () {
                    $('#forgeryRadarPulse').addClass('active');
                }, 10);

                // Hedef Alan Merkezi
                var c = forgeryCases[currentForgeryIdx];
                var targetCenterX = (c.target.leftPct / 100) * boxW;
                var targetCenterY = (c.target.topPct / 100) * boxH;
                var dist = Math.sqrt(Math.pow(normX - targetCenterX, 2) + Math.pow(normY - targetCenterY, 2));

                // Önceki işaretleri temizle
                $('.forgery-student-marker').remove();
                $('#forgeryTargetLabel').remove();

                var targetAssetUrl = $('#forgeryDocImg').attr('src');
                var refAssetUrl = $('#forgeryRefImg').attr('src');

                if (dist <= c.target.radius + 20) {
                    // DOĞRU İSABET!
                    isCurrentForgerySolved = true;
                    forgerySolvedCount++;
                    forgeryXp += 100;
                    $('#forgerySuccessCount').text(forgerySolvedCount);
                    $('#forgeryXpCount').text(forgeryXp);

                    $('#forgeryTargetZone').removeClass('revealed-hint').addClass('revealed');
                    $('#forgeryTargetZone').append('<div class="forgery-target-label" id="forgeryTargetLabel"><i class="fas fa-check mr-1"></i> TAHRİFAT ALANI</div>');

                    var correctMarkerHtml = '<div class="forgery-student-marker correct" style="left:' + (normX / boxW * 100) + '%; top:' + (normY / boxH * 100) + '%;">' +
                        '<div class="marker-label">SİZİN İŞARETİNİZ (DOĞRU)</div>' +
                        '<div class="marker-circle"><i class="fas fa-check"></i></div>' +
                        '</div>';
                    $('#forgeryCanvasWrapper').append(correctMarkerHtml);

                    playSound('ding');

                    $('#forgeryResultIcon').attr('class', 'fas fa-check-circle fa-lg mr-2 text-success');
                    $('#forgeryResultTitle').text('Tebrikler! Tahrifat Tespit Edildi (+100 XP)');
                    $('#forgeryResultMsg').html('<strong>Adli İnceleme Bulgusu:</strong><br/>' + c.rationale);
                    $('#forgeryResultAlert')
                        .removeClass('d-none alert-danger')
                        .addClass('alert-success animate__animated animate__fadeIn');

                    $('#btnActionNextCase').prop('disabled', false).removeClass('opacity-50');
                    $('#btnScrollToForgeryCmp').removeClass('d-none');

                    // Yan Yana Karşılaştırma Masasını Doldur (DOĞRU İSABET)
                    renderForgeryComparison(true, normX, normY, boxW, boxH, c, targetAssetUrl, refAssetUrl);

                    if (forgerySolvedCount >= forgeryCases.length) {
                        setTimeout(function () {
                            $('#forgeryWinBanner').removeClass('d-none');
                            playSound('fanfare');
                        }, 800);
                    }
                } else {
                    // ISKA / YANLIŞ BÖLGE (Öğrencinin Yanıtı ile Doğru Alanı Yan Yana Getir!)
                    $('#forgeryTargetZone').removeClass('revealed').addClass('revealed-hint');
                    $('#forgeryTargetZone').append('<div class="forgery-target-label" id="forgeryTargetLabel"><i class="fas fa-exclamation-triangle mr-1"></i> ASIL TAHRİFAT BURADA</div>');

                    var wrongMarkerHtml = '<div class="forgery-student-marker wrong" style="left:' + (normX / boxW * 100) + '%; top:' + (normY / boxH * 100) + '%;">' +
                        '<div class="marker-label">SİZİN İŞARETİNİZ (HATALI)</div>' +
                        '<div class="marker-circle"><i class="fas fa-times"></i></div>' +
                        '</div>';
                    $('#forgeryCanvasWrapper').append(wrongMarkerHtml);

                    playSound('buzz');
                    $('#forgeryResultIcon').attr('class', 'fas fa-times-circle fa-lg mr-2 text-danger');
                    $('#forgeryResultTitle').text('Tahrifat Emaresi Tespit Edilemedi!');
                    $('#forgeryResultMsg').html('Tıkladığınız alanda adli aykırılık bulunamadı.<br/><strong class="text-warning">Kriminal İpucu:</strong> ' + c.tip + '<br/><span class="text-info"><i class="fas fa-arrow-down mr-1"></i> Aşağıdaki <em>Adli Mukayese Masasında</em> işaretlediğiniz bölge ile gerçek tahrifatı yan yana inceleyin.</span>');
                    $('#forgeryResultAlert')
                        .removeClass('d-none alert-success')
