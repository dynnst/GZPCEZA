                $('#uvHotspot3').css({ top: '76%', left: '42%' });

                startUvTimer();
            }

            function startUvTimer() {
                clearInterval(uvTimerInterval);
                uvTimerInterval = setInterval(function () {
                    uvSecondsLeft--;
                    if (uvSecondsLeft < 0) uvSecondsLeft = 0;
                    $('#uvTimerSec').text(uvSecondsLeft);
                    if (uvSecondsLeft <= 0) {
                        clearInterval(uvTimerInterval);
                    }
                }, 1000);
            }

            var $desk = $('#uvInspectionDesk');
            var $lens = $('#uvTorchLens');
            var $glow = $('#uvGlowLayer');

            $desk.on('mousemove touchmove', function (e) {
                var offset = $desk.offset();
                var pageX = e.pageX;
                var pageY = e.pageY;
                if (e.originalEvent && e.originalEvent.touches && e.originalEvent.touches.length > 0) {
                    pageX = e.originalEvent.touches[0].pageX;
                    pageY = e.originalEvent.touches[0].pageY;
                }

                var x = pageX - offset.left;
                var y = pageY - offset.top;
                var w = $desk.width();
                var h = $desk.height();

                if (x < 0) x = 0; if (x > w) x = w;
                if (y < 0) y = 0; if (y > h) y = h;

                $lens.css({ left: x + 'px', top: y + 'px', display: 'block' });
                $glow.css('clip-path', 'circle(85px at ' + x + 'px ' + y + 'px)');

                $('.uv-hotspot').each(function () {
                    var $spot = $(this);
                    if ($spot.hasClass('found')) return;
                    var pos = $spot.position();
                    var sx = pos.left + 22;
                    var sy = pos.top + 22;
                    var dist = Math.sqrt(Math.pow(x - sx, 2) + Math.pow(y - sy, 2));

                    if (dist < 80) {
                        $spot.addClass('in-beam');
                    } else {
                        $spot.removeClass('in-beam');
                    }
                });
            });

            $desk.on('mouseleave', function () {
                $lens.hide();
                $glow.css('clip-path', 'circle(0px at 0px 0px)');
                $('.uv-hotspot:not(.found)').removeClass('in-beam');
            });

