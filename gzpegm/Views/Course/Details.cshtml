                    $('#btnScrollToForgeryCmp').removeClass('d-none');

                    // Yan Yana Karşılaştırma Masasını Doldur (HATALI İSABET - EĞİTİCİ KIYASLAMA)
                    renderForgeryComparison(false, normX, normY, boxW, boxH, c, targetAssetUrl, refAssetUrl);
                }
            });

