@section Scripts {
    <script>
        $(function () {
            // Eğitmenlik Başvuru Butonu
            $('#teacherRequestBtnCourse').on('click', function (e) {
                e.preventDefault();
                var btn = $(this);
                btn.prop('disabled', true);
                var token = $('#teacherRequestFormCourse').find('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("TeacherRequest", "Landing")',
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function (res) {
                        btn.prop('disabled', false);
                        if (!res) { alert('Beklenmeyen cevap.'); return; }
                        if (res.status === 'notLogin') {
                            window.location.href = '@Url.Action("Index", "Giris")';
                        } else if (res.status === 'ok') {
                            alert('Başvurunuz başarıyla alındı. Yönetici onayına gönderildi.');
                        } else if (res.status === 'alreadyRequested') {
                            alert('Zaten bir başvurunuz inceleme aşamasında beklemektedir.');
                        } else if (res.status === 'alreadyTeacher') {
                            alert('Zaten eğitmen yetkisine sahipsiniz.');
                        } else {
                            alert('Hata: ' + (res.message || res.status));
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false);
                        alert('İstek gönderilirken bir hata oluştu.');
                    }
                });
            });
        });
    </script>
}
