@model gzpegm.Models.E_User
@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Title = "Profilim";
    var tahditStats = ViewBag.TahditStats as gzpegm.Models.ViewModels.TahditStatisticsViewModel ?? new gzpegm.Models.ViewModels.TahditStatisticsViewModel();
    var pictureUrl = string.IsNullOrEmpty(Model.fldPicture)
        ? Url.Content("~/AdminTemplate/img/a4.jpg")
        : Url.Content("~/files/User/" + Model.fldPicture);
    var displayName = ((Model.fldName ?? "") + " " + (Model.fldLastName ?? "")).Trim();
}

@section Styles {
    <link href="@Url.Content("~/css/profil-index.css")?v=@gzpegm.Helpers.AssetVersionHelper.GetVersion("~/css/profil-index.css")" rel="stylesheet" />
}

<main class="profile-page">
    <section class="profile-hero">
        <div class="profile-hero-copy">
            <div class="profile-eyebrow"><span class="profile-live-dot"></span> PERSONEL HESABI</div>
            <h1>Profilim</h1>
            <p>Kişisel bilgilerini, görev detaylarını ve çalışma özetini buradan yönetebilirsin.</p>
        </div>
        <div class="profile-identity">
            <img src="@pictureUrl" alt="@displayName" id="profilePreview" class="profile-avatar-image" />
            <div class="profile-identity-copy">
                <h2>@displayName</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.fldTitle) ? "Personel" : Model.fldTitle)</p>
                <div class="profile-identity-tags">
                    @if (!string.IsNullOrWhiteSpace(Model.fldSicil)) { <span><i class="fas fa-id-badge"></i> @Model.fldSicil</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.fldDeputy)) { <span><i class="fas fa-map-marker-alt"></i> @Model.fldDeputy</span> }
                </div>
            </div>
        </div>
        <div class="profile-hero-mark" aria-hidden="true"><i class="fas fa-user-shield"></i></div>
    </section>

    <section class="profile-kpi-grid" aria-label="Genel istatistikler">
        <article class="profile-kpi-card kpi-blue">
            <span class="profile-kpi-icon"><i class="fas fa-file-alt"></i></span>
            <div><span class="profile-kpi-label">Toplam işlem</span><strong>@(ViewBag.TotalHistory ?? 0)</strong><small>Mevcut görev yerinde</small></div>
        </article>
        <article class="profile-kpi-card kpi-amber">
            <span class="profile-kpi-icon"><i class="fas fa-coins"></i></span>
            <div><span class="profile-kpi-label">Toplam ceza</span><strong>₺ @(ViewBag.TotalPenalty ?? 0)</strong><small>Kaydedilen toplam tutar</small></div>
        </article>
        <article class="profile-kpi-card kpi-violet">
            <span class="profile-kpi-icon"><i class="fas fa-graduation-cap"></i></span>
            <div><span class="profile-kpi-label">Aktif kurs</span><strong>@(ViewBag.EnrolledCoursesCount ?? 0)</strong><small>Kayıtlı kurs</small></div>
        </article>
        <article class="profile-kpi-card kpi-green">
            <span class="profile-kpi-icon"><i class="fas fa-clipboard-check"></i></span>
            <div><span class="profile-kpi-label">Sınav</span><strong>@(ViewBag.ExamResultsCount ?? 0)</strong><small>Tamamlanan sınav</small></div>
        </article>
    </section>

    <div class="profile-content-grid">
        <section class="profile-panel profile-edit-panel">
            <header class="profile-panel-heading">
                <div class="profile-section-icon"><i class="fas fa-user-edit"></i></div>
                <div><h2>Profil bilgileri</h2><p>İletişim ve görev bilgilerini güncel tut.</p></div>
            </header>
            <form method="post" action="@Url.Action("SaveProfile", "Profile")" enctype="multipart/form-data" id="profileForm" class="profile-form">
                @Html.AntiForgeryToken()
                <div class="profile-form-section-title">Kişisel bilgiler</div>
                <div class="profile-form-row">
                    <div class="form-group"><label for="fldName">Ad</label><input id="fldName" type="text" name="fldName" class="form-control" value="@Model.fldName" autocomplete="given-name" /></div>
                    <div class="form-group"><label for="fldLastName">Soyad</label><input id="fldLastName" type="text" name="fldLastName" class="form-control" value="@Model.fldLastName" autocomplete="family-name" /></div>
                </div>
                <div class="form-group"><label for="fldTitle">Ünvan</label><input id="fldTitle" type="text" name="fldTitle" class="form-control" value="@Model.fldTitle" /></div>

                <div class="profile-form-section-title">İletişim</div>
                <div class="form-group"><label for="fldPhone">Telefon</label><div class="profile-input-icon"><i class="fas fa-phone"></i><input id="fldPhone" type="tel" name="fldPhone" class="form-control" value="@Model.fldPhone" autocomplete="tel" /></div></div>
                <div class="form-group"><label for="fldEmail">E-posta</label><div class="profile-input-icon"><i class="fas fa-envelope"></i><input id="fldEmail" type="email" name="fldEmail" class="form-control" value="@Model.fldEmail" autocomplete="email" /></div></div>

                <div class="profile-form-section-title">Görev bilgileri</div>
                <div class="form-group"><label for="fldDeputy">Görev yeri</label><input id="fldDeputy" type="text" name="fldDeputy" class="form-control" value="@Model.fldDeputy" /></div>
                <div class="form-group"><label for="fldBorder">Hudut kapısı</label>
                    <select id="fldBorder" name="fldBorder" class="form-control">
                        <option value="">Seçiniz</option>
                        @if (ViewBag.Borders != null)
                        {
                            foreach (var b in (System.Collections.IEnumerable)ViewBag.Borders)
                            {
                                var bb = b as dynamic;
                                var name = bb.fldName as string;
                                var selected = string.Equals(name, Model.fldBorder, StringComparison.OrdinalIgnoreCase) ? "selected" : "";
                                <option value="@name" @selected>@name</option>
                            }
                        }
                    </select>
                </div>

                <div class="profile-form-section-title">Profil fotoğrafı</div>
                <div class="profile-upload-box">
                    <div class="profile-upload-icon"><i class="fas fa-camera"></i></div>
                    <div class="profile-upload-copy"><label for="profileImageInput">Yeni fotoğraf seç</label><small>JPG, PNG veya GIF · en fazla 2 MB</small></div>
                    <input type="file" name="PictureFile" accept=".jpg,.jpeg,.png,.gif,.bmp" id="profileImageInput" />
                </div>

                <details class="profile-password-details">
                    <summary><i class="fas fa-lock"></i><span>Şifreyi değiştir</span><small>İsteğe bağlı</small></summary>
                    <div class="profile-password-fields">
                        <div class="form-group"><label for="currentpass">Mevcut şifre</label><input id="currentpass" type="password" name="currentpass" class="form-control" autocomplete="current-password" placeholder="Mevcut şifren" /></div>
                        <div class="form-group"><label for="newpass">Yeni şifre</label><input id="newpass" type="password" name="newpass" class="form-control" autocomplete="new-password" /></div>
                        <div class="form-group"><label for="confirmpass">Yeni şifre (tekrar)</label><input id="confirmpass" type="password" name="confirmpass" class="form-control" autocomplete="new-password" /></div>
                    </div>
                </details>

                <button type="submit" class="profile-save-button"><i class="fas fa-check"></i> Değişiklikleri kaydet</button>
            </form>
        </section>

        <div class="profile-insights-column">
            <section class="profile-panel">
                <header class="profile-panel-heading">
                    <div class="profile-section-icon icon-teal"><i class="fas fa-chart-line"></i></div>
                    <div><h2>Çalışma özeti</h2><p>İşlem yoğunluğu ve performans göstergeleri</p></div>
                </header>
                <div class="profile-insight-grid">
                    <div class="profile-insight-tile"><span>En aktif gün</span><strong>@(ViewBag.MostActiveDay ?? "-")</strong><small>@(ViewBag.MostActiveDayCount ?? 0) işlem</small></div>
                    <div class="profile-insight-tile"><span>Ceza sıralaması</span><strong>@(ViewBag.PenaltyRank ?? "-")</strong><small>Görev yerindeki sıralama</small></div>
                    <div class="profile-insight-tile"><span>En çok işlem yapılan ülke</span><strong>@(ViewBag.TopCountry ?? "-")</strong><small>@(ViewBag.TopCountryCount ?? 0) işlem</small></div>
                    <div class="profile-insight-tile"><span>En çok İNAD</span><strong>@(ViewBag.InadTopCountry ?? "-")</strong><small>@(ViewBag.InadTopReason ?? "-") · @(ViewBag.InadTopCount ?? 0) kayıt</small></div>
                </div>
                <div class="profile-chart-block">
                    <div class="profile-subheading"><div><h3>Son 12 ay</h3><p>Aylık işlem sayısı</p></div><span class="profile-chart-legend"><i></i> İşlem</span></div>
                    <div id="profile-sparkline" class="profile-chart" aria-label="Son 12 aylık işlem grafiği"></div>
                    <div class="profile-chart-months"><span>12 ay önce</span><span>Bugün</span></div>
                </div>
            </section>

            <section class="profile-panel">
                <header class="profile-panel-heading">
                    <div class="profile-section-icon icon-rose"><i class="fas fa-shield-alt"></i></div>
                    <div><h2>Tahdit formu özeti</h2><p>Oluşturduğun formların dağılımı</p></div>
                </header>
                <div class="profile-tahdit-summary">
                    <div><span>Bugün</span><strong>@tahditStats.TodayTotal</strong><small>basılan form</small></div>
                    <div><span>Toplam</span><strong>@tahditStats.AllTotal</strong><small>basılan form</small></div>
                </div>
                <div class="table-responsive profile-table-wrap">
                    <table class="table profile-data-table">
                        <thead><tr><th>Tahdit kodu</th><th>İdari kod</th><th class="text-right">Adet</th></tr></thead>
                        <tbody>
                            @if (tahditStats.AllByCode.Any())
                            {
                                foreach (var item in tahditStats.AllByCode)
                                {
                                    <tr><td><span class="profile-code-pill">@item.TahditCode</span></td><td>@item.IdariTahditCode</td><td class="text-right font-weight-bold">@item.Count</td></tr>
                                }
                            }
                            else { <tr><td colspan="3" class="profile-empty-cell">Henüz tahdit formu kaydı yok.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="profile-bottom-grid">
                <section class="profile-panel profile-message-panel">
                    <header class="profile-panel-heading">
                        <div class="profile-section-icon icon-amber"><i class="fas fa-comment-alt"></i></div>
                        <div><h2>Son mesaj</h2><p>Gelen kutundaki son bilgilendirme</p></div>
                    </header>
                    @if (ViewBag.LastMessageSubject != null)
                    {
                        <div class="profile-message-content"><strong>@ViewBag.LastMessageSubject</strong><time>@(ViewBag.LastMessageDate != null ? ((DateTime)ViewBag.LastMessageDate).ToString("dd.MM.yyyy HH:mm") : "")</time><p>@Html.Raw(Html.Encode(ViewBag.LastMessageText ?? "").Replace("\n", "<br/>"))</p></div>
                    }
                    else { <div class="profile-empty-state"><i class="far fa-envelope-open"></i><span>Henüz mesajın yok.</span></div> }
                </section>

                <section class="profile-panel profile-border-panel">
                    <header class="profile-panel-heading">
                        <div class="profile-section-icon icon-blue"><i class="fas fa-map-marked-alt"></i></div>
                        <div><h2>Hudut kapıları</h2><p>İşlem yaptığın diğer kapılar</p></div>
                    </header>
                    @{
                        var list = (IEnumerable<gzpegm.Models.ViewModels.ProfileBorderStat>)(ViewBag.BorderHistory ?? new List<gzpegm.Models.ViewModels.ProfileBorderStat>());
                        var top5 = list.OrderByDescending(x => x.Count).Take(5).ToList();
                    }
                    @if (list.Any())
                    {
                        <div class="profile-border-list">
                            @foreach (var bi in top5)
                            {
                                <div class="profile-border-item">
                                    <div class="profile-border-avatar"><i class="fas fa-plane"></i></div>
                                    <div class="profile-border-copy"><strong>@bi.Border</strong><small>@bi.Count işlem · @bi.Sum TL</small></div>
                                    <button type="button" class="profile-detail-button view-border" data-border="@bi.Border" aria-label="@bi.Border detaylarını görüntüle"><i class="fas fa-chevron-right"></i></button>
                                </div>
                            }
                        </div>
                        if (list.Count() > 5) { <button type="button" id="showAllBorders" class="profile-text-button">Tüm hudut kapılarını gör <i class="fas fa-arrow-right"></i></button> }
                    }
                    else { <div class="profile-empty-state"><i class="fas fa-route"></i><span>Henüz hudut bilgisi yok.</span></div> }
                </section>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <div id="profil-config"
         data-details-url="@Url.Action("GetBorderDetails", "Profile")"
         data-history-chart='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.HistoryChart ?? new object[0]))'
         data-border-history='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BorderHistory ?? new List<object>()))'
         style="display:none;"></div>
    <script src="@Url.Content("~/AdminTemplate/js/plugins/sparkline/jquery.sparkline.min.js")"></script>
    <script src="@Url.Content("~/js/profil-index.js")?v=@gzpegm.Helpers.AssetVersionHelper.GetVersion("~/js/profil-index.js")"></script>
}
