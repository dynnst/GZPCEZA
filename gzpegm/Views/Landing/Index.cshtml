@model gzpegm.Models.ViewModels.LandingViewModel
@using gzpegm.Models.ViewModels
@using System.Linq
@using gzpegm.ViewModels
@using System.Text.RegularExpressions

@functions {
    private static readonly Regex _imgSrcRegex =
        new Regex("<img[^>]+src\\s*=\\s*['\\\"]([^'\\\"]+)['\\\"]", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private static readonly Regex _imgTagRegex =
        new Regex("<img[^>]*>", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private static readonly Regex _stripTagsRegex =
        new Regex("<.*?>", RegexOptions.Singleline | RegexOptions.Compiled);

    private string GetFirstImageSrc(string html)
    {
        if (string.IsNullOrEmpty(html)) return null;
        var m = _imgSrcRegex.Match(html);
        return m.Success ? m.Groups[1].Value : null;
    }

    private string RemoveFirstImageTag(string html)
    {
        if (string.IsNullOrEmpty(html)) return html;
        return _imgTagRegex.Replace(html, "");
    }

    private string StripTags(string html)
    {
        if (string.IsNullOrEmpty(html)) return string.Empty;
        return _stripTagsRegex.Replace(html, string.Empty);
    }
}

@{
    string defaultCourseImage = Url.Content("~/AdminTemplate/img/landing/default-course.jpg");
    string defaultAvatar = Url.Content("~/AdminTemplate/img/landing/avatar1.jpg");
    string defaultPoliceAvatar = Url.Content("~/files/user/police-xxl.png");
