        .course-card:hover {
            transform: translateY(-5px);
            border-color: #1e3c72;
            box-shadow: 0 12px 28px rgba(30, 60, 114, 0.12);
        }
        .category-tag-over {
            position: absolute;
            top: 10px;
            left: 10px;
