            border: 1px solid #e2e8f0;
            transition: all 0.25s ease;
        }
        .landing-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(30, 60, 114, 0.08);
            border-color: #93c5fd;
        }
        .stat-icon-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            margin-bottom: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        }
