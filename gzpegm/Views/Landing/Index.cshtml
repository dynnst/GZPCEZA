    <div class="modal fade" id="quickChallengeModal" tabindex="-1" role="dialog" aria-labelledby="quickChallengeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 20px; border: 1px solid #1e3c72; box-shadow: 0 20px 50px rgba(7, 20, 38, 0.4); overflow:hidden;">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #071739 0%, #1e3c72 100%); padding: 18px 24px;">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon-circle bg-warning text-dark mr-3 mb-0" style="width:38px;height:38px;font-size:16px;">
                            <i class="fa fa-bolt"></i>
                        </div>
                        <div>
                            <h5 class="modal-title font-weight-bold mb-0 text-white" id="quickChallengeModalLabel">Günün Hızlı Refleks Testi</h5>
                            <span class="small text-warning">ICAO 9303 Biyometrik Pasaport Güvenliği</span>
                        </div>
                    </div>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat" style="opacity:0.85;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4" style="background:#f8fafc;">
                    <p class="font-weight-bold text-dark mb-3" style="font-size:14.5px; line-height:1.5;">
                        🔍 <strong>Soru:</strong> Bir e-Pasaportun kimlik sayfasında yer alan <em>Optik Değişken Mürekkep (OVI)</em> öğesi kontrol edilirken hangi fiziksel değişim gözlenmelidir?
                    </p>

                    <div class="challenge-options" style="display:flex; flex-direction:column; gap:10px;">
                        <button type="button" class="btn btn-light text-left p-3 challenge-opt-btn" onclick="checkReflexAnswer(this, false)" style="border-radius:12px; border:1px solid #cbd5e1; font-size:13px;">
                            <strong>A)</strong> Belge UV ışığı altına tutulduğunda kırmızıdan maviye floresan ışıma yapmalıdır.
                        </button>
                        <button type="button" class="btn btn-light text-left p-3 challenge-opt-btn" onclick="checkReflexAnswer(this, true)" style="border-radius:12px; border:1px solid #cbd5e1; font-size:13px;">
                            <strong>B)</strong> Farklı bakış açılarında eğildiğinde belirgin renk değişimi (ör. yeşilden macentaya) göstermelidir.
                        </button>
                        <button type="button" class="btn btn-light text-left p-3 challenge-opt-btn" onclick="checkReflexAnswer(this, false)" style="border-radius:12px; border:1px solid #cbd5e1; font-size:13px;">
                            <strong>C)</strong> Kızılötesi (IR) ışık altında tamamen görünmez hale gelmelidir.
                        </button>
                        <button type="button" class="btn btn-light text-left p-3 challenge-opt-btn" onclick="checkReflexAnswer(this, false)" style="border-radius:12px; border:1px solid #cbd5e1; font-size:13px;">
                            <strong>D)</strong> Parmakla dokunulduğunda hissedilebilir kabartmalı (intaglio) olmalıdır.
                        </button>
                    </div>

                    <div id="challengeFeedback" class="mt-3 text-center" style="display:none;"></div>
                </div>
                <div class="modal-footer" style="background:#ffffff; border-top:1px solid #e2e8f0;">
                    @if (firstCourse != null)
                    {
                        <a href="@Url.Action("Details", "Course", new { id = firstCourse.CourseId })" class="btn btn-primary font-weight-bold" style="border-radius:20px;">
                            <i class="fa fa-graduation-cap mr-1"></i> Tam Kursu ve Simülasyonu Başlat
                        </a>
                    }
                    <button type="button" class="btn btn-secondary font-weight-bold" data-dismiss="modal" style="border-radius:20px;">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["msgError"] != null)
    {
        <div class="modal fade" id="loginAlertModal" tabindex="-1" role="dialog" aria-labelledby="loginAlertLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title font-weight-bold" id="loginAlertLabel">Uyarı</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @TempData["msgError"]
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="loginRedirectBtn">Giriş Sayfasına Git</button>
                        <button type="button" class="btn btn-secondary" id="homeRedirectBtn">Anasayfaya Dön</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SCRIPTS -->
    <script src="/AdminTemplate/js/jquery-3.1.1.min.js"></script>
    <script src="/AdminTemplate/js/popper.min.js"></script>
    <script src="/AdminTemplate/js/bootstrap.js"></script>
    <script src="/AdminTemplate/js/plugins/wow/wow.min.js"></script>

    <script>
        window.landingConfig = {
            courseDetailsUrl: '@Url.Action("Details", "Course")',
            courseListUrl: '@Url.Action("StudentIndex", "Course")',
            searchUrl: '@Url.Action("Search", "Landing")',
            teacherRequestUrl: '@Url.Action("TeacherRequest", "Landing")',
            loginUrl: '@Url.Action("Index", "Giris", new { direct = true })',
            landingUrl: '@Url.Action("Index", "Landing")',
            categoriesUrl: '@Url.Action("GetActiveCategories", "Landing")',
            coursesByCategoryUrl: '@Url.Action("CoursesByCategory", "Landing")',
            defaultCourseImage: '/AdminTemplate/img/landing/default-course.jpg',
            hasLoginError: @Html.Raw(System.Web.Helpers.Json.Encode(TempData["msgError"] != null))
        };

        // Slider'ı otomatik ve kesintisiz çalıştıran yapı
        $(document).ready(function () {
            var $slider = $('#inSlider');
            if ($slider.length) {
                $slider.carousel({
                    interval: 4500,
                    pause: false, // Fare üzerindeyken duraklamaz, akıcı akar
                    wrap: true,
                    keyboard: true
                });

                // Tıklamalarda garantili geçiş
                $('.carousel-control-prev').on('click', function (e) {
                    e.preventDefault();
                    $slider.carousel('prev');
                });
                $('.carousel-control-next').on('click', function (e) {
                    e.preventDefault();
                    $slider.carousel('next');
                });
            }
        });

        function checkReflexAnswer(btn, isCorrect) {
            var $all = $('.challenge-opt-btn');
            $all.prop('disabled', true);
            var $fb = $('#challengeFeedback');

            if (isCorrect) {
                $(btn).removeClass('btn-light').addClass('btn-success text-white');
                $fb.html(
                    '<div class="alert alert-success font-weight-bold py-2 mb-0">' +
                    '<i class="fa fa-check-circle mr-1"></i> TEBRİKLER! DOĞRU CEVAP (+50 XP)<br>' +
                    '<span class="small font-weight-normal">OVI mürekkebi farklı bakış açılarında renk kırılması gösterir. Diğer vakaları incelemek için tam eğitime katılın!</span>' +
                    '</div>'
                ).slideDown();
            } else {
                $(btn).removeClass('btn-light').addClass('btn-danger text-white');
                $all.each(function () {
                    if ($(this).attr('onclick').indexOf('true') > -1) {
                        $(this).removeClass('btn-light').addClass('btn-success text-white');
                    }
                });
                $fb.html(
                    '<div class="alert alert-warning font-weight-bold py-2 mb-0">' +
                    '<i class="fa fa-times-circle mr-1"></i> YANLIŞ CEVAP<br>' +
                    '<span class="small font-weight-normal">Doğru şık B şıkkıdır. OVI mürekkebi bakış açısı değiştikçe renk değiştirir.</span>' +
                    '</div>'
                ).slideDown();
            }
        }
    </script>
    <script src="/js/landing-page.js"></script>

</body>
</html>
