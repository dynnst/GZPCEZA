    <link href="/AdminTemplate/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    <link href="/AdminTemplate/css/style.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet" />
    <link href="/Content/landing-page.css" rel="stylesheet" />

    <style>
        /* EK MODERN LANDING STILLERI */
        .fb-logo-text {
            font-weight: 800;
            letter-spacing: 0.5px;
            font-size: 16px;
            color: #ffffff;
        }
        .fb-logo-sub {
