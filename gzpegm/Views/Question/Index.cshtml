@model List<gzpegm.Models.ViewModels.QuestionViewModel>
@using System.Linq
@{
    ViewBag.Title = "Soru Havuzu - " + (ViewBag.ExamTitle ?? "Sınav");
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseDataTables = true;

    var questions = Model ?? new List<gzpegm.Models.ViewModels.QuestionViewModel>();
    int totalQuestions = questions.Count;
    int activeQuestions = questions.Count(q => q.IsActive);
    int passiveQuestions = questions.Count(q => !q.IsActive);
    int totalPoints = questions.Where(q => q.IsActive).Sum(q => q.Points);
    int multipleChoiceCount = questions.Count(q => q.QuestionType == "MultipleChoice");
    int trueFalseCount = questions.Count(q => q.QuestionType == "TrueFalse");
    int textCount = questions.Count(q => q.QuestionType == "Text");
}

<div class="question-management-container">

    <!-- ÜST BİLGİ VE AKSİYON HERO BANNERI (EGM POLİS TEMASI) -->
    <div class="question-hero-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-7 col-md-6">
                <div class="d-flex align-items-center">
                    <div class="hero-icon-box mr-3 d-none d-sm-flex">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <div>
                        <div class="hero-breadcrumbs mb-1">
                            <a href="@Url.Action("Index", "Course")" class="text-white-50"><i class="fas fa-book-open mr-1"></i>@(ViewBag.CourseTitle ?? "Ders")</a>
                            <span class="text-white-50 mx-1">/</span>
                            <a href="@Url.Action("Index", "Exam")" class="text-white-50"><i class="fas fa-file-signature mr-1"></i>@(ViewBag.ExamTitle ?? "Sınav")</a>
                            <span class="text-white-50 mx-1">/</span>
                            <span class="text-white font-weight-semibold">Soru Havuzu</span>
                        </div>
                        <h2 class="hero-title mb-1">@ViewBag.ExamTitle &mdash; Soru Havuzu</h2>
                        <p class="hero-desc mb-0">Bu sınava ait soruları, çoktan seçmeli şıkları, puan ağırlıklarını ve soru medyalarını yönetin.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-6 text-md-right mt-3 mt-md-0">
                <div class="d-flex justify-content-md-end align-items-center gap-2 flex-wrap">
                    @if (ViewBag.CourseId != null)
                    {
                        <a href="@Url.Action("Details", "Course", new { id = ViewBag.CourseId })" class="btn btn-outline-light hero-action-btn mr-1" title="Kursa Dön">
                            <i class="fas fa-graduation-cap mr-1"></i>Kursa Dön
                        </a>
                    }
                    <a href="@Url.Action("Index", "Exam")" class="btn btn-outline-light hero-action-btn mr-1" title="Sınavlar Listesi">
                        <i class="fas fa-arrow-left mr-1"></i>Sınavlara Dön
                    </a>
                    @if (ViewBag.CourseIsActive == false && ViewBag.CourseId != null)
                    {
                        <a href="@Url.Action("Review", "EducationPackage", new { id = ViewBag.CourseId })" class="btn btn-warning hero-action-btn mr-1 font-weight-bold" title="Taslak Kontrolü">
                            <i class="fas fa-clipboard-check mr-1"></i>Taslak Kontrolü
                        </a>
                    }
                    <button type="button" class="btn btn-success hero-action-btn font-weight-bold shadow-sm" data-toggle="modal" data-target="#createQuestionModal">
                        <i class="fas fa-plus-circle mr-1"></i>Yeni Soru Ekle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SİSTEM BİLDİRİM MESAJLARI -->
    @if (TempData["msgSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle fa-lg mr-2 text-success"></i>
                <div>
                    <strong>İşlem Başarılı!</strong> @TempData["msgSuccess"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["msgWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-lg mr-2 text-warning"></i>
                <div>
                    <strong>Uyarı:</strong> @TempData["msgWarning"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["msgError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-times-circle fa-lg mr-2 text-danger"></i>
                <div>
                    <strong>Hata:</strong> @TempData["msgError"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- İSTATİSTİK METRİK KARTLARI (4 KART) -->
    <div class="row stat-cards-row mb-4">
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-blue">
                <div class="metric-icon">
                    <i class="fas fa-list-ol"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@totalQuestions</div>
                    <div class="metric-label">Toplam Soru</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-emerald">
                <div class="metric-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@activeQuestions</div>
                    <div class="metric-label">Aktif Soru</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-teal">
                <div class="metric-icon">
                    <i class="fas fa-star"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">
                        @totalPoints <small style="font-size: 1rem; opacity: 0.9;">/ 100</small>
                    </div>
                    <div class="metric-label">
                        Toplam Puan Ağırlığı
                        @if (totalPoints == 100)
                        {
                            <span class="badge badge-light text-success ml-1 font-weight-bold">100 Tamam</span>
                        }
                        else
                        {
                            <span class="badge badge-light text-danger ml-1 font-weight-bold">@(100 - totalPoints > 0 ? (100 - totalPoints) + " Puan Eksik" : (totalPoints - 100) + " Puan Fazla")</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-purple">
                <div class="metric-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value" style="font-size: 1.3rem;">
                        <span>@multipleChoiceCount Ç.Seçim</span>
                    </div>
                    <div class="metric-label">@trueFalseCount D/Y &bull; @textCount Klasik</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FİLTRE VE ARAMA ÇUBUĞU -->
    <div class="card filter-toolbar-card mb-4 shadow-sm">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <!-- Arama Kutusu -->
                <div class="col-lg-5 col-md-6 mb-2 mb-lg-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                        </div>
                        <input type="text" id="questionSearchInput" class="form-control border-left-0" placeholder="Soru metni veya şık içeriği ara..." />
                    </div>
                </div>

                <!-- Tür Filtresi -->
                <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                    <select id="typeFilterSelect" class="form-control">
                        <option value="">Tüm Soru Türleri</option>
                        <option value="MultipleChoice">Çoktan Seçmeli</option>
                        <option value="TrueFalse">Doğru / Yanlış</option>
                        <option value="Text">Klasik (Yazılı)</option>
                    </select>
                </div>

                <!-- Durum Filtresi -->
                <div class="col-lg-4 col-md-12 text-lg-right">
                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                        <label class="btn btn-outline-secondary btn-sm active status-filter-btn" data-status="all">
                            <input type="radio" name="statusOption" autocomplete="off" checked> Tümü (@totalQuestions)
                        </label>
                        <label class="btn btn-outline-success btn-sm status-filter-btn" data-status="active">
                            <input type="radio" name="statusOption" autocomplete="off"> Aktif (@activeQuestions)
                        </label>
                        <label class="btn btn-outline-danger btn-sm status-filter-btn" data-status="passive">
                            <input type="radio" name="statusOption" autocomplete="off"> Pasif (@passiveQuestions)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SORU LİSTESİ TABLOSU -->
    <div class="card shadow-sm border-0 question-list-card">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-tasks text-primary mr-2" style="font-size: 1.2rem;"></i>
                <h5 class="card-title font-weight-bold text-dark mb-0">Soru Listesi & Seçenekler</h5>
            </div>
            <span class="badge badge-primary px-3 py-2 font-weight-semibold" id="visibleCountBadge">Toplam @totalQuestions Soru</span>
        </div>

        <div class="card-body p-0">
            @if (questions.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="questionDataTable">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 70px;" class="text-center">Sıra</th>
                                <th>Soru Metni & Şıklar</th>
                                <th style="width: 150px;" class="text-center">Soru Türü</th>
                                <th style="width: 100px;" class="text-center">Puan</th>
                                <th style="width: 140px;" class="text-center">Medya</th>
                                <th style="width: 110px;" class="text-center">Durum</th>
                                <th style="width: 130px;" class="text-center">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var question in questions)
                            {
                                string rowStatus = question.IsActive ? "active" : "passive";
                                string rowSearchText = (question.QuestionText + " " + (question.Options != null ? string.Join(" ", question.Options.Select(o => o.OptionText)) : "")).ToLower();

                                <tr class="question-row @(question.IsActive ? "" : "table-secondary-passive")"
                                    data-status="@rowStatus"
                                    data-type="@question.QuestionType"
                                    data-search="@rowSearchText">

                                    <!-- SIRA NO -->
                                    <td class="text-center font-weight-bold">
                                        <span class="badge-order-circle @(question.IsActive ? "badge-order-active" : "badge-order-passive")">
                                            @question.SortOrder
                                        </span>
                                    </td>

                                    <!-- SORU METNİ VE ŞIKLAR -->
                                    <td>
                                        <div class="question-text-wrapper mb-2">
                                            <span class="question-title-text font-weight-semibold text-dark">
                                                @question.QuestionText
                                            </span>
                                            @if (!question.IsActive)
                                            {
                                                <span class="badge badge-danger ml-2 font-weight-normal"><i class="fas fa-ban mr-1"></i>Pasif</span>
                                            }
                                        </div>

                                        <!-- ŞIKLAR / SEÇENEKLER ÖNİZLEMESİ -->
                                        @if (question.Options != null && question.Options.Count > 0)
                                        {
                                            <div class="question-options-preview d-flex flex-wrap gap-2 mt-2">
                                                @{
                                                    char optionLetter = 'A';
                                                }
                                                @foreach (var opt in question.Options)
                                                {
                                                    <div class="option-preview-chip @(opt.IsCorrect ? "option-correct-chip" : "option-standard-chip")">
                                                        <span class="option-letter-badge">@optionLetter</span>
                                                        <span class="option-text-span">@opt.OptionText</span>
                                                        @if (opt.IsCorrect)
                                                        {
                                                            <i class="fas fa-check-circle text-success ml-1" title="Doğru Cevap"></i>
                                                        }
                                                    </div>
                                                    optionLetter++;
                                                }
                                            </div>
                                        }
                                        else if (question.QuestionType == "Text")
                                        {
                                            <div class="text-muted small mt-1">
                                                <i class="fas fa-info-circle mr-1 text-primary"></i>Klasik soru — Değerlendirme eğitmen tarafından metin bazlı yapılır.
                                            </div>
                                        }
                                    </td>

                                    <!-- SORU TÜRÜ -->
                                    <td class="text-center">
                                        @if (question.QuestionType == "MultipleChoice")
                                        {
                                            <span class="badge badge-soft-primary px-2 py-1">
                                                <i class="fas fa-list-ul mr-1"></i>Çoktan Seçmeli
                                            </span>
                                        }
                                        else if (question.QuestionType == "TrueFalse")
                                        {
                                            <span class="badge badge-soft-info px-2 py-1">
                                                <i class="fas fa-check-square mr-1"></i>Doğru / Yanlış
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-secondary px-2 py-1">
                                                <i class="fas fa-paragraph mr-1"></i>Klasik
                                            </span>
                                        }
                                    </td>

                                    <!-- PUAN -->
                                    <td class="text-center">
                                        <span class="badge-points">
                                            @question.Points Puan
                                        </span>
                                    </td>

                                    <!-- MEDYA DOSYALARI -->
                                    <td class="text-center">
                                        @if (question.MediaFiles != null && question.MediaFiles.Count > 0)
                                        {
                                            <div class="d-flex justify-content-center align-items-center gap-1 flex-wrap">
                                                @foreach (var media in question.MediaFiles)
                                                {
                                                    if (media.MediaType == 1)
                                                    {
                                                        <div class="media-thumb-box" title="Görseli Büyüt" data-src="@media.MediaPath" data-type="image">
                                                            <img src="@media.MediaPath" class="media-thumb-img" alt="Soru Görseli" />
                                                            <span class="media-thumb-overlay"><i class="fas fa-search-plus"></i></span>
                                                        </div>
                                                    }
                                                    else if (media.MediaType == 2)
                                                    {
                                                        <div class="media-thumb-box video-box" title="Videoyu Oynat" data-src="@media.MediaPath" data-type="video">
                                                            <div class="media-video-placeholder">
                                                                <i class="fas fa-play text-white"></i>
                                                            </div>
                                                            <span class="media-thumb-overlay"><i class="fas fa-play"></i></span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">&mdash;</span>
                                        }
                                    </td>

                                    <!-- DURUM -->
                                    <td class="text-center">
                                        @if (question.IsActive)
                                        {
                                            <span class="badge-status-pill badge-active">
                                                <span class="status-pulse-dot"></span> Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-status-pill badge-passive">
                                                <i class="fas fa-ban mr-1"></i> Pasif
                                            </span>
                                        }
                                    </td>

                                    <!-- İŞLEMLER -->
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- Düzenle -->
                                            <button type="button"
                                                    class="btn btn-outline-primary edit-question-btn"
                                                    data-questionid="@question.QuestionId"
                                                    title="Soruyu Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <!-- Durum Değiştir / Pasif / Aktif Yap -->
                                            <button type="button"
                                                    class="btn @(question.IsActive ? "btn-outline-warning" : "btn-outline-success") delete-question-btn"
                                                    data-questionid="@question.QuestionId"
                                                    data-isactive="@(question.IsActive ? "true" : "false")"
                                                    title="@(question.IsActive ? "Pasife Al / Sil" : "Yeniden Aktif Et")">
                                                <i class="fas @(question.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="empty-state-icon mb-3">
                        <i class="fas fa-folder-open text-muted" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="text-dark font-weight-bold">Henüz Soru Eklenmemiş</h5>
                    <p class="text-muted mb-3">Bu sınava henüz soru havuzundan soru tanımlanmamıştır. Aşağıdaki butondan hemen soru ekleyebilirsiniz.</p>
                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createQuestionModal">
                        <i class="fas fa-plus mr-1"></i>İlk Soruyu Ekle
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===================== YENİ SORU EKLEME MODALI (CREATE) ===================== -->
<div class="modal fade" id="createQuestionModal" tabindex="-1" role="dialog" aria-labelledby="createQuestionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content border-0 shadow-lg">
            <form id="createQuestionForm" method="post" action="@Url.Action("CreateQuestion", "Question")" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExamId" value="@(ViewBag.ExamId ?? Request.QueryString["examId"] ?? "0")" />

                <!-- MODAL HEADER -->
                <div class="modal-header modal-hero-header text-white">
                    <div class="d-flex align-items-center">
                        <div class="modal-header-icon mr-3">
                            <i class="fas fa-plus-circle"></i>
                        </div>
                        <div>
                            <h5 class="modal-title font-weight-bold text-white mb-0" id="createQuestionModalLabel">Yeni Soru Ekle</h5>
                            <small class="text-white-50">Soru metnini, türünü, puanını ve varsa şıklarını tanımlayın</small>
                        </div>
                    </div>
                    <button type="button" class="close text-white opacity-8" data-dismiss="modal" aria-label="Kapat">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <!-- MODAL BODY -->
                <div class="modal-body p-4 bg-light-subtle">

                    <!-- Soru Metni -->
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold text-dark">
                            Soru Metni <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" name="QuestionText" rows="3" required placeholder="Soru metnini detaylı şekilde buraya yazınız..."></textarea>
                    </div>

                    <!-- Tür, Puan ve Sıra -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label font-weight-bold text-dark">Soru Türü <span class="text-danger">*</span></label>
                            <select class="form-control" id="createQuestionTypeSelect" name="QuestionType" required>
                                <option value="MultipleChoice" selected>Çoktan Seçmeli</option>
                                <option value="TrueFalse">Doğru / Yanlış</option>
                                <option value="Text">Klasik (Yazılı)</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label font-weight-bold text-dark">Puan <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" name="Points" value="10" min="1" max="100" required />
                                <div class="input-group-append">
                                    <span class="input-group-text bg-white">Puan</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label font-weight-bold text-dark">Soru Sırası <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="SortOrder" value="@(totalQuestions + 1)" min="1" required />
                        </div>
                    </div>

                    <!-- ÇOKTAN SEÇMELİ ŞIKLAR BÖLÜMÜ -->
                    <div id="createOptionsSection" class="options-container-box p-3 mb-3 border rounded bg-white shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label font-weight-bold text-dark mb-0">
                                <i class="fas fa-list-ul mr-1 text-primary"></i>Şıklar & Seçenekler <span class="text-danger">*</span>
                            </label>
                            <small class="text-muted"><i class="fas fa-info-circle mr-1"></i>Doğru şıkkı yanındaki kutucuktan işaretleyin</small>
                        </div>

                        <div id="createOptionsContainer" class="mb-2">
                            <!-- Dinamik şıklar JavaScript ile doldurulacak -->
                        </div>

                        <button type="button" id="createAddOptionBtn" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-plus mr-1"></i>Yeni Şık Ekle
                        </button>
                    </div>

                    <!-- KLASİK SORU BİLGİLENDİRMESİ -->
                    <div id="createTextNotice" class="alert alert-info py-2 px-3 mb-3 d-none">
                        <i class="fas fa-info-circle mr-1"></i>
                        <strong>Klasik Yazılı Soru:</strong> Bu soru tipi için şık tanımlanmaz. Sınav esnasında adaya metin kutusu sunulur.
                    </div>

                    <!-- MEDYA EKLEME BÖLÜMÜ -->
                    <div class="media-upload-section p-3 border rounded bg-white shadow-sm">
                        <label class="form-label font-weight-bold text-dark mb-2">
                            <i class="fas fa-paperclip mr-1 text-primary"></i>Medya Dosyaları Ekle (İsteğe Bağlı)
                        </label>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="small text-muted font-weight-semibold mb-1"><i class="fas fa-image mr-1"></i>Görsel Dosyaları (JPG, PNG)</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="createImageFiles" name="ImageFiles" accept="image/png,image/jpeg" multiple>
                                    <label class="custom-file-label" for="createImageFiles">Görsel seçin...</label>
                                </div>
                                <div id="createImagePreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="small text-muted font-weight-semibold mb-1"><i class="fas fa-video mr-1"></i>Video Dosyaları (MP4)</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="createVideoFiles" name="VideoFiles" accept="video/mp4" multiple>
                                    <label class="custom-file-label" for="createVideoFiles">Video seçin...</label>
                                </div>
                                <div id="createVideoPreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                            </div>
                        </div>
                    </div>

