@section Scripts {
    <script>
        $(function () {
            'use strict';

            var currentSearch = '';
            var currentType = '';
            var currentStatus = 'all';

            var $questionRows = $('.question-row');

            // FİLTRE VE ARAMA UYGULA
            function applyFilters() {
                var visibleCount = 0;

                $questionRows.each(function () {
                    var $row = $(this);
                    var text = ($row.attr('data-search') || '').toLowerCase();
                    var type = $row.attr('data-type') || '';
                    var status = $row.attr('data-status') || '';

                    var matchSearch = !currentSearch || text.indexOf(currentSearch) >= 0;
                    var matchType = !currentType || type === currentType;
                    var matchStatus = currentStatus === 'all' || status === currentStatus;

                    if (matchSearch && matchType && matchStatus) {
                        $row.show();
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });

                $('#visibleCountBadge').text('Gösterilen: ' + visibleCount + ' Soru');
            }

            // Arama kutusu
            $('#questionSearchInput').on('keyup', function () {
                currentSearch = $(this).val().trim().toLowerCase();
                applyFilters();
            });

            // Tür seçimi
            $('#typeFilterSelect').on('change', function () {
                currentType = $(this).val();
                applyFilters();
            });

            // Durum butonları
            $('.status-filter-btn').on('click', function () {
                currentStatus = $(this).attr('data-status');
                applyFilters();
            });

            /* ================= DİNAMİK ŞIK OLUŞTURMA YARDIMCISI ================= */
            function buildOptionRowHtml(index, text, isCorrect, isTrueFalse) {
                var checkedAttr = isCorrect ? 'checked' : '';
                var selectedClass = isCorrect ? 'is-correct-selected' : '';
                var letter = String.fromCharCode(65 + index);

                return '<div class="option-row-item d-flex align-items-center ' + selectedClass + '" data-idx="' + index + '">' +
                            '<div class="mr-2 font-weight-bold text-muted" style="width: 22px;">' + letter + '</div>' +
                            '<div class="custom-control custom-checkbox mr-3" title="Doğru Şık İşareti">' +
                                '<input type="checkbox" class="custom-control-input option-correct-chk" id="optChk_' + index + '_' + Math.random().toString(36).substring(7) + '" name="Options[' + index + '].IsCorrect" value="true" ' + checkedAttr + ' />' +
                                '<label class="custom-control-label small font-weight-bold text-success" for="' + 'optChk_' + index + '_' + Math.random().toString(36).substring(7) + '">Doğru</label>' +
                            '</div>' +
                            '<input type="text" class="form-control form-control-sm mr-2" name="Options[' + index + '].OptionText" value="' + (text || '') + '" placeholder="' + letter + ' şıkkı metnini giriniz..." required ' + (isTrueFalse ? 'readonly' : '') + ' />' +
                            (!isTrueFalse ? '<button type="button" class="btn btn-outline-danger btn-sm remove-option-row-btn" title="Şıkkı Kaldır"><i class="fas fa-trash"></i></button>' : '') +
                       '</div>';
            }

            // CREATE MODAL: Şık ekleme ve tür değişimleri
            var createIdx = 0;

            function initCreateOptions(type) {
                var $c = $('#createOptionsContainer');
                $c.empty();
                createIdx = 0;

                if (type === 'MultipleChoice') {
                    $('#createOptionsSection').removeClass('d-none');
                    $('#createTextNotice').addClass('d-none');
                    $('#createAddOptionBtn').removeClass('d-none');

                    // 4 varsayılan şık ekle (A, B, C, D)
                    for (var i = 0; i < 4; i++) {
                        $c.append(buildOptionRowHtml(createIdx++, '', i === 0, false));
                    }
                } else if (type === 'TrueFalse') {
                    $('#createOptionsSection').removeClass('d-none');
                    $('#createTextNotice').addClass('d-none');
                    $('#createAddOptionBtn').addClass('d-none');

                    // 2 şık: Doğru / Yanlış
                    $c.append(buildOptionRowHtml(createIdx++, 'Doğru', true, true));
                    $c.append(buildOptionRowHtml(createIdx++, 'Yanlış', false, true));
                } else if (type === 'Text') {
                    $('#createOptionsSection').addClass('d-none');
                    $('#createTextNotice').removeClass('d-none');
                }
            }

            $('#createQuestionTypeSelect').on('change', function () {
                initCreateOptions($(this).val());
            });

            // Modal açıldığında varsayılanı yükle
            $('#createQuestionModal').on('show.bs.modal', function () {
                if ($('#createOptionsContainer .option-row-item').length === 0) {
                    initCreateOptions($('#createQuestionTypeSelect').val());
                }
            });

            $('#createAddOptionBtn').on('click', function () {
                $('#createOptionsContainer').append(buildOptionRowHtml(createIdx++, '', false, false));
            });

            // Şık silme ve yeniden indeksleme
            $(document).on('click', '.remove-option-row-btn', function () {
                var $container = $(this).closest('#createOptionsContainer, #editOptionsContainer');
                $(this).closest('.option-row-item').remove();

                // Reindex
                $container.find('.option-row-item').each(function (i, el) {
                    var $el = $(el);
                    $el.attr('data-idx', i);
                    $el.find('.mr-2.font-weight-bold').text(String.fromCharCode(65 + i));
                    $el.find('input[type="checkbox"]').attr('name', 'Options[' + i + '].IsCorrect');
                    $el.find('input[type="text"]').attr('name', 'Options[' + i + '].OptionText');
                });

                if ($container.attr('id') === 'createOptionsContainer') {
                    createIdx = $('#createOptionsContainer .option-row-item').length;
                } else {
                    editIdx = $('#editOptionsContainer .option-row-item').length;
                }
            });

            // Checkbox seçildiğinde satır stili değişimi
            $(document).on('change', '.option-correct-chk', function () {
                var $item = $(this).closest('.option-row-item');
                if ($(this).is(':checked')) {
                    $item.addClass('is-correct-selected');
                } else {
                    $item.removeClass('is-correct-selected');
                }
            });

            /* ================= EDIT MODAL AJAX İŞLEMLERİ ================= */
            var editIdx = 0;

            function populateEditOptions(options, type) {
                var $c = $('#editOptionsContainer');
                $c.empty();
                editIdx = 0;

                if (type === 'Text') {
                    $('#editOptionsSection').addClass('d-none');
                    return;
                }

                $('#editOptionsSection').removeClass('d-none');
                var isTrueFalse = (type === 'TrueFalse');

                if (isTrueFalse) {
                    $('#editAddOptionBtn').addClass('d-none');
                } else {
                    $('#editAddOptionBtn').removeClass('d-none');
                }

                if (options && options.length) {
                    options.forEach(function (opt) {
                        $c.append(buildOptionRowHtml(editIdx++, opt.OptionText, opt.IsCorrect, isTrueFalse));
                    });
                } else {
                    if (isTrueFalse) {
                        $c.append(buildOptionRowHtml(editIdx++, 'Doğru', true, true));
                        $c.append(buildOptionRowHtml(editIdx++, 'Yanlış', false, true));
                    } else {
                        $c.append(buildOptionRowHtml(editIdx++, '', true, false));
                        $c.append(buildOptionRowHtml(editIdx++, '', false, false));
                    }
                }
            }

            $('#editAddOptionBtn').on('click', function () {
                $('#editOptionsContainer').append(buildOptionRowHtml(editIdx++, '', false, false));
            });

            $('#editQuestionTypeSelect').on('change', function () {
                var type = $(this).val();
                if (type === 'Text') {
                    $('#editOptionsSection').addClass('d-none');
                } else {
                    $('#editOptionsSection').removeClass('d-none');
                    if (type === 'TrueFalse') {
                        $('#editAddOptionBtn').addClass('d-none');
                    } else {
                        $('#editAddOptionBtn').removeClass('d-none');
                    }
                }
            });

            // Düzenle butonuna tıklama
            $(document).on('click', '.edit-question-btn', function () {
                var questionId = $(this).data('questionid');
                var $btn = $(this);
                $btn.prop('disabled', true);

                $.post('@Url.Action("GetQuestionDetails", "Question")',
                    {
                        questionId: questionId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    function (res) {
                        $btn.prop('disabled', false);

                        if (!res.success) {
                            alert(res.message || 'Soru bilgileri alınamadı.');
                            return;
                        }

                        var q = res.question;
                        $('#editQuestionId').val(q.QuestionId);
                        $('#editQuestionText').val(q.QuestionText);
                        $('#editQuestionTypeSelect').val(q.QuestionType);
                        $('#editPoints').val(q.Points);
                        $('#editSortOrder').val(q.SortOrder);

                        // Şıkları doldur
                        populateEditOptions(q.Options, q.QuestionType);

                        // Medyaları doldur
                        var $mediaContainer = $('#editQuestionMediaContainer');
                        $mediaContainer.empty();

                        if (q.MediaFiles && q.MediaFiles.length > 0) {
                            q.MediaFiles.forEach(function (m) {
                                var html = '<div class="media-edit-box mr-2 mb-2" data-mediaid="' + m.MediaId + '">';
                                if (m.MediaType === 1) {
                                    html += '<img src="' + m.MediaPath + '" alt="Medya" />';
                                } else if (m.MediaType === 2) {
                                    html += '<video controls><source src="' + m.MediaPath + '" type="video/mp4"></video>';
                                }
                                html += '<button type="button" class="btn btn-danger btn-sm media-delete-btn" data-mediaid="' + m.MediaId + '" title="Medyayı Sil"><i class="fas fa-trash"></i></button>';
                                html += '</div>';
                                $mediaContainer.append(html);
                            });
                        } else {
                            $mediaContainer.html('<span class="text-muted small">Yüklenmiş medya bulunmuyor.</span>');
                        }

                        $('#editQuestionModal').modal('show');
                    }
                ).fail(function () {
                    $btn.prop('disabled', false);
                    alert('Sunucu ile iletişim kurulurken bir hata oluştu.');
                });
            });

            /* ================= MEDYA SİLME (AJAX) ================= */
            $(document).on('click', '.media-delete-btn', function () {
                if (!confirm('Bu görsel veya video silinsin mi?')) return;

                var mediaId = $(this).data('mediaid');
                var $box = $(this).closest('.media-edit-box');

                $.post('@Url.Action("DeleteQuestionMedia", "Question")',
                    {
                        mediaId: mediaId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    function (res) {
                        if (res.success) {
                            $box.fadeOut(250, function () {
                                $(this).remove();
                                if ($('#editQuestionMediaContainer .media-edit-box').length === 0) {
                                    $('#editQuestionMediaContainer').html('<span class="text-muted small">Yüklenmiş medya bulunmuyor.</span>');
                                }
                            });
                        } else {
                            alert(res.message || 'Medya silinemedi.');
                        }
                    }
                ).fail(function () {
                    alert('Sunucu hatası oluştu.');
                });
            });

            /* ================= SORU SİL / PASİF / AKTİF YAP ================= */
            $(document).on('click', '.delete-question-btn', function () {
                var questionId = $(this).data('questionid');
                var isActive = $(this).data('isactive') === true || $(this).data('isactive') === 'true';

                var confirmMsg = isActive
                    ? 'Bu soruyu pasif duruma almak veya silmek istediğinizden emin misiniz?'
                    : 'Bu pasif soruyu yeniden aktif duruma getirmek istiyor musunuz?';

                if (!confirm(confirmMsg)) return;

                var $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("DeleteQuestion", "Question")',
                    type: 'POST',
                    data: {
                        questionId: questionId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    success: function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            $btn.prop('disabled', false);
                            alert(res.message || 'İşlem gerçekleştirilemedi.');
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false);
                        alert('Sunucu hatası oluştu.');
                    }
                });
            });

            /* ================= LIGHTBOX MEDYA ÖNİZLEME ================= */
            $(document).on('click', '.media-thumb-box', function () {
                var src = $(this).attr('data-src');
                var type = $(this).attr('data-type');
                var $body = $('#lightboxModalBody');

                if (type === 'image') {
                    $body.html('<img src="' + src + '" class="img-fluid rounded" style="max-height: 75vh;" alt="Önizleme" />');
                } else if (type === 'video') {
                    $body.html('<video controls autoplay style="width: 100%; max-height: 75vh;"><source src="' + src + '" type="video/mp4"></video>');
                }

                $('#mediaLightboxModal').modal('show');
            });

            $('#mediaLightboxModal').on('hidden.bs.modal', function () {
                $('#lightboxModalBody').empty();
            });

            // Dosya input etiket güncellemesi
            $('.custom-file-input').on('change', function () {
                var filesCount = $(this)[0].files.length;
                var fileName = filesCount > 1 ? filesCount + ' dosya seçildi' : $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').addClass('selected').html(fileName || 'Dosya seçin...');
            });
        });
    </script>
}
