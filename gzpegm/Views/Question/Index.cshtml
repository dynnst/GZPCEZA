    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content border-0 shadow-lg">
            <form id="editQuestionForm" method="post" action="@Url.Action("EditQuestion", "Question")" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editQuestionId" name="QuestionId" />
                <input type="hidden" name="ExamId" value="@(ViewBag.ExamId ?? Request.QueryString["examId"] ?? "0")" />

                <!-- MODAL HEADER -->
