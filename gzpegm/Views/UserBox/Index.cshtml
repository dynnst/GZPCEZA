@model gzpegm.Models.E_User
@using System
@using System.Linq
@using System.Collections.Generic

@{
    var authValues = (Model?.fldAuth ?? "")
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();

    if (!string.IsNullOrWhiteSpace(Model?.Role))
    {
        if (string.Equals(Model.Role, "Teacher", StringComparison.OrdinalIgnoreCase) && !authValues.Contains("6"))
        {
            authValues.Add("6");
        }
        else if (string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase) && !authValues.Contains("2"))
        {
            authValues.Add("2");
        }
    }

    Func<string, bool> hasAuth = code => authValues.Contains(code);
    Func<bool> canUseCoreApps = () => hasAuth("2") || hasAuth("3");
    Func<bool> canUseEducation = () => hasAuth("2") || hasAuth("3") || hasAuth("6");
    Func<bool> canManageEducation = () => hasAuth("2") || hasAuth("6");

    var displayName = ((Model?.fldName ?? "") + " " + (Model?.fldLastName ?? "")).Trim();
    var displayNameUpper = string.IsNullOrWhiteSpace(displayName) ? "KULLANICI" : displayName.ToUpper(new System.Globalization.CultureInfo("tr-TR"));
    var title = Model?.fldTitle ?? "";
    var email = Model?.fldEmail ?? "";

    string pictureUrl;
    var picture = (Model?.fldPicture ?? "").Trim();
    if (string.IsNullOrWhiteSpace(picture))
    {
        pictureUrl = Url.Content("~/files/user/no-user-image.jpg");
    }
    else if (picture.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || picture.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
    {
        pictureUrl = picture;
    }
    else
    {
        pictureUrl = Url.Content("~/files/user/" + picture.TrimStart('/', '\\'));
    }
}

