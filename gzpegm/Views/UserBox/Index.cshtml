<script>
    function openSahtecilikPortal() {
        var host = window.location.hostname || '10.7.202.138';
        var isLocal = (host === 'localhost' || host === '127.0.0.1');
        var baseUrl = isLocal ? 'https://localhost:44324' : (window.location.protocol + '//' + host + ':8080');
        var token = '@(Request.Cookies["Token"]?.Value ?? "")';
        if (!token) {
            try {
                var m = document.cookie.match(/(?:^|;\s*)Token=([^;]+)/);
                if (m) token = decodeURIComponent(m[1]);
            } catch(e) {}
        }
        var targetUrl = baseUrl + '/ReferenceDocument' + (token ? '?ssoToken=' + encodeURIComponent(token) : '');

        // Güvenlik & Denetim Logu Kaydet (Arka planda)
        try {
            $.ajax({
                url: '@Url.Action("LogGecis", "SahtecilikLog")',
                type: 'POST',
                data: {
                    kaynak: 'UserBox',
                    ulke: '',
                    hedefUrl: targetUrl,
                    detay: 'UserBox menüsünden Sahtecilik Portalı açıldı.'
                }
            });
        } catch(logErr) {}

        window.open(targetUrl, '_blank');
    }
</script>
