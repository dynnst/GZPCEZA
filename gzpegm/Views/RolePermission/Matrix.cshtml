@model gzpegm.Controllers.RolePermissionMatrixViewModel

@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Title = "Yetki Matrisi / Erişim Kontrolü";
    ViewBag.UseDataTables = true;

    Func<bool, IHtmlString> yesNo = allowed =>
        new HtmlString(allowed
            ? "<span class=\"badge badge-success\">Var</span>"
            : "<span class=\"badge badge-secondary\">Yok</span>");
}

<section class="card">
    <header class="card-header d-flex align-items-center justify-content-between flex-wrap">
        <div>
            <h2 class="card-title mb-0"><i class="fas fa-shield-alt"></i> Yetki Matrisi / Erişim Kontrolü</h2>
            <p class="card-subtitle">Controller/action bazında erişim durumu. Kaynak: <code>UserAuthorize</code> attribute kayıtları.</p>
        </div>
        <div class="text-right mt-2 mt-sm-0">
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "RolePermission")">
                <i class="fas fa-user-shield"></i> Rol Yetkilerine Dön
            </a>
            <a class="btn btn-outline-primary" href="@Url.Action("Matrix", "RolePermission")">
                <i class="fas fa-sync-alt"></i> Yenile
            </a>
        </div>
    </header>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card border h-100"><div class="card-body"><h4>@Model.Rows.Count</h4><span>Action</span><div class="small text-muted">Taranan endpoint</div></div></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card border h-100"><div class="card-body"><h4>@Model.ProtectedCount</h4><span>Korumalı</span><div class="small text-muted">Giriş/yetki isteyen</div></div></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card border h-100"><div class="card-body"><h4>@Model.OpenCount</h4><span>Açık / Korumasız</span><div class="small text-muted">Kontrol edilmesi gereken alan</div></div></div>
            </div>
        </div>

        <div class="alert alert-warning mb-0">
            <i class="fas fa-exclamation-triangle"></i>
            “Korumalı Değil” görünen endpointlerde <code>UserAuthorize</code> bulunmaz. Bunlar bilinçli public alan değilse ayrıca değerlendirilmelidir.
        </div>
    </div>
</section>

<section class="card">
    <header class="card-header">
        <h2 class="card-title"><i class="fas fa-key"></i> Yetki Kodları</h2>
    </header>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Kod</th>
                        <th>Grup</th>
                        <th>Yetki</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var permission in Model.Permissions)
                    {
                        <tr>
                            <td><span class="badge badge-dark">@permission.Code</span></td>
                            <td>@permission.Group</td>
                            <td><strong>@permission.Name</strong></td>
                            <td>@permission.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="card">
    <header class="card-header">
        <h2 class="card-title"><i class="fas fa-table"></i> Controller / Action Matrisi</h2>
    </header>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="permissionMatrixTable" class="table table-striped table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Controller</th>
                        <th>Action</th>
                        <th>HTTP</th>
                        <th>Route / URL</th>
                        <th>Koruma</th>
                        <th>Kaynak</th>
                        <th>Yetki Kodları</th>
                        <th>Admin</th>
                        <th>Teacher</th>
                        <th>Student</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Controller</td>
                            <td>@row.Action</td>
                            <td>@row.HttpMethods</td>
                            <td><code>@row.Routes</code></td>
                            <td>
                                <span class="badge @(row.Protection == "Yetki Kodlu" ? "badge-primary" : row.Protection == "Giriş Yeterli" ? "badge-info" : row.Protection == "Anonim" ? "badge-success" : "badge-warning")">
                                    @row.Protection
                                </span>
                            </td>
                            <td>@row.Source</td>
                            <td>
                                @if (row.RequiredCodes.Any())
                                {
                                    foreach (var code in row.RequiredCodes)
                                    {
                                        <span class="badge badge-dark">@code</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@yesNo(row.AdminAccess)</td>
                            <td>@yesNo(row.TeacherAccess)</td>
                            <td>@yesNo(row.StudentAccess)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            if ($.fn.DataTable) {
                $('#permissionMatrixTable').DataTable({
                    pageLength: 50,
                    order: [[0, 'asc'], [1, 'asc']],
                    language: {
                        search: 'Ara:',
                        lengthMenu: 'Sayfada _MENU_ kayıt göster',
                        info: '_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor',
                        infoEmpty: 'Kayıt yok',
                        zeroRecords: 'Eşleşen kayıt bulunamadı',
                        paginate: { next: 'Sonraki', previous: 'Önceki' }
                    }
                });
            }
        });
    </script>
}
