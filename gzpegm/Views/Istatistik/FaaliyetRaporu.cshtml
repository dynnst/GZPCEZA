@model List<gzpegm.Services.StatReportDepartmentDto>
@{
    ViewBag.Title = "Hudut Kapıları Faaliyet ve İstatistik Raporu";
    Layout = "~/Views/Shared/_Master.cshtml";

    var criteria = ViewBag.Criteria as gzpegm.Services.StatPeriodCriteria ?? new gzpegm.Services.StatPeriodCriteria();
    criteria.ResolveDatesAndHeaders();

    int activeYear = criteria.Year;
    int activeMonth = criteria.Month;
    int cumMonths = criteria.CumulativeMonths;
    string reportMode = criteria.Mode ?? "month";
    bool isRange = reportMode == "range";

    string[] monthNames = new string[] { "", "OCAK", "ŞUBAT", "MART", "NİSAN", "MAYIS", "HAZİRAN", "TEMMUZ", "AĞUSTOS", "EYLÜL", "EKİM", "KASIM", "ARALIK" };

    bool isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var borders = ViewBag.Borders as List<gzpegm.Models.E_Border> ?? new List<gzpegm.Models.E_Border>();
    var depts = ViewBag.Departments as List<gzpegm.Services.StatDepartmentDto> ?? new List<gzpegm.Services.StatDepartmentDto>();
    int selectedBorderId = (int)(ViewBag.SelectedBorderId ?? 14);
    int? selectedDeptId = ViewBag.SelectedDepartmentId as int?;
    string borderName = ViewBag.BorderName as string ?? "HUDUT KAPISI";
    string valilikName = ViewBag.ValilikName as string ?? "T.C. VALİLİĞİ";

    string printUrl = Url.Action("PrintFaaliyetRaporu", "Istatistik", new
    {
        borderId = selectedBorderId,
        departmentId = selectedDeptId,
        mode = criteria.Mode,
        year = criteria.Year,
        compareYear = criteria.CompareYear,
        month = criteria.Month,
        cumMonths = criteria.CumulativeMonths,
        startDate = criteria.StartDate.HasValue ? criteria.StartDate.Value.ToString("yyyy-MM-dd") : criteria.P1CurrStart.ToString("yyyy-MM-dd"),
        endDate = criteria.EndDate.HasValue ? criteria.EndDate.Value.ToString("yyyy-MM-dd") : criteria.P1CurrEnd.ToString("yyyy-MM-dd"),
        compStartDate = criteria.CompareStartDate.HasValue ? criteria.CompareStartDate.Value.ToString("yyyy-MM-dd") : criteria.P1PrevStart.ToString("yyyy-MM-dd"),
        compEndDate = criteria.CompareEndDate.HasValue ? criteria.CompareEndDate.Value.ToString("yyyy-MM-dd") : criteria.P1PrevEnd.ToString("yyyy-MM-dd")
    });
}

<style>
    .official-report-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        margin-bottom: 25px;
        overflow: hidden;
    }
    .official-table thead tr.header-grp th {
        background: #0f172a;
        color: #ffffff;
        text-align: center;
        vertical-align: middle;
        font-weight: 800;
        font-size: 0.90rem;
        letter-spacing: 0.5px;
        border: 1px solid #334155;
        padding: 8px;
    }
    .official-table thead tr.header-sub th {
        background: #1e293b;
        color: #e2e8f0;
        text-align: center;
        vertical-align: middle;
        font-weight: 700;
        font-size: 0.82rem;
        border: 1px solid #334155;
        padding: 8px 6px;
    }
    .official-table tbody td {
        vertical-align: middle;
        font-size: 0.88rem;
        border: 1px solid #cbd5e1;
        padding: 8px 10px;
    }
    .official-table tbody tr:hover {
        background-color: #f1f5f9;
    }
    .official-badge-hizmete-ozel {
        display: inline-block;
        padding: 4px 14px;
        background: #fee2e2;
        color: #991b1b;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 2px;
        border-radius: 4px;
        border: 1px dashed #ef4444;
    }
    .dept-title-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 1px;
        border-bottom: 3px solid #f59e0b;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .trend-indicator-pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.80rem;
        font-weight: 700;
    }
    .trend-up {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
    }
    .trend-down {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }
    .trend-equal {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }
    .kpi-mini-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 12px;
        display: inline-flex;
        align-items: center;
        margin-left: 8px;
        font-size: 0.82rem;
        font-weight: 700;
    }
    .mode-nav-tabs {
        display: inline-flex;
        background: #f1f5f9;
        padding: 4px;
        border-radius: 30px;
        border: 1px solid #cbd5e1;
    }
    .mode-tab-btn {
        border: none;
        background: transparent;
        color: #475569;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 7px 18px;
        border-radius: 25px;
        transition: all 0.2s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }
    .mode-tab-btn:hover {
        color: #0f172a;
    }
    .mode-tab-btn.active {
        background: #0f172a;
        color: #ffffff !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.25);
    }
    .filter-section-title {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        margin-bottom: 6px;
    }
    .filter-control-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 14px;
        height: 100%;
    }
</style>

<div class="row">
    <div class="col-12">
        <!-- Üst Başlık & Hızlı İşlem Araç Çubuğu -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-3">
            <div class="mb-2 mb-lg-0">
                <h3 class="font-weight-bold text-dark mb-1">
                    <i class="fas fa-chart-line text-primary mr-2"></i> Hudut Kapıları Faaliyet ve İstatistik Raporu
                </h3>
                <p class="text-muted mb-0">Özelleştirilebilir kümülatif dönemler (1, 3, 8 aylık vb.) ve serbest gün aralıkları (örn: 20 günlük) ile resmi brifing kıyaslaması</p>
            </div>
            <div class="d-flex flex-wrap align-items-center">
                <a href="@printUrl" target="_blank" class="btn btn-dark font-weight-bold shadow-sm px-3 py-2 mr-2 mb-1">
                    <i class="fas fa-print mr-1 text-warning"></i> Resmi Yazdır / PDF
                </a>
                <a href="@Url.Action("VeriGiris", "Istatistik", new { borderId = selectedBorderId })" class="btn btn-primary font-weight-bold shadow-sm px-3 py-2 mr-2 mb-1">
                    <i class="fas fa-edit mr-1"></i> Günlük Sayı Girişi
                </a>
                @if (isAdmin)
                {
                    <a href="@Url.Action("Yonetim", "Istatistik", new { borderId = selectedBorderId })" class="btn btn-warning font-weight-bold shadow-sm px-3 py-2 mb-1">
                        <i class="fas fa-users-cog mr-1"></i> Personel Yetki &amp; Büro Yönetimi
                    </a>
                }
            </div>
        </div>

        <!-- Filtre ve Dönem Belirleme Paneli (Ferah, Geniş ve Düzenli Grid) -->
        <div class="card mb-4 border-0 shadow-sm" style="border-radius:10px; overflow:hidden;">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center border-bottom">
                <div class="mode-nav-tabs my-1">
                    <button type="button" class="mode-tab-btn @(!isRange ? "active" : "")" id="btnModeMonth" onclick="switchMode('month')">
                        <i class="fas fa-calendar-alt mr-2 text-primary"></i> Ay &amp; Kümülatif Dönem (1, 3, 8 Aylık vb.)
                    </button>
                    <button type="button" class="mode-tab-btn @(isRange ? "active" : "") ml-1" id="btnModeRange" onclick="switchMode('range')">
                        <i class="fas fa-calendar-day mr-2 text-success"></i> Özel Gün / Tarih Aralığı (Örn: 20 Günlük)
                    </button>
                </div>
                <div class="my-1">
                    <span class="badge badge-primary px-3 py-2 font-weight-bold" style="font-size:0.85rem;">
                        <i class="fas fa-info-circle mr-1"></i> @(isRange ? criteria.P1GroupHeader : $"{criteria.P1GroupHeader} & {criteria.P2GroupHeader}")
                    </span>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <form method="get" action="@Url.Action("FaaliyetRaporu", "Istatistik")" id="statFilterForm">
                    <input type="hidden" name="mode" id="inputMode" value="@reportMode" />

                    <!-- 1. BÖLÜM: KAPSAM & YERLEŞİM (2 Ferah Sütun) -->
                    <div class="row mb-3">
                        @if (isAdmin)
                        {
                            <div class="col-12 col-md-6 mb-2 mb-md-0">
                                <label class="font-weight-bold text-dark text-xs mb-1">
                                    <i class="fas fa-university text-primary mr-1"></i> Hudut Kapısı:
                                </label>
                                <select name="borderId" class="form-control select2">
                                    @foreach (var b in borders)
                                    {
                                        <option value="@b.fldId" @(b.fldId == selectedBorderId ? "selected" : "")>@b.fldName</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="borderId" value="@selectedBorderId" />
                            <div class="col-12 col-md-6 mb-2 mb-md-0">
                                <label class="font-weight-bold text-dark text-xs mb-1">
                                    <i class="fas fa-university text-primary mr-1"></i> Hudut Kapısı:
                                </label>
                                <input type="text" class="form-control font-weight-bold bg-light" value="@borderName" readonly />
                            </div>
                        }

                        <div class="col-12 col-md-6">
                            <label class="font-weight-bold text-dark text-xs mb-1">
                                <i class="fas fa-layer-group text-info mr-1"></i> Büro / Birim Filtresi:
                            </label>
                            <select name="departmentId" class="form-control select2">
                                <option value="">-- Tüm Bürolar (Genel Brifing) --</option>
                                @foreach (var d in depts)
                                {
                                    <option value="@d.DepartmentId" @(d.DepartmentId == selectedDeptId ? "selected" : "")>@d.DepartmentName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- 2. BÖLÜM: DÖNEM VE KIYASLAMA SEÇİCİSİ -->
                    <!-- MOD 1: AY VE KÜMÜLATİF DÖNEM (4 Eşit, Ferah Sütun) -->
                    <div id="panelMonthMode" style="@(isRange ? "display:none;" : "")" class="mb-3">
                        <div class="filter-section-title">
                            <i class="fas fa-sliders-h mr-1 text-primary"></i> Dönem ve Kıyaslama Parametreleri
                        </div>
                        <div class="row">
                            <div class="col-6 col-md-3 mb-2 mb-md-0">
                                <div class="filter-control-card">
                                    <label class="font-weight-bold text-dark text-xs mb-1">Cari Yıl:</label>
                                    <select name="year" id="selectYear" class="form-control form-control-sm font-weight-bold">
                                        @for (int y = DateTime.Now.Year; y >= 2010; y--)
                                        {
                                            <option value="@y" @(y == activeYear ? "selected" : "")>@y</option>
                                        }
                                    </select>
                                    <small class="text-muted d-block mt-1">Rapor yılı</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0">
                                <div class="filter-control-card" style="border-left: 3px solid #ef4444;">
                                    <label class="font-weight-bold text-danger text-xs mb-1">
                                        <i class="fas fa-history mr-1"></i> Kıyas Yılı:
                                    </label>
                                    <select name="compareYear" id="selectCompareYear" class="form-control form-control-sm font-weight-bold border-danger">
                                        @{
                                            int selectedCompYear = criteria.CompareYear.HasValue && criteria.CompareYear.Value >= 2000 
                                                ? criteria.CompareYear.Value 
                                                : activeYear - 1;
                                        }
                                        @for (int y = DateTime.Now.Year; y >= 2010; y--)
                                        {
                                            <option value="@y" @(y == selectedCompYear ? "selected" : "")>@y</option>
                                        }
                                    </select>
                                    <small class="text-danger d-block mt-1">Karşılaştırılacak yıl</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 mb-2 mb-md-0">
                                <div class="filter-control-card">
                                    <label class="font-weight-bold text-dark text-xs mb-1">
                                        <i class="fas fa-calendar-alt text-primary mr-1"></i> Ay:
                                    </label>
                                    <select name="month" class="form-control form-control-sm font-weight-bold">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            <option value="@m" @(m == activeMonth ? "selected" : "")>@monthNames[m]</option>
                                        }
                                    </select>
                                    <small class="text-muted d-block mt-1">1. Dönem ayı</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="filter-control-card" style="border-left: 3px solid #2563eb;">
                                    <label class="font-weight-bold text-primary text-xs mb-1">
                                        <i class="fas fa-chart-pie mr-1"></i> Kümülatif:
                                    </label>
                                    <select name="cumMonths" class="form-control form-control-sm font-weight-bold border-primary">
                                        <option value="0" @(cumMonths == 0 ? "selected" : "")>Otomatik (1-@activeMonth. Ay)</option>
                                        <option value="1" @(cumMonths == 1 ? "selected" : "")>1 Aylık (Ocak)</option>
                                        <option value="2" @(cumMonths == 2 ? "selected" : "")>2 Aylık</option>
                                        <option value="3" @(cumMonths == 3 ? "selected" : "")>3 Aylık (1. Çeyrek)</option>
                                        <option value="4" @(cumMonths == 4 ? "selected" : "")>4 Aylık</option>
                                        <option value="5" @(cumMonths == 5 ? "selected" : "")>5 Aylık</option>
                                        <option value="6" @(cumMonths == 6 ? "selected" : "")>6 Aylık (Yarıyıl)</option>
                                        <option value="7" @(cumMonths == 7 ? "selected" : "")>7 Aylık</option>
                                        <option value="8" @(cumMonths == 8 ? "selected" : "")>8 Aylık (1-8. Ay)</option>
                                        <option value="9" @(cumMonths == 9 ? "selected" : "")>9 Aylık</option>
                                        <option value="10" @(cumMonths == 10 ? "selected" : "")>10 Aylık</option>
                                        <option value="11" @(cumMonths == 11 ? "selected" : "")>11 Aylık</option>
                                        <option value="12" @(cumMonths == 12 ? "selected" : "")>12 Aylık (Tüm Yıl)</option>
                                    </select>
                                    <small class="text-primary d-block mt-1">2. Kümülatif aralık</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MOD 2: SERBEST GÜN / TARİH ARALIĞI SEÇİCİSİ -->
                    <div id="panelRangeMode" style="@(!isRange ? "display:none;" : "")" class="mb-3">
                        <div class="filter-section-title">
                            <i class="fas fa-calendar-day mr-1 text-success"></i> Serbest Gün &amp; Özel Tarih Aralığı
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6 mb-2 mb-md-0">
                                <div class="filter-control-card">
                                    <div class="row">
                                        <div class="col-6">
                                            <label class="font-weight-bold text-dark text-xs mb-1">Cari Başlangıç:</label>
                                            <input type="date" name="startDate" id="startDate" class="form-control form-control-sm font-weight-bold"
                                                   value="@(criteria.StartDate.HasValue ? criteria.StartDate.Value.ToString("yyyy-MM-dd") : criteria.P1CurrStart.ToString("yyyy-MM-dd"))" onchange="calculateDaySpan();" />
                                        </div>
                                        <div class="col-6">
                                            <label class="font-weight-bold text-dark text-xs mb-1">Cari Bitiş:</label>
                                            <input type="date" name="endDate" id="endDate" class="form-control form-control-sm font-weight-bold"
                                                   value="@(criteria.EndDate.HasValue ? criteria.EndDate.Value.ToString("yyyy-MM-dd") : criteria.P1CurrEnd.ToString("yyyy-MM-dd"))" onchange="calculateDaySpan();" />
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-2">Örn: 20 günlük serbest dönem</small>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="filter-control-card bg-light" style="border-left: 3px solid #10b981;">
                                    <label class="font-weight-bold text-success text-xs mb-1">
                                        <i class="fas fa-sync-alt mr-1"></i> Geçen Yıl Eşleşen Karşılık Dönemi:
                                    </label>
                                    <div class="text-dark font-weight-bold" id="rangeMatchedPreview">
                                        @criteria.P1PrevStart.ToString("dd.MM.yyyy") - @criteria.P1PrevEnd.ToString("dd.MM.yyyy")
                                    </div>
                                    <small class="text-success d-block mt-1">Geçen yılın aynı gün aralığı ile birebir otomatik eşleştirilir.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. BÖLÜM: EYLEM & BİLGİLENDİRME ÇUBUĞU -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pt-3 border-top">
                        <div class="mb-2 mb-md-0" id="rangeHintBadge">
                            @if (isRange)
                            {
                                int days = (criteria.P1CurrEnd - criteria.P1CurrStart).Days + 1;
                                <span class="badge badge-success px-3 py-2 font-weight-bold" style="font-size:0.85rem;">
                                    <i class="fas fa-check-circle mr-1"></i> @days Günlük Dönem Seçili
                                </span>
                                <span class="ml-2 text-muted text-xs">
                                    Geçen yıl karşılığı: <strong>@criteria.P1PrevStart.ToString("dd.MM.yyyy") - @criteria.P1PrevEnd.ToString("dd.MM.yyyy")</strong>
                                </span>
                            }
                            else
                            {
                                int cM = cumMonths > 0 ? cumMonths : activeMonth;
                                int cY = criteria.CompareYear.HasValue && criteria.CompareYear.Value >= 2000 ? criteria.CompareYear.Value : activeYear - 1;
                                <span class="badge badge-info px-3 py-2 font-weight-bold" style="font-size:0.85rem;">
                                    <i class="fas fa-info-circle mr-1"></i> @activeYear ile @cY Yılı Kıyaslaması (@monthNames[activeMonth] Ayı &amp; @cM Aylık Kümülatif)
                                </span>
                            }
                        </div>
                        <button type="submit" class="btn btn-success font-weight-bold px-4 py-2 shadow-sm">
                            <i class="fas fa-filter mr-2"></i> Raporu ve Kıyaslamayı Getir
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Resmi Belge Başlığı -->
        <div class="text-center my-3">
            <span class="official-badge-hizmete-ozel mb-2">HİZMETE ÖZEL</span>
            <h5 class="text-uppercase font-weight-bold text-dark mb-0" style="letter-spacing:1px;">T.C.</h5>
            <h4 class="text-uppercase font-weight-bold text-dark mb-0">@valilikName</h4>
            <h6 class="text-uppercase font-weight-bold text-muted mb-1">İL EMNİYET MÜDÜRLÜĞÜ</h6>
            <h5 class="text-uppercase font-weight-bold text-primary mb-3">@borderName</h5>
        </div>

        <!-- Rapor Tabloları -->
        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info text-center py-4 font-weight-bold">
                <i class="fas fa-info-circle mr-2"></i> Seçilen kriterlere ait büro veya tablo kaydı bulunamadı.
            </div>
        }
        else
        {
            foreach (var dept in Model)
            {
                <div class="official-report-card">
                    <div class="dept-title-banner">
                        <div>
                            <i class="fas fa-university text-warning mr-2"></i> @dept.DepartmentName
                        </div>
                        <span class="badge badge-warning text-dark font-weight-bold px-3 py-1" style="font-size:0.85rem;">
                            @criteria.P1GroupHeader &amp; @criteria.P2GroupHeader
                        </span>
                    </div>

                    <div class="card-body p-3">
                        @foreach (var tbl in dept.Tables)
                        {
                            <div class="table-responsive mb-4">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-2 pb-1 border-bottom">
                                    <h6 class="font-weight-bold text-dark mb-1 mb-md-0" style="letter-spacing:0.5px; font-size:1rem;">
                                        <i class="fas fa-table text-primary mr-1"></i> @activeYear YILI İTİBARİYLE @tbl.TableTitle
                                    </h6>
                                    <span class="badge badge-light border text-muted px-2 py-1 font-weight-normal">
                                        <i class="fas fa-list-ol mr-1 text-primary"></i> @tbl.Rows.Count Kalem Gösterge
                                    </span>
                                </div>

                                <table class="table table-bordered official-table mb-0">
                                    <thead>
                                        <tr class="header-grp">
                                            <th rowspan="2" class="text-left" style="width: 28%; vertical-align:middle;">YAPILAN İŞLEM / GÖSTERGE</th>
                                            <th colspan="3" style="width: 36%;">@criteria.P1GroupHeader</th>
                                            <th colspan="3" style="width: 36%;">@criteria.P2GroupHeader</th>
                                        </tr>
                                        <tr class="header-sub">
                                            <!-- 1. Dönem -->
                                            <th style="width: 11%;">@criteria.P1PrevTitle</th>
                                            <th style="width: 11%; background:#1e3a8a;">@criteria.P1CurrTitle</th>
                                            <th style="width: 14%; background:#0f172a;">DEĞİŞİM (FARK &amp; %)</th>
                                            <!-- 2. Kümülatif Dönem -->
                                            <th style="width: 11%;">@criteria.P2PrevTitle</th>
                                            <th style="width: 11%; background:#1e40af;">@criteria.P2CurrTitle</th>
                                            <th style="width: 14%; background:#0f172a;">DÖNEMLİK DEĞİŞİM (FARK &amp; %)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in tbl.Rows)
                                        {
                                            string rowMonthClass = row.MonthDiff > 0 ? "trend-up" : (row.MonthDiff < 0 ? "trend-down" : "trend-equal");
                                            string rowMonthIcon = row.MonthDiff > 0 ? "fa-arrow-up" : (row.MonthDiff < 0 ? "fa-arrow-down" : "fa-minus");
                                            string rowMonthSign = row.MonthDiff > 0 ? "+" : "";

                                            string rowYtdClass = row.YtdDiff > 0 ? "trend-up" : (row.YtdDiff < 0 ? "trend-down" : "trend-equal");
                                            string rowYtdIcon = row.YtdDiff > 0 ? "fa-arrow-up" : (row.YtdDiff < 0 ? "fa-arrow-down" : "fa-minus");
                                            string rowYtdSign = row.YtdDiff > 0 ? "+" : "";

                                            <tr>
                                                <td class="font-weight-bold text-dark text-left">
                                                    @row.RowTitle
                                                    @if (!string.IsNullOrEmpty(row.Unit) && row.Unit != "Adet")
                                                    {
                                                        <span class="badge badge-light text-muted border ml-1 font-weight-normal">@row.Unit</span>
                                                    }
                                                </td>

                                                <!-- 1. Dönem Sütunları -->
                                                <td class="text-center font-weight-bold text-secondary">
                                                    @row.MonthPrevYear.ToString("N0")
                                                </td>
                                                <td class="text-center font-weight-bold text-primary" style="background:#eff6ff;">
                                                    @row.MonthCurrYear.ToString("N0")
                                                </td>
                                                <td class="text-center">
                                                    <span class="trend-indicator-pill @rowMonthClass">
                                                        <i class="fas @rowMonthIcon mr-1"></i>
                                                        @rowMonthSign@row.MonthDiff.ToString("N0")
                                                        <span class="ml-1">(@rowMonthSign@row.MonthChangePercent.ToString("F1")%)</span>
                                                    </span>
                                                </td>

                                                <!-- 2. Kümülatif Dönem Sütunları -->
                                                <td class="text-center font-weight-bold text-secondary">
                                                    @row.YtdPrevYear.ToString("N0")
                                                </td>
                                                <td class="text-center font-weight-bold text-primary" style="background:#eff6ff;">
                                                    @row.YtdCurrYear.ToString("N0")
                                                </td>
                                                <td class="text-center">
                                                    <span class="trend-indicator-pill @rowYtdClass">
                                                        <i class="fas @rowYtdIcon mr-1"></i>
                                                        @rowYtdSign@row.YtdDiff.ToString("N0")
                                                        <span class="ml-1">(@rowYtdSign@row.YtdChangePercent.ToString("F1")%)</span>
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <!-- Belge Altı Gizlilik Notu -->
        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 text-muted text-xs border-top">
            <span class="font-weight-bold">HİZMETE ÖZEL</span>
            <span>Rapor Üretim Tarihi: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
            <span class="font-weight-bold">HİZMETE ÖZEL</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchMode(m) {
            $('#inputMode').val(m);
            if (m === 'range') {
                $('#btnModeRange').addClass('active');
                $('#btnModeMonth').removeClass('active');
                $('#panelRangeMode').show();
                $('#panelMonthMode').hide();
                calculateDaySpan();
            } else {
                $('#btnModeMonth').addClass('active');
                $('#btnModeRange').removeClass('active');
                $('#panelMonthMode').show();
                $('#panelRangeMode').hide();
                $('#rangeHintBadge').html('<span class="badge badge-info px-2 py-1"><i class="fas fa-info-circle mr-1"></i> Ay ve Kümülatif Modu</span>');
            }
        }

        function calculateDaySpan() {
            var s = $('#startDate').val();
            var e = $('#endDate').val();
            if (s && e) {
                var d1 = new Date(s);
                var d2 = new Date(e);
                var diffTime = d2.getTime() - d1.getTime();
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                if (diffDays > 0) {
                    $('#rangeHintBadge').html('<span class="badge badge-success px-2 py-1"><i class="fas fa-calendar-check mr-1"></i> ' + diffDays + ' Günlük Dönem Seçildi</span> <span class="ml-2 text-muted">Geçen yıl aynı aralıkla kıyaslanacaktır.</span>');
                } else {
                    $('#rangeHintBadge').html('<span class="badge badge-danger px-2 py-1">Bitiş tarihi başlangıçtan küçük olamaz</span>');
                }
            }
        }
    </script>
}
