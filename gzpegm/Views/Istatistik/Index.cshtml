@section Scripts {
    <!-- INSPINIA kaynak şablonundaki Chart.js ve html2canvas yolları -->
    <script src="@Url.Content("~/AdminTemplate/js/plugins/chartJs/Chart.min.js")?v=2.8"></script>
    <script src="@Url.Content("~/AdminTemplate/js/plugins/html2canvas/html2canvas.min.js")"></script>

    <!-- İstatistik ve Brifing JavaScript Dosyaları -->
    <script src="@Url.Content("~/js/istatistik-index.js")?v=3.2"></script>
    <script src="@Url.Content("~/js/ceza-grafik.js")?v=1.2"></script>

    <script>
        $(document).ready(function () {
            // URL hash veya parametre kontrolü: #tab-brifing veya ?tab=grafik
            if (window.location.hash === '#tab-brifing' ||
                window.location.search.indexOf('tab=grafik') !== -1 ||
                window.location.search.indexOf('tab=brifing') !== -1) {
                $('#tab-brifing-btn').tab('show');
            }

            // Sekme değişiminde Chart.js canvas boyutlarını yenile
            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).attr('href');
                window.dispatchEvent(new Event('resize'));
                if (target === '#tab-brifing') {
                    if (window.location.hash !== '#tab-brifing') {
                        history.replaceState(null, null, '#tab-brifing');
                    }
                } else if (target === '#tab-ozet') {
                    if (window.location.hash === '#tab-brifing') {
                        history.replaceState(null, null, '#tab-ozet');
                    }
                }
            });
        });
    </script>
}
