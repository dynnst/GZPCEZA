@section Scripts {
    <script src="@Url.Content("~/vendor/chart.js/Chart.bundle.min.js")"></script>
    <script>
        $(document).ready(function () {
            // Tab Switcher
            $('.brifing-tab-btn').on('click', function () {
                var targetTab = $(this).data('tab');
                $('.brifing-tab-btn').removeClass('active');
                $(this).addClass('active');

                $('.tab-pane').removeClass('active');
                $('#' + targetTab).addClass('active');
            });

            // Presentation Mode Toggle
            $('#btnTogglePresentation').on('click', function () {
                $('body').toggleClass('presentation-mode');
                var isPres = $('body').hasClass('presentation-mode');
                $('#presModeText').text(isPres ? 'Normal Mod' : 'Sunum Modu');
                $(this).find('i').toggleClass('fa-desktop fa-compress');
            });

            // 1. Chart: Yolcu Karşılaştırma
            var ctxYolcu = document.getElementById('chartYolcu');
            if (ctxYolcu) {
                new Chart(ctxYolcu, {
                    type: 'bar',
                    data: {
                        labels: ['İç Hatlar Yolcu', 'Dış Hatlar Yolcu', 'Toplam Yolcu'],
                        datasets: [
                            {
                                label: '2025 (9 Aylık)',
                                backgroundColor: '#94a3b8',
                                data: [335225, 471639, 806864]
                            },
                            {
                                label: '2026 (9 Aylık)',
                                backgroundColor: '#2563eb',
                                data: [316892, 416741, 733633]
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'top' },
                        scales: {
                            yAxes: [{
                                ticks: {
                                    callback: function (val) { return val.toLocaleString('tr-TR'); }
                                }
                            }]
                        }
                    }
                });
            }

            // 2. Chart: Uçak Karşılaştırma
            var ctxUcak = document.getElementById('chartUcak');
            if (ctxUcak) {
                new Chart(ctxUcak, {
                    type: 'bar',
                    data: {
                        labels: ['İç Hatlar Uçak', 'Dış Hatlar Uçak', 'Toplam Uçak'],
                        datasets: [
                            {
                                label: '2025 (9 Aylık)',
                                backgroundColor: '#cbd5e1',
                                data: [2302, 2861, 5163]
                            },
                            {
                                label: '2026 (9 Aylık)',
                                backgroundColor: '#4f46e5',
                                data: [2082, 2573, 4655]
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'top' },
                        scales: {
                            yAxes: [{
                                ticks: {
                                    callback: function (val) { return val.toLocaleString('tr-TR'); }
                                }
                            }]
                        }
                    }
                });
            }

            // 3. Chart: Ülke Doughnut
            var ctxUlke = document.getElementById('chartUlkeDoughnut');
            if (ctxUlke) {
                new Chart(ctxUlke, {
                    type: 'doughnut',
                    data: {
                        labels: ['Rusya (%27.7)', 'Danimarka (%20.5)', 'Finlandiya (%12.3)', 'Norveç (%11.3)', 'İsveç (%6.3)', 'Kazakistan (%5.9)', 'Hollanda (%4.2)', 'İran (%3.3)', 'Almanya (%2.7)', 'Diğer (%5.8)'],
                        datasets: [{
                            data: [115258, 85415, 51315, 47229, 26311, 24513, 17397, 13699, 11159, 24445],
                            backgroundColor: [
                                '#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6',
                                '#06b6d4', '#ec4899', '#f97316', '#64748b', '#94a3b8'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'right' }
                    }
                });
            }

            // 4. Chart: INAD Trend
            var ctxInad = document.getElementById('chartInadTrend');
            if (ctxInad) {
                new Chart(ctxInad, {
                    type: 'line',
                    data: {
                        labels: ['2013', '2014', '2015', '2016', '2017', '2018', '2019', '2020', '2021', '2022', '2023', '2024', '2025', '2026'],
                        datasets: [{
                            label: 'INAD Vaka Sayısı',
                            data: [21, 18, 69, 23, 29, 30, 36, 11, 39, 14, 34, 75, 63, 37],
                            borderColor: '#dc2626',
                            backgroundColor: 'rgba(220, 38, 38, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { display: false }
                    }
                });
            }

            // 5. Chart: INAD Nedenleri
            var ctxInadGerekce = document.getElementById('chartInadGerekceler');
            if (ctxInadGerekce) {
                new Chart(ctxInadGerekce, {
                    type: 'pie',
                    data: {
                        labels: ['Giriş Yasağı (143)', 'Vize Yok (139)', 'Pasaport Süresi (51)', 'Belge Yok (48)', '180/90 Gün (37)', 'Sahte Pasaport (35)', 'Diğer (46)'],
                        datasets: [{
                            data: [143, 139, 51, 48, 37, 35, 46],
                            backgroundColor: ['#dc2626', '#ea580c', '#f59e0b', '#2563eb', '#7c3aed', '#059669', '#94a3b8']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'bottom' }
                    }
                });
            }

            // 6. Chart: YTS Sorguları
            var ctxYts = document.getElementById('chartYts');
            if (ctxYts) {
                new Chart(ctxYts, {
                    type: 'line',
                    data: {
                        labels: ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'],
                        datasets: [
                            {
                                label: '2024 YTS (1.505)',
                                borderColor: '#94a3b8',
                                data: [185, 128, 161, 159, 183, 157, 158, 85, 80, 107, 41, 61],
                                fill: false,
                                borderWidth: 2
                            },
                            {
                                label: '2025 YTS (1.961)',
                                borderColor: '#0284c7',
                                data: [192, 142, 174, 204, 240, 194, 200, 170, 129, 131, 92, 93],
                                fill: false,
                                borderWidth: 2
                            },
                            {
                                label: '2026 YTS (1.253)',
                                borderColor: '#f59e0b',
                                data: [202, 115, 166, 166, 141, 138, 116, 105, 104, null, null, null],
                                fill: false,
                                borderWidth: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'top' }
                    }
                });
            }
        });
    </script>
}
