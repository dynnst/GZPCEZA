@model gzpegm.Models.AdminBriefingViewModel
@{
    ViewBag.Title = "Yönetici Operasyonel Brifing Merkezi";
    Layout = "~/Views/Shared/_Master.cshtml";
    var currentUser = ViewBag.CurrentUser as gzpegm.Models.E_User;
}

<style>
    .briefing-hero {
        background: linear-gradient(135deg, #091e3a 0%, #173865 50%, #1e40af 100%);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 14px;
        margin-bottom: 24px;
        box-shadow: 0 10px 30px -5px rgba(9, 30, 58, 0.4);
        position: relative;
        overflow: hidden;
    }
    .briefing-hero-watermark {
        position: absolute;
        right: 15px;
        bottom: -25px;
        font-size: 160px;
        color: rgba(255, 255, 255, 0.04);
        pointer-events: none;
    }
    .briefing-badge-sec {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* Zaman Dilimi Seçici */
    .period-bar {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 24px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .period-btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .period-btn {
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 600;
        padding: 7px 14px;
        transition: all 0.2s ease;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .period-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
    }
    .period-btn.active {
        background: #1e40af;
        border-color: #1e40af;
        color: #ffffff;
        box-shadow: 0 3px 8px rgba(30, 64, 175, 0.3);
    }

    /* KPI Kartları */
    .kpi-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(0,0,0,0.08);
    }
    .kpi-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
    }
    .kpi-card.blue::before { background: #2563eb; }
    .kpi-card.purple::before { background: #8b5cf6; }
    .kpi-card.emerald::before { background: #10b981; }
    .kpi-card.rose::before { background: #f43f5e; }
    .kpi-card.amber::before { background: #f59e0b; }
    .kpi-card.cyan::before { background: #06b6d4; }
    .kpi-card.indigo::before { background: #6366f1; }
    .kpi-card.orange::before { background: #f97316; }

    .kpi-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .kpi-card.blue .kpi-icon-wrap { background: #eff6ff; color: #2563eb; }
    .kpi-card.purple .kpi-icon-wrap { background: #f5f3ff; color: #8b5cf6; }
    .kpi-card.emerald .kpi-icon-wrap { background: #ecfdf5; color: #10b981; }
    .kpi-card.rose .kpi-icon-wrap { background: #fff1f2; color: #f43f5e; }
    .kpi-card.amber .kpi-icon-wrap { background: #fffbeb; color: #f59e0b; }
    .kpi-card.cyan .kpi-icon-wrap { background: #ecfeff; color: #0891b2; }
    .kpi-card.indigo .kpi-icon-wrap { background: #eef2ff; color: #6366f1; }
    .kpi-card.orange .kpi-icon-wrap { background: #fff7ed; color: #f97316; }

    .kpi-title {
        font-size: 12.5px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }
    .kpi-value {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.1;
    }
    .kpi-subtext {
        font-size: 12px;
        color: #64748b;
        margin-top: 5px;
    }

    /* Detay Kartları ve Tablolar */
    .detail-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        overflow: hidden;
    }
    .detail-card-header {
        padding: 16px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .detail-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .custom-table {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
    }
    .custom-table th {
        background: #f1f5f9;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 10px 14px;
        border-bottom: 1px solid #cbd5e1;
    }
    .custom-table td {
        padding: 10px 14px;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .custom-table tr:hover td {
        background: #f8fafc;
    }

    .pulse-btn {
        animation: subtle-pulse 2s infinite;
    }
    @@keyframes subtle-pulse {
        0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4); }
        70% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
    }
</style>

<div class="container-fluid" style="padding-top: 15px; padding-bottom: 40px;">

    <!-- ========================================================================= -->
    <!-- 1. HERO BAŞLIK VE AKSİYON ALANI -->
    <!-- ========================================================================= -->
    <div class="briefing-hero">
        <i class="fa fa-chart-line briefing-hero-watermark"></i>
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="briefing-badge-sec"><i class="fa fa-shield-alt"></i> YÖNETİCİ KONTROL ODASI</span>
                    <span class="badge badge-light" style="font-size: 11px;"><i class="fa fa-lock"></i> SADECE ADMİN</span>
                    <span class="badge badge-primary" style="font-size: 11px;"><i class="fa fa-bolt"></i> CANLI VERİ</span>
                </div>
                <h2 style="font-size: 24px; font-weight: 800; margin: 0 0 8px 0; color: #ffffff;">
                    YÖNETİCİ OPERASYONEL BRİFİNG MERKEZİ
                </h2>
                <p style="margin: 0; font-size: 13.5px; color: #cbd5e1; max-width: 800px; line-height: 1.5;">
                    Seçilen zaman diliminde sistem genelinde kullanıcılar tarafından gerçekleştirilen tüm ceza hesaplamaları, form ve tahdit tanzimleri, şartlı girişler (V-84), inad yolcular, kurs/sınav hareketleri ve sahtecilik incelemelerinin anlık operasyonel özeti.
                </p>
                <div class="mt-3 text-white-50" style="font-size: 12px;">
                    <i class="fa fa-clock"></i> <strong>Rapor Kapsamı:</strong> <span class="text-white font-weight-bold">@Model.PeriodLabel</span>
                    &nbsp;|&nbsp;
                    <i class="fa fa-user-shield"></i> <strong>Yetkili:</strong> <span class="text-white">@Model.GeneratedByName (@Model.GeneratedBySicil)</span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-right mt-3 mt-lg-0">
                <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-2">
                    <!-- Brifing Ver / Yenile Butonu -->
                    <a href="@Url.Action("Index", "AdminBriefing", new { period = Model.SelectedPeriod, startDate = Request.QueryString["startDate"], endDate = Request.QueryString["endDate"] })"
                       class="btn btn-warning font-weight-bold pulse-btn text-dark shadow-sm" style="border-radius: 8px; padding: 10px 18px;">
                        <i class="fa fa-sync-alt"></i> Brifing Ver (Yenile)
                    </a>

                    <!-- PDF Raporu İndir Butonu -->
                    <a href="@Url.Action("ExportPdf", "AdminBriefing", new { period = Model.SelectedPeriod, startDate = Request.QueryString["startDate"], endDate = Request.QueryString["endDate"] })"
                       class="btn btn-danger font-weight-bold shadow-sm" style="border-radius: 8px; padding: 10px 18px;" target="_blank">
                        <i class="fa fa-file-pdf"></i> Resmi PDF İndir
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. ZAMAN DİLİMİ VE PERİYOT SEÇİCİ BAR -->
    <!-- ========================================================================= -->
    <div class="period-bar">
        <div class="d-flex align-items-center gap-2">
            <span style="font-weight: 700; color: #1e293b; font-size: 13px;">
                <i class="fa fa-calendar-alt text-primary"></i> Brifing Dilimi:
            </span>
            <div class="period-btn-group">
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "1saat" })" class="period-btn @(Model.SelectedPeriod == "1saat" ? "active" : "")">
                    <i class="fa fa-stopwatch"></i> Son 1 Saat
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "3saat" })" class="period-btn @(Model.SelectedPeriod == "3saat" ? "active" : "")">
                    Son 3 Saat
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "6saat" })" class="period-btn @(Model.SelectedPeriod == "6saat" ? "active" : "")">
                    Son 6 Saat
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "12saat" })" class="period-btn @(Model.SelectedPeriod == "12saat" ? "active" : "")">
                    Son 12 Saat
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "24saat" })" class="period-btn @(Model.SelectedPeriod == "24saat" ? "active" : "")">
                    <i class="fa fa-star text-warning"></i> Son 24 Saat
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "bugun" })" class="period-btn @(Model.SelectedPeriod == "bugun" ? "active" : "")">
                    Bugün
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "dun" })" class="period-btn @(Model.SelectedPeriod == "dun" ? "active" : "")">
                    Dün
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "haftalik" })" class="period-btn @(Model.SelectedPeriod == "haftalik" ? "active" : "")">
                    Haftalık (7 Gün)
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "aylik" })" class="period-btn @(Model.SelectedPeriod == "aylik" ? "active" : "")">
                    Aylık (30 Gün)
                </a>
                <a href="@Url.Action("Index", "AdminBriefing", new { period = "yillik" })" class="period-btn @(Model.SelectedPeriod == "yillik" ? "active" : "")">
                    Yıllık (365 Gün)
                </a>
            </div>
        </div>

        <!-- Özel Tarih Aralığı Açılır Form -->
        <div>
            <button class="btn btn-outline-secondary btn-sm font-weight-bold" type="button" data-toggle="collapse" data-target="#customDateCollapse" aria-expanded="false">
                <i class="fa fa-sliders-h"></i> Özel Tarih Aralığı <i class="fa fa-chevron-down"></i>
            </button>
        </div>
    </div>

    <!-- Özel Tarih Aralığı Form Paneli -->
    <div class="collapse mb-4 @(Model.SelectedPeriod == "ozel" ? "show" : "")" id="customDateCollapse">
        <div class="card card-body bg-light border-0 shadow-sm" style="border-radius: 10px;">
            @using (Html.BeginForm("Index", "AdminBriefing", FormMethod.Get, new { @class = "form-inline d-flex flex-wrap gap-2 align-items-center" }))
            {
                <input type="hidden" name="period" value="ozel" />
                <label class="mr-2 font-weight-bold text-dark" style="font-size: 13px;">Başlangıç:</label>
                <input type="datetime-local" name="startDate" class="form-control form-control-sm mr-3"
                       value="@(Model.StartDate.ToString("yyyy-MM-ddTHH:mm"))" required />

                <label class="mr-2 font-weight-bold text-dark" style="font-size: 13px;">Bitiş:</label>
                <input type="datetime-local" name="endDate" class="form-control form-control-sm mr-3"
                       value="@(Model.EndDate.ToString("yyyy-MM-ddTHH:mm"))" required />

                <button type="submit" class="btn btn-primary btn-sm font-weight-bold">
                    <i class="fa fa-filter"></i> Tarihe Göre Brifing Ver
                </button>
            }
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. ANA OPERASYONEL KPI KARTLARI (KULLANICININ İSTEDİĞİ METRİKLER) -->
    <!-- ========================================================================= -->
    <div class="row">
        <!-- 1. Ceza Hesaplama -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card blue">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Ceza Hesaplama</div>
                        <div class="kpi-value">@Model.HesaplamaCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            <strong>@Model.HesaplamaTotalTutar.ToString("N2") TL</strong> tutarında
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-calculator"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Ceza Form & Tahdit Çıkartma -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card purple">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Form / Tutanak Çıkartma</div>
                        <div class="kpi-value">@Model.ToplamFormCikarmaCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            <span>@Model.CezaFormCikarmaCount İSK Form</span> &bull; <span>@Model.TahditFormCikarmaCount Tahdit Form</span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-file-invoice"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. V-84 Şartlı Giriş -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card emerald">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">V-84 Şartlı Giriş</div>
                        <div class="kpi-value">@Model.V84IslemCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            10 Günlük Vize Taahhüdü
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-plane-arrival"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. İnad Yolcu İşlemleri -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card rose">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">İnad Yolcu İşlemi</div>
                        <div class="kpi-value">@Model.InadIslemCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            Kabul Edilemez Yolcu Kaydı
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-user-slash"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Ders Kayıtları & Eğitim -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card amber">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Ders / Kurs Kaydı</div>
                        <div class="kpi-value">@Model.DersKayitCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            Akademi Personel Eğitimi
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-graduation-cap"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Sınav Tamamlama -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card amber">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Tamamlanan Sınav</div>
                        <div class="kpi-value">@Model.SinavCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            Ortalama Puan: <strong>@Model.SinavOrtalamaPuan.ToString("N1")</strong>
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-clipboard-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 7. Sahtecilik Portalı Yönlendirme & İnceleme -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card cyan">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Sahtecilik İnceleme</div>
                        <div class="kpi-value">@Model.ToplamSahtecilikIslemCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            <span>@Model.SahtecilikGecisCount Geçiş</span> &bull; <span>@Model.SahtecilikIncelemeCount Belge</span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-fingerprint"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 8. Yeni Kullanıcı Kaydı -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card indigo">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Yeni Kullanıcı Kaydı</div>
                        <div class="kpi-value">@Model.YeniKullaniciKayitCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            Sisteme Kayıt Olan Personel
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-user-plus"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 9. Şifremi Unuttum / Sıfırlama -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card orange">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Şifre Sıfırlama Talebi</div>
                        <div class="kpi-value">@Model.SifremiUnuttumCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            <span>@Model.SifremiUnuttumOnaylananCount Onaylanmış</span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-key"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 10. Sistem İçi Mesajlaşma -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card blue">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">İç Mesajlaşma</div>
                        <div class="kpi-value">@Model.MesajlasmaCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            Gönderilen İletişim Mesajı
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-comments"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 11. Gizli Genelge Talepleri -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card purple">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title">Genelge Erişim Talebi</div>
                        <div class="kpi-value">@Model.GenelgeTalepCount.ToString("N0")</div>
                        <div class="kpi-subtext">
                            Yetki & İzin Başvuruları
                        </div>
                    </div>
                    <div class="kpi-icon-wrap">
                        <i class="fa fa-file-contract"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 12. Toplam Operasyonel Hacim -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="kpi-card emerald" style="background: linear-gradient(135deg, #065f46 0%, #047857 100%); color: #ffffff;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="kpi-title" style="color: #a7f3d0;">Toplam İşlem Hacmi</div>
                        <div class="kpi-value" style="color: #ffffff;">@Model.ToplamIslemHacmi.ToString("N0")</div>
                        <div class="kpi-subtext" style="color: #d1fae5;">
                            Tüm Sistem Etkileşimi
                        </div>
                    </div>
                    <div class="kpi-icon-wrap" style="background: rgba(255,255,255,0.2); color: #ffffff;">
                        <i class="fa fa-layer-group"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 4. DETAYLI DAĞILIMLAR VE İSTATİSTİKSEL ANALİZ -->
    <!-- ========================================================================= -->
    <div class="row">
        <!-- Sol Kolon: Ülke ve Kod Dağılımları -->
        <div class="col-lg-6">
            <!-- Ceza Hesaplanan Ülkeler -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h5 class="detail-card-title">
                        <i class="fa fa-globe-americas text-primary"></i> En Çok Ceza Hesaplanan Ülkeler
                    </h5>
                    <span class="badge badge-light">@Model.TopHesaplamaUlkeleri.Count Ülke</span>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Ülke</th>
                                <th class="text-center">İşlem Adedi</th>
                                <th class="text-right">Toplam Ceza (TL)</th>
                                <th style="width: 25%;">Oran</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopHesaplamaUlkeleri != null && Model.TopHesaplamaUlkeleri.Count > 0)
                            {
                                foreach (var item in Model.TopHesaplamaUlkeleri)
                                {
                                    <tr>
                                        <td><strong>@item.Title</strong></td>
                                        <td class="text-center"><span class="badge badge-pill badge-primary">@item.Count</span></td>
                                        <td class="text-right font-weight-bold">@item.TotalAmount.ToString("N2") TL</td>
                                        <td>
                                            <div class="progress" style="height: 6px; border-radius: 4px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @item.Percentage%;"></div>
                                            </div>
                                            <small class="text-muted">@item.Percentage%</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted p-3">Bu zaman aralığında hesaplama kaydı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tahdit Kodları Dağılımı -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h5 class="detail-card-title">
                        <i class="fa fa-tag text-warning"></i> En Sık İşlem Yapılan Tahdit Kodları
                    </h5>
                    <span class="badge badge-light">Form Logları</span>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Tahdit Kodu</th>
                                <th class="text-center">Tutanak / Form Adedi</th>
                                <th style="width: 35%;">Dağılım</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopTahditKodlari != null && Model.TopTahditKodlari.Count > 0)
                            {
                                foreach (var item in Model.TopTahditKodlari)
                                {
                                    <tr>
                                        <td><span class="badge badge-dark" style="font-size: 13px;">@item.Title</span></td>
                                        <td class="text-center font-weight-bold">@item.Count</td>
                                        <td>
                                            <div class="progress" style="height: 6px; border-radius: 4px;">
                                                <div class="progress-bar bg-warning" role="progressbar" style="width: @item.Percentage%;"></div>
                                            </div>
                                            <small class="text-muted">@item.Percentage%</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">Bu zaman aralığında tahdit tutanak kaydı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- İnad Edilen Uyruklar -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h5 class="detail-card-title">
                        <i class="fa fa-user-times text-danger"></i> En Çok İnad Edilen Uyruklar
                    </h5>
                    <span class="badge badge-light">İnad Kayıtları</span>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Uyruk</th>
                                <th class="text-center">İnad Adedi</th>
                                <th style="width: 35%;">Oran</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopInadUlkeleri != null && Model.TopInadUlkeleri.Count > 0)
                            {
                                foreach (var item in Model.TopInadUlkeleri)
                                {
                                    <tr>
                                        <td><strong>@item.Title</strong></td>
                                        <td class="text-center"><span class="badge badge-danger">@item.Count</span></td>
                                        <td>
                                            <div class="progress" style="height: 6px; border-radius: 4px;">
                                                <div class="progress-bar bg-danger" role="progressbar" style="width: @item.Percentage%;"></div>
                                            </div>
                                            <small class="text-muted">@item.Percentage%</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">Bu zaman aralığında İnad kaydı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Hudut Kapıları ve Personel Dağılımları -->
        <div class="col-lg-6">
            <!-- En Aktif Hudut Kapıları -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h5 class="detail-card-title">
                        <i class="fa fa-landmark text-success"></i> En Aktif Hudut Kapıları (İşlem Yoğunluğu)
                    </h5>
                    <span class="badge badge-light">Toplam Operasyon</span>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Hudut Kapısı</th>
                                <th class="text-center">Toplam İşlem Adedi</th>
                                <th style="width: 35%;">Yoğunluk Oranı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopHudutKapilari != null && Model.TopHudutKapilari.Count > 0)
                            {
                                foreach (var item in Model.TopHudutKapilari)
                                {
                                    <tr>
                                        <td><strong>@item.Title</strong></td>
                                        <td class="text-center"><span class="badge badge-success">@item.Count işlem</span></td>
                                        <td>
                                            <div class="progress" style="height: 6px; border-radius: 4px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @item.Percentage%;"></div>
                                            </div>
                                            <small class="text-muted">@item.Percentage%</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">Bu zaman aralığında hudut kapısı işlem kaydı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- En Aktif Personeller -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h5 class="detail-card-title">
                        <i class="fa fa-user-check text-info"></i> En Çok İşlem Yapan Görevli Personel
                    </h5>
                    <span class="badge badge-light">Personel Performans</span>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Personel</th>
                                <th class="text-center">İşlem Hacmi</th>
                                <th style="width: 35%;">Dağılım</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopAktifPersoneller != null && Model.TopAktifPersoneller.Count > 0)
                            {
                                foreach (var item in Model.TopAktifPersoneller)
                                {
                                    <tr>
                                        <td><strong>@item.Title</strong></td>
                                        <td class="text-center"><span class="badge badge-info">@item.Count işlem</span></td>
                                        <td>
                                            <div class="progress" style="height: 6px; border-radius: 4px;">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: @item.Percentage%;"></div>
                                            </div>
                                            <small class="text-muted">@item.Percentage%</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">Bu zaman aralığında aktif personel kaydı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- V-84 Şartlı Giriş Ülkeleri -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h5 class="detail-card-title">
                        <i class="fa fa-passport text-primary"></i> V-84 Şartlı Giriş Verilen Ülkeler
                    </h5>
                    <span class="badge badge-light">V-84 Kayıtları</span>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Ülke</th>
                                <th class="text-center">Şartlı Giriş Adedi</th>
                                <th style="width: 35%;">Oran</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopV84Ulkeleri != null && Model.TopV84Ulkeleri.Count > 0)
                            {
                                foreach (var item in Model.TopV84Ulkeleri)
                                {
                                    <tr>
                                        <td><strong>@item.Title</strong></td>
                                        <td class="text-center"><span class="badge badge-primary">@item.Count</span></td>
                                        <td>
                                            <div class="progress" style="height: 6px; border-radius: 4px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @item.Percentage%;"></div>
                                            </div>
                                            <small class="text-muted">@item.Percentage%</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">Bu zaman aralığında V-84 kaydı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 5. SON GERÇEKLEŞEN OPERASYONEL İŞLEMLER (AKTARIM AKIŞI) -->
    <!-- ========================================================================= -->
    <div class="detail-card">
        <div class="detail-card-header">
            <h5 class="detail-card-title">
                <i class="fa fa-stream text-primary"></i> Dönem İçinde Gerçekleşen Son Operasyonel Hareketler
            </h5>
            <span class="badge badge-secondary">Son @Model.SonIslemler.Count Faaliyet</span>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">Tarih / Saat</th>
                        <th style="width: 160px;">Modül</th>
                        <th>İşlem Özeti / Detay</th>
                        <th>Görevli Personel</th>
                        <th>Hudut Kapısı</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SonIslemler != null && Model.SonIslemler.Count > 0)
                    {
                        foreach (var item in Model.SonIslemler)
                        {
                            <tr>
                                <td class="font-weight-bold text-muted">@item.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @item.BadgeClass" style="font-size: 11.5px; padding: 4px 8px;">@item.Module</span>
                                </td>
                                <td>@item.Description</td>
                                <td><i class="fa fa-user-circle text-muted"></i> @item.Officer</td>
                                <td><i class="fa fa-building text-muted"></i> @item.Border</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted p-4">Bu zaman aralığında listelenecek işlem kaydı bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
