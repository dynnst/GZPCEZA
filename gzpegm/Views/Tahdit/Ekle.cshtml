@model gzpegm.Models.TahditKod
@{
    ViewBag.Title = "Yeni Tahdit Kodu Ekle";
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseSummernote = true;
}

<div class="page-wrapper">
    <div class="container-fluid p-0">
        <div class="page-heading mb-4">
            <h2 class="page-title"><i class="fas fa-plus-circle mr-2"></i>Yeni Tahdit Kodu Ekle</h2>
        </div>

        <div class="card">
            <div class="card-body">
                @using (Html.BeginForm("Ekle", "Tahdit", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label class="font-weight-bold">Kod <span class="text-danger">*</span></label>
                            <input name="Kod" id="Yeni_Kod" class="form-control" placeholder="Örn: Ç-101" value="@((Model != null) ? Model.Kod : "")" required />
                        </div>
                        <div class="col-md-9 form-group">
                            <label class="font-weight-bold">Açıklama</label>
                            <textarea name="Aciklama" id="Yeni_Aciklama" class="form-control" rows="3">@((Model != null) ? Model.Aciklama : "")</textarea>
                        </div>
                        <div class="col-md-2 form-group">
                            <label class="font-weight-bold">Süre (Ay)</label>
                            <input name="SureAy" id="Yeni_SureAy" type="number" class="form-control" placeholder="Ay" value="@((Model != null && Model.SureAy.HasValue) ? Model.SureAy.ToString() : "")" />
                        </div>
                        <div class="col-md-5 form-group">
                            <label class="font-weight-bold">Girişe Gelirse</label>
                            <textarea name="GirisGelirse" id="Yeni_GirisGelirse" class="form-control" rows="3">@((Model != null) ? Model.GirisGelirse : "")</textarea>
                        </div>
                        <div class="col-md-5 form-group">
                            <label class="font-weight-bold">Çıkışa Gelirse</label>
                            <textarea name="CikisGelirse" id="Yeni_CikisGelirse" class="form-control" rows="3">@((Model != null) ? Model.CikisGelirse : "")</textarea>
                        </div>
                        <div class="col-md-12 form-group">
                            <label class="font-weight-bold">Tahdit İçeriği (Resim, Video, Metin)</label>
                            <textarea name="TahditMedia" id="Yeni_TahditMedia" class="form-control summernote" rows="8">@Html.Raw((Model != null) ? Model.TahditMedia : "")</textarea>
                            <small class="text-muted">Resim eklemek için resim butonuna tıklayın, video için embed kodu kullanabilirsiniz.</small>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="@Url.Action("Index","Tahdit")" class="btn btn-secondary mr-2"><i class="fas fa-times mr-1"></i>İptal</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Kaydet</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div id="tahdit-editor-config" data-upload-url="@Url.Action("SummernoteUpload", "Tahdit")" style="display:none;"></div>
    <script src="@Url.Content("~/vendor/summernote/summernote-bs4.js")"></script>
    <script src="@Url.Content("~/js/tahdit-editor.js")?v=1.1"></script>
}
