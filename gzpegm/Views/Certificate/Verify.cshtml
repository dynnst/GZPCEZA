@{
    ViewBag.Title = "Belge Doğrulama";
    Layout = "~/Views/Shared/_Master.cshtml";
    bool searched = ViewBag.Searched is bool && (bool)ViewBag.Searched;
    bool found = ViewBag.Found is bool && (bool)ViewBag.Found;
    var cert = ViewBag.Cert as gzpegm.Models.Certificate;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0" style="border-radius: 14px; overflow: hidden;">
                <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #071426 0%, #15325b 100%);">
                    <div class="d-flex align-items-center">
                        <div class="mr-3 text-warning" style="font-size: 2.2rem;">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 font-weight-bold text-white">Hudut Kapıları Eğitim ve Bilgi Sistemi</h4>
                            <p class="mb-0 text-white-50 small">Yerel Hizmet İçi Eğitim Başarı Belgesi Doğrulama Portalı</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form method="get" action="@Url.Action("Verify", "Certificate")" class="mb-4">
                        <label class="font-weight-bold text-dark small">Sertifika / Belge Numarası Giriniz:</label>
                        <div class="input-group">
                            <input type="text" name="code" class="form-control" placeholder="Örn: CERT-20261116-00001" value="@ViewBag.Code" required />
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-primary font-weight-bold px-4">
                                    <i class="fas fa-search mr-1"></i> Doğrula
                                </button>
                            </div>
                        </div>
                    </form>

                    @if (searched)
                    {
                        if (found && cert != null)
                        {
                            var owner = cert.E_User;
                            var ownerName = owner != null ? $"{owner.fldName} {owner.fldLastName}" : "Personel";
                            var ownerSicil = owner?.fldSicil ?? "-";
                            var courseTitle = cert.Courses?.CourseTitle ?? "Eğitim";

                            <div class="alert alert-success border-success p-4 rounded" style="background-color: #f0fdf4;">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="fas fa-check-circle fa-2x text-success mr-3"></i>
                                    <div>
                                        <h5 class="mb-0 font-weight-bold text-success">BELGE GEÇERLİ VE DOĞRULANDI</h5>
                                        <span class="small text-muted">Bu belge yerel eğitim sistemi veritabanında aktif ve kayıtlıdır.</span>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-sm-6 mb-2">
                                        <span class="small text-muted d-block">Belge Sahibi:</span>
                                        <strong class="text-dark">@ownerName</strong>
                                    </div>
                                    <div class="col-sm-6 mb-2">
                                        <span class="small text-muted d-block">Sicil No:</span>
                                        <strong class="text-dark">@ownerSicil</strong>
                                    </div>
                                    <div class="col-sm-6 mb-2">
                                        <span class="small text-muted d-block">Tamamlanan Eğitim:</span>
                                        <strong class="text-dark">@courseTitle</strong>
                                    </div>
                                    <div class="col-sm-6 mb-2">
                                        <span class="small text-muted d-block">Düzenleme Tarihi:</span>
                                        <strong class="text-dark">@cert.IssuedDate.ToString("dd.MM.yyyy")</strong>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <span class="small text-muted d-block">Belge Numarası:</span>
                                        <code class="h6 font-weight-bold text-primary">@cert.CertificateNumber</code>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger p-4 rounded">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-times-circle fa-2x text-danger mr-3"></i>
                                    <div>
                                        <h5 class="mb-1 font-weight-bold text-danger">Kayıt Bulunamadı</h5>
                                        <span class="small">Girilen numara sistemimizde kayıtlı bir başarı belgesiyle eşleşmemektedir. Lütfen numarayı kontrol ediniz.</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="card-footer bg-light p-3 text-center small text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Bu doğrulama sistemi yerel eğitim ve sınav platformunun iç kayıt sorgulama aracıdır.
                </div>
            </div>
        </div>
    </div>
</div>
