@model IEnumerable<gzpegm.Models.E_History>
@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseDataTables = true;
    ViewBag.UseDataTablesExport = true;
    ViewBag.Title = "Yapılan İşlem Geçmişi";
}

<div class="page-wrapper">
    <!-- BAŞLIK BÖLÜMÜ -->
    <div class="page-heading mb-4">
        <h1 class="page-title">
            <i class="fas fa-history me-2"></i>Yapılan İşlem Geçmişi
        </h1>
        <p class="text-muted">Hesaplama işlemleri geçmişi</p>
    </div>
    @{
        int? selectedHours = ViewBag.SelectedHours as int?;
        var fromVal = ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "";
        var toVal = ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "";
        var searchText = ViewBag.SearchText as string ?? "";
        var baseUrl = Url.Action("OSHIST", "OSISK");
        var currentParams = "";
        if (selectedHours.HasValue) { currentParams += (currentParams == "" ? "?" : "&") + "hours=" + selectedHours.Value; }
        if (!string.IsNullOrEmpty(fromVal)) { currentParams += (currentParams == "" ? "?" : "&") + "from=" + fromVal; }
        if (!string.IsNullOrEmpty(toVal)) { currentParams += (currentParams == "" ? "?" : "&") + "to=" + toVal; }
        if (!string.IsNullOrEmpty(searchText)) { currentParams += (currentParams == "" ? "?" : "&") + "q=" + HttpUtility.UrlEncode(searchText); }
        var exportPdfUrl = baseUrl + currentParams + (currentParams == "" ? "?" : "&") + "export=pdf";
        var exportXlsUrl = baseUrl + currentParams + (currentParams == "" ? "?" : "&") + "export=excel";
        var tahditStats = ViewBag.TahditStats as gzpegm.Models.ViewModels.TahditStatisticsViewModel ?? new gzpegm.Models.ViewModels.TahditStatisticsViewModel();
    }

    <div class="row mb-3">
        <div class="col-md-2">
            <form method="get" action="@Url.Action("OSHIST","OSISK")" class="d-flex">
                <select name="hours" class="form-control">
                    <option value="" @(!selectedHours.HasValue ? "selected" : "")>Son 100 Kayıt</option>
                    <option value="24" @(selectedHours==24?"selected":"")>Son 24 Saat</option>
                    <option value="168" @(selectedHours==168?"selected":"")>Son 7 Gün</option>
                    <option value="720" @(selectedHours==720?"selected":"")>Son 30 Gün</option>
                    <option value="8760" @(selectedHours==8760?"selected":"")>Son 1 Yıl</option>
                </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="from" value="@fromVal" class="form-control" />
        </div>
        <div class="col-md-2">
            <input type="date" name="to" value="@toVal" class="form-control" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Filtrele</button>
            <a href="@exportPdfUrl" class="btn btn-outline-secondary ml-2">PDF Dışa Aktar</a>
            <a href="@exportXlsUrl" class="btn btn-outline-secondary ml-1">Excel Dışa Aktar</a>
            </form>
        </div>
    </div>
    <!-- İSTATİSTİK KARTLARI (4 ADET) -->
    <div class="row mb-4">
        <!-- Toplam Hesaplama Sayısı -->
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="stat-card stat-card-primary">
                <div class="stat-icon">
                    <i class="fas fa-calculator"></i>
                </div>
                <div class="stat-content">
                    <h5>Toplam Hesaplama Sayısı</h5>
                    <h2>@ViewBag.ToplamHesaplama</h2>
                    <small>toplam işlem</small>
                </div>
            </div>
        </div>

        <!-- Toplam Hesaplanan Ceza Miktarı -->
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="stat-card stat-card-success">
                <div class="stat-icon">
                    <i class="fas fa-lira-sign"></i>
                </div>
                <div class="stat-content">
                    <h5>Toplam Hesaplanan Ceza Miktarı</h5>
                    <h2>@ViewBag.ToplamMiktar</h2>
                    <small>TL</small>
                </div>
            </div>
        </div>

        <!-- En Çok Hesaplama Yapan Personel -->
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="stat-card stat-card-info">
                <div class="stat-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stat-content">
                    <h5>En Çok Hesaplama Yapan Personel</h5>
                    <h2>@ViewBag.EnCokHesaplayanPersonel</h2>
                    <small>@ViewBag.EnCokHesaplayanAdi</small>
                </div>
            </div>
        </div>

        <!-- En Çok Hesaplanan Ülke -->
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="stat-card stat-card-warning">
                <div class="stat-icon">
                    <i class="fas fa-globe"></i>
                </div>
                <div class="stat-content">
                    <h5>En Çok Hesaplanan Ülke</h5>
                    <h2>@ViewBag.EnCokUlkeSayi</h2>
                    <small>@ViewBag.EnCokUlke</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-4 mb-3">
            <div class="stat-card stat-card-warning">
                <div class="stat-icon"><i class="fas fa-ban"></i></div>
                <div class="stat-content">
                    <h5>Seçili Aralık Tahdit Formu</h5>
                    <h2>@tahditStats.AllTotal</h2>
                    <small>kapı filtresine göre</small>
                </div>
            </div>
        </div>
        <div class="col-lg-8 mb-3">
            <div class="card">
                <div class="card-header"><h4 class="card-title mb-0">Tahdit Kodu Dağılımı</h4></div>
                <div class="card-body p-0">
                    <div class="table-responsive tahdit-code-table-wrap">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Tahdit</th><th>İdari</th><th class="text-right">Adet</th></tr></thead>
                            <tbody>
                                @if (tahditStats.AllByCode.Any())
                                {
                                    foreach (var item in tahditStats.AllByCode)
                                    {
                                        <tr><td>@item.TahditCode</td><td>@item.IdariTahditCode</td><td class="text-right">@item.Count</td></tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="3" class="text-center text-muted">Seçili aralıkta tahdit formu yok.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- YAPILAN İŞLEM LİSTESİ KARTI -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap">
                    <div>
                        <h4 class="card-title mb-0">
                            <i class="fas fa-list me-2"></i>Yapılan İşlem Listesi
                        </h4>
                        <p class="card-subtitle">Bu bölümde yapılan işlemleri görüntüleyebilirsiniz.</p>
                    </div>
                </div>
                <div class="card-body pb-0">
                    <form method="get" action="@Url.Action("OSHIST", "OSISK")" class="form-inline mb-3">
                        <div class="input-group" style="max-width: 560px; width: 100%;">
                            <input type="text" name="q" class="form-control" value="@ViewBag.SearchText" placeholder="Ülke, kullanıcı, kapı veya ceza bilgisi ara...">
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-primary">Ara</button>
                                @if (!string.IsNullOrEmpty(ViewBag.SearchText as string))
                                {
                                    <a href="@Url.Action("OSHIST", "OSISK")" class="btn btn-default">Temizle</a>
                                }
                            </div>
                        </div>
                    </form>
                    <div class="text-muted mb-2">@(ViewBag.ResultInfo ?? "Son işlemler gösteriliyor.")</div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="historyTable" class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Doğum Tarihi</th>
                                    <th>Ülke</th>
                                    <th>Kullanıcı</th>
                                    <th>İşlem Tarihi</th>
                                    <th>Kapı</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var data in Model)
                                {
                                    <tr>
                                        <td>@(data.fldBirthDate.HasValue ? data.fldBirthDate.Value.ToString("dd.MM.yyyy") : "")</td>
                                        <td>@data.fldCountry</td>
                                        <td>@data.fldUser</td>
                                        <td>@(data.fldDatetime.HasValue ? data.fldDatetime.Value.ToString("dd.MM.yyyy HH:mm") : "")</td>
                                        <td>@data.fldBorder</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/css/oshist.css")?v=1.0" rel="stylesheet" />
}

@section Scripts {
    <script src="@Url.Content("~/AdminTemplate/js/plugins/dataTables/datatables.min.js")"></script>
    <script src="@Url.Content("~/AdminTemplate/js/plugins/dataTables/dataTables.bootstrap4.min.js")"></script>
    <script src="@Url.Content("~/js/oshist.js")?v=1.0"></script>
}
