@model gzpegm.Controllers.ErrorLogsPageViewModel

@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Title = "Hata Logları";
    ViewBag.UseDataTables = true;

    Func<long, string> formatBytes = bytes =>
    {
        decimal value = bytes;
        string[] units = { "B", "KB", "MB", "GB" };
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return string.Format("{0:N2} {1}", value, units[unit]);
    };
}

<section class="card">
    <header class="card-header d-flex align-items-center justify-content-between flex-wrap">
        <div>
            <h2 class="card-title mb-0"><i class="fas fa-bug"></i> Hata Logları</h2>
            <p class="card-subtitle">Canlı ortamda oluşan beklenmeyen hataları Visual Studio açmadan inceleyebilirsiniz.</p>
        </div>
        <a class="btn btn-outline-primary mt-2 mt-sm-0" href="@Url.Action("Index", new { take = Model.Take, file = Model.SelectedFile })">
            <i class="fas fa-sync-alt"></i> Yenile
        </a>
    </header>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            Yeni beklenmeyen uygulama hataları <code>@Model.LogDirectory</code> klasörüne günlük dosya olarak yazılır.
        </div>

        <form method="get" class="form-row align-items-end mb-3">
            <div class="form-group col-md-5">
                <label>Log Dosyası</label>
                <select name="file" class="form-control">
                    <option value="">Tüm dosyalar</option>
                    @foreach (var file in Model.Files)
                    {
                        <option value="@file.FileName" @(string.Equals(file.FileName, Model.SelectedFile, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>
                            @file.FileName - @formatBytes(file.Length)
                        </option>
                    }
                </select>
            </div>
            <div class="form-group col-md-3">
                <label>Gösterilecek Kayıt</label>
                <select name="take" class="form-control">
                    <option value="100" @(Model.Take == 100 ? "selected" : "")>Son 100</option>
                    <option value="200" @(Model.Take == 200 ? "selected" : "")>Son 200</option>
                    <option value="500" @(Model.Take == 500 ? "selected" : "")>Son 500</option>
                    <option value="1000" @(Model.Take == 1000 ? "selected" : "")>Son 1000</option>
                </select>
            </div>
            <div class="form-group col-md-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Filtrele
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SelectedFile))
                {
                    <a class="btn btn-outline-secondary" href="@Url.Action("Download", new { file = Model.SelectedFile })">
                        <i class="fas fa-download"></i> Dosyayı İndir
                    </a>
                }
            </div>
        </form>
    </div>
</section>

<section class="card">
    <header class="card-header">
        <h2 class="card-title"><i class="fas fa-list"></i> Son Hatalar</h2>
    </header>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="errorLogsTable" class="table table-striped table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Tip</th>
                        <th>Mesaj</th>
                        <th>URL</th>
                        <th>Kullanıcı/IP</th>
                        <th>Dosya</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Entries)
                    {
                        <tr>
                            <td data-order="@item.LoggedAt.ToString("yyyyMMddHHmmss")">@item.LoggedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td><span class="badge badge-danger">@item.ExceptionType</span></td>
                            <td style="max-width:360px;">@item.Message</td>
                            <td style="max-width:320px;">
                                <span title="@item.Url">@item.Path</span>
                            </td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(item.UserName) ? "-" : item.UserName)</div>
                                <small class="text-muted">@item.IpAddress</small>
                            </td>
                            <td>
                                <code>@item.FileName:@item.LineNumber</code>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Detail", new { id = item.Id })">
                                    <i class="fas fa-search"></i> İncele
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            if ($.fn.DataTable) {
                $('#errorLogsTable').DataTable({
                    pageLength: 25,
                    order: [[0, 'desc']],
                    language: {
                        search: 'Ara:',
                        lengthMenu: 'Sayfada _MENU_ kayıt göster',
                        info: '_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor',
                        infoEmpty: 'Kayıt yok',
                        zeroRecords: 'Eşleşen kayıt bulunamadı',
                        paginate: {
                            next: 'Sonraki',
                            previous: 'Önceki'
                        }
                    }
                });
            }
        });
    </script>
}
