                                    bool isChk = selectedSebep.Contains(s);
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="InadSebep" id="sebep_@s.GetHashCode()" value="@s" @(isChk ? "checked" : "")>
