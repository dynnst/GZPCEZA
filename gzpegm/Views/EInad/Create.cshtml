@section Scripts {
    <script>
        var URL_SCAN_PASSPORT = '@Url.Action("ScanPassport", "EInad")';
        var URL_SCAN_IMAGE = '@Url.Action("ScanPassportImage", "EInad")';
        var URL_GET_AIRLINES = '@Url.Action("GetEuropeanAirlines", "EInad")';
        var URL_GET_IATA = '@Url.Action("GetByIataCode", "EInad")';

        $(document).ready(function () {
            loadAirlines();
            initChips();
            // initDropzone();
            initIataLookup();
            initFormValidationAndEvents();
        });

        // OCR Hatalarını Otomatik Düzelt
        function fixOcrMisreads(str) {
            if (!str) return "";
            return str.replace(/\bYFKTAS\b/gi, 'YEKTAS').replace(/YFKTAS/g, 'YEKTAS')
                      .replace(/\bOAYAN\b/gi, 'DAYAN').replace(/OAYAN/g, 'DAYAN');
        }

        function playScanBeep() {
            try {
                var AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                var ctx = new AudioCtx();
                if (ctx.state === 'suspended') ctx.resume();
                var osc = ctx.createOscillator();
                var gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.18);
            } catch (e) { }
        }

        // 1. Cihazdan Doğrudan Pasaport Oku (3M, Thales, Desko, Regula - Sıfır Kurulum & Donanım Entegrasyonu)
        window.scanPassportForCreatePage = function (deviceType) {
            deviceType = deviceType || 'auto';
            if (window.PassportReader && typeof window.PassportReader.scanDevice === 'function') {
                window.PassportReader.scanDevice(deviceType);
            } else if (typeof triggerDirectOpticalScan === 'function') {
                triggerDirectOpticalScan(deviceType);
            } else if (typeof scanPassportDirect === 'function') {
                scanPassportDirect(deviceType);
            }
        };
        window.scanPassportDirect = window.scanPassportForCreatePage;

        // Formu pasaport verisiyle doldur ve 1. bölümü açık tut
        function applyPassportDataToForm(d) {
            if (!d) return;

            var fullName = d.fullName || ((d.surname || '') + ' ' + (d.givenNames || '')).trim();
            if (fullName) {
                fullName = fixOcrMisreads(fullName);
                $('#AdSoyad').val(fullName).addClass('highlight-flash');
            }

            var docNo = d.documentNumber || d.passportNo || '';
            if (docNo) {
                $('#PasaportNo').val(docNo).addClass('highlight-flash');
                if (!$('#BelgeNo').val()) $('#BelgeNo').val(docNo).addClass('highlight-flash');
            }

            if (d.personalNumber) $('#KimlikNo').val(d.personalNumber).addClass('highlight-flash');

            if (d.birthDate) {
                var bDate = normalizeDateForInput(d.birthDate);
                if (bDate) $('#DogumT').val(bDate).addClass('highlight-flash');
            }

            if (d.sex || d.gender) {
                var s = (d.sex || d.gender || '').toLowerCase();
                if (s.indexOf('e') === 0 || s === 'm' || s.indexOf('erkek') >= 0 || s.indexOf('male') >= 0) {
                    $('#Cinsiyet').val('Erkek').addClass('highlight-flash');
                } else if (s.indexOf('k') === 0 || s.indexOf('b') === 0 || s === 'f' || s.indexOf('bayan') >= 0 || s.indexOf('kadın') >= 0 || s.indexOf('female') >= 0) {
                    $('#Cinsiyet').val('Bayan').addClass('highlight-flash');
                }
            }

            var c = d.country || d.countryCode || d.nationality;
            if (c) {
                c = c.trim();
                var matched = false;
                $('#Uyruk option').each(function () {
                    if ($(this).val().toLowerCase() === c.toLowerCase()) {
                        $('#Uyruk').val($(this).val()).addClass('highlight-flash');
                        matched = true;
                        return false;
                    }
                });
                if (!matched) {
                    if (c.toUpperCase() === 'TUR' || c.toUpperCase() === 'TR' || c.toUpperCase() === 'TLR' || c.toLowerCase().indexOf('türk') >= 0) {
                        $('#Uyruk option').each(function () {
                            if ($(this).val().toLowerCase().indexOf('türk') >= 0) {
                                $('#Uyruk').val($(this).val()).addClass('highlight-flash');
                                matched = true;
                                return false;
                            }
                        });
                    }
                    if (!matched) {
                        $('#Uyruk').val(c).addClass('highlight-flash');
                    }
                }

                // Doğum Yeri alanına otomatik uyruk gelsin (eğer boşsa)
                if (!$('#DogumY').val() || $('#DogumY').val().trim() === '') {
                    $('#DogumY').val($('#Uyruk').val() || c).addClass('highlight-flash');
                }
            }

            if (d.documentType) {
                var dt = d.documentType.toUpperCase();
                if (dt.indexOf('P') >= 0) $('#PasaportTuru').val('Umuma Mahsus');
                else if (dt.indexOf('I') >= 0 || dt.indexOf('C') >= 0 || dt.indexOf('A') >= 0) $('#PasaportTuru').val('Kimlik Kartı');
            }

            if (d.rawText || d.mrz) {
                $('#mrzInputText').val(d.rawText || d.mrz);
            }

            var photo = d.visBase64 || d.photoBase64;
            if (photo) {
                var imgSrc = photo.indexOf('data:image') === 0 ? photo : ('data:image/jpeg;base64,' + photo);
                $('#passportPreviewImg').attr('src', imgSrc);
                $('#photoStatusText').text('Pasaport Görüntüsü Aktarıldı');
                $('#photoFileName').text('Belge No: ' + (docNo || '-'));
                $('#passportPreviewContainer').slideDown(200);
            }

            // 1. BÖLÜMÜN AÇIK OLDUĞUNDAN KESİNLİKLE EMİN OL
            $('#accKimlik').show();

            // Vurgu efektini kaldır
            setTimeout(function () {
                $('.highlight-flash').removeClass('highlight-flash');
            }, 1800);

            // 1. Bölüme yumuşak kaydır
            if ($('#accKimlik').length && $('#accKimlik').offset()) {
                $('html, body').animate({
                    scrollTop: $('#accKimlik').offset().top - 100
                }, 300);
            }
        }

        function normalizeDateForInput(raw) {
            if (!raw) return '';
            var parts = raw.split('.');
            if (parts.length === 3) {
                var dd = parts[0].length === 1 ? '0' + parts[0] : parts[0];
                var mm = parts[1].length === 1 ? '0' + parts[1] : parts[1];
                var yyyy = parts[2];
                return yyyy + '-' + mm + '-' + dd;
            }
            if (raw.indexOf('-') >= 0 && raw.length >= 10) {
                return raw.substring(0, 10);
            }
            return raw;
        }

        // Manuel MRZ Ayrıştır
        window.parseMrzDirect = function () {
            var raw = ($('#mrzInputText').val() || '').trim();
            if (!raw) {
                alert('Lütfen MRZ metnini yapıştırınız.');
                return;
            }
            var lines = raw.split(/\r?\n/).map(function (l) { return l.trim(); }).filter(Boolean);
            if (lines.length < 2) {
                alert('Geçerli bir MRZ en az 2 satır olmalıdır.');
                return;
            }

            var l1 = lines[0].replace(/\s+/g, '');
            var l2 = lines[1].replace(/\s+/g, '');

            var data = {
                documentType: 'Pasaport',
                documentNumber: '',
                country: '',
                birthDate: '',
                sex: '',
                fullName: '',
                mrz: raw
            };

            if (l1.length >= 44 && l2.length >= 44) {
                data.country = l2.substring(10, 13);
                data.documentNumber = l2.substring(0, 9).replace(/</g, '');
                var dob = l2.substring(13, 19);
                data.birthDate = formatYymmdd(dob);
                data.sex = l2.substring(20, 21);

                var namePart = l1.substring(5).replace(/</g, ' ').trim();
                data.fullName = fixOcrMisreads(namePart.replace(/\s+/g, ' '));
            }

            applyPassportDataToForm(data);
            showFeedback('MRZ başarıyla ayrıştırıldı ve forma aktarıldı.', 'success');
        };

        function formatYymmdd(yymmdd) {
            if (!yymmdd || yymmdd.length !== 6) return '';
            var yy = parseInt(yymmdd.substring(0, 2), 10);
            var mm = yymmdd.substring(2, 4);
            var dd = yymmdd.substring(4, 6);
            var curYear = new Date().getFullYear() % 100;
            var fullYear = yy <= curYear ? (2000 + yy) : (1900 + yy);
            return fullYear + '-' + mm + '-' + dd;
        }

        // Dropzone & Dosya Yükleme
        function initDropzone() {
            var $dropzone = $('#passportDropzone');
            var $fileInput = $('#passportPhotoInput');

            $('#btnBrowsePassport, #passportDropzone').on('click', function (e) {
                if (e.target.id === 'passportPhotoInput') return;
                $fileInput.trigger('click');
            });

            $dropzone.on('dragover dragenter', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $dropzone.addClass('dragover');
            });

            $dropzone.on('dragleave dragend drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $dropzone.removeClass('dragover');
            });

            $dropzone.on('drop', function (e) {
                var files = e.originalEvent.dataTransfer.files;
                if (files && files.length > 0) {
                    handlePhotoUpload(files[0]);
                }
            });

            $fileInput.on('change', function () {
                if (this.files && this.files.length > 0) {
                    handlePhotoUpload(this.files[0]);
                }
            });

            $('#btnRemovePhoto').on('click', function () {
                $('#passportPreviewContainer').slideUp(150);
                $('#passportPhotoInput').val('');
                $('#passportPreviewImg').attr('src', '');
            });
        }

        function handlePhotoUpload(file) {
            if (!file.type.match(/image.*/)) {
                alert('Lütfen geçerli bir resim dosyası seçin (JPG, PNG).');
                return;
            }

            var reader = new FileReader();
            reader.onload = function (e) {
                $('#passportPreviewImg').attr('src', e.target.result);
                $('#photoStatusText').text('Görsel yüklendi, taranıyor...');
                $('#photoFileName').text(file.name);
                $('#passportPreviewContainer').slideDown(150);
            };
            reader.readAsDataURL(file);

            var formData = new FormData();
            formData.append('passportImage', file);
            var token = $('input[name="__RequestVerificationToken"]').val();
            if (token) formData.append('__RequestVerificationToken', token);

            $.ajax({
                url: URL_SCAN_IMAGE,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res && res.success && res.data) {
                        applyPassportDataToForm(res.data);
                        $('#photoStatusText').html('<span class="text-success"><i class="fas fa-check-circle mr-1"></i> MRZ Algılandı</span>');
                        showFeedback('Fotoğraftan pasaport verileri başarıyla aktarıldı.', 'success');
                    } else {
                        var msg = (res && res.message) ? res.message : 'Görselde MRZ okunamadı.';
                        $('#photoStatusText').html('<span class="text-danger"><i class="fas fa-exclamation-triangle mr-1"></i> ' + msg + '</span>');
                    }
                },
                error: function () {
                    $('#photoStatusText').html('<span class="text-danger">Fotoğraf işleme hatası oluştu.</span>');
                }
            });
        }

        // Hızlı Sebep Çipleri (Çoklu Seçim & İki Yönlü Senkronizasyon)
        function initChips() {
            $('.btn-chip').each(function () {
                var val = $(this).attr('data-val');
                var $chk = $('input[name="InadSebep"][value="' + val + '"]');
                if ($chk.is(':checked')) {
                    $(this).addClass('active');
                }
            });

            $('.btn-chip').on('click', function () {
                var val = $(this).attr('data-val');
                var $chk = $('input[name="InadSebep"][value="' + val + '"]');
                if ($chk.length) {
                    var newState = !$chk.is(':checked');
                    $chk.prop('checked', newState);
                    $(this).toggleClass('active', newState);
                }
            });

            $('input[name="InadSebep"]').on('change', function () {
                var val = $(this).val();
                var $chip = $('.btn-chip[data-val="' + val + '"]');
                if ($chip.length) {
                    $chip.toggleClass('active', $(this).is(':checked'));
                }
            });
        }

        // Havayolu Listesi
        function loadAirlines() {
            $.get(URL_GET_AIRLINES, function (data) {
                if (data && data.length) {
                    var $dl = $('#airlineList');
                    $dl.empty();
                    data.forEach(function (a) {
                        $dl.append($('<option>').val(a.Name).text(a.IATACode + ' - ' + a.Name));
                    });
                }
            });
        }

        // Uçuş No IATA Kodundan Otomatik Havayolu Doldurma (2 karakter yazıldığında anında tamamlama)
        function initIataLookup() {
            var lookupIata = function ($flightInput, $airlineInput) {
                var flight = ($flightInput.val() || '').trim().toUpperCase();
                if (flight.length >= 2) {
                    var iata = flight.substring(0, 2);
                    $.get(URL_GET_IATA, { iata: iata }, function (res) {
                        if (res && res.found && res.name) {
                            if (!$airlineInput.val() || $airlineInput.val().trim() === '') {
                                $airlineInput.val(res.name);
                            }
                        }
                    });
                }
            };

            $('#GelenUcusNo').on('input blur change', function () {
                lookupIata($('#GelenUcusNo'), $('#GelenHavayolu'));
            });

            $('#GidisUcusNo').on('input blur change', function () {
                lookupIata($('#GidisUcusNo'), $('#GidenHavayolu'));
            });
        }

        // Form Doğrulama ve Etkinlikler
        function initFormValidationAndEvents() {
            // Uyruk seçildiğinde Doğum Yeri alanını otomatik doldur
            $('#Uyruk').on('change', function () {
                var uyrukVal = $(this).val();
                if (uyrukVal && (!$('#DogumY').val() || $('#DogumY').val().trim() === '')) {
                    $('#DogumY').val(uyrukVal);
                }
            });

            // Personel Sicil senkronizasyonu
            $('#Sicil').on('input change blur', function () {
                $('#Personel').val($(this).val().trim());
            });

            // Form Gönderim Doğrulaması (Sicil zorunlu kontrolü)
            $('#inadForm').on('submit', function (e) {
                var sicil = ($('#Sicil').val() || '').trim();
                if (!sicil) {
                    e.preventDefault();
                    showFeedback('Lütfen Tespit Eden Personel Sicilini giriniz (Zorunlu Alan).', 'danger');
                    $('html, body').animate({ scrollTop: $('#Sicil').offset().top - 120 }, 300);
                    $('#Sicil').focus().addClass('is-invalid');
                    return false;
                }
                $('#Sicil').removeClass('is-invalid');
                $('#Personel').val(sicil);
            });
        }

        // Üst Arama Maddeleri Ekleme
        window.appendItemToUstArama = function (itemText) {
            var $area = $('#UstAramaEsya');
            var curVal = ($area.val() || '').trim();
            var linePrefix = "- ";
            if (curVal.length > 0) {
                $area.val(curVal + "\r\n" + linePrefix + itemText);
            } else {
                $area.val(linePrefix + itemText);
            }
            $area.focus();
        };

        window.loadUstAramaDefaultTemplate = function () {
            var template = "1. [Miktar: 1 Adet] Cep Telefonu (Marka/Model: ..., Seri No/IMEI: ..., Durum: Sağlam)\r\n" +
                           "2. [Miktar/Tutar: ...] Cüzdan & Nakit Para (Birim: ..., Banknot Seri No: ...)\r\n" +
                           "3. [Miktar: 1 Adet] Seyahat Belgesi (Cinsi: Pasaport, Seri No: ..., Veren Ülke: ...)\r\n" +
                           "4. [Miktar: 1 Adet] Sırt Çantası / El Bagajı (Renk/Marka: ..., Seri/Etiket No: ...)\r\n" +
                           "5. Yapılan üst aramasında herhangi bir suç unsuru veya yasaklı maddeye rastlanılmamıştır.";
            $('#UstAramaEsya').val(template).focus();
        };

        window.clearUstArama = function () {
            $('#UstAramaEsya').val('').focus();
        };

        function showFeedback(msg, type) {
            var cssType = type || 'info';
            var html = '<div class="alert alert-' + cssType + ' alert-dismissible fade show" role="alert">' +
                       '<strong>' + (type === 'success' ? 'Başarılı: ' : (type === 'danger' ? 'Hata: ' : 'Bilgi: ')) + '</strong>' +
                       msg +
                       '<button type="button" class="close" data-dismiss="alert" aria-label="Kapat">' +
                       '<span aria-hidden="true">&times;</span></button></div>';
            $('#pageAlertArea').html(html);
        }
    </script>
    <script src="@Url.Content("~/js/passport-reader.js")?v=@DateTime.Now.Ticks"></script>
