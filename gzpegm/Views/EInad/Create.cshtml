                    </div>
                    <div class="form-group col-md-3">
                        <label class="font-weight-bold">Giden Havayolu / Taşıyıcı</label>
                        <input list="airlineList" class="form-control" id="GidenHavayolu" name="GidenHavayolu" value="@(Model?.GidenHavayolu ?? "")" placeholder="Seçin veya yazın">
                    </div>
                    <div class="form-group col-md-3">
                        <label class="font-weight-bold">Gidiş Yeri (Hedef Liman/Kapı)</label>
