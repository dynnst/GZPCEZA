                <tr style="height:8pt;">
                    <td style="width:488.6pt; border-bottom-style:solid; border-bottom-width:0.75pt; padding-right:5.03pt; padding-left:5.03pt; vertical-align:top;">
                        <p style="margin-top:0pt; margin-bottom:0pt; line-height:90%; font-size:7.5pt;">You can use the toilet, sink, shower, bed, and, if available, television, radio, WiFi as provided by the airport operator) in the room, free of charge.</p>
                    </td>
