        <table cellspacing="0" cellpadding="0" style="margin-right: auto; margin-left: auto; border: 0.75pt solid rgb(0, 0, 0); border-collapse: collapse; width: 100%;">
            <tbody>
                <tr style="height:12.75pt;">
                    <td style="width:488.6pt; border-bottom-style:solid; border-bottom-width:0.75pt; padding-right:5.03pt; padding-left:5.03pt; vertical-align:middle; background-color:#bfbfbf;">
                        <p style="margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:8pt;"><strong>DİĞER BİLGİLER /&nbsp;</strong>OTHER INFORMATION<strong>&nbsp;</strong></p>
                    </td>
