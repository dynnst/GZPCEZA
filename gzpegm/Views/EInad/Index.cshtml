@model IEnumerable<gzpegm.Models.E_Inad>
@using System.Web
@using gzpegm.Models
@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseDataTables = true;
    ViewBag.Title = "İNAD Yönetim Sistemi";
    var totalRecords = Model == null ? 0 : Model.Count();
    var fromVal = ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "";
    var toVal = ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "";
    var searchText = ViewBag.SearchText as string ?? "";
    var selectedBorder = ViewBag.SelectedBorder as string ?? "";
    var selectedUser = ViewBag.SelectedUser as string ?? "";
    var isAdmin = ViewBag.IsAdmin is bool && (bool)ViewBag.IsAdmin;
    var myBorder = ViewBag.MyBorder as string ?? "";
    var baseUrl = Url.Action("Index", "EInad");

    var currentParams = "";
    if (!string.IsNullOrEmpty(fromVal)) { currentParams += (currentParams == "" ? "?" : "&") + "from=" + fromVal; }
    if (!string.IsNullOrEmpty(toVal)) { currentParams += (currentParams == "" ? "?" : "&") + "to=" + toVal; }
    if (!string.IsNullOrEmpty(searchText)) { currentParams += (currentParams == "" ? "?" : "&") + "q=" + HttpUtility.UrlEncode(searchText); }
    if (!string.IsNullOrEmpty(selectedBorder)) { currentParams += (currentParams == "" ? "?" : "&") + "border=" + HttpUtility.UrlEncode(selectedBorder); }
    if (!string.IsNullOrEmpty(selectedUser)) { currentParams += (currentParams == "" ? "?" : "&") + "userCode=" + HttpUtility.UrlEncode(selectedUser); }
    var exportPdfUrl = baseUrl + currentParams + (currentParams == "" ? "?" : "&") + "export=pdf";
    var exportXlsUrl = baseUrl + currentParams + (currentParams == "" ? "?" : "&") + "export=excel";

    var kpiTotal = ViewBag.TotalCount ?? totalRecords;
    var kpiOdada = ViewBag.InadOdadaCount ?? 0;
    var kpiEdildi = ViewBag.InadEdildiCount ?? 0;
    var kpiBugun = ViewBag.TodayCount ?? 0;
}

@section Styles {
    <link href="@Url.Content("~/css/einad-index.css")?v=2.0" rel="stylesheet" />
}

<div class="einad-page-wrapper">
    <!-- Executive Command Header -->
    <div class="einad-command-banner mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <div class="einad-badge-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="ml-3">
                    <h2 class="einad-command-title mb-0">E-İNAD Yolcu Takip & İşlem Merkezi</h2>
                    <p class="einad-command-subtitle mb-0">
                        Kabul Edilemez Yolcu (INAD) Kayıt, Tutanak Tanzimi ve Sevk Yönetimi
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                @if (!string.IsNullOrEmpty(myBorder))
                {
                    <span class="badge badge-pill badge-primary px-3 py-2 mr-2">
                        <i class="fas fa-map-marker-alt mr-1"></i> @myBorder
                    </span>
                }
                <a href="@Url.Action("Create", "EInad")" class="btn btn-warning font-weight-bold shadow-sm">
                    <i class="fas fa-plus-circle mr-1"></i> Yeni İNAD Kaydı Ekle
                </a>
            </div>
        </div>
    </div>

    <!-- 4 Interactive Executive KPI Cards -->
    <div class="row mb-4">
        <!-- KPI 1: Toplam İNAD -->
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="card einad-kpi-card kpi-total" onclick="filterByKpi('all')" title="Tüm kayıtları listelemek için tıklayın">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-label">Toplam İNAD Kaydı</div>
                            <div class="kpi-value">@kpiTotal</div>
                            <div class="kpi-hint"><i class="fas fa-database mr-1"></i> Yetkili Bölge Geneli</div>
                        </div>
                        <div class="kpi-icon-wrap bg-primary-soft text-primary">
                            <i class="fas fa-folder-open"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 2: İnad Odasında Bekleyenler (Pulsing Warning) -->
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="card einad-kpi-card kpi-odada @(kpiOdada > 0 ? "has-active-warning" : "")" onclick="filterByKpi('odada')" title="İnad Odasında bekleyenleri listelemek için tıklayın">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-label">
                                İnad Odasında Bekleyenler
                                @if (kpiOdada > 0)
                                {
                                    <span class="badge badge-warning blink ml-1">Takipte</span>
                                }
                            </div>
                            <div class="kpi-value text-warning">@kpiOdada</div>
                            <div class="kpi-hint"><i class="fas fa-clock mr-1"></i> Sevk bekleyen yolcular</div>
                        </div>
                        <div class="kpi-icon-wrap bg-warning-soft text-warning">
                            <i class="fas fa-user-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 3: İnad Edilenler (Deported) -->
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="card einad-kpi-card kpi-edildi" onclick="filterByKpi('edildi')" title="İnad edilen yolcuları listelemek için tıklayın">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-label">İnad Edilenler</div>
                            <div class="kpi-value text-success">@kpiEdildi</div>
                            <div class="kpi-hint"><i class="fas fa-check-double mr-1"></i> Sevk işlemi tamamlananlar</div>
                        </div>
                        <div class="kpi-icon-wrap bg-success-soft text-success">
                            <i class="fas fa-plane-departure"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 4: Bugün İşlem Görenler -->
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="card einad-kpi-card kpi-bugun" onclick="filterByKpi('bugun')" title="Bugün işlem görenleri listelemek için tıklayın">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-label">Bugün İşlem Görenler</div>
                            <div class="kpi-value text-info">@kpiBugun</div>
                            <div class="kpi-hint"><i class="fas fa-calendar-check mr-1"></i> Günlük Nöbet İcmali</div>
                        </div>
                        <div class="kpi-icon-wrap bg-info-soft text-info">
                            <i class="fas fa-calendar-day"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Section Card -->
    <section class="card einad-main-card">
        <div class="card-body">
            @if (TempData["msgSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["msgSuccess"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">&times;</button>
                </div>
            }
            @if (TempData["msgError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["msgError"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">&times;</button>
                </div>
            }

            <div id="einadStatus" class="alert einad-status" role="status" aria-live="polite"></div>

            <!-- Modern Filter Toolbar -->
            <form method="get" action="@baseUrl" id="inadFilterForm" class="mb-4 einad-filter-box">
                <div class="row align-items-end">
                    <div class="col-lg-3 col-md-6 mb-2">
                        <label class="small font-weight-bold text-muted mb-1"><i class="fas fa-search mr-1"></i> Hızlı Arama</label>
                        <input type="text" name="q" id="filterQ" value="@searchText" class="form-control form-control-sm" placeholder="Ad, uyruk, pasaport, kapı ara..." />
                    </div>
                    <div class="col-lg-2 col-md-6 mb-2">
                        <label class="small font-weight-bold text-muted mb-1"><i class="fas fa-archway mr-1"></i> Kapı</label>
                        <select name="border" class="form-control form-control-sm">
                            <option value="">Tüm Kapılar</option>
                            @foreach (var item in (ViewBag.BorderList as List<string> ?? new List<string>()))
                            {
                                <option value="@item" @(selectedBorder == item ? "selected" : "")>@item</option>
                            }
                        </select>
                    </div>
                    @if (isAdmin)
                    {
                        <div class="col-lg-2 col-md-6 mb-2">
                            <label class="small font-weight-bold text-muted mb-1"><i class="fas fa-user-shield mr-1"></i> Kullanıcı</label>
                            <select name="userCode" class="form-control form-control-sm">
                                <option value="">Tüm Kullanıcılar</option>
                                @foreach (var item in (ViewBag.UserList as List<string> ?? new List<string>()))
                                {
                                    <option value="@item" @(selectedUser == item ? "selected" : "")>@item</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-lg-2 col-md-3 mb-2">
                        <label class="small font-weight-bold text-muted mb-1"><i class="fas fa-calendar-alt mr-1"></i> Başlangıç</label>
                        <input type="date" name="from" id="filterFrom" value="@fromVal" class="form-control form-control-sm" />
                    </div>
                    <div class="col-lg-2 col-md-3 mb-2">
                        <label class="small font-weight-bold text-muted mb-1"><i class="fas fa-calendar-alt mr-1"></i> Bitiş</label>
                        <input type="date" name="to" id="filterTo" value="@toVal" class="form-control form-control-sm" />
                    </div>
                    <div class="col-lg-1 col-md-12 mb-2 d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm btn-block" title="Filtrele">
                            <i class="fas fa-filter"></i>
                        </button>
                        <a href="@baseUrl" class="btn btn-light btn-sm border" title="Filtreyi Temizle">
                            <i class="fas fa-undo"></i>
                        </a>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="text-muted small">
                        <i class="fas fa-info-circle text-primary mr-1"></i> @(ViewBag.ResultInfo ?? "Son kayıtlar listeleniyor.")
                    </span>
                    <div class="btn-group">
                        <a href="@exportPdfUrl" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-file-pdf mr-1"></i> PDF Aktar
                        </a>
                        <a href="@exportXlsUrl" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-file-excel mr-1"></i> Excel Aktar
                        </a>
                    </div>
                </div>
            </form>

            <!-- Data Table -->
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 einad-table" id="inad-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Tarih & Saat</th>
                            <th>Yolcu Adı Soyadı</th>
                            <th>Uyruk</th>
                            <th>Pasaport No</th>
                            <th>Kapı</th>
                            <th>Durum (Tek Tıkla Güncelle)</th>
                            <th>Sicil</th>
                            <th style="min-width: 175px;">Eylemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1; }
                        @foreach (var r in Model ?? Enumerable.Empty<gzpegm.Models.E_Inad>())
                        {
                            <tr data-inad-id="@r.InadId">
                                <td class="text-muted font-weight-bold">@(i++)</td>
                                <td class="nowrap">
                                    <i class="far fa-clock text-muted mr-1"></i>
                                    @(r.TarihSaat.HasValue ? r.TarihSaat.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark">@(r.AdSoyad ?? "-")</div>
                                    @if (!string.IsNullOrEmpty(r.GelenUcusNo))
                                    {
                                        <small class="text-muted"><i class="fas fa-plane mr-1"></i>@r.GelenUcusNo</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-light border text-dark font-weight-normal px-2 py-1">
                                        <i class="fas fa-globe text-primary mr-1"></i> @(r.Uyruk ?? "-")
                                    </span>
                                </td>
                                <td>
                                    <code>@(r.PasaportNo ?? "-")</code>
                                </td>
                                <td>@(r.Kapi ?? "-")</td>

                                <td>
                                    @if (r.Durum == "İnad Edildi")
                                    {
                                        <button type="button"
                                                class="inad-status-btn status-edildi"
                                                data-inad-id="@r.InadId"
                                                data-next-status="İnad Odasına Alındı"
                                                aria-label="Durumu 'İnad Odasına Alındı' yapmak için tıklayın"
                                                title="Durumu 'İnad Odasına Alındı' yapmak için tıklayın">
                                            <i class="fas fa-check-circle"></i> @r.Durum
                                        </button>
                                    }
                                    else if (!string.IsNullOrEmpty(r.Durum) && (r.Durum.Contains("Oda") || r.Durum.Contains("oda")))
                                    {
                                        <button type="button"
                                                class="inad-status-btn status-odada blink"
                                                data-inad-id="@r.InadId"
                                                data-next-status="İnad Edildi"
                                                aria-label="Durumu 'İnad Edildi' yapmak için tıklayın"
                                                title="Durumu 'İnad Edildi' yapmak için tıklayın">
                                            <i class="fas fa-exclamation-circle"></i> @r.Durum
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="inad-status-btn status-diger">
                                            @r.Durum
                                        </span>
                                    }
                                </td>

                                <td><span class="badge badge-light border">@r.Sicil</span></td>
                                <td class="actions">
                                    <div class="btn-group mr-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle font-weight-bold" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fas fa-print mr-1"></i> Yazdır
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right shadow">
                                            <a class="dropdown-item font-weight-bold text-primary border-bottom py-2" href="@Url.Action("Print", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-desktop mr-2 text-primary"></i> <strong>Yazdırma & Sevk Konsolu</strong>
                                            </a>
                                            <a class="dropdown-item py-2" target="_blank" rel="noopener noreferrer" href="@Url.Action("PrintForm1", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-file-invoice text-info mr-2"></i> Form 1 - Bilgi Formu (Yolcuya)
                                            </a>
                                            <a class="dropdown-item py-2" target="_blank" rel="noopener noreferrer" href="@Url.Action("PrintForm2", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-file-signature text-primary mr-2"></i> Form 2 - İNAD Bildirim Formu
                                            </a>
                                            <a class="dropdown-item py-2" target="_blank" rel="noopener noreferrer" href="@Url.Action("PrintForm3", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-user-slash text-warning mr-2"></i> Form 3 - Takip & Tebellüğ Tutanağı
                                            </a>
                                            <a class="dropdown-item py-2" target="_blank" rel="noopener noreferrer" href="@Url.Action("PrintForm4", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-plane-departure text-success mr-2"></i> Form 4 - Uçağa Kabul & Sevk Tutanağı
                                            </a>
                                            <a class="dropdown-item py-2" target="_blank" rel="noopener noreferrer" href="@Url.Action("PrintForm5", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-boxes text-dark mr-2"></i> Form 5 - Teslim Tesellüm Tutanağı
                                            </a>
                                            <a class="dropdown-item py-2" target="_blank" rel="noopener noreferrer" href="@Url.Action("PrintForm6", "EInad", new { id = r.InadId })">
                                                <i class="fas fa-search text-danger mr-2"></i> Form 6 - Üst Arama Tutanağı
                                            </a>
                                        </div>
                                    </div>

                                    <a href="@Url.Action("Edit", "EInad", new { id = r.InadId })" class="btn btn-sm btn-outline-secondary" title="Kaydı Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteRecord(@r.InadId)" title="Kaydı Sil">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<!-- Datalist for Airlines -->
<datalist id="airlineList"></datalist>

@section Scripts {
    <div id="einad-config"
         data-url-get-airlines="@Url.Action("GetEuropeanAirlines", "EInad")"
         data-url-add-airline="@Url.Action("AddUserDefinedAirline", "EInad")"
         data-url-get-iata="@Url.Action("GetByIataCode", "EInad")"
         data-url-add-inad="@Url.Action("AddInad", "EInad")"
         data-url-get-border="@Url.Action("GetMyBorder", "EInad")"
         data-url-get-inad="@Url.Action("GetInad", "EInad")"
         data-url-edit-inad="@Url.Action("EditInad", "EInad")"
         data-url-get-countries="@Url.Action("GetCountries", "EInad")"
         data-url-delete-inad="@Url.Action("DeleteInad", "EInad")"
         data-url-update-status="@Url.Action("UpdateStatus", "EInad")"
         data-url-scan-image="@Url.Action("ScanPassportImage", "EInad")"
          data-url-scan-passport="@Url.Action("ScanPassport", "EInad")"
         data-url-connect-3m="@Url.Action("Connect3MReader", "EInad")"
         data-url-status-3m="@Url.Action("Get3MReaderStatus", "EInad")"
         style="display:none;"></div>
    <script src="@Url.Content("~/js/einad-index.js")?v=@DateTime.Now.Ticks"></script>
}
