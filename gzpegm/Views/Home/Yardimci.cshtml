@{
    ViewBag.Title = "Kullanıcı Rehberi ve İşlem Kılavuzu";
    Layout = "~/Views/Shared/_Master.cshtml";
}

@section Styles {
<style>
    /* ==========================================================================
       CEZAM Kapsamlı Kullanıcı ve İşlem Rehberi Stilleri
       ========================================================================== */
    .guide-wrapper {
        padding: 10px 0 35px 0;
        color: #243342;
    }

    /* Hero Banner */
    .guide-hero {
        background: linear-gradient(135deg, #0e273c 0%, #173b57 60%, #1f4e72 100%);
        border-radius: 12px;
        padding: 35px 30px;
        color: #fff;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(14, 39, 60, 0.25);
    }
    .guide-hero::after {
        content: "";
        position: absolute;
        right: -60px;
        bottom: -60px;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
        pointer-events: none;
    }
    .guide-hero h1 {
        font-size: 2.1rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .guide-hero .hero-badge {
        font-size: 0.78rem;
        background: rgba(255, 193, 7, 0.22);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.45);
        padding: 4px 12px;
        border-radius: 30px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .guide-hero p {
        font-size: 1.05rem;
        color: #c5d7e6;
        max-width: 850px;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    /* Arama Barı */
    .guide-search-box {
        position: relative;
        max-width: 650px;
    }
    .guide-search-box input {
        width: 100%;
        height: 50px;
        padding: 10px 20px 10px 48px;
        border-radius: 30px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.95);
        color: #1a2c3e;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.25s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }
    .guide-search-box input:focus {
        background: #fff;
        border-color: #38a169;
        outline: none;
        box-shadow: 0 6px 20px rgba(56, 161, 105, 0.25);
    }
    .guide-search-box i {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #718096;
        font-size: 1.15rem;
    }

    /* Hızlı Filtre Butonları */
    .quick-filter-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }
    .pill-btn {
        background: rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .pill-btn:hover, .pill-btn.active {
        background: #2b6cb0;
        color: #fff;
        border-color: #4299e1;
        transform: translateY(-1px);
    }

    /* Ana Layout: Sol Tab Menü + Sağ İçerik */
    .guide-layout {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 24px;
        align-items: flex-start;
    }

    /* Sol Menü */
    .guide-nav {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        position: sticky;
        top: 20px;
    }
    .guide-nav-title {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #718096;
        margin-bottom: 12px;
        padding-left: 8px;
    }
    .guide-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .guide-menu li {
        margin-bottom: 5px;
    }
    .guide-menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 8px;
        color: #334e68;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
    }
    .guide-menu a i {
        font-size: 1.1rem;
        width: 22px;
        text-align: center;
        color: #627d98;
        transition: color 0.2s;
    }
    .guide-menu a:hover {
        background: #f0f4f8;
        color: #102a43;
        transform: translateX(2px);
    }
    .guide-menu a.active {
        background: #ebf8ff;
        color: #2b6cb0;
        border-left-color: #3182ce;
    }
    .guide-menu a.active i {
        color: #3182ce;
    }

    /* Sağ İçerik Kartları */
    .guide-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 26px 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .guide-card:hover {
        box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }
    .guide-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        margin-bottom: 18px;
        border-bottom: 2px solid #edf2f7;
        flex-wrap: wrap;
        gap: 12px;
    }
    .guide-card-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #1a365d;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }
    .guide-card-title i {
        color: #3182ce;
        background: #ebf8ff;
        padding: 8px;
        border-radius: 8px;
        font-size: 1.2rem;
    }
    .guide-badge-role {
        background: #edf2f7;
        color: #4a5568;
        border: 1px solid #cbd5e0;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
    }

    /* Adım Adım İşlem Akışı (Timeline / Stepper) */
    .steps-container {
        position: relative;
        padding-left: 36px;
        margin: 20px 0;
    }
    .steps-container::before {
        content: "";
        position: absolute;
        left: 14px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: #cbd5e0;
    }
    .step-item {
        position: relative;
        margin-bottom: 20px;
    }
    .step-item:last-child {
        margin-bottom: 0;
    }
    .step-number {
        position: absolute;
        left: -36px;
        top: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #3182ce;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
        box-shadow: 0 0 0 4px #fff, 0 2px 6px rgba(49, 130, 206, 0.4);
    }
    .step-content {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 14px 18px;
    }
    .step-title {
        font-size: 0.98rem;
        font-weight: 800;
        color: #2d3748;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .step-desc {
        font-size: 0.88rem;
        color: #4a5568;
        line-height: 1.5;
        margin: 0;
    }

    /* Canlı Senaryo & Püf Noktası Kutusu */
    .scenario-box {
        background: linear-gradient(135deg, #f0fff4 0%, #e6fffa 100%);
        border: 1px solid #b2f5ea;
        border-left: 5px solid #38a169;
        border-radius: 8px;
        padding: 16px 20px;
        margin: 18px 0;
    }
    .scenario-box-title {
        font-weight: 800;
        font-size: 0.95rem;
        color: #22543d;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }

    /* Dikkat / Uyarı Kutusu */
    .warning-box {
        background: linear-gradient(135deg, #fffaf0 0%, #feebc8 100%);
        border: 1px solid #fbd38d;
        border-left: 5px solid #dd6b20;
        border-radius: 8px;
        padding: 16px 20px;
        margin: 18px 0;
    }
    .warning-box-title {
        font-weight: 800;
        font-size: 0.95rem;
        color: #7b341e;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }

    /* İnteraktif Simülatör Kartı */
    .simulator-card {
        background: #1a202c;
        border-radius: 10px;
        padding: 20px;
        color: #e2e8f0;
        margin: 18px 0;
        box-shadow: inset 0 2px 6px rgba(0,0,0,0.4);
    }
    .simulator-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #2d3748;
        padding-bottom: 10px;
        margin-bottom: 14px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #a0aec0;
    }
    .sim-tag {
        background: #319795;
        color: #fff;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.72rem;
        font-weight: 700;
    }

    /* Canlı Animasyonlu Nabız Efekti */
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(49, 130, 206, 0.5); }
        70% { box-shadow: 0 0 0 10px rgba(49, 130, 206, 0); }
        100% { box-shadow: 0 0 0 0 rgba(49, 130, 206, 0); }
    }
    .pulse-glow {
        animation: pulseGlow 2s infinite;
    }

    /* Buton Linki */
    .btn-guide-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #3182ce;
        color: #fff !important;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 8px 18px;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-guide-action:hover {
        background: #2b6cb0;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(49, 130, 206, 0.3);
    }

    /* SSS Akordeon */
    .faq-item {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: 10px;
        overflow: hidden;
        background: #fff;
    }
    .faq-question {
        padding: 14px 18px;
        font-weight: 700;
        color: #2d3748;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f7fafc;
        transition: background 0.2s;
    }
    .faq-question:hover {
        background: #edf2f7;
    }
    .faq-answer {
        padding: 16px 18px;
        font-size: 0.9rem;
        color: #4a5568;
        line-height: 1.55;
        border-top: 1px solid #e2e8f0;
        display: none;
    }
    .faq-item.open .faq-answer {
        display: block;
    }
    .faq-item.open .faq-icon {
        transform: rotate(180deg);
    }
    .faq-icon {
        transition: transform 0.2s;
    }

    @@media (max-width: 991px) {
        .guide-layout {
            grid-template-columns: 1fr;
        }
        .guide-nav {
            position: static;
            margin-bottom: 20px;
        }
    }

    /* ==========================================================================
       Ceza Hesaplama Ön Planda - Amiral Gemisi & Simülatör Stilleri
       ========================================================================== */
    .flagship-ceza-card {
        border: 2px solid #3182ce !important;
        box-shadow: 0 12px 36px rgba(49, 130, 206, 0.18) !important;
        position: relative;
        overflow: hidden;
        background: #ffffff;
    }
    .flagship-ceza-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #3182ce, #00d2ff, #f6ad55, #38a169, #3182ce);
        background-size: 300% 100%;
        animation: gradientFlow 4s linear infinite;
        z-index: 2;
    }
    @@keyframes gradientFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    .flagship-nav-item {
        background: #ebf8ff !important;
        color: #2b6cb0 !important;
        border-left: 3px solid #3182ce !important;
        font-weight: 800 !important;
    }
    .ceza-flagship-badge {
        background: linear-gradient(135deg, #1a365d, #2b6cb0);
        color: #ffd700;
        border: 1px solid rgba(255, 215, 0, 0.45);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.25);
        animation: badgePulse 2.5s infinite;
    }
    @@keyframes badgePulse {
        0%, 100% { transform: scale(1); box-shadow: 0 0 8px rgba(255, 215, 0, 0.2); }
        50% { transform: scale(1.03); box-shadow: 0 0 16px rgba(255, 215, 0, 0.4); }
    }

    /* İnteraktif Simülatör (Dark Sci-Fi Cyber Paneli) */
    .ceza-simulator-wrap {
        background: radial-gradient(circle at top left, #162436 0%, #0c1521 100%);
        border: 1px solid #2b4566;
        border-radius: 12px;
        padding: 22px;
        color: #e2e8f0;
        margin: 22px 0;
        box-shadow: 0 10px 28px rgba(0,0,0,0.35);
        position: relative;
    }
    .ceza-sim-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #23374e;
        padding-bottom: 12px;
        margin-bottom: 18px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .ceza-sim-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #38bdf8;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }
    .sim-ctrl-label {
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #93c5fd;
        margin-bottom: 5px;
        display: block;
    }
    .sim-input-dark {
        background: #111e2e;
        border: 1px solid #2b4566;
        color: #fff;
        border-radius: 6px;
        padding: 8px 12px;
        width: 100%;
        font-size: 0.88rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .sim-input-dark:focus {
        outline: none;
        border-color: #38bdf8;
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.35);
        background: #16253a;
    }
    .sim-presets-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 6px;
    }
    .sim-preset-btn {
        background: rgba(255, 255, 255, 0.07);
        color: #cbd5e1;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 14px;
        padding: 3px 10px;
        font-size: 0.73rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.18s;
    }
    .sim-preset-btn:hover, .sim-preset-btn.active {
        background: #2563eb;
        color: #fff;
        border-color: #60a5fa;
        transform: translateY(-1px);
    }
    .sim-toggle-pill {
        display: flex;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 3px;
        gap: 4px;
    }
    .sim-toggle-opt {
        flex: 1;
        text-align: center;
        padding: 7px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        color: #94a3b8;
    }
    .sim-toggle-opt.active-paid {
        background: #059669;
        color: #fff;
        box-shadow: 0 0 10px rgba(5, 150, 105, 0.5);
    }
    .sim-toggle-opt.active-unpaid {
        background: #dc2626;
        color: #fff;
        box-shadow: 0 0 10px rgba(220, 38, 38, 0.5);
    }
    .btn-sim-run {
        background: linear-gradient(135deg, #2563eb 0%, #0284c7 50%, #0d9488 100%);
        color: #fff;
        border: none;
        font-weight: 800;
        font-size: 0.95rem;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        transition: all 0.25s;
        box-shadow: 0 4px 16px rgba(37, 99, 235, 0.4);
        margin-top: 14px;
    }
    .btn-sim-run:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(2, 132, 199, 0.6);
    }

    /* Animasyonlu Pipeline Stepper */
    .sim-pipeline {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin: 18px 0;
    }
    .pipe-step {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid #22374e;
        border-radius: 8px;
        padding: 10px 8px;
        text-align: center;
        transition: all 0.3s;
        position: relative;
    }
    .pipe-step.pipe-active {
        background: rgba(56, 189, 248, 0.15);
        border-color: #38bdf8;
        box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
        transform: scale(1.02);
    }
    .pipe-num {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #1e293b;
        color: #94a3b8;
        font-weight: 800;
        font-size: 0.75rem;
        margin: 0 auto 5px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }
    .pipe-step.pipe-active .pipe-num {
        background: #38bdf8;
        color: #0c1521;
        box-shadow: 0 0 8px #38bdf8;
    }
    .pipe-title {
        font-size: 0.74rem;
        font-weight: 700;
        color: #e2e8f0;
        line-height: 1.3;
    }

    /* Canlı Sonuç Kutuları */
    .sim-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 10px;
        margin: 14px 0;
    }
    .sim-stat-card {
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 10px;
        text-align: center;
        transition: all 0.3s;
    }
    .sim-stat-card.stat-primary {
        border-color: #38bdf8;
        background: rgba(56, 189, 248, 0.08);
    }
    .sim-stat-card.stat-gold {
        border-color: #f59e0b;
        background: rgba(245, 158, 11, 0.12);
    }
    .sim-stat-title {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 4px;
    }
    .sim-stat-number {
        font-size: 1.15rem;
        font-weight: 800;
        color: #fff;
        font-family: 'Courier New', monospace;
    }

    /* Tahdit ve Karar Sonuç Alanı */
    .sim-decision-result {
        border-radius: 8px;
        padding: 14px 18px;
        margin-top: 14px;
        display: none;
        animation: fadeInBox 0.4s ease;
    }
    @@keyframes fadeInBox {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .sim-res-paid {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 95, 70, 0.3));
        border: 1px solid #10b981;
        color: #ecfdf5;
        box-shadow: 0 0 18px rgba(16, 185, 129, 0.2);
    }
    .sim-res-unpaid {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.12), rgba(153, 27, 27, 0.3));
        border: 1px solid #ef4444;
        color: #fef2f2;
        box-shadow: 0 0 18px rgba(239, 68, 68, 0.3);
        animation: sirenPulse 1.4s infinite alternate;
    }
    @@keyframes sirenPulse {
        0% { box-shadow: 0 0 10px rgba(239, 68, 68, 0.3); }
        100% { box-shadow: 0 0 25px rgba(239, 68, 68, 0.65); }
    }

    /* İnteraktif Senaryo Sekmeleri */
    .scenario-tabs-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 8px;
        margin: 16px 0;
    }
    .scenario-tab-btn {
        background: #edf2f7;
        color: #4a5568;
        border: 1px solid #cbd5e0;
        border-radius: 6px;
        padding: 6px 14px;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }
    .scenario-tab-btn:hover, .scenario-tab-btn.active {
        background: #2b6cb0;
        color: #fff;
        border-color: #2b6cb0;
    }
    .scenario-tab-pane {
        display: none;
        animation: fadeInBox 0.3s ease;
    }
    .scenario-tab-pane.active {
        display: block;
    }

    @@media (max-width: 768px) {
        .sim-pipeline {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
}

<div class="guide-wrapper">
    <!-- HERO BÖLÜMÜ -->
    <div class="guide-hero">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <h1>
                <i class="fas fa-book-reader text-warning"></i> CEZAM İşlem Rehberi & Operasyon Kılavuzu
