@{
    Layout = "~/Views/Shared/_Master.cshtml";
}

@using System.Globalization
@using System.Collections.Generic
@using gzpegm.Cont
@using gzpegm.Models
@{
    // Harç (gün başı) değeri veritabanından çekilecek (E_TGVH.fldPrice)
    // Kullanmak için yeni GetCurrentPrice helper'ı kullanıyoruz (decimal parsing ile güvenli).
    string harcPerGunValue = "10";
    try
    {
        var _tgvh = new gzpegm.Cont.tgvh();
        var price = _tgvh.GetCurrentPrice(10m);
        harcPerGunValue = price.ToString("0.##", CultureInfo.InvariantCulture);
    }
    catch { /* ignore DB errors, use default */ }

    // Ülke listesi controller tarafında cache'lenerek hazırlanır.
    var uvrCountries = ViewBag.UvrCountries as IEnumerable<string> ?? new List<string>();

    var currentUser = ViewBag.User as gzpegm.Models.E_User;
    var currentUserName = currentUser == null
        ? "Kullanıcı"
        : ((currentUser.fldName ?? "") + " " + (currentUser.fldLastName ?? "")).Trim();
    var currentUserPicture = currentUser == null || string.IsNullOrWhiteSpace(currentUser.fldPicture)
        ? Url.Content("/AdminTemplate/img/a4.jpg")
        : Url.Content("~/files/User/" + currentUser.fldPicture);
    Func<string, string> profileValue = value => string.IsNullOrWhiteSpace(value) ? "Belirtilmemiş" : value;
    var profileTitle = currentUser == null ? null : currentUser.fldTitle;
    var profileRole = currentUser == null ? null : currentUser.Role;
    var profileStatus = currentUser != null && currentUser.fldActive == "0" ? "Pasif" : "Aktif";
    var profileSicil = currentUser == null ? null : currentUser.fldSicil;
    var profilePhone = currentUser == null ? null : currentUser.fldPhone;
    var profileEmail = currentUser == null ? null : currentUser.fldEmail;
    var profileDeputy = currentUser == null ? null : currentUser.fldDeputy;
    var profileBorder = currentUser == null ? null : currentUser.fldBorder;
    var profileAuth = currentUser == null ? null : currentUser.fldAuth;

    Func<string, string> getAuthDescription = code =>
    {
        switch ((code ?? "").Trim())
        {
            case "1": return "Kullanıcı İşlemleri";
            case "2": return "Admin / Sistem Tanımları";
            case "3": return "Ceza, Tahdit ve Şartlı Vize";
            case "4": return "Eski İşlemler / Raporlar";
            case "5": return "Duyuru ve Mesajlar";
            case "6": return "Eğitim Yönetimi";
            case "0": return "Temel Erişim";
            default: return string.IsNullOrWhiteSpace(code) ? "" : "Yetki " + code;
        }
    };

    var authCodesList = (profileAuth ?? "")
        .Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrEmpty(x))
        .Distinct()
        .ToList();

    var authDescriptionList = authCodesList
        .Select(c => getAuthDescription(c))
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .ToList();
    var pendingInadList = ViewBag.PendingInadList as List<gzpegm.Models.E_Inad> ?? new List<gzpegm.Models.E_Inad>();
    var pendingInadCount = ViewBag.PendingInadCount != null ? (int)ViewBag.PendingInadCount : pendingInadList.Count;
    var inadUserBorder = ViewBag.InadUserBorder as string ?? "";
}

@section Styles {
    <link href="@Url.Content("~/css/home-index.css")?v=@DateTime.Now.Ticks" rel="stylesheet" />
}


<div class="home-workspace">
    <section class="home-hero" aria-labelledby="homeTitle">
        <div>
            <div class="home-eyebrow"><i class="fas fa-shield-alt"></i>İŞLEM EKRANLARI</div>
            <h1 id="homeTitle" class="home-title">Ceza, vize ve tahdit işlemleri için hızlı çalışma alanı</h1>
            <p class="home-summary">Sık kullanılan hesaplama, belge, sözlük ve kontrol ekranları tek yerde toplandı. Tüm bağlantılar yerel proje dosyaları ve mevcut modüller üzerinden çalışır.</p>
            <div class="home-primary-actions">
                <a href="@Url.Action("Index", "Calculate")" class="home-primary-btn">
                    <i class="fas fa-calculator"></i> Hesaplama
                </a>
                <button id="openKaseVizeModal" type="button" class="home-secondary-btn" data-toggle="modal" data-target="#kaseVizeModal">
                    <i class="fas fa-passport"></i> Kaşe Vize Kontrolü
                </button>
            </div>
        </div>
        <aside class="home-profile-card" aria-label="Profil tanıtımı">
            <div class="home-profile-head">
                <img class="home-profile-avatar" src="@currentUserPicture" alt="@currentUserName" />
                <div>
                    <h2 class="home-profile-name">@profileValue(currentUserName)</h2>
                    <div class="home-profile-title">@profileValue(profileTitle)</div>
                    <div class="home-profile-badges">
                        <span class="home-profile-badge">@profileValue(profileRole)</span>
                        <span class="home-profile-badge">@profileStatus</span>
                    </div>
                </div>
            </div>
            <div class="home-profile-grid">
                <div class="home-profile-field"><span>Sicil</span><strong>@profileValue(profileSicil)</strong></div>
                <div class="home-profile-field"><span>Telefon</span><strong>@profileValue(profilePhone)</strong></div>
                <div class="home-profile-field"><span>E-Posta</span><strong>@profileValue(profileEmail)</strong></div>
                <div class="home-profile-field"><span>Görev Yeri</span><strong>@profileValue(profileDeputy)</strong></div>
                <div class="home-profile-field"><span>Hudut Kapısı</span><strong>@profileValue(profileBorder)</strong></div>
                <div class="home-profile-field">
                    <span>Yetkiler</span>
                    @if (authDescriptionList.Any())
                    {
                        <div style="display:flex; flex-wrap:wrap; gap:4px; margin-top:4px;">
                            @foreach (var authText in authDescriptionList)
                            {
                                <span class="badge" style="background:#eaf2f9; color:#1e425e; font-size:0.72rem; font-weight:600; padding:3px 6px; border:1px solid #c8dff1; border-radius:4px; text-transform:none; display:inline-flex; align-items:center; line-height:1.2;">
                                    <i class="fas fa-shield-alt text-primary me-1" style="margin-right:3px; font-size:0.65rem;"></i>@authText
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <strong>Belirtilmemiş</strong>
                    }
                </div>
            </div>
            <div class="home-profile-note">
                <i class="fas fa-id-card"></i>
                <span>Bu alan profil bilgilerini sadece tanıtım amaçlı gösterir; resim, şifre veya bilgi değiştirme işlemi içermez.</span>
            </div>
        </aside>
    </section>


        @if (pendingInadCount > 0)
    {
        <section class="inad-alert-wrapper mb-4" id="inadAlertBanner">
            <div class="inad-pulse-card">
                <div class="inad-pulse-left">
                    <div class="inad-bell-badge">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div>
                        <div class="inad-pulse-badge">
                            <i class="fas fa-door-open mr-1"></i> İNAD ODASI HATIRLATMASI &bull; @inadUserBorder
                        </div>
                        <h4 class="inad-pulse-title">
                            Kapınızda İnad Odasında Bekleyen <span class="badge badge-danger inad-count-badge">@pendingInadCount</span> Yolcu Bulunmaktadır
                        </h4>
                        <p class="inad-pulse-desc">
                            Yolcu uçağa verilip sınır dışı edildiyse, lütfen durumunu <strong>"İnad Edildi"</strong> olarak güncelleyiniz.
                        </p>
                    </div>
                </div>
                <div class="inad-pulse-actions">
                    <button type="button" class="btn-inad-review" data-toggle="modal" data-target="#inadReminderModal">
                        <i class="fas fa-user-check mr-1"></i> Yolcuları İncele & Onayla (@pendingInadCount)
                    </button>
                </div>
            </div>
        </section>
    }

    <section class="home-section" aria-labelledby="quickActionsTitle">
        <div class="home-section-title">
            <h3 id="quickActionsTitle">Hızlı İşlemler</h3>
            <span>Yerel modüller ve dosyalar</span>
        </div>
        <div class="quick-action-grid">
