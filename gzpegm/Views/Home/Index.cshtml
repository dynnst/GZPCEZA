            <div class="modal-header bg-dark text-white">
                <div class="d-flex align-items-center gap-2">
                    <span id="mTahditBadge" class="badge badge-warning font-weight-bold" style="font-size:15px; padding:6px 12px;">Ç-101</span>
                    <h5 class="modal-title font-weight-bold ml-2" id="modalTahditDetailTitle">Tahdit Kodu Açıklaması</h5>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-md-6">
                        <span class="text-muted small text-uppercase font-weight-bold">Kategori</span>
                        <div id="mTahditKategori" class="font-weight-bold text-dark">Giriş Yasağı</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted small text-uppercase font-weight-bold">Yasak / Tedbir Süresi</span>
                        <div id="mTahditSure" class="font-weight-bold text-primary">3 Ay</div>
                    </div>
                </div>
                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small text-uppercase font-weight-bold">Tanım ve Açıklama</span>
                    <div id="mTahditAciklama" class="mt-1 text-dark" style="line-height:1.5;"></div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded border border-danger">
                            <span class="badge badge-danger mb-2"><i class="fas fa-sign-in-alt mr-1"></i>GİRİŞTE YAPILACAK İŞLEM</span>
                            <div id="mTahditGiris" class="small text-dark font-weight-bold"></div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded border border-info">
                            <span class="badge badge-info mb-2"><i class="fas fa-sign-out-alt mr-1"></i>ÇIKIŞTA YAPILACAK İŞLEM</span>
                            <div id="mTahditCikis" class="small text-dark font-weight-bold"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light d-flex justify-content-between">
                <span class="small text-muted"><i class="fas fa-shield-alt mr-1"></i>6458 sayılı YUKK ve EGM Hudut Kapıları Tahdit Prosedürü</span>
                <button type="button" class="btn btn-secondary px-4 font-weight-bold" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div id="home-config"
         data-chart-url="@Url.Action("ChartData", "Grafik")"
         data-harc-per-gun="@harcPerGunValue"
         data-history-labels='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.HistoryChartLabels ?? new List<string>()))'
         data-history-data='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.HistoryChart ?? new List<int>()))'
         data-force-unread-modal="@((ViewBag.ForceUnreadModal != null && (bool)ViewBag.ForceUnreadModal == true).ToString().ToLowerInvariant())"
         data-has-new-courses="@(newCourseBriefs.Any().ToString().ToLowerInvariant())"
         data-new-course-key="@newCourseModalKey"
         style="display:none;"></div>
    <script src="@Url.Content("~/AdminTemplate/js/plugins/chartJs/Chart.min.js")"></script>
    <script src="@Url.Content("~/js/country-documents.js")?v=@DateTime.Now.Ticks"></script>
    <script src="@Url.Content("~/js/home-index.js")?v=@DateTime.Now.Ticks"></script>

    <script>
        // Tahdit Verileri ve Arama Sistemi
        var allTahditData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(tahditCodes));
        var currentTahditCat = 'Tumu';

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }

        function filterTahditList() {
            var q = ($('#tahditQuickSearch').val() || '').trim().toLowerCase();
            var filtered = allTahditData.filter(function(item) {
                var catMatch = (currentTahditCat === 'Tumu') || 
                               (item.Kategori && item.Kategori.indexOf(currentTahditCat) >= 0) ||
                               (item.Kod && item.Kod.indexOf(currentTahditCat) === 0);
                if (!catMatch) return false;
                if (!q) return true;
                return (item.Kod && item.Kod.toLowerCase().indexOf(q) >= 0) ||
                       (item.Baslik && item.Baslik.toLowerCase().indexOf(q) >= 0) ||
                       (item.Aciklama && item.Aciklama.toLowerCase().indexOf(q) >= 0) ||
                       (item.GirisIslem && item.GirisIslem.toLowerCase().indexOf(q) >= 0) ||
                       (item.CikisIslem && item.CikisIslem.toLowerCase().indexOf(q) >= 0);
            });
            renderTahditItems(filtered);
        }

        function renderTahditItems(items) {
            var container = $('#tahditResultsList');
            container.empty();
            if (!items || items.length === 0) {
                container.html('<div class="p-3 text-center text-muted small"><i class="fas fa-search mr-1"></i>Eşleşen tahdit kodu bulunamadı.</div>');
                $('#tahditCountInfo').text('Eşleşen kod yok');
                return;
            }
            $('#tahditCountInfo').text(items.length + ' tahdit kodu listelendi');
            items.slice(0, 15).forEach(function(tk) {
                var el = $('<div class="tahdit-item"></div>')
                    .html('<div class="d-flex align-items-center justify-content-between">' +
                          '<span class="badge ' + tk.BadgeClass + ' tahdit-badge">' + escapeHtml(tk.Kod) + '</span>' +
                          '<span class="tahdit-sure"><i class="fas fa-hourglass-half mr-1"></i>' + escapeHtml(tk.Sure) + '</span>' +
                          '</div>' +
                          '<div class="tahdit-title">' + escapeHtml(tk.Baslik) + '</div>' +
                          '<div class="tahdit-preview text-muted small">' + escapeHtml(tk.Aciklama || '') + '</div>')
                    .on('click', function() {
                        showTahditModal(tk);
                    });
                container.append(el);
            });
        }

        function showTahditByCode(code) {
            var match = allTahditData.find(function(x) { return x.Kod === code; });
            if (match) {
                showTahditModal(match);
            }
        }

        function showTahditModal(tk) {
            $('#mTahditBadge').attr('class', 'badge font-weight-bold ' + tk.BadgeClass).text(tk.Kod);
            $('#modalTahditDetailTitle').text(tk.Baslik);
            $('#mTahditKategori').text(tk.Kategori || 'Standart');
            $('#mTahditSure').text(tk.Sure || 'Belirtilmemiş');
            $('#mTahditAciklama').text(tk.Aciklama || 'Açıklama bulunmuyor.');
            $('#mTahditGiris').text(tk.GirisIslem || 'Normal kontrol yapılır.');
            $('#mTahditCikis').text(tk.CikisIslem || 'Normal kontrol yapılır.');
            $('#modalTahditDetail').modal('show');
        }

        $(document).ready(function() {
            $('#tahditQuickSearch').on('input', function() {
                filterTahditList();
            });

            $('.tahdit-chip').on('click', function() {
                $('.tahdit-chip').removeClass('active');
                $(this).addClass('active');
                currentTahditCat = $(this).data('cat');
                filterTahditList();
            });
        });

        // Duyuru Yayınlama Fonksiyonu
        function submitNewDuyuru() {
            var baslik = ($('#duyuruBaslik').val() || '').trim();
            var kategori = $('#duyuruKategori').val();
            var oncelik = parseInt($('#duyuruOncelik').val()) || 1;
            var icerik = ($('#duyuruIcerik').val() || '').trim();
            var token = $('input[name="__RequestVerificationToken"]').first().val();

            if (baslik.length < 3) {
                alert('Lütfen en az 3 karakterden oluşan bir başlık giriniz.');
                $('#duyuruBaslik').focus();
                return;
            }
            if (icerik.length < 5) {
                alert('Lütfen en az 5 karakterden oluşan bir duyuru metni giriniz.');
                $('#duyuruIcerik').focus();
                return;
            }

            var btn = $('#btnSubmitDuyuru');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Yayınlanıyor...');

            $.ajax({
                url: '@Url.Action("AddDuyuru", "Home")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    baslik: baslik,
                    kategori: kategori,
                    oncelik: oncelik,
                    icerik: icerik
                },
                success: function(res) {
                    btn.prop('disabled', false).html('<i class="fas fa-paper-plane mr-1"></i> Duyuruyu Yayınla');
                    if (res.success) {
                        $('#modalAddDuyuru').modal('hide');
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function() {
                    btn.prop('disabled', false).html('<i class="fas fa-paper-plane mr-1"></i> Duyuruyu Yayınla');
                    alert('Duyuru eklenirken sunucu hatası oluştu.');
                }
            });
        }

        // Duyuru Silme Fonksiyonu
        function deleteDuyuru(id) {
            if (!confirm('Bu duyuruyu yayından kaldırmak istediğinize emin misiniz?')) {
                return;
            }
            var token = $('input[name="__RequestVerificationToken"]').first().val();
            $.ajax({
                url: '@Url.Action("DeleteDuyuru", "Home")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    id: id
                },
                success: function(res) {
                    if (res.success) {
                        $('#duyuru-item-' + id).fadeOut(300, function() {
                            $(this).remove();
                            if ($('.duyuru-item').length === 0) {
                                $('.duyuru-list').html('<div class="hub-empty"><i class="fas fa-bell-slash"></i><p>Şu anda aktif bir duyuru bulunmamaktadır.</p></div>');
                            }
                        });
                    } else {
                        alert(res.message);
                    }
                },
                error: function() {
                    alert('Duyuru silinirken hata oluştu.');
                }
            });
        }
    </script>
}
