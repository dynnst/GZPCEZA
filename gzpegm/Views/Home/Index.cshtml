@{
    Layout = "~/Views/Shared/_Master.cshtml";
}

@using System.Globalization
@using System.Collections.Generic
@using gzpegm.Cont
@using gzpegm.Models
@{
    // Harç (gün başı) değeri veritabanından çekilecek (E_TGVH.fldPrice)
    // Kullanmak için yeni GetCurrentPrice helper'ı kullanıyoruz (decimal parsing ile güvenli).
    string harcPerGunValue = "10";
    try
    {
        var _tgvh = new gzpegm.Cont.tgvh();
        var price = _tgvh.GetCurrentPrice(10m);
        harcPerGunValue = price.ToString("0.##", CultureInfo.InvariantCulture);
    }
    catch { /* ignore DB errors, use default */ }

    // Ülke listesi controller tarafında cache'lenerek hazırlanır.
    var uvrCountries = ViewBag.UvrCountries as IEnumerable<string> ?? new List<string>();

    var currentUser = ViewBag.User as gzpegm.Models.E_User;
    var currentUserName = currentUser == null
        ? "Kullanıcı"
        : ((currentUser.fldName ?? "") + " " + (currentUser.fldLastName ?? "")).Trim();
    var currentUserPicture = currentUser == null || string.IsNullOrWhiteSpace(currentUser.fldPicture)
        ? Url.Content("/AdminTemplate/img/a4.jpg")
        : Url.Content("~/files/User/" + currentUser.fldPicture);
    Func<string, string> profileValue = value => string.IsNullOrWhiteSpace(value) ? "Belirtilmemiş" : value;
    var profileTitle = currentUser == null ? null : currentUser.fldTitle;
    var profileRole = currentUser == null ? null : currentUser.Role;
    var profileStatus = currentUser != null && currentUser.fldActive == "0" ? "Pasif" : "Aktif";
    var profileSicil = currentUser == null ? null : currentUser.fldSicil;
    var profilePhone = currentUser == null ? null : currentUser.fldPhone;
    var profileEmail = currentUser == null ? null : currentUser.fldEmail;
    var profileDeputy = currentUser == null ? null : currentUser.fldDeputy;
    var profileBorder = currentUser == null ? null : currentUser.fldBorder;
    var profileAuth = currentUser == null ? null : currentUser.fldAuth;

    Func<string, string> getAuthDescription = code =>
    {
        switch ((code ?? "").Trim())
        {
            case "1": return "Kullanıcı İşlemleri";
            case "2": return "Admin / Sistem Tanımları";
            case "3": return "Ceza, Tahdit ve Şartlı Vize";
            case "4": return "Eski İşlemler / Raporlar";
            case "5": return "Duyuru ve Mesajlar";
            case "6": return "Eğitim Yönetimi";
            case "0": return "Temel Erişim";
            default: return string.IsNullOrWhiteSpace(code) ? "" : "Yetki " + code;
        }
    };

    var authCodesList = (profileAuth ?? "")
        .Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrEmpty(x))
        .Distinct()
        .ToList();

    var authDescriptionList = authCodesList
        .Select(c => getAuthDescription(c))
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .ToList();

    bool isAdmin = (currentUser != null && string.Equals(currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase)) || authCodesList.Contains("2");
    bool canCore = isAdmin || authCodesList.Contains("3");
    bool canEducation = isAdmin || authCodesList.Contains("3") || authCodesList.Contains("6");
    bool canAdminOld = isAdmin || authCodesList.Contains("4");
    bool isStatSuper = gzpegm.Services.StatService.IsSuperAdmin(currentUser);
    bool isStatKapi = gzpegm.Services.StatService.IsAnyKapiAdmin(currentUser);
    bool canManageStats = isStatSuper || isStatKapi;

    var pendingInadList = ViewBag.PendingInadList as List<gzpegm.Models.E_Inad> ?? new List<gzpegm.Models.E_Inad>();
    var pendingInadCount = ViewBag.PendingInadCount != null ? (int)ViewBag.PendingInadCount : pendingInadList.Count;
    var inadUserBorder = ViewBag.InadUserBorder as string ?? "";

    var duyurular = ViewBag.Duyurular as List<gzpegm.Models.DuyuruItem> ?? new List<gzpegm.Models.DuyuruItem>();
    bool canManageDuyuru = ViewBag.CanManageDuyuru != null && (bool)ViewBag.CanManageDuyuru;
    var recentGenelgeler = ViewBag.RecentGenelgeler as List<gzpegm.Models.Genelge.GenelgeItem> ?? new List<gzpegm.Models.Genelge.GenelgeItem>();
    var tahditCodes = ViewBag.TahditCodes as List<gzpegm.Models.TahditSozlukItem> ?? new List<gzpegm.Models.TahditSozlukItem>();
}

@section Styles {
    <link href="@Url.Content("~/css/home-index.css")?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <style>
        .cd-doc-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            margin-bottom: 8px;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .cd-doc-card:hover {
            background: #f8fafc;
            border-color: #0284c7;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.12);
            transform: translateY(-1px);
        }
        .cd-doc-card.is-confidential {
            border-left: 4px solid #ef4444;
        }
        .cd-doc-icon {
            font-size: 28px;
            width: 36px;
            text-align: center;
            flex-shrink: 0;
        }
        .cd-doc-title {
            font-weight: 700;
            font-size: 14.5px;
            color: #1e293b;
            margin-bottom: 3px;
            word-break: break-word;
        }
        .cd-doc-meta {
            font-size: 12px;
            color: #64748b;
        }
        .cd-doc-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            margin-left: 12px;
        }
        #modalCountryDocViewer {
            z-index: 1080 !important;
        }
    </style>
}


<div class="home-workspace">
    <section class="home-hero" aria-labelledby="homeTitle">
        <div class="home-hero-left">
            <div class="home-eyebrow"><i class="fas fa-shield-alt"></i>İŞLEM EKRANLARI</div>
            <h1 id="homeTitle" class="home-title">Ceza, vize ve tahdit işlemleri için hızlı çalışma alanı</h1>
            <p class="home-summary">Sık kullanılan hesaplama, mevzuat ve operasyonel kontrol ekranları tek yerde toplandı. Tüm bağlantılar yerel proje modülleri üzerinden anlık çalışır.</p>
            <div class="home-primary-actions">
                @if (canCore)
                {
                    <a href="@Url.Action("Index", "Calculate")" class="home-primary-btn">
                        <i class="fas fa-calculator"></i> Ceza Hesaplama
                    </a>
                }
                <button id="openKaseVizeModal" type="button" class="home-secondary-btn" data-toggle="modal" data-target="#kaseVizeModal">
                    <i class="fas fa-passport"></i> Kaşe Vize Kontrolü
                </button>
            </div>
        </div>

        <div class="home-hero-hub">
            <div class="hub-card">
                <div class="hub-header">
                    <ul class="nav nav-pills hub-tabs" id="hubTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="tab-duyuru-btn" data-toggle="pill" href="#tab-duyuru" role="tab">
                                <i class="fas fa-bullhorn text-warning mr-1"></i> Duyurular
                                @if (duyurular.Count > 0)
                                {
                                    <span class="badge badge-warning ml-1">@duyurular.Count</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="tab-genelge-btn" data-toggle="pill" href="#tab-genelge" role="tab">
                                <i class="fas fa-file-contract text-primary mr-1"></i> Son Genelgeler
                                @if (recentGenelgeler.Count > 0)
                                {
                                    <span class="badge badge-info ml-1">@recentGenelgeler.Count</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="tab-tahdit-btn" data-toggle="pill" href="#tab-tahdit" role="tab">
                                <i class="fas fa-book-dead text-danger mr-1"></i> Tahdit Sözlüğü
                            </a>
                        </li>
                    </ul>
                    @if (canManageDuyuru)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary hub-add-btn" data-toggle="modal" data-target="#modalAddDuyuru" title="Yeni Duyuru Yayınla (Admin & Öğretmen)">
                            <i class="fas fa-plus mr-1"></i> Duyuru Ekle
                        </button>
                    }
                </div>

                <div class="tab-content hub-body" id="hubTabContent">
                    <!-- 1. DUYURULAR SEKMESİ -->
                    <div class="tab-pane fade show active" id="tab-duyuru" role="tabpanel">
                        <div class="duyuru-list">
                            @if (duyurular.Any())
                            {
                                foreach (var d in duyurular)
                                {
                                    <div class="duyuru-item kategori-@((d.Kategori ?? "genel").ToLowerInvariant())" id="duyuru-item-@d.Id">
                                        <div class="duyuru-top">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @d.BadgeClass">@d.BadgeText</span>
                                                <span class="duyuru-title">@d.Baslik</span>
                                            </div>
                                            <div class="duyuru-actions">
                                                <span class="duyuru-time text-muted" title="@d.FormattedTarih"><i class="far fa-clock mr-1"></i>@d.TimeAgo</span>
                                                @if (canManageDuyuru)
                                                {
                                                    <button type="button" class="btn-del-duyuru" onclick="deleteDuyuru(@d.Id)" title="Duyuruyu Kaldır">
                                                        <i class="fas fa-trash-alt text-danger"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        <div class="duyuru-desc">
                                            @d.Icerik
                                        </div>
                                        <div class="duyuru-footer">
                                            <span class="duyuru-author"><i class="fas fa-user-shield mr-1"></i>@d.OlusturanAd (@(d.OlusturanRol ?? "Görevli"))</span>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="hub-empty">
                                    <i class="fas fa-bell-slash"></i>
                                    <p>Şu anda aktif bir duyuru bulunmamaktadır.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2. SON EKLENEN GENELGELER SEKMESİ -->
                    <div class="tab-pane fade" id="tab-genelge" role="tabpanel">
                        <div class="genelge-quick-list">
                            @if (recentGenelgeler.Any())
                            {
                                foreach (var g in recentGenelgeler)
                                {
                                    var ext = (g.Extension ?? "").ToLowerInvariant();
                                    string iconClass = "fa-file-pdf text-danger";
                                    if (ext.Contains("doc")) { iconClass = "fa-file-word text-primary"; }
                                    else if (ext.Contains("xls")) { iconClass = "fa-file-excel text-success"; }
                                    else if (ext.Contains("tif") || ext.Contains("jpg") || ext.Contains("png")) { iconClass = "fa-file-image text-warning"; }

                                    <div class="genelge-item">
                                        <div class="genelge-icon"><i class="fas @iconClass"></i></div>
                                        <div class="genelge-info">
                                            <a href="@Url.Action("Viewer", "Genelge", new { path = g.Id })" target="_blank" class="genelge-name" title="@g.Title">
                                                @g.Title
                                            </a>
                                            <div class="genelge-sub">
                                                <span class="badge badge-light border">@(g.FolderTitle ?? "Genelge")</span>
                                                <span class="text-muted"><i class="far fa-calendar-alt ml-2 mr-1"></i>@(g.FormattedDate ?? "Güncel")</span>
                                                <span class="text-muted ml-1">@g.FormattedSize</span>
                                                @if (g.IsConfidential)
                                                {
                                                    <span class="badge badge-danger ml-1"><i class="fas fa-lock mr-1"></i>Gizli</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="genelge-action">
                                            <a href="@Url.Action("Viewer", "Genelge", new { path = g.Id })" target="_blank" class="btn btn-xs btn-outline-info" title="İncele">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="hub-empty">
                                    <i class="fas fa-folder-open"></i>
                                    <p>Henüz listelenecek genelge bulunamadı.</p>
                                </div>
                            }
                            <div class="hub-more text-right mt-2">
                                <a href="@Url.Action("Index", "Genelge")" class="small font-weight-bold text-primary">
                                    Tüm Genelgeleri ve Arşivi Görüntüle <i class="fas fa-arrow-right ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- 3. HIZLI TAHDİT KODU SÖZLÜĞÜ SEKMESİ -->
                    <div class="tab-pane fade" id="tab-tahdit" role="tabpanel">
                        <div class="tahdit-widget">
                            <div class="tahdit-search-wrap">
                                <i class="fas fa-search tahdit-search-icon"></i>
                                <input type="text" id="tahditQuickSearch" class="form-control tahdit-search-input" placeholder="Kod veya tanım ara (Örn: Ç-101, V-84, G-87, kaçak, ceza...)" autocomplete="off" />
                            </div>
                            <div class="tahdit-chips">
                                <button type="button" class="tahdit-chip active" data-cat="Tumu">Tümü</button>
                                <button type="button" class="tahdit-chip" data-cat="Ç">Ç Kodları</button>
                                <button type="button" class="tahdit-chip" data-cat="G">G Kodları</button>
                                <button type="button" class="tahdit-chip" data-cat="V">V Kodları</button>
                                <button type="button" class="tahdit-chip" data-cat="N">N Kodları</button>
                            </div>
                            <div class="tahdit-results" id="tahditResultsList">
                                @foreach (var tk in tahditCodes.Take(8))
                                {
                                    <div class="tahdit-item" data-code="@tk.Kod" data-cat="@tk.Kategori" onclick="showTahditByCode('@tk.Kod')">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="badge @tk.BadgeClass tahdit-badge">@tk.Kod</span>
                                            <span class="tahdit-sure"><i class="fas fa-hourglass-half mr-1"></i>@tk.Sure</span>
                                        </div>
                                        <div class="tahdit-title">@tk.Baslik</div>
                                        <div class="tahdit-preview text-muted small">@tk.Aciklama</div>
                                    </div>
                                }
                            </div>
                            <div class="hub-more d-flex justify-content-between align-items-center mt-2">
                                <span class="small text-muted" id="tahditCountInfo">Toplam @tahditCodes.Count tahdit kodu kayıtlı</span>
                                <a href="@Url.Action("Index", "Tahdit")" target="_blank" class="small font-weight-bold text-primary">
                                    Detaylı Tahdit Modülü <i class="fas fa-external-link-alt ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


        @if (pendingInadCount > 0)
    {
        <section class="inad-alert-wrapper mb-4" id="inadAlertBanner">
            <div class="inad-pulse-card">
                <div class="inad-pulse-left">
                    <div class="inad-bell-badge">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div>
                        <div class="inad-pulse-badge">
                            <i class="fas fa-door-open mr-1"></i> İNAD ODASI HATIRLATMASI &bull; @inadUserBorder
                        </div>
                        <h4 class="inad-pulse-title">
                            Kapınızda İnad Odasında Bekleyen <span class="badge badge-danger inad-count-badge">@pendingInadCount</span> Yolcu Bulunmaktadır
                        </h4>
                        <p class="inad-pulse-desc">
                            Yolcu uçağa verilip sınır dışı edildiyse, lütfen durumunu <strong>"İnad Edildi"</strong> olarak güncelleyiniz.
                        </p>
                    </div>
                </div>
                <div class="inad-pulse-actions">
                    <button type="button" class="btn-inad-review" data-toggle="modal" data-target="#inadReminderModal">
                        <i class="fas fa-user-check mr-1"></i> Yolcuları İncele & Onayla (@pendingInadCount)
                    </button>
                </div>
            </div>
        </section>
    }

