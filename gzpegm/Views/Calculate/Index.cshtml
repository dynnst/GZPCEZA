            </div>

            <div class="text-right mt-1">
                <button type="submit" class="btn btn-print-action">
                    <i class="fas fa-file-pdf mr-1"></i> Resmi Tutanağı Oluştur ve Yazdır
                </button>
            </div>
        </form>

    </div>
</div>

<!-- KÖPRÜ BAŞLATMA MODALI (YÖNETİCİ İZNİ GEREKTİRMEZ) -->
<div class="modal fade" id="modalBridgeSetup" tabindex="-1" role="dialog" style="z-index:99999;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius:14px; overflow:hidden;">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title font-weight-bold">
                    <i class="fas fa-id-card mr-2"></i>Optik Okuyucuyu Masanızda Başlatın
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shield-alt text-success" style="font-size:3.5rem;"></i>
                </div>
                <h5 class="font-weight-bold text-dark mb-2">Yönetici Şifresi / Admin İzni GEREKTİRMEZ</h5>
                <p class="text-muted" style="font-size:0.92rem;">
                    3M Cogent, Thales ve Regula okuyucularını sayfaya bağlamak için köprüyü ilk kullanımda bir kez indirip açın. Desko PENTA, üretici yazılımının klavye modu üzerinden çalışır. Kurulum sadece kendi Windows hesabınıza yapılır.
                </p>
                <div class="alert alert-info py-2 px-3 text-left font-weight-bold mb-3" style="font-size:0.86rem; border-radius:8px;">
                    <i class="fas fa-check-circle mr-1 text-success"></i> Yönetici izni olmadan kendi kullanıcı profilinize kurulur.<br/>
                    <i class="fas fa-check-circle mr-1 text-success"></i> Bilgisayar açıldığında arka planda otomatik başlar; tekrar kurulum gerekmez.<br/>
                    <i class="fas fa-check-circle mr-1 text-success"></i> Kurulumdan sonra her taramada yalnızca Oku butonuna basmanız yeterlidir.
                </div>
                <a href="@Url.Action("DownloadBridgeExe", "Calculate")" id="btnDownloadBridgeNow" class="btn btn-success btn-lg btn-block shadow font-weight-bold py-2 mb-2" style="font-size:1.05rem; border-radius:8px;">
                    <i class="fas fa-download mr-2"></i> Köprüyü İndir / Güncelle
                </a>
                <small class="text-muted">İlk kullanımda indirilen EgmReaderBridge.exe dosyasını bir kez açın. Yönetici şifresi gerekmez; köprü arka planda kurulur ve sonraki Windows açılışlarında otomatik başlar.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.bridgeExeUrl = '@Url.Action("DownloadBridgeExe", "Calculate")';</script>
    <script src="@Url.Content("~/js/passport-reader.js")?v=@gzpegm.Helpers.AssetVersionHelper.GetVersion("~/js/passport-reader.js")"></script>
    <script src="@Url.Content("~/js/calculate-index.js")?v=@gzpegm.Helpers.AssetVersionHelper.GetVersion("~/js/calculate-index.js")"></script>
    <script>
        function scanPassportDirect(deviceType) {
            if (window.PassportReader && typeof window.PassportReader.scanDevice === 'function') {
                window.PassportReader.scanDevice(deviceType || 'auto');
            } else if (typeof window.triggerDirectOpticalScan === 'function') {
                window.triggerDirectOpticalScan(deviceType || 'auto');
            } else {
                setTimeout(function () {
                    if (window.PassportReader && typeof window.PassportReader.scanDevice === 'function') {
                        window.PassportReader.scanDevice(deviceType || 'auto');
                    }
                }, 250);
            }
        }

        $(document).ready(function () {
            // Kimlik bilgileri tutanak formu (#form) her zaman açık ve görünür
            $('#form').show().removeClass('hidden').css('display', 'block');
        });
    </script>
}
