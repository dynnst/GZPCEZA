                                    <option value="8">Çalışma İzni</option>
                                    <option value="10">V-69 Tahditli Şahıslar</option>
                                    <option value="15">V-69 Tebliğ Tarihi İçinde Gelen Tahditli Şahıslar</option>
                                    <option value="11">V-137 Vize Süresiz Tahditli Şahıslar</option>
                                    <option value="12">V-88 Tahditli Şahıslar</option>
                                    <option value="13">V-137 Vize Süreli</option>
                                </select>
                                <input name="Visaday" id="Visaday" type="number" class="form-control hidden">
                            </div>
                        </div>

                        <!-- Koşullu Alanlar: İkamet Tezkeresi / Terke Davet Süresi -->
                        <div id="ikametli" class="conditional-alert-box hidden">
                            <div class="form-row align-items-center">
                                <div class="col-md-7 mb-1 mb-md-0">
                                    <strong id="testarihiLabel" class="text-primary font-weight-bold" style="font-size:0.85rem;">İkamet Tezkeresi Bitiş Tarihi</strong>
                                    <div class="text-muted small">İkamet tezkeresi veya belgede yazılı geçerlilik son tarihi</div>
                                </div>
                                <div class="col-md-5">
                                    <div class="input-group">
                                        <span class="input-group-prepend"><span class="input-group-text"><i class="fas fa-calendar-alt"></i></span></span>
                                        <input onchange="hesapla1()" autocomplete="off" id="testarihi" name="testarihi" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+1d","orientation":"bottom"}' class="form-control" placeholder="GG.AA.YYYY">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="v137SureDurumu" class="conditional-alert-box hidden">
                            <div class="form-row align-items-center">
                                <div class="col-md-7 mb-1 mb-md-0">
                                    <strong class="text-warning font-weight-bold" style="font-size:0.85rem;">Terke Davet Tebliğ Durumu</strong>
                                    <div class="text-muted small">V-137 tahditli yolcunun terke davet süresi içinde çıkıp çıkmadığı</div>
                                </div>
                                <div class="col-md-5">
                                    <select onchange="hesapla2()" id="V137ExpiredCalculate" name="V137ExpiredCalculate" class="form-control">
                                        <option value="0">Hayır, süresi içinde çıkıyor</option>
                                        <option value="1">Evet, süresi geçti</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Doğum Tarihi & Yaş Grubu & Hesapla -->
                        <div class="p-2 mt-2 rounded bg-light border">
                            <div class="form-row align-items-center">
                                <div class="col-md-5 mb-1 mb-md-0">
                                    <label for="BirthDateCalculate" class="control-label mb-1">Yolcu Doğum Tarihi</label>
                                    <div class="input-group">
                                        <span class="input-group-prepend"><span class="input-group-text"><i class="fas fa-birthday-cake"></i></span></span>
                                        <input autocomplete="off" onchange="adultchild(this)" id="BirthDateCalculate" name="BirthDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1" ,"language":"tr","startView": "years"}' class="form-control" placeholder="GG.AA.YYYY">
                                    </div>
                                </div>

                                <div class="col-md-3 mb-1 mb-md-0">
                                    <label for="AdultCalculate" class="control-label mb-1">Yaş Grubu</label>
                                    <select id="AdultCalculate" name="AdultCalculate" onchange="hesapla2()" class="form-control" required>
                                        <option value="2" selected>Yetişkin (18+)</option>
                                        <option value="1">Çocuk (&lt;18)</option>
                                    </select>
                                </div>

                                <div class="col-md-4 mt-2 mt-md-3 text-right">
                                    <button onclick="hesapla2()" type="button" class="btn btn-primary btn-block font-weight-bold" id="btnHesapla2" style="height:34px; font-size:0.85rem;">
                                        <i class="fas fa-calculator mr-1"></i> Cezaları Hesapla
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SAĞ SÜTUN: HESAPLAMA, HARÇLAR VE KARAR ÖZETİ -->
                <div class="col-xl-5 col-lg-5 col-md-12">
                    <div class="calc-summary-panel">
                        <div class="calc-panel-header">
                            <h5 class="panel-title">
                                <i class="fas fa-chart-pie"></i> Hesaplama ve Karar Özeti
                            </h5>
                        </div>

                        <!-- Boş Durum Bilgisi (Hesaplama Yapılmadığında) -->
                        <div id="calc-empty-placeholder">
                            <i class="fas fa-calculator d-block"></i>
                            <div>Giriş-çıkış tarihleri ve ülke seçildiğinde ihlal ve ceza dökümü bu ekranda anında hesaplanacaktır.</div>
                        </div>

                        <!-- 1. İhlal ve Kalış Süresi (#veri) -->
                        <div id="veri" class="summary-section hidden">
                            <!-- İhlal Durumu Banner'ı -->
                            <div class="violation-banner has-fine d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="violation-title">İhlal Edilen (Cezalı) Süre</div>
                                    <div class="small text-muted">Kaçak kalınan toplam süre</div>
                                </div>
                                <div>
                                    <input readonly id="SonucCalculate" name="SonucCalculate" type="text" class="form-control font-weight-bold text-danger text-right" style="font-size:1.15rem; width:130px; border:none; background:transparent;" required>
                                </div>
                            </div>

                            <!-- Kalış ve Yasal Aralık Tablosu -->
                            <table class="calc-table">
                                <tr>
                                    <td class="table-label">Kanuni Kalış Hakkı</td>
                                    <td class="table-value">
                                        <input readonly name="DayCalculate" id="DayCalculate" type="text" style="width:30px; border:none; background:transparent; font-weight:700;" required> Günde 
                                        <input readonly name="LongCalculate" id="LongCalculate" type="text" style="width:30px; border:none; background:transparent; font-weight:700;" required> G 
                                        (1 Seferde: <input readonly name="OneTimeCalculate" id="OneTimeCalculate" type="text" style="width:30px; border:none; background:transparent; font-weight:700;" required> G)
                                    </td>
                                </tr>
                                <tr>
                                    <td class="table-label">Yasal Tarih Aralığı</td>
                                    <td class="table-value">
                                        <input readonly id="BasCalculate" name="BasCalculate" type="text" style="width:85px; border:none; background:transparent; font-weight:700;" required> - 
                                        <input readonly id="BitCalculate" name="BitCalculate" type="text" style="width:85px; border:none; background:transparent; font-weight:700; color:#dc2626;" required>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="table-label">Cezalı Ay / Gün</td>
                                    <td class="table-value">
                                        <input readonly id="CezaAyCalculate" name="CezaAyCalculate" type="text" style="width:25px; border:none; background:transparent; font-weight:700;" required> Ay 
                                        <input readonly id="CezaGunCalculate" name="CezaGunCalculate" type="text" style="width:25px; border:none; background:transparent; font-weight:700;" required> Gün
                                    </td>
                                </tr>
                                <tr>
                                    <td class="table-label">Tekrar Giriş Hakkı</td>
                                    <td class="table-value">
                                        <input readonly id="ReEntryCalculate" type="text" class="text-success" style="width:100%; border:none; background:transparent; font-weight:700;" placeholder="Hesaplanmadı" />
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- 2. Harç ve Ceza Tutarları Dökümü (#step3-card) -->
                        <div id="step3-card" class="summary-section">
                            <!-- Kur ve Dövizli Ceza (#hes2) -->
                            <div id="hes2" class="hidden exchange-strip">
                                <div>
                                    <span class="mr-1">Döviz Harç:</span>
                                    <input readonly id="CezaCalculate" name="CezaCalculate" type="text" style="width:60px; border:none; background:transparent; font-weight:700; color:#166534;">
                                    <select disabled id="ToMCalculate" name="ToMCalculate" style="border:none; background:transparent; font-weight:700; color:#166534;" required>
                                        <option value="TRY">TRY</option>
                                        <option value="EUR">EUR</option>
                                        <option value="USD">USD</option>
                                        <option value="GBP">GBP</option>
                                    </select>
                                </div>
                                <div>
                                    <span id="KurCalculate" class="font-weight-bold"></span>
                                </div>
                            </div>

                            <!-- Kalem Kalem Harçlar Tablosu (#hes3) -->
                            <div id="hes3" class="hidden">
                                <table class="fee-table">
                                    <tr>
                                        <td class="fee-name">Cezalı İkamet Harcı</td>
                                        <td class="fee-val"><input readonly id="CezaTLCalculate" name="CezaTLCalculate" type="text" style="width:75px; border:none; background:transparent; text-align:right; font-weight:700;"> TL</td>
                                    </tr>
                                    <tr>
                                        <td class="fee-name">Vize Harcı</td>
                                        <td class="fee-val"><input readonly id="VisaHarcCalculate" name="VisaHarcCalculate" type="text" style="width:75px; border:none; background:transparent; text-align:right; font-weight:700;"> TL</td>
                                    </tr>
                                    <tr>
                                        <td class="fee-name">İkamet Defter Harcı</td>
                                        <td class="fee-val"><input readonly id="DefterCalculate" name="DefterCalculate" type="text" style="width:75px; border:none; background:transparent; text-align:right; font-weight:700;"> TL</td>
                                    </tr>
                                    <tr>
                                        <td class="fee-name">İdari Para Cezası</td>
                                        <td class="fee-val"><input readonly id="IdariCalculate" name="IdariCalculate" type="text" style="width:75px; border:none; background:transparent; text-align:right; font-weight:700;"> TL</td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Grand Total & Ödeme Tercihi (#hes4) -->
                            <div id="hes4" class="hidden">
                                <div class="grand-total-box">
                                    <div>
                                        <div class="grand-total-label">Tahsil Edilecek Toplam Tutar</div>
                                        <div class="small text-muted" style="color:#94a3b8 !important;">Vergi dairesi / vezne tahsilatı</div>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <input readonly id="ToplamCalculate" name="ToplamCalculate" type="text" class="grand-total-amount text-right" style="width:120px; border:none; background:transparent;" required>
                                        <span class="font-weight-bold ml-1 text-warning" style="font-size:1.1rem;">TL</span>
                                    </div>
                                </div>

                                <div class="form-group mb-2 p-2 rounded bg-light border">
                                    <label for="PayCalculate" class="control-label mb-1 font-weight-bold text-dark">
                                        Yolcu Ödeme Tercihi / Durumu
                                    </label>
                                    <select onchange="tahdit1(this)" id="PayCalculate" name="PayCalculate" data-plugin-selectTwo class="form-control populate" required>
                                        <option value="">Lütfen Seçiniz</option>
                                        <option value="1">Ödeyen</option>
                                        <option value="0">Ödemeyen</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Tahdit Kodu ve Hukuki Karar (#hes5) -->
                        <div id="hes5" class="summary-section hidden">
                            <div class="decision-card">
                                <div class="font-weight-bold mb-1 text-danger">
                                    <i class="fas fa-gavel mr-1"></i> Uygulanacak Hukuki Karar ve Tahdit Kodu:
                                </div>
                                <div id="lastalert" class="small"></div>
                            </div>

                            <button onclick="hesapla3()" type="button" class="btn btn-sm btn-outline-primary btn-block font-weight-bold" id="btnHesapla3">
                                <i class="fas fa-file-invoice mr-1"></i> Tutanak Bilgilerini Doldur
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </form>

        <!-- ALT PANEL: RESMİ TUTANAK VE TEBLİĞ FORMU YAZDIR (#form) -->
        <form id="form" class="calc-panel tutanak-panel mt-3 hidden" method="post" target="_blank" action="/Formolustur">
            <div class="calc-panel-header">
                <h5 class="panel-title">
                    <i class="fas fa-print"></i> Resmi Tebliğ Formu ve Tutanak Bilgileri
                </h5>
                <span class="text-muted small">Yazdırılacak resmi evrak üst bilgileri</span>
            </div>

            <!-- Hidden Fields required by /Formolustur -->
            <input name="OrginCFORM" id="OrginCFORM" type="text" class="form-control hidden" required>
            <input name="EntryDateCFORM" id="EntryDateCFORM" type="text" class="form-control hidden" required>
            <input name="VisaDistanceCFORM" id="VisaDistanceCFORM" type="text" class="form-control hidden" required>
            <input name="ShouldExitCFORM" id="ShouldExitCFORM" type="text" class="form-control hidden" required>
            <input name="FineDayCFORM" id="FineDayCFORM" type="text" class="form-control hidden" required>
            <input name="FinePriceCFORM" id="FinePriceCFORM" type="text" class="form-control hidden" required>
            <input name="PaymentTypeCFORM" id="PaymentTypeCFORM" type="text" class="form-control hidden" required>
            <input name="DDayCFORM" id="DDayCFORM" type="text" class="form-control hidden" required>
            <input name="DefterCFORM" id="DefterCFORM" type="text" class="form-control hidden" required>
            <input name="CGunCFORM" id="CGunCFORM" type="text" class="form-control hidden" required>
            <input name="CAyCFORM" id="CAyCFORM" type="text" class="form-control hidden" required>
            <input name="codeFORM" id="codeFORM" type="text" class="form-control hidden" required>
            <input name="visatype" id="visatype" type="text" class="form-control hidden" required>
            <input readonly autocomplete="off" id="BirthdateCFORM" name="BirthdateCFORM" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+0d"}' class="form-control hidden" required>

            <div class="form-row">
                <div class="form-group col-xl-2 col-lg-4 col-md-6 mb-2">
                    <label for="NameCFORM" class="control-label">Yolcu Adı Soyadı</label>
                    <input autocomplete="off" name="NameCFORM" id="NameCFORM" type="text" class="form-control" placeholder="Ad Soyad" required>
                </div>
                <div class="form-group col-xl-2 col-lg-4 col-md-6 mb-2">
                    <label for="PassportCFORM" class="control-label">Pasaport Numarası</label>
                    <input autocomplete="off" name="PassportCFORM" id="PassportCFORM" type="text" class="form-control" placeholder="Pasaport No" required>
                </div>
                <div class="form-group col-xl-2 col-lg-4 col-md-6 mb-2">
                    <label for="IDNCFORM" class="control-label">YKN / TC No</label>
                    <input autocomplete="off" name="IDNCFORM" id="IDNCFORM" type="text" class="form-control" placeholder="Varsa YKN">
                </div>
                <div class="form-group col-xl-2 col-lg-4 col-md-6 mb-2">
                    <label for="FatherCFORM" class="control-label">Baba Adı</label>
                    <input autocomplete="off" name="FatherCFORM" id="FatherCFORM" type="text" class="form-control" placeholder="Baba Adı">
                </div>
                <div class="form-group col-xl-2 col-lg-4 col-md-6 mb-2">
                    <label for="MotherCFORM" class="control-label">Anne Adı</label>
                    <input autocomplete="off" name="MotherCFORM" id="MotherCFORM" type="text" class="form-control" placeholder="Anne Adı">
                </div>
                <div class="form-group col-xl-2 col-lg-4 col-md-6 mb-2">
                    <label for="PoliceCFORM" class="control-label">Kontrol Memuru</label>
                    <input autocomplete="off" name="PoliceCFORM" id="PoliceCFORM" type="text" class="form-control" value="@ViewBag.OfficerName" placeholder="Memur Sicil" required>
                </div>
            </div>

            <div class="text-right mt-1">
                <button type="submit" class="btn btn-print-action">
                    <i class="fas fa-file-pdf mr-1"></i> Resmi Tutanağı Oluştur ve Yazdır
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/calculate-index.js")?v=3.3"></script>
    <script src="@Url.Content("~/js/passport-reader.js")?v=1.0"></script>
}
