@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseSelect2 = true;
}
@section Styles {
    <link href="@Url.Content("~/css/calculate-index.css")?v=2.2" rel="stylesheet" />
}

<div class="calculate-card">
    <header class="card-header calculate-header">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="calculate-header-icon mr-3">
                    <i class="fas fa-passport"></i>
                </div>
                <div>
                    <h2 class="card-title mb-1">Vize ve İkamet İhlali Ceza Hesaplama</h2>
                    <p class="card-subtitle mb-0">Pasaport kontrol noktaları yabancı yolcu vize muafiyeti, kalış hakları, harç, para cezası ve tahdit kodları hesaplama sistemi</p>
                </div>
            </div>
            <div class="d-flex align-items-center mt-2 mt-md-0">
                <div class="stat-pill mr-3" title="Sınır kapınızdaki toplam ceza hesaplama işlemi">
                    <i class="fas fa-history text-info mr-1"></i>
                    <span class="stat-label">Toplam İşlem:</span>
                    <span id="userHistoryCount" class="stat-value badge badge-pill badge-primary">0</span>
                </div>
                <button type="button" onclick="resetCalculateForm()" class="btn btn-sm btn-outline-light btn-reset-calc" title="Tüm alanları sıfırlar ve yeni yolcu için hazırlar">
                    <i class="fas fa-redo-alt mr-1"></i> Yeni Yolcu
                </button>
            </div>
        </div>
    </header>

    <div class="card-body p-3 p-md-4">
        <form id="calculate-form" style="display: flex; flex-direction: column;">
            
            <!-- ADIM 1: GİRİŞ-ÇIKIŞ VE PASAPORT / VİZE BİLGİLERİ -->
            <div class="calc-step-card" id="step1-card" style="order: 1;">
                <div class="calc-step-title">
                    <span class="step-badge step-primary">1</span>
                    <span>Yolcu Giriş-Çıkış ve Pasaport / Vize Bilgileri</span>
                </div>

                <!-- Giriş - Çıkış Hareketleri Başlığı ve Ekleme Çubuğu -->
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <div class="font-weight-bold text-dark" style="font-size: 13.5px;">
                        <i class="fas fa-calendar-alt text-primary mr-1"></i> Giriş - Çıkış Sefer Tarihleri
                        <span class="text-muted small ml-1 font-weight-normal">(Tarihler alt alta listelenir)</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <button id="GcAddButton" onclick="gcadd()" type="button" class="btn btn-sm btn-gc-action btn-gc-add mr-1" title="Önceki giriş-çıkışları ekle">
                            <i class="fas fa-plus-circle"></i> <span>Giriş-Çıkış Ekle</span>
                        </button>
                        <button type="button" onclick="gcremove(this);" class="btn btn-sm btn-gc-action btn-gc-remove" title="Son eklenen satırı sil">
                            <i class="fas fa-trash-alt"></i> <span>Son Satırı Sil</span>
                        </button>
                    </div>
                </div>

                <!-- Giriş - Çıkış Tarih Satırları Konteyneri (ALT ALTA GELMESİ İÇİN) -->
                <div id="date-rows-container" class="date-rows-container mb-3">
                    <!-- 1. Giriş-Çıkış Satırı -->
                    <div class="form-group row form-row date-pair-row align-items-end mb-2" id="date-row-0">
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-2">
                            <label for="EnterDateCalculate" class="control-label font-weight-bold" style="font-size: 12.5px;">
                                <i class="fas fa-sign-in-alt text-primary mr-1"></i> <span class="badge badge-primary mr-1 row-badge">1</span> Giriş Tarihi
                            </label>
                            <div class="input-group">
                                <span class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                </span>
                                <input autocomplete="off" onchange="hesapla1()" id="EnterDateCalculate" name="EnterDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+1d","orientation":"bottom"}' class="form-control endt" placeholder="GG.AA.YYYY" required>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-2">
                            <label for="ExitDateCalculate" class="control-label font-weight-bold" style="font-size: 12.5px;">
                                <i class="fas fa-sign-out-alt text-danger mr-1"></i> <span class="badge badge-danger mr-1 row-badge">1</span> Çıkış Tarihi
                            </label>
                            <div class="input-group">
                                <span class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                </span>
                                <input autocomplete="off" onchange="hesapla1()" id="ExitDateCalculate" name="ExitDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","endDate":"+1d","autoclose":"true","weekStart":"1" ,"language":"tr","orientation":"bottom"}' value="@DateTime.Now.ToString("dd.MM.yyyy")" class="form-control exdt" placeholder="GG.AA.YYYY" required>
                            </div>
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-10 mb-2">
                            <label for="PairDiff_0" class="control-label font-weight-bold" style="font-size: 12.5px;">
                                <i class="fas fa-clock text-info mr-1"></i> Kalış Süresi
                            </label>
                            <input readonly id="PairDiff_0" class="form-control pair-diff" placeholder="Gün Farkı" />
                        </div>

                        <div class="col-xl-1 col-lg-1 col-md-1 col-sm-2 mb-2 text-center">
                            <span class="text-muted" title="Ana giriş-çıkış kaydı" style="font-size: 12px; display:inline-block; padding-top:8px;">
                                <i class="fas fa-lock text-muted"></i>
                            </span>
                        </div>
                    </div>
                </div>

