@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseSelect2 = true;
}
@section Styles {
    <link href="@Url.Content("~/css/calculate-index.css")?v=@gzpegm.Helpers.AssetVersionHelper.GetVersion("~/css/calculate-index.css")" rel="stylesheet" />
    <link href="@Url.Content("~/AdminLTE-3.0.4/plugins/flag-icon-css/css/flag-icon.min.css")" rel="stylesheet" />
}

<div class="calculate-card">
    <!-- Sade ve Kurumsal Başlık -->
    <header class="card-header calculate-header">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="calculate-header-icon mr-2">
                    <i class="fas fa-passport"></i>
                </div>
                <div>
                    <h2 class="card-title">Vize ve İkamet İhlali Ceza Hesaplama</h2>
                    <p class="card-subtitle mb-0">Pasaport kontrol noktaları hızlı ihlal, harç, ceza ve tahdit kodu hesaplama sistemi</p>
                </div>
            </div>
            <div class="d-flex align-items-center mt-2 mt-md-0">
                <a href="@Url.Action("Mevzuat", "Calculate")" target="_blank" class="btn btn-outline-info mr-2 shadow-sm font-weight-bold" id="btnMevzuat" style="border-radius:6px; font-size:0.86rem; padding:6px 14px; border:1.5px solid #0284c7; background-color:#f0f9ff; color:#0369a1;" title="Hesaplama Algoritmaları ve Yasal Dayanaklar Rehberi"><i class="fas fa-balance-scale mr-1 text-primary"></i> İlgili Mevzuat & Algoritmalar</a>
                <a href="@Url.Action("DownloadBridgeExe", "Calculate")" id="btnLaunchBridgeDirect" onclick="handleStartBridgeClick(event)" class="btn btn-warning font-weight-bold mr-2 shadow-sm text-dark btn-launch-bridge" style="border-radius:6px; font-size:0.86rem; padding:6px 14px; background:linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color:#1f2937 !important; border:none;" title="Masanızdaki Optik Okuyucu Donanım Köprüsünü Başlat veya İndir (Yönetici Yetkisi Gerekmez)">
                    <i class="fas fa-bolt text-danger mr-1"></i> <span id="lblBridgeStatusText" class="lblBridgeStatusText">Köprüyü Başlat</span>
                </a>
                <div class="btn-group mr-2 shadow-sm" role="group">
                    <button type="button" id="btnDirectOpticalScan" onclick="scanPassportDirect('auto');" class="btn btn-success font-weight-bold" style="border-radius:6px 0 0 6px; font-size:0.86rem; padding:6px 14px; background:linear-gradient(135deg, #059669 0%, #047857 100%); border:none;" title="Optik Okuyucudan Pasaport Oku (Otomatik Algıla)">
                        <span class="passport-pulse-dot"></span> <i class="fas fa-camera mr-1"></i> Cihazdan Pasaport Oku
                    </button>
                    <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border-radius:0 6px 6px 0; background:#047857; border:none; border-left:1px solid rgba(255,255,255,0.25);" title="Okuyucu Cihazını Seç">
                        <span class="sr-only">Cihaz Seçimi</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow-lg" style="font-size:0.85rem; min-width:260px; z-index:1050;">
                        <h6 class="dropdown-header text-uppercase font-weight-bold text-muted py-1" style="font-size:0.75rem;"><i class="fas fa-microchip mr-1"></i> Okuyucu Donanımı</h6>
                        <a class="dropdown-item py-2 font-weight-bold text-success" href="javascript:void(0);" onclick="scanPassportDirect('auto');">
                            <i class="fas fa-magic mr-2"></i> Otomatik Algıla <span class="badge badge-success ml-1">Önerilen</span>
                        </a>
                        <div class="dropdown-divider my-1"></div>
                        <a class="dropdown-item py-2" href="javascript:void(0);" onclick="scanPassportDirect('3m');">
                            <i class="fas fa-id-card mr-2 text-primary"></i> 3M Cogent / Gemalto (PV40/AT9000)
                        </a>
                        <a class="dropdown-item py-2" href="javascript:void(0);" onclick="scanPassportDirect('regula');">
                            <i class="fas fa-camera-retro mr-2 text-info"></i> Regula Document Reader (70X4)
                        </a>
                        <a class="dropdown-item py-2" href="javascript:void(0);" onclick="scanPassportDirect('desko');">
                            <i class="fas fa-barcode mr-2 text-warning"></i> Desko PENTA Scanner
                        </a>
                        <a class="dropdown-item py-2" href="javascript:void(0);" onclick="scanPassportDirect('thales');">
                            <i class="fas fa-fingerprint mr-2 text-danger"></i> Thales Cogent CS500f
                        </a>
                    </div>
                </div>
                <span id="bridgeStatusContainer" class="mr-2"></span>
                <button type="button" onclick="resetCalculateForm()" class="btn btn-reset-calc" title="Tüm alanları sıfırlar ve yeni yolcu için hazırlar">
                    <i class="fas fa-redo-alt mr-1"></i> Yeni Yolcu
                </button>
            </div>
        </div>
    </header>

    <div class="card-body p-2 p-md-3">
        <!-- TEK EKRANDA 2 SÜTUNLU KABİN DÜZENİ -->
        <div id="opticalScanAlert" class="mt-1 mb-2" style="display:none;"></div>
        <form id="calculate-form">
            <div class="row">
                
                <!-- SOL SÜTUN: YOLCU VE SEFER BİLGİLERİ -->
                <div class="col-xl-7 col-lg-7 col-md-12">
                    <div class="calc-panel">
                        
                        <!-- 1. Giriş - Çıkış Seferleri -->
                        <div class="calc-panel-header">
                            <h5 class="panel-title">
                                <i class="fas fa-calendar-alt"></i> Giriş - Çıkış Sefer Tarihleri
                            </h5>
                            <div class="panel-actions">
                                <button id="GcAddButton" onclick="gcadd()" type="button" class="btn btn-primary" title="Önceki giriş-çıkışları ekle">
                                    <i class="fas fa-plus mr-1"></i> Sefer Ekle
                                </button>
                                <button type="button" onclick="gcremove(this);" class="btn btn-outline-danger" title="Son eklenen seferi sil">
                                    <i class="fas fa-trash-alt mr-1"></i> Son Satırı Sil
                                </button>
                            </div>
                        </div>

                        <!-- Giriş - Çıkış Tarih Satırları Konteyneri -->
                        <div id="date-rows-container" class="date-rows-container mb-2">
                            <!-- 1. Giriş-Çıkış Satırı -->
                            <div class="form-group row form-row date-pair-row align-items-end mb-1" id="date-row-0">
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-1">
                                    <label for="EnterDateCalculate" class="control-label font-weight-bold">
                                        <span class="row-badge mr-1">1</span> <span id="enterDateLabel" class="entry-date-caption">Son Giriş</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                        </span>
                                        <input autocomplete="off" onchange="hesapla1()" id="EnterDateCalculate" name="EnterDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+1d","orientation":"bottom"}' class="form-control endt" placeholder="GG.AA.YYYY" required>
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-1">
                                    <label for="ExitDateCalculate" class="control-label font-weight-bold">
                                        <span class="row-badge mr-1">1</span> <span class="exit-date-caption">Son Çıkış</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                        </span>
                                        <input autocomplete="off" onchange="hesapla1()" id="ExitDateCalculate" name="ExitDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","endDate":"+1d","autoclose":"true","weekStart":"1" ,"language":"tr","orientation":"bottom"}' value="@DateTime.Now.ToString("dd.MM.yyyy")" class="form-control exdt" placeholder="GG.AA.YYYY" required>
                                    </div>
                                </div>

                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-10 mb-1">
                                    <label for="PairDiff_0" class="control-label font-weight-bold">Kalış</label>
                                    <input readonly id="PairDiff_0" class="form-control pair-diff" placeholder="Gün" />
                                    <div class="window-diff-badge mt-1" style="font-size:11.5px; font-weight:600;"></div>
                                </div>

                                <div class="col-xl-1 col-lg-1 col-md-1 col-sm-2 mb-1 text-center">
                                    <span class="text-muted" title="Ana sefer kaydı" style="display:inline-block; padding-top:22px;">
                                        <i class="fas fa-lock text-muted"></i>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Yolcu ve Vize Parametreleri -->
