                        </div>
                        <div class="col-md-2 col-sm-6 mb-2">
                            <small class="text-muted d-block font-weight-bold">PASAPORT NO</small>
                            <span id="hksPassPassport" class="font-weight-bold text-dark font-mono">—</span>
                        </div>
                        <div class="col-md-2 col-sm-6 mb-2">
                            <small class="text-muted d-block font-weight-bold">YKN / KİMLİK NO</small>
                            <span id="hksPassIdNo" class="font-weight-bold text-dark font-mono">—</span>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-2">
                            <small class="text-muted d-block font-weight-bold">DOĞUM TARİHİ & YAŞ</small>
                            <span id="hksPassBirth" class="text-dark font-weight-bold">—</span>
                            <span id="hksPassAgeBadge" class="badge badge-info ml-1"></span>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-1" id="hksPassFatherCol">
                            <small class="text-muted d-block font-weight-bold">BABA ADI</small>
                            <span id="hksPassFather" class="text-dark font-weight-bold">—</span>
                        </div>
                    </div>
                </div>

                <!-- 3. HKS Seferleri Tablosu -->
                <div class="card mt-3 border shadow-sm">
                    <div class="card-header bg-light d-flex align-items-center justify-content-between py-2 px-3">
                        <span class="font-weight-bold text-dark small">
                            <i class="fas fa-list-ol mr-1"></i> Ayıklanan Giriş - Çıkış Seferleri <span class="text-muted">(Saat bilgileri mevzuat gereği otomatik atılmıştır)</span>
                        </span>
                        <button type="button" id="btnAddManualRow" class="btn btn-xs btn-outline-primary font-weight-bold">
                            <i class="fas fa-plus mr-1"></i> Manuel Satır Ekle
                        </button>
                    </div>
                    <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                        <table class="table table-sm table-hover table-striped mb-0 text-center" style="font-size:0.88rem;">
                            <thead class="bg-white">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Hareket Tipi</th>
                                    <th>İşlem Tarihi</th>
                                    <th style="width: 70px;">İşlem</th>
                                </tr>
                            </thead>
                            <tbody id="hksMovementsTbody">
                                <tr>
                                    <td colspan="4" class="text-muted py-3">Henüz veri yüklenmedi. Yukarıdaki seçeneklerden birini kullanarak HKS dökümünü ekleyin.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="hksTripsValidationBox" class="p-2 bg-white border-top small hidden"></div>
                </div>

                <!-- 4. 90/180 Gün Kuralı Sonuç ve Karar Destek Kartı -->
                <div id="hksResultCard" class="hks-result-card hidden">
                    <div class="d-flex flex-wrap align-items-center justify-content-between">
                        <div class="d-flex align-items-center mb-2 mb-md-0">
                            <span id="hksResStatusBadge" class="badge px-3 py-2 font-weight-bold mr-3" style="font-size:1rem;"></span>
                            <div>
                                <div class="font-weight-bold" style="font-size:1.1rem;" id="hksResDetailText"></div>
                                <small class="text-muted">Son 180 Gün Penceresindeki Toplam Kalış: <strong id="hksResTotalStay" class="text-dark">0 Gün</strong> (Yasal Sınır: 90 Gün)</small>
                            </div>
                        </div>
                        <button type="button" id="btnTransferToCezam" class="btn btn-success btn-lg font-weight-bold shadow px-4 py-2">
                            <i class="fas fa-rocket mr-2"></i> Seferleri ve İhlali Ceza Ekranına Aktar
                        </button>
                    </div>
                </div>

            </div>

            <!-- Modal Alt Bilgi -->
            <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between">
                <small class="text-muted">
                    <i class="fas fa-shield-alt text-success mr-1"></i> 6458 Sayılı YUKK Md. 18 Kayan Pencere (Rolling Window) motoru ile hesaplanır.
                </small>
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Kapat</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/xlsx.full.min.js")"></script>
    <script src="@Url.Content("~/js/ocr/tesseract.min.js")"></script>
    <script src="@Url.Content("~/js/calculate-index.js")?v=3.2"></script>
    <script src="@Url.Content("~/js/hks-calculator.js")?v=1.1"></script>
}
