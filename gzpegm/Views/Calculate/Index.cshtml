                            <option value="3">Konsolosluk Vizeli, Transit Yolcu ve Kaşe Vize Hesaplama</option>
                            <option value="4">İkamet Tezkereli</option>
                            <option value="5">Türkiye'de Doğan</option>
                            <option value="7">İkamet Şartlı Giriş (V-84)</option>
                            <option value="8">Çalışma İzni</option>
                            <option value="10">V-69 Tahditli Şahıslar</option>
                            <option value="15">V-69 Tebliğ Tarihi İçinde Gelen Tahditli Şahıslar</option>
                            <option value="11">V-137 Vize Süresiz Tahditli Şahıslar</option>
                            <option value="12">V-88 Tahditli Şahıslar</option>
                            <option value="13">V-137 Vize Süreli</option>
                        </select>
                        <input name="Visaday" id="Visaday" type="number" class="form-control hidden">
                    </div>
                </div>

                <!-- Koşullu Alanlar: İkamet Tezkeresi / Terke Davet Süresi -->
                <div id="ikametli" class="conditional-alert-box hidden">
                    <div class="form-row align-items-center">
                        <div class="col-md-7 mb-2 mb-md-0">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle text-primary fa-2x mr-3"></i>
                                <div>
                                    <strong id="testarihiLabel">İkamet Tezkeresi Bitiş Tarihi</strong>
                                    <div class="text-muted small">İkamet tezkeresi, çalışma izni veya terke davet tebliğinde belirtilen son geçerlilik tarihi</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                </span>
                                <input onchange="hesapla1()" autocomplete="off" id="testarihi" name="testarihi" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+1d","orientation":"bottom"}' class="form-control" placeholder="GG.AA.YYYY">
                            </div>
                        </div>
                    </div>
                </div>

                <div id="v137SureDurumu" class="conditional-alert-box hidden">
                    <div class="form-row align-items-center">
                        <div class="col-md-7 mb-2 mb-md-0">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-triangle text-warning fa-2x mr-3"></i>
                                <div>
                                    <strong>Terke Davet Tebliğ Durumu</strong>
                                    <div class="text-muted small">V-137 tahditli yolcunun terke davet süresi içinde çıkıp çıkmadığı</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <select onchange="hesapla2()" id="V137ExpiredCalculate" name="V137ExpiredCalculate" class="form-control">
                                <option value="0">Hayır, süresi içinde çıkıyor</option>
                                <option value="1">Evet, süresi geçti</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ADIM 2: KALIŞ VE İHLAL SÜRESİ ANALİZİ (#veri) -->
            <div id="veri" class="calc-step-card hidden" style="order: 3;">
                <div class="calc-step-title text-warning">
                    <span class="step-badge step-warning">2</span>
                    <span>Kalış ve İhlal Süresi Analizi</span>
                </div>

                <div class="row">
                    <!-- Kanuni Kalış Süresi -->
                    <div class="col-lg-3 col-md-6 mb-3">
                        <div class="kpi-tile kpi-info">
                            <div>
                                <div class="kpi-title"><i class="fas fa-balance-scale mr-1"></i> Kanuni Kalış Hakkı</div>
                                <div class="small text-muted mb-2">180 günde yasal kalış limiti</div>
                            </div>
                            <div class="d-flex align-items-baseline">
                                <input readonly name="DayCalculate" id="DayCalculate" type="number" class="form-control font-weight-bold text-primary mr-1" style="width: 70px; display:inline-block;" required>
                                <span class="small font-weight-bold text-muted mr-1">Günde</span>
                                <input readonly name="LongCalculate" id="LongCalculate" type="number" class="form-control font-weight-bold text-primary mr-1" style="width: 60px; display:inline-block;" required>
                                <span class="small font-weight-bold text-muted mr-1">G (1 Seferde:</span>
                                <input readonly name="OneTimeCalculate" id="OneTimeCalculate" type="number" class="form-control font-weight-bold text-primary" style="width: 60px; display:inline-block;" required>
                                <span class="small font-weight-bold text-muted ml-1">G)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Yasal Tarih Aralığı -->
                    <div class="col-lg-3 col-md-6 mb-3">
                        <div class="kpi-tile kpi-info">
                            <div>
                                <div class="kpi-title"><i class="fas fa-calendar-check mr-1"></i> Yasal Kalış Tarihleri</div>
                                <div class="small text-muted mb-2">Giriş ve yasal son çıkış tarihi</div>
                            </div>
                            <div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="small text-muted mr-2" style="width: 75px;">Başlangıç:</span>
                                    <input readonly id="BasCalculate" name="BasCalculate" type="text" class="form-control font-weight-bold" required>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="small text-muted mr-2" style="width: 75px;">Son Çıkış:</span>
                                    <input readonly id="BitCalculate" name="BitCalculate" type="text" class="form-control font-weight-bold text-danger" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cezalı Süre -->
                    <div class="col-lg-3 col-md-6 mb-3">
                        <div class="kpi-tile kpi-danger">
                            <div>
                                <div class="kpi-title text-danger"><i class="fas fa-exclamation-circle mr-1"></i> İhlal Edilen (Cezalı) Süre</div>
                                <div class="small text-muted mb-2">Yolcunun kaçak kaldığı süre</div>
                            </div>
                            <div>
                                <div class="d-flex align-items-center mb-2">
                                    <input readonly id="CezaAyCalculate" name="CezaAyCalculate" type="number" class="form-control font-weight-bold mr-1" style="width: 55px;" required>
                                    <span class="small mr-2 font-weight-bold">Ay</span>
                                    <input readonly id="CezaGunCalculate" name="CezaGunCalculate" type="number" class="form-control font-weight-bold mr-1" style="width: 55px;" required>
                                    <span class="small font-weight-bold">Gün</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="small text-muted mr-2">Toplam:</span>
                                    <input readonly id="SonucCalculate" name="SonucCalculate" type="tel" class="form-control font-weight-bold text-danger" style="font-size:1.1rem;" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tekrar Giriş Bilgisi -->
                    <div class="col-lg-3 col-md-6 mb-3">
                        <div class="kpi-tile kpi-success">
                            <div>
                                <div class="kpi-title text-success"><i class="fas fa-plane-arrival mr-1"></i> Tekrar Giriş Hakkı</div>
                                <div class="small text-muted mb-2">180/90 kuralı sonrası gelebileceği tarih</div>
                            </div>
                            <div>
                                <input readonly id="ReEntryCalculate" type="text" class="form-control font-weight-bold text-success" placeholder="Hesaplanmadı" style="font-size: 0.92rem;" />
                                <div class="small text-muted mt-1 font-italic">Başka yurda giriş yasağı bulunmuyorsa geçerlidir.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Yaş Tespiti ve Harç Hesaplama Butonu -->
                <div class="p-3 bg-light rounded mt-2 border">
                    <div class="form-row align-items-center">
                        <div class="col-lg-4 col-md-5 mb-2 mb-lg-0">
                            <label for="BirthDateCalculate" class="control-label mb-1">
                                <i class="fas fa-birthday-cake text-primary mr-1"></i> Yolcu Doğum Tarihi
                            </label>
                            <div class="input-group">
                                <span class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                </span>
                                <input autocomplete="off" onchange="adultchild(this)" id="BirthDateCalculate" name="BirthDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1" ,"language":"tr","startView": "years"}' class="form-control" placeholder="GG.AA.YYYY">
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-4 mb-2 mb-lg-0">
                            <label for="AdultCalculate" class="control-label mb-1">
                                <i class="fas fa-user-tag text-info mr-1"></i> Yaş Grubu (Otomatik Tespiti)
                            </label>
                            <select disabled id="AdultCalculate" name="AdultCalculate" data-plugin-selectTwo class="form-control populate" required>
                                <option value="">Otomatik Seçim</option>
                                <option value="1">Çocuk (18 Yaş Altı)</option>
                                <option value="2">Yetişkin (18 Yaş ve Üzeri)</option>
                            </select>
                        </div>

                        <div class="col-lg-4 col-md-3 mt-md-4 text-right">
                            <button onclick="hesapla2()" type="button" class="btn btn-primary btn-block btn-step-action" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
                                <i class="fas fa-calculator mr-2"></i> Harç ve Cezaları Hesapla
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ADIM 3: HARÇ VE CEZA TUTARLARI DÖKÜMÜ -->
            <div id="step3-card" class="calc-step-card" style="order: 4;">
                <div class="calc-step-title text-success">
                    <span class="step-badge step-success">3</span>
                    <span>Harç ve Ceza Tutarları Dökümü</span>
                </div>

                <!-- Kur ve Dövizli Ceza (#hes2) -->
                <div id="hes2" class="hidden exchange-rate-banner">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-money-bill-wave text-success fa-2x mr-3"></i>
                        <div>
                            <strong class="text-success">Cezalı İkamet Harcı (Döviz):</strong>
                            <span class="d-inline-flex align-items-center ml-2">
                                <input readonly autocomplete="off" id="CezaCalculate" name="CezaCalculate" type="text" class="form-control font-weight-bold text-success text-center mr-2" style="width: 100px; display:inline-block;">
                                <select disabled id="ToMCalculate" name="ToMCalculate" data-plugin-selectTwo class="form-control populate" style="width: 140px; display:inline-block;" required>
                                    <option value="TRY">Türk Lirası</option>
                                    <option value="EUR">Avro</option>
                                    <option value="USD">Amerikan Doları</option>
                                    <option value="GBP">İngiliz Sterlini</option>
                                </select>
                            </span>
                        </div>
                    </div>
                    <div>
                        <span class="rate-badge">
                            <i class="fas fa-chart-line mr-1"></i>
                            <span id="KurCalculate">TCMB Kuru</span>
                        </span>
                    </div>
                </div>

                <!-- Kalem Kalem Harçlar (#hes3) -->
                <div id="hes3" class="hidden">
                    <div class="row">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="fee-breakdown-card">
                                <div class="fee-label"><i class="fas fa-file-invoice-dollar mr-1"></i> Cezalı İkamet Harcı</div>
                                <div class="input-group">
                                    <input readonly autocomplete="off" id="CezaTLCalculate" name="CezaTLCalculate" type="text" class="form-control fee-input">
                                    <span class="input-group-append"><span class="input-group-text font-weight-bold">TL</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="fee-breakdown-card">
                                <div class="fee-label"><i class="fas fa-stamp mr-1"></i> Vize Harcı</div>
                                <div class="input-group">
                                    <input readonly autocomplete="off" id="VisaHarcCalculate" name="VisaHarcCalculate" type="text" class="form-control fee-input">
                                    <span class="input-group-append"><span class="input-group-text font-weight-bold">TL</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="fee-breakdown-card">
                                <div class="fee-label"><i class="fas fa-book mr-1"></i> İkamet Defter Harcı</div>
                                <div class="input-group">
                                    <input readonly autocomplete="off" id="DefterCalculate" name="DefterCalculate" type="text" class="form-control fee-input">
                                    <span class="input-group-append"><span class="input-group-text font-weight-bold">TL</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="fee-breakdown-card">
                                <div class="fee-label"><i class="fas fa-gavel mr-1"></i> İdari Para Cezası</div>
                                <div class="input-group">
                                    <input readonly autocomplete="off" id="IdariCalculate" name="IdariCalculate" type="text" class="form-control fee-input">
                                    <span class="input-group-append"><span class="input-group-text font-weight-bold">TL</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grand Total & Ödeme Durumu (#hes4) -->
                <div id="hes4" class="hidden grand-total-card">
                    <div class="row align-items-center">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="total-label"><i class="fas fa-receipt mr-1"></i> Tahsil Edilecek Toplam Tutar</div>
                            <div class="d-flex align-items-center">
                                <input readonly autocomplete="off" id="ToplamCalculate" name="ToplamCalculate" type="text" class="form-control mr-2" style="max-width: 250px;">
                                <span class="font-weight-bold text-white" style="font-size: 1.5rem;">TL</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="PayCalculate" class="text-white font-weight-bold mb-1">
                                <i class="fas fa-hand-holding-usd mr-1"></i> Yolcu Ödeme Tercihi / Durumu
                            </label>
                            <select onchange="tahdit1((this))" id="PayCalculate" name="PayCalculate" data-plugin-selectTwo class="form-control populate" required>
                                <option value="">Lütfen Seçiniz</option>
                                <option value="1">Ödeyen</option>
                                <option value="0">Ödemeyen</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ADIM 4: TAHDİT KODU VE HUKUKİ KARAR (#hes5) -->
            <div id="hes5" class="calc-step-card hidden" style="order: 5;">
                <div class="calc-step-title text-danger">
                    <span class="step-badge step-danger">4</span>
                    <span>Tahdit Kodu ve Hukuki Karar</span>
                </div>

                <div class="row align-items-center">
                    <div class="col-lg-9 mb-3 mb-lg-0">
                        <div id="lastalert" class="alert alert-danger mb-0">
                        </div>
                    </div>
                    <div class="col-lg-3 text-right">
                        <button onclick="hesapla3()" type="button" class="btn btn-primary btn-block btn-generate-form">
                            <i class="fas fa-file-invoice mr-2"></i> Form Oluştur
                        </button>
                    </div>
                </div>
            </div>

        </form>

        <!-- ADIM 5: TUTANAK VE TEBLİĞ FORMU YAZDIR (#form) -->
        <form id="form" class="calc-step-card form-print-card hidden" method="post" target="_blank" action="/Formolustur">
            <div class="calc-step-title text-info">
                <span class="step-badge step-info">5</span>
                <span>Resmi Tebliğ Formu ve Tutanak Bilgileri</span>
            </div>

            <!-- Hidden Fields required by /Formolustur -->
            <input name="OrginCFORM" id="OrginCFORM" type="text" class="form-control hidden" required>
            <input name="EntryDateCFORM" id="EntryDateCFORM" type="text" class="form-control hidden" required>
            <input name="VisaDistanceCFORM" id="VisaDistanceCFORM" type="text" class="form-control hidden" required>
            <input name="ShouldExitCFORM" id="ShouldExitCFORM" type="text" class="form-control hidden" required>
            <input name="FineDayCFORM" id="FineDayCFORM" type="text" class="form-control hidden" required>
            <input name="FinePriceCFORM" id="FinePriceCFORM" type="text" class="form-control hidden" required>
            <input name="PaymentTypeCFORM" id="PaymentTypeCFORM" type="text" class="form-control hidden" required>
            <input name="DDayCFORM" id="DDayCFORM" type="text" class="form-control hidden" required>
            <input name="DefterCFORM" id="DefterCFORM" type="text" class="form-control hidden" required>
            <input name="CGunCFORM" id="CGunCFORM" type="text" class="form-control hidden" required>
            <input name="CAyCFORM" id="CAyCFORM" type="text" class="form-control hidden" required>
            <input name="codeFORM" id="codeFORM" type="text" class="form-control hidden" required>
            <input name="visatype" id="visatype" type="text" class="form-control hidden" required>
            <input readonly autocomplete="off" id="BirthdateCFORM" name="BirthdateCFORM" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+0d"}' class="form-control hidden" required>

            <div class="row">
                <div class="form-group col-lg-4 col-md-6 mb-3">
                    <label for="NameCFORM" class="control-label">
                        <i class="fas fa-user text-primary mr-1"></i> Yolcu Adı Soyadı
                    </label>
                    <input autocomplete="off" name="NameCFORM" id="NameCFORM" type="text" class="form-control" placeholder="Yolcunun pasaportundaki tam adı" required>
                </div>
                <div class="form-group col-lg-4 col-md-6 mb-3">
                    <label for="PassportCFORM" class="control-label">
                        <i class="fas fa-passport text-info mr-1"></i> Pasaport Numarası
                    </label>
                    <input autocomplete="off" name="PassportCFORM" id="PassportCFORM" type="text" class="form-control" placeholder="Örn: U12345678" required>
                </div>
                <div class="form-group col-lg-4 col-md-6 mb-3">
                    <label for="IDNCFORM" class="control-label">
                        <i class="fas fa-id-card text-secondary mr-1"></i> Yabancı Kimlik No (YKN) / TC No
                    </label>
                    <input autocomplete="off" name="IDNCFORM" id="IDNCFORM" type="text" class="form-control" placeholder="Varsa 99 ile başlayan YKN">
                </div>
                <div class="form-group col-lg-4 col-md-6 mb-3">
                    <label for="FatherCFORM" class="control-label">
                        <i class="fas fa-user-friends text-muted mr-1"></i> Baba Adı
                    </label>
                    <input autocomplete="off" name="FatherCFORM" id="FatherCFORM" type="text" class="form-control" placeholder="Baba adı">
                </div>
                <div class="form-group col-lg-4 col-md-6 mb-3">
                    <label for="MotherCFORM" class="control-label">
                        <i class="fas fa-female text-muted mr-1"></i> Anne Adı
                    </label>
                    <input autocomplete="off" name="MotherCFORM" id="MotherCFORM" type="text" class="form-control" placeholder="Anne adı">
                </div>
                <div class="form-group col-lg-4 col-md-6 mb-3">
                    <label for="PoliceCFORM" class="control-label">
                        <i class="fas fa-user-shield text-success mr-1"></i> Pasaport Kontrol Memuru
                    </label>
                    <input autocomplete="off" name="PoliceCFORM" id="PoliceCFORM" type="text" class="form-control" value="@ViewBag.OfficerName" placeholder="Memur Adı ve Sicili" required>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-12 text-right">
                    <button type="submit" class="btn btn-success btn-lg px-4 font-weight-bold" style="border-radius:10px; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);">
                        <i class="fas fa-file-pdf mr-2"></i> Resmi Tutanağı Oluştur ve Yazdır
                    </button>
                </div>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/calculate-index.js")?v=2.2"></script>
}
