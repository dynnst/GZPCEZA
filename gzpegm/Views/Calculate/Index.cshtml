@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseSelect2 = true;
}
@section Styles {
    <link href="@Url.Content("~/css/calculate-index.css")?v=3.0" rel="stylesheet" />
}

<div class="calculate-card">
    <!-- Sade ve Kurumsal Başlık -->
    <header class="card-header calculate-header">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="calculate-header-icon mr-2">
                    <i class="fas fa-passport"></i>
                </div>
                <div>
                    <h2 class="card-title">Vize ve İkamet İhlali Ceza Hesaplama</h2>
                    <p class="card-subtitle mb-0">Pasaport kontrol noktaları hızlı ihlal, harç, ceza ve tahdit kodu hesaplama sistemi</p>
                </div>
            </div>
            <div class="d-flex align-items-center mt-2 mt-md-0">
                <button type="button" id="btnOpenHksModal" class="btn btn-hks-launch mr-2" title="HKS İkamet Hesabından Ekran, Excel veya Pano ile Otomatik Çek">
                    <i class="fas fa-camera mr-1"></i> HKS'den Oku / 90-180 Kontrol Et
                </button>
                <div class="stat-pill mr-2" title="Sınır kapınızdaki toplam işlem sayısı">
                    <span class="stat-label">Toplam İşlem:</span>
                    <span id="userHistoryCount" class="stat-value">0</span>
                </div>
                <button type="button" onclick="resetCalculateForm()" class="btn btn-reset-calc" title="Tüm alanları sıfırlar ve yeni yolcu için hazırlar">
                    <i class="fas fa-redo-alt mr-1"></i> Yeni Yolcu
                </button>
            </div>
        </div>
    </header>

    <div class="card-body p-2 p-md-3">
        <!-- TEK EKRANDA 2 SÜTUNLU KABİN DÜZENİ -->
        <form id="calculate-form">
            <div class="row">
                
                <!-- SOL SÜTUN: YOLCU VE SEFER BİLGİLERİ -->
                <div class="col-xl-7 col-lg-7 col-md-12">
                    <div class="calc-panel">
                        
                        <!-- 1. Giriş - Çıkış Seferleri -->
                        <div class="calc-panel-header">
                            <h5 class="panel-title">
                                <i class="fas fa-calendar-alt"></i> Giriş - Çıkış Sefer Tarihleri
                            </h5>
                            <div class="panel-actions">
                                <button type="button" onclick="$('#btnOpenHksModal').click()" class="btn btn-warning btn-sm font-weight-bold mr-1" title="HKS İkamet Hesabından Ekran, Excel veya Pano ile Oku">
                                    <i class="fas fa-camera mr-1"></i> HKS'den Oku
                                </button>
                                <button id="GcAddButton" onclick="gcadd()" type="button" class="btn btn-primary" title="Önceki giriş-çıkışları ekle">
                                    <i class="fas fa-plus mr-1"></i> Sefer Ekle
                                </button>
                                <button type="button" onclick="gcremove(this);" class="btn btn-outline-danger" title="Son eklenen seferi sil">
                                    <i class="fas fa-trash-alt mr-1"></i> Son Satırı Sil
                                </button>
                            </div>
                        </div>

                        <!-- Giriş - Çıkış Tarih Satırları Konteyneri -->
                        <div id="date-rows-container" class="date-rows-container mb-2">
                            <!-- 1. Giriş-Çıkış Satırı -->
                            <div class="form-group row form-row date-pair-row align-items-end mb-1" id="date-row-0">
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-1">
                                    <label for="EnterDateCalculate" class="control-label font-weight-bold">
                                        <span class="row-badge mr-1">1</span> Giriş Tarihi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                        </span>
                                        <input autocomplete="off" onchange="hesapla1()" id="EnterDateCalculate" name="EnterDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","autoclose":"true","weekStart":"1","language":"tr","endDate":"+1d","orientation":"bottom"}' class="form-control endt" placeholder="GG.AA.YYYY" required>
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-1">
                                    <label for="ExitDateCalculate" class="control-label font-weight-bold">
                                        <span class="row-badge mr-1">1</span> Çıkış Tarihi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                        </span>
                                        <input autocomplete="off" onchange="hesapla1()" id="ExitDateCalculate" name="ExitDateCalculate" type="text" data-plugin-datepicker data-plugin-options='{"format":"dd.mm.yyyy","endDate":"+1d","autoclose":"true","weekStart":"1" ,"language":"tr","orientation":"bottom"}' value="@DateTime.Now.ToString("dd.MM.yyyy")" class="form-control exdt" placeholder="GG.AA.YYYY" required>
                                    </div>
                                </div>

                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-10 mb-1">
                                    <label for="PairDiff_0" class="control-label font-weight-bold">Kalış</label>
                                    <input readonly id="PairDiff_0" class="form-control pair-diff" placeholder="Gün" />
                                </div>

                                <div class="col-xl-1 col-lg-1 col-md-1 col-sm-2 mb-1 text-center">
                                    <span class="text-muted" title="Ana sefer kaydı" style="display:inline-block; padding-top:22px;">
                                        <i class="fas fa-lock text-muted"></i>
                                    </span>
                                </div>
                            </div>
                        </div>

