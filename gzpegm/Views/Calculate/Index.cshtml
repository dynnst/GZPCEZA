                                <select onchange="hesapla1()" id="CTypeCalculate" name="CTypeCalculate" data-plugin-selectTwo class="form-control populate" required>
                                    <option selected value="1">Normal Hesaplama</option>
                                    <option value="2">180 Gün Kuralı</option>
                                    <option value="3">30 Günlük (Tır Şoförleri)</option>
                                    <option value="5">Beyaz Rusya (30G / 365G-90G)</option>
                                </select>
                            </div>

