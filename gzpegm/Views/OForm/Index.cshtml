<body>
    <div class="invoice" style="page-break-after:always">
        @if (Model != null)
        {
            <div id="cezaQrCode" title="T.C. EGM Ceza Formu Doğrulama Karekodu"></div>
            <div class="violation-form-container">
                @Html.Partial("Languages/" + lang + "/_ViolationForm", Model)
            </div>

            if (Model.HasNKodlu)
            {
                <div class="page-break" style="display:block; page-break-before:always !important; break-before:page !important; clear:both;"></div>
                @Html.Partial("Languages/" + lang + "/_NKodluForm", Model)
            }

            if (Model.HasCKodlu && Model.IsAdult && (Model.IsOver90 || !Model.IsPaid))
            {
                <div class="page-break" style="display:block; page-break-before:always !important; break-before:page !important; clear:both;"></div>
                @Html.Partial("Languages/" + lang + "/_CKodluForm", Model)
            }
        }
        else
        {
            if (ViewBag.Form != null && !((string)ViewBag.Form).Contains("id=\"cezaQrCode\""))
            {
                <div id="cezaQrCode" title="T.C. EGM Ceza Formu Doğrulama Karekodu"></div>
            }
            @Html.Raw(ViewBag.Form) 
        }
    </div>

    <script>
        function renderCezaQr() {
            try {
                var qrTextData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model != null ? Model.QrText : (ViewBag.QrText ?? "")));
                if (!qrTextData || qrTextData.length === 0) {
                    var bodyText = document.body.innerText || "";
                    var nameMatch = bodyText.match(/(?:Adı Soyadı|Name\/Surname|Имя; Фамилия|姓名)[^\n:]*[:\t\s]+([^\n\r]+)/i);
                    var passMatch = bodyText.match(/(?:Pasaport No|Passport No|Номер паспорта|护照号码)[^\n:]*[:\t\s]+([^\n\r]+)/i);
                    var name = nameMatch ? nameMatch[1].trim() : "-";
                    var pass = passMatch ? passMatch[1].trim() : "-";
                    qrTextData = "T.C. İÇİŞLERİ BAKANLIĞI EGM\n" +
                                 "Yolcu: " + name + "\n" +
                                 "Pasaport: " + pass + "\n" +
                                 "Tarih: " + new Date().toLocaleDateString('tr-TR');
                }
                var targetBox = document.getElementById("cezaQrCode");
                if (typeof qrcode !== 'undefined' && targetBox) {
                    if (qrcode.stringToBytesFuncs && qrcode.stringToBytesFuncs['UTF-8']) {
                        qrcode.stringToBytes = qrcode.stringToBytesFuncs['UTF-8'];
                    }
                    var qr = qrcode(0, 'M');
                    qr.addData(qrTextData);
                    qr.make();
                    targetBox.innerHTML = qr.createSvgTag({
                        cellSize: 2,
                        margin: 1,
                        scalable: true
                    });
                }
            } catch (e) {
                console.error("QR Code oluşturulamadı:", e);
                try {
                    var qrFallback = qrcode(0, 'L');
                    qrFallback.addData(qrTextData);
                    qrFallback.make();
                    var tb = document.getElementById("cezaQrCode");
                    if (tb) tb.innerHTML = qrFallback.createTableTag(2, 0);
                } catch(e2) {}
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', renderCezaQr);
        } else {
            renderCezaQr();
        }

        // Ç Kodlu veya N Kodlu formların 1. sayfa dibinden başlamasını engellemek için JS güvencesi
        document.querySelectorAll('.page-break').forEach(function(el) {
            el.style.display = 'block';
            el.style.pageBreakBefore = 'always';
            el.style.breakBefore = 'page';
            el.style.clear = 'both';
        });

        // Vize ihlali toplam ödenecek tutarını personelin hemen fark edebileceği şekilde belirginleştirme güvencesi
        function enhanceFineAmount() {
            try {
                var fineCells = document.querySelectorAll('.violation-data-table td');
                fineCells.forEach(function(td) {
                    if (td.querySelector('.fine-total-badge')) return;
                    var text = (td.innerText || '').trim();
                    if (text.indexOf('Toplam=') >= 0 || text.indexOf('Toplam:') >= 0) {
                        var topMatch = text.match(/(.*?)(Toplam\s*[=:]\s*[\d.,]+(?:\s*TL)?)(.*)/i);
                        if (topMatch) {
                            var detail = topMatch[1].trim();
                            var total = topMatch[2].trim();
                            if (!total.match(/TL$/i)) total += " TL";
                            detail = detail.replace(/\+\s*DEF\s*(\d+)\s*(?:TL)?/gi, ' + DEF $1 TL')
                                           .replace(/\s+/g, ' ')
                                           .trim()
                                           .replace(/^[+,;]+|[+,;]+$/g, '')
                                           .trim();
                            var html = '<div class="fine-amount-wrap">';
                            if (detail.length > 0) {
                                html += '<span class="fine-breakdown">' + detail + '</span>';
                            }
                            html += '<strong class="fine-total-badge">' + total + '</strong>';
                            html += '</div>';
                            td.innerHTML = html;
                        }
                    }
                });
            } catch(e) {
                console.error("enhanceFineAmount error:", e);
            }
        }
        enhanceFineAmount();

        window.print();
    </script>
</body>
</html>
