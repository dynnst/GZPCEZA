@model gzpegm.Models.ViewModels.FormPrintViewModel
<h3 align="center" class="violation-title">VİZE İHLALİ İŞLEM FORMU /<strong>FORMALİTÄT FÜR DİE BEEİNTRÄCHTİGUNG DES AUFENTHALTSFRİSTS</strong></h3>
<table class="violation-data-table" style="width: 100%; border: 1px solid #000; border-collapse: collapse; margin-bottom: 6px;">
  <tbody>
    <tr>
      <td style="width: 65%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Adı Soyadı /Name und Vorname</td>
      <td style="width: 35%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassengerName</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Uyruğu / Nationalität</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.Nationality</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Pasaport No / Pass. Nummer</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassportNo</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize Giriş Tarihiniz ve Vize süreniz İhre Einreisedatum und Aufenthaltsfrist in der Türkei.</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.EntryDate</strong> &nbsp; <strong>@Model.VisaDistanceDays Tag(e)</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış için müracaat tarihiniz/ İhr(e) Ausreisedatum aus der Türkei</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.Today</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış yapmanız gereken tarih/ Die erforderliche Ausreisedatum aus der Türkei</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize giriş yapabileceğiniz tarih/ (Giriş yasağınızın otomatik olarak iptal edileceği tarih) / The date on which the ban on entry will be automatically canceled</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.CanEnterDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Tebliğ Edilen, Tahdit Çıkış veya İkamet Teskere Bitiş Tarihi / End date of notified or limitation date or residence permit</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlal süreniz / İhr(e) Beeinträchtigte Aufenthaltsfrist.</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ViolationPeriod</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlali için ödenecek ücret / Die zahlbare Gebühr für die Beeinträchtigung des Aufenthaltsfrists.</td>
      <td style="border: 1px solid #000; padding: 3px 6px; font-size: 11.5pt; vertical-align: middle;">@Html.Raw(Model.RenderFineAmountHtml())</td>
    </tr>
  </tbody>
</table>

<table width="800" border="0">
  <tbody>
    <tr>
      <td style="font-size: 12px"><p>
<p>
@if (Model.IsPaid)
{
    if (Model.IsOver90 && Model.HasCKodlu)
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
    }
    else
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretinizi şimdi ödediğinizden dolayı teşekkür ederiz.</span>
    }
}
else
{
    <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödemediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
}
</p>
<hr>

      <table width="800" border="0">
  <tbody>
    <tr>
      <td>
        Sehr Geehrte Herr/Frau <strong>@Model.PassengerName</strong>, Sie haben Ihre legale Aufenthaltsdauer in unserem Land überschritten.
        @if (Model.IsPaid)
        {
            if (Model.IsOver90 && Model.HasCKodlu)
            {
                <span>Da Sie die Strafe bezahlt haben, wird Ihnen ein Einreiseverbot für <strong>@Model.EntryBanDays</strong> Tage auferlegt. Sperrcode: <strong>@Model.TahditCode</strong></span>
            }
            else
            {
                <span>Wir bedanken uns im Voraus für die Bezahlung Ihrer Strafe bezüglich des Visa-Vergehens.</span>
            }
        }
        else
        {
            <span>Da Sie die Strafe nicht bezahlt haben, wird Ihnen ein Einreiseverbot für <strong>@Model.EntryBanDays</strong> Tage auferlegt. Sperrcode: <strong>@Model.TahditCode</strong></span>
        }
      </td>
    </tr>
  </tbody>
</table>


      </td>
    </tr>
  </tbody>
</table>
