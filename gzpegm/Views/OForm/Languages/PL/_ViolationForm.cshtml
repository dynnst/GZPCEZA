@model gzpegm.Models.ViewModels.FormPrintViewModel
<h3 align="center" class="violation-title">VİZE İHLALİ İŞLEM FORMU / FORMULARZ NARUSZENIA PRZEPISÓW WIZOWYCH</h3>
<table class="violation-data-table" style="width: 100%; border: 1px solid #000; border-collapse: collapse; margin-bottom: 6px;">
  <tbody>
    <tr>
      <td style="width: 65%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Adı Soyadı / Imię i nazwisko</td>
      <td style="width: 35%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassengerName</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Uyruğu / Obywatelstwo</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.Nationality</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Pasaport No / Numer paszportu</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassportNo</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize Giriş Tarihiniz ve Vize süreniz / Data wjazdu do kraju i ważność wizy</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.EntryDate</strong> &nbsp; <strong>@Model.VisaDistanceDays Dni / Day(s)</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış için müracaat tarihiniz / Data złożenia wniosku o wyjazd z kraju</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.Today</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış yapmanız gereken tarih / Data, do której należało opuścić kraj</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize giriş yapabileceğiniz tarih / (Giriş yasağınızın otomatik olarak iptal edileceği tarih) / Data, od której możliwy jest ponowny wjazd do kraju (Data automatycznego anulowania zakazu wjazdu)</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.CanEnterDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Tebliğ Edilen, Tahdit Çıkış veya İkamet Teskere Bitiş Tarihi / Data powiadomienia, wygaśnięcia zakazu lub wygaśnięcia karty pobytu</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlal süreniz / Okres naruszenia przepisów wizowych</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ViolationPeriod</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlali için ödenecek ücret / Opłata za naruszenie przepisów wizowych</td>
      <td style="border: 1px solid #000; padding: 3px 6px; font-size: 11.5pt; vertical-align: middle;">@Html.Raw(Model.RenderFineAmountHtml())</td>
    </tr>
  </tbody>
</table>

<table width="800" border="0">
  <tbody>
    <tr>
      <td style="font-size: 12px">
<p>
@if (Model.IsPaid)
{
    if (Model.IsOver90 && Model.HasCKodlu)
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
    }
    else
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretinizi şimdi ödediğinizden dolayı teşekkür ederiz.</span>
    }
}
else
{
    <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödemediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
}
</p>
<hr>
      <table width="800" border="0">
  <tbody>
    <tr>
      <td>
        Szanowny/a <strong>@Model.PassengerName</strong>, przekroczył(a) Pan/Pani legalny okres pobytu w naszym kraju.
        @if (Model.IsPaid)
        {
            if (Model.IsOver90 && Model.HasCKodlu)
            {
                <span>Ponieważ opłacił(a) Pan/Pani karę za naruszenie przepisów wizowych, zostanie wobec Pana/Pani nałożony zakaz wjazdu do Turcji na okres <strong>@Model.EntryBanDays</strong> dni. Kod ograniczenia: <strong>@Model.TahditCode</strong></span>
            }
            else
            {
                <span>Dziękujemy za opłacenie kary za naruszenie przepisów wizowych.</span>
            }
        }
        else
        {
            <span>Ponieważ nie opłacił(a) Pan/Pani należnej kary, zostanie wobec Pana/Pani nałożony zakaz wjazdu do Turcji na okres <strong>@Model.EntryBanDays</strong> dni. Kod ograniczenia: <strong>@Model.TahditCode</strong></span>
        }
      </td>
    </tr>
  </tbody>
</table>
      </td>
    </tr>
  </tbody>
</table>
<span style="font-size: 14px"><br></span>
<table align="center" width="400" border="0">
  <tbody>
    <tr>
      <td>Düzenleme Tarihi / Data wydania:</td>
      <td><strong>@Model.Today</strong></td>
    </tr>
  </tbody>
</table>
<span style="font-size: 14px"><br></span>
<table width="800" border="0">
  <tbody>
    <tr align="center">
      <td>Yolcu İmzası</td>
      <td>Pasaport Kontrol Polisi</td>
    </tr>
    <tr align="center">
      <td>Podpis pasażera</td>
      <td>Funkcjonariusz kontroli paszportowej</td>
    </tr>
    <tr align="center">
      <td><strong>&nbsp;@Model.PassengerName</strong></td>
      <td><strong>@Model.PoliceOfficer</strong></td>
    </tr>
  </tbody>
</table>
<span style="font-size: 14px"><br></span>
<table width="800" border="0">
  <tbody>
    <tr>
      <td>Formu okudum, imzaladım ve kopyasını aldım / Zapoznałem(-am) się z formularzem, podpisałem(-am) go i otrzymałem(-am) jego kopię</td>
    </tr>
  </tbody>
</table>
<span style="font-size: 14px"><br></span>
<table width="800" border="0">
  <tbody>
    <tr align="center">
      <td><strong>O N A Y</strong></td>
    </tr>
    <tr align="center">
      <td>ZATWIERDZENIE / APPROVAL</td>
    </tr>
    <tr align="center">
      <td>@Model.ApprovalUser</td>
    </tr>
  </tbody>
</table>
<span style="font-size: 14px"><br></span>
<table width="800" border="0">
  <tbody>
  <tr>
    <th scope="col" style="width:10"><span style="font-size:10px">1</span></th>
    <td style="text-align:left"><span style="font-size:10px">İkamet Harçları 492 sayılı Harçlar kanununun 6 sayılı tarifesine göre her yıl Maliye Bakanlığınca Belirlenmektedir. / Opłaty pobytowe są ustalane corocznie przez Ministerstwo Finansów zgodnie z taryfą nr 6 ustawy o opłatach skarbowych nr 492.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:10"><span style="font-size:10px">2</span></th>
    <td style="text-align:left"><span style="font-size:10px">Hakkınızda konulmuşsa, konulan ülkemize giriş yasağının kaldırılması için Türkiye Cumhuriyeti dış temsilciliklerine özel amaçlı vize için müracaat ediniz. / W celu zniesienia zakazu wjazdu do naszego kraju, o ile został nałożony, należy złożyć wniosek o wizę specjalnego przeznaczenia w przedstawicielstwach zagranicznych Republiki Turcji.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:20"><span style="font-size:10px">3</span></th>
    <td style="text-align:left"><span style="font-size:10px">Vize ihlali nedeniyle hakkınızda uygulanan "N" veya "Ç" tahdit kodlarıyla ilgili , 60(altmış) gün içerisinde İdare mahkemesine başvuru yapmanız gerekmektedir. / W sprawie kodów ograniczeń „N” lub „Ç” nałożonych z powodu naruszenia przepisów wizowych należy złożyć skargę do Sądu Administracyjnego w terminie 60 (sześćdziesięciu) dni.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:20"><span style="font-size:10px">4</span></th>
    <td style="text-align:left"><span style="font-size:10px">Tahdit iş ve işlemler ile ilgili uygulamalar Göç İdaresi Genel Müdürlüğü'nün 22/07/2020 tarih ve 2020/17 sayılı genelgeye istinaden yapılmaktadır. / Procedury dotyczące ograniczeń są realizowane na podstawie okólnika nr 2020/17 z dnia 22.07.2020 r. Generalnej Dyrekcji ds. Zarządzania Migracją.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:20"><span style="font-size:10px">5</span></th>
    <td style="text-align:left"><span style="font-size:10px">Vize ihlalinde bulunan yolcularla ilgili yurda giriş yasaklarına ilişkin uygulama 2020/17 sayılı genelgenin Madde 6'nın "A" ve "B" bendlerine istinaden uygulanır. / Stosowanie zakazów wjazdu dla pasażerów naruszających przepisy wizowe odbywa się na podstawie art. 6 lit. „A” i „B” okólnika nr 2020/17.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:20"><span style="font-size:10px">6</span></th>
    <td style="text-align:left"><span style="font-size:10px">6458 Sayılı Yabancılar ve Uluslararası Koruma Kanununun "9","15","102" Maddeleri. / Artykuły 9, 15 i 102 Ustawy nr 6458 o cudzoziemcach i ochronie międzynarodowej.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:20"><span style="font-size:10px">7</span></th>
    <td style="text-align:left"><span style="font-size:10px">17/03/2016 tarihli ve 29656 sayılı Yabancılar ve Uluslararası Koruma Kanununun Uygulamasına İlişkin Yönetmeliğin 8. ve 9. Maddeleri. / Artykuły 8 i 9 Rozporządzenia w sprawie wykonania Ustawy o cudzoziemcach i ochronie międzynarodowej z dnia 17.03.2016 r. nr 29656.</span></td>
  </tr>
  <tr>
    <th scope="row" style="width:20"><span style="font-size:10px">8</span></th>
    <td style="text-align:left"><span style="font-size:10px">Göç İdaresi Başkanlığı'nın 06.01.2022 tarih ve V-157 İdari Takip Kodu Görüş Talebi Konulu Yazısı. / Pismo Prezydium ds. Zarządzania Migracją z dnia 06.01.2022 r. w sprawie wniosku o opinię dotyczącą administracyjnego kodu śledzenia V-157.</span></td>
  </tr>
  </tbody>
</table>
