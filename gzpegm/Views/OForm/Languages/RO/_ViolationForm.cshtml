@model gzpegm.Models.ViewModels.FormPrintViewModel
<h3 align="center" class="violation-title">VİZE İHLALİ İŞLEM FORMU / FORMULAR PENTRU ÎNCĂLCAREA REGIMULUI DE VIZĂ</h3>
<table class="violation-data-table" style="width: 100%; border: 1px solid #000; border-collapse: collapse; margin-bottom: 6px;">
  <tbody>
    <tr>
      <td style="width: 70%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Adı Soyadı / Nume și prenume</td>
      <td style="width: 30%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassengerName</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Uyruğu / Cetățenie</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.Nationality</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Pasaport No / Număr pașaport</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassportNo</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize Giriş Tarihiniz ve Vize süreniz / Data intrării în țară și valabilitatea vizei</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.EntryDate</strong> &nbsp; <strong>@Model.VisaDistanceDays Zile / Day(s)</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış için müracaat tarihiniz / Data solicitării de părăsire a țării</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.Today</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış yapmanız gereken tarih / Data la care trebuia să părăsiți țara</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize giriş yapabileceğiniz tarih / (Giriş yasağınızın otomatik olarak iptal edileceği tarih) / Data de la care puteți reintra în țară (Data expirării automate a interdicției de intrare)</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.CanEnterDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Tebliğ Edilen, Tahdit Çıkış veya İkamet Teskere Bitiş Tarihi / Data notificării, expirării interdicției sau încetării permisului de ședere</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlal süreniz / Perioada de încălcare a regimului de viză</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ViolationPeriod</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlali için ödenecek ücret / Taxă pentru încălcarea regimului de viză</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.FineAmount TL</strong></td>
    </tr>
  </tbody>
</table>

<table width="800" border="0">
  <tbody>
    <tr>
      <td style="font-size: 12px">
<p>
@if (Model.IsPaid)
{
    if (Model.IsOver90 && Model.HasCKodlu)
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
    }
    else
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretinizi şimdi ödediğinizden dolayı teşekkür ederiz.</span>
    }
}
else
{
    <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödemediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
}
</p>
<hr>
      <table width="800" border="0">
  <tbody>
    <tr>
      <td>
        Stimate/Stimată <strong>@Model.PassengerName</strong>, ați depășit perioada legală de ședere în țara noastră.
        @if (Model.IsPaid)
        {
            if (Model.IsOver90 && Model.HasCKodlu)
            {
                <span>Deoarece ați achitat amenda pentru încălcarea vizei, vi se va aplica o interdicție de intrare în Turcia pentru o perioadă de <strong>@Model.EntryBanDays</strong> zile. Codul de restricție: <strong>@Model.TahditCode</strong></span>
            }
            else
            {
                <span>Vă mulțumim pentru achitarea taxei pentru depășirea termenului legal de ședere.</span>
            }
        }
        else
        {
            <span>Deoarece nu ați achitat amenda aplicabilă, vi se va impune o interdicție de intrare în Turcia pentru o perioadă de <strong>@Model.EntryBanDays</strong> zile. Codul de restricție: <strong>@Model.TahditCode</strong></span>
        }
      </td>
    </tr>
  </tbody>
</table>
      </td>
    </tr>
  </tbody>
</table>
