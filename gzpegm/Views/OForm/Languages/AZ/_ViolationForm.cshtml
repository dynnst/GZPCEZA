@model gzpegm.Models.ViewModels.FormPrintViewModel
<h3 align="center" class="violation-title">VİZE İHLALİ İŞLEM FORMU / VİZA REJİMİNİN POZULMASI HAQQINDA BƏYANNAMƏ FORMASI</h3>
<table class="violation-data-table" style="width: 100%; border: 1px solid #000; border-collapse: collapse; margin-bottom: 6px;">
  <tbody>
    <tr>
      <td style="width: 65%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Adı Soyadı / Adı və Soyadı</td>
      <td style="width: 35%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassengerName</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Uyruğu / Vətəndaşlığı</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.Nationality</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Pasaport No / Pasport nömrəsi</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassportNo</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize Giriş Tarihiniz ve Vize süreniz / Ölkəmizə giriş tarixi və viza müddəti</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.EntryDate</strong> &nbsp; <strong>@Model.VisaDistanceDays Gün / Day(s)</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış için müracaat tarihiniz / Ölkəmizdən çıxış üçün müraciət tarixi</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.Today</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış yapmanız gereken tarih / Ölkəmizdən çıxmalı olduğunuz tarix</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize giriş yapabileceğiniz tarih / (Giriş yasağınızın otomatik olarak iptal edileceği tarih) / Ölkəmizə giriş edə biləcəyiniz tarix (Giriş qadağasının avtomatik ləğv ediləcəyi tarix)</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.CanEnterDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Tebliğ Edilen, Tahdit Çıkış veya İkamet Teskere Bitiş Tarihi / Bildirilən məhdudiyyət və ya yaşayış icazəsinin bitmə tarixi</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlal süreniz / Viza rejiminin pozulma müddəti</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ViolationPeriod</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlali için ödenecek ücret / Viza rejiminin pozulmasına görə ödəniləcək cərimə</td>
      <td style="border: 1px solid #000; padding: 3px 6px; font-size: 11.5pt; vertical-align: middle;">@Html.Raw(Model.RenderFineAmountHtml())</td>
    </tr>
  </tbody>
</table>

<table width="800" border="0">
  <tbody>
    <tr>
      <td style="font-size: 12px">
<p>
@if (Model.IsPaid)
{
    if (Model.IsOver90 && Model.HasCKodlu)
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
    }
    else
    {
        <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretinizi şimdi ödediğinizden dolayı teşekkür ederiz.</span>
    }
}
else
{
    <span>Sayın&nbsp;<span style="color: rgb(0, 0, 0); font-size: 13px;">@Model.PassengerName</span>&nbsp;Ülkemizdeki yasal kalış sürenizi ihlal etmiş bulunmaktasınız. Vize ihlal ücretini ödemediğiniz için hakkınızda ülkemize&nbsp;<strong>@Model.EntryBanDays&nbsp;</strong>Gün giriş yasağı uygulanacaktır.&nbsp; Hakkınızda girilecek&nbsp;Tahdit kodu @Model.TahditCode</span>
}
</p>
<hr>
      <table width="800" border="0">
  <tbody>
    <tr>
      <td>
        Hörmətli <strong>@Model.PassengerName</strong>, ölkəmizdə qanuni qalma müddətini pozmusunuz.
        @if (Model.IsPaid)
        {
            if (Model.IsOver90 && Model.HasCKodlu)
            {
                <span>Viza pozuntusu cəriməsini ödədiyiniz üçün Türkiyəyə <strong>@Model.EntryBanDays</strong> gün müddətinə giriş qadağası tətbiq ediləcəkdir. Məhdudiyyət kodu: <strong>@Model.TahditCode</strong></span>
            }
            else
            {
                <span>Viza pozuntusu cəriməsini vaxtında ödədiyiniz üçün təşəkkür edirik.</span>
            }
        }
        else
        {
            <span>Müvafiq cəriməni ödəmədiyiniz üçün Türkiyəyə <strong>@Model.EntryBanDays</strong> gün müddətinə giriş qadağası tətbiq ediləcəkdir. Məhdudiyyət kodu: <strong>@Model.TahditCode</strong></span>
        }
      </td>
    </tr>
  </tbody>
</table>
      </td>
    </tr>
  </tbody>
</table>
