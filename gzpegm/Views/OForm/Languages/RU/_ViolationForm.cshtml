@model gzpegm.Models.ViewModels.FormPrintViewModel
<h3 align="center" class="violation-title"><strong>VİZE İHLALİ İŞLEM FORMU /АКТ О НАРУШЕНИИ ВИЗОВОГО РЕЖИМА</strong></h3>
<table class="violation-data-table" style="width: 100%; border: 1px solid #000; border-collapse: collapse; margin-bottom: 6px;">
  <tbody>
    <tr>
      <td style="width: 70%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Adı Soyadı /Имя; Фамилия</td>
      <td style="width: 30%; border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassengerName</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Uyruğu / Гражданство</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.Nationality</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">Pasaport No / Номер паспорта</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong class="passenger-val">@Model.PassportNo</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize Giriş Tarihiniz ve Vize süreniz Дата прибытия и срок действия визы..</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.EntryDate</strong> &nbsp; <strong>@Model.VisaDistanceDays Day</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış için müracaat tarihiniz/ Дата выезда</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.Today</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemizden çıkış yapmanız gereken tarih/Окончание срока пребывания.</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Ülkemize giriş yapabileceğiniz tarih/ (Giriş yasağınızın otomatik olarak iptal edileceği tarih) / Вы можете подключиться к нашей стране (Автоматически отменить дату вашего запрет)</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.CanEnterDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Tebliğ Edilen, Tahdit Çıkış veya İkamet Teskere Bitiş Tarihi / End date of notified or limitation date or residence permit</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ShouldExitDate</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlal süreniz / Срок нарушения визы</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.ViolationPeriod</strong></td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;">* Vize ihlali için ödenecek ücret / Сумма штрафа</td>
      <td style="border: 1px solid #000; padding: 2px 5px; font-size: 11.5pt;"><strong>@Model.FineAmount TL</strong></td>
    </tr>
  </tbody>
</table>

<strong><span style="font-size: 14px"><br>
</span>
