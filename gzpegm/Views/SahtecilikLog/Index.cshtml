@model gzpegm.Models.SahtecilikLogViewModel
@{
    ViewBag.Title = "Sahtecilik Denetim ve Güvenlik Logları";
    Layout = "~/Views/Shared/_Master.cshtml";
}

<style>
    .audit-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #b91c1c 100%);
        color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25);
    }
    .audit-hero-watermark {
        position: absolute;
        right: 20px;
        bottom: -20px;
        font-size: 140px;
        color: rgba(255, 255, 255, 0.05);
        pointer-events: none;
    }
    .audit-stat-card {
        background: #ffffff;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        transition: transform 0.2s;
    }
    .audit-stat-card:hover {
        transform: translateY(-2px);
    }
    .audit-stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-right: 15px;
        flex-shrink: 0;
    }
    .audit-filter-card {
        background: #ffffff;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .audit-table-card {
        background: #ffffff;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .audit-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 12px 16px;
    }
    .audit-table td {
        padding: 14px 16px;
        vertical-align: middle;
        font-size: 13.5px;
        border-bottom: 1px solid #f1f5f9;
    }
    .audit-table tr:hover td {
        background-color: #f8fafc;
    }
    .badge-source-calc {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
        font-weight: 600;
    }
    .badge-source-userbox {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
        font-weight: 600;
    }
    .badge-source-portal {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        font-weight: 600;
    }
    .badge-source-guide {
        background: #faf5ff;
        color: #6b21a8;
        border: 1px solid #e9d5ff;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-3 py-4">
    <!-- HERO BANNER -->
    <div class="audit-hero">
        <i class="fas fa-user-secret audit-hero-watermark"></i>
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <span class="badge badge-danger px-3 py-1 text-uppercase font-weight-bold mb-2" style="letter-spacing:1px;">
                    <i class="fas fa-lock mr-1"></i> YALNIZCA SİSTEM YÖNETİCİSİ (ADMİN) PANELİ
                </span>
                <h2 class="font-weight-bold mb-2">
                    <i class="fas fa-shield-alt text-warning mr-2"></i> Sahtecilik Portalı Denetim ve Güvenlik Logları
                </h2>
                <p class="mb-0 text-white-50" style="max-width: 800px; font-size: 14px;">
                    Personelin <strong>Hesaplama Ekranı</strong> ve <strong>UserBox Menüsü</strong> üzerinden Sahtecilik İnceleme Portalı'na geçişleri, işlem anında seçili olan yolcu uyrukları, inceleme zamanları ve terminal IP kayıtları.
                </p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="@Url.Action("Export", "SahtecilikLog", new { search = Model.Search, kaynak = Model.Kaynak, ulke = Model.Ulke, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd") })" 
                   class="btn btn-success btn-lg font-weight-bold shadow-sm">
                    <i class="fas fa-file-excel mr-2"></i> Excel / CSV Olarak İndir
                </a>
            </div>
        </div>
    </div>

    <!-- İSTATİSTİK KARTLARI -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="audit-stat-card">
                <div class="audit-stat-icon bg-primary text-white">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase font-weight-bold">Bugünkü Geçişler</span>
                    <h3 class="font-weight-bold text-dark mb-0">@Model.TodayCount</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="audit-stat-card">
                <div class="audit-stat-icon bg-danger text-white">
                    <i class="fas fa-search-plus"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase font-weight-bold">Son 7 Günlük Toplam</span>
                    <h3 class="font-weight-bold text-dark mb-0">@Model.WeekCount</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="audit-stat-card">
                <div class="audit-stat-icon bg-success text-white">
                    <i class="fas fa-users-cog"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase font-weight-bold">İşlem Yapan Personel</span>
                    <h3 class="font-weight-bold text-dark mb-0">@Model.DistinctUserCount</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="audit-stat-card">
                <div class="audit-stat-icon bg-warning text-dark">
                    <i class="fas fa-globe-americas"></i>
                </div>
                <div style="flex:1; overflow:hidden;">
                    <span class="text-muted small text-uppercase font-weight-bold d-block">Sık İncelenen Ülkeler</span>
                    <div class="d-flex flex-wrap mt-1" style="gap:4px;">
                        @if (Model.TopCountries != null && Model.TopCountries.Any())
                        {
                            foreach (var tc in Model.TopCountries.Take(3))
                            {
                                <span class="badge badge-light border text-dark font-weight-semibold" style="font-size:11px;">
                                    @tc.Key (@tc.Value)
                                </span>
                            }
                        }
                        else
                        {
                            <span class="small text-muted">-</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FİLTRELEME FORMU -->
    <div class="audit-filter-card">
        <form method="get" action="@Url.Action("Index", "SahtecilikLog")" id="filterForm">
            <div class="row align-items-end">
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="font-weight-bold small text-muted text-uppercase">Personel / Sicil / Arama</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        </div>
                        <input type="text" name="search" class="form-control" placeholder="Sicil no, isim, ülke..." value="@Model.Search" />
                    </div>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="font-weight-bold small text-muted text-uppercase">Kaynak Sayfa</label>
                    <select name="kaynak" class="form-control">
                        <option value="">Tüm Kaynaklar</option>
                        <option value="Hesaplama" @(Model.Kaynak == "Hesaplama" ? "selected" : "")>Hesaplama Sayfası</option>
                        <option value="UserBox" @(Model.Kaynak == "UserBox" ? "selected" : "")>UserBox Menüsü</option>
                        <option value="Sahtecilik Portalı" @(Model.Kaynak == "Sahtecilik Portalı" ? "selected" : "")>Sahtecilik Portalı İçi</option>
                        <option value="Yardımcı" @(Model.Kaynak == "Yardımcı" ? "selected" : "")>Yardımcı Doküman</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="font-weight-bold small text-muted text-uppercase">Başlangıç Tarihi</label>
                    <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="font-weight-bold small text-muted text-uppercase">Bitiş Tarihi</label>
                    <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 d-flex" style="gap: 8px;">
                    <button type="submit" class="btn btn-primary font-weight-bold flex-grow-1">
                        <i class="fas fa-filter mr-1"></i> Filtrele
                    </button>
                    <a href="@Url.Action("Index", "SahtecilikLog")" class="btn btn-outline-secondary font-weight-bold" title="Filtreleri Temizle">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- LOG TABLOSU -->
    <div class="audit-table-card">
        <div class="p-3 bg-white border-bottom d-flex align-items-center justify-content-between">
            <div>
                <h5 class="font-weight-bold mb-0 text-dark">
                    <i class="fas fa-list-alt text-primary mr-2"></i> Denetim Kayıtları
                </h5>
                <small class="text-muted">Toplam <strong>@Model.TotalCount</strong> adet işlem kaydı listelendi.</small>
            </div>
            <div>
                <span class="badge badge-light border text-muted px-3 py-2 font-weight-bold">
                    Sayfa @Model.PageIndex / @(Model.TotalPages > 0 ? Model.TotalPages : 1)
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table audit-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th style="width: 170px;">Tarih / Saat</th>
                        <th style="width: 220px;">Personel Bilgisi</th>
                        <th style="width: 150px;">Kaynak Ekran</th>
                        <th style="width: 140px;">İşlem Türü</th>
                        <th style="width: 160px;">İlgili Ülke / Belge</th>
                        <th>İşlem Detayı &amp; Açıklama</th>
                        <th style="width: 140px;">IP Adresi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs != null && Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            string badgeClass = "badge-secondary";
                            if (log.KaynakSayfa == "Hesaplama") { badgeClass = "badge-source-calc"; }
                            else if (log.KaynakSayfa == "UserBox") { badgeClass = "badge-source-userbox"; }
                            else if (log.KaynakSayfa == "Sahtecilik Portalı") { badgeClass = "badge-source-portal"; }
                            else if (log.KaynakSayfa == "Yardımcı") { badgeClass = "badge-source-guide"; }

                            <tr>
                                <td class="text-muted font-weight-bold">#@log.Id</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@log.FormattedTarih</div>
                                    <small class="text-muted"><i class="far fa-clock mr-1"></i>@log.TimeAgo</small>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark">
                                        <i class="fas fa-user-shield text-secondary mr-1"></i>
                                        @(string.IsNullOrWhiteSpace(log.UserName) ? "Bilinmeyen Personel" : log.UserName)
                                    </div>
                                    <div class="small text-muted">
                                        <span>Sicil: <strong>@(log.UserSicil ?? "-")</strong></span>
                                        @if (!string.IsNullOrWhiteSpace(log.UserBorder))
                                        {
                                            <span class="ml-1 badge badge-light border">@log.UserBorder</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @badgeClass px-2 py-1" style="font-size:12px;">
                                        @if (log.KaynakSayfa == "Hesaplama")
                                        {
                                            <i class="fas fa-calculator mr-1"></i>
                                        }
                                        else if (log.KaynakSayfa == "UserBox")
                                        {
                                            <i class="fas fa-th-large mr-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-external-link-alt mr-1"></i>
                                        }
                                        @log.KaynakSayfa
                                    </span>
                                </td>
                                <td>
                                    <span class="font-weight-semibold text-dark">
                                        @if (log.IslemTipi == "Belge İnceleme")
                                        {
                                            <span class="badge badge-warning text-dark"><i class="fas fa-file-search mr-1"></i>Belge İnceleme</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info"><i class="fas fa-sign-in-alt mr-1"></i>Portal Geçişi</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.SecilenUlke))
                                    {
                                        <div class="font-weight-bold text-danger">
                                            <i class="fas fa-flag mr-1"></i>@log.SecilenUlke
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(log.IncelenenBelgeBaslik))
                                    {
                                        <div class="small text-dark font-weight-semibold text-truncate" style="max-width:180px;" title="@log.IncelenenBelgeBaslik">
                                            <i class="fas fa-passport mr-1 text-primary"></i>@log.IncelenenBelgeBaslik
                                        </div>
                                    }
                                    @if (string.IsNullOrWhiteSpace(log.SecilenUlke) && string.IsNullOrWhiteSpace(log.IncelenenBelgeBaslik))
                                    {
                                        <span class="text-muted small">Genel İnceleme</span>
                                    }
                                </td>
                                <td>
                                    <div class="text-dark" style="line-height: 1.4;">
                                        @(log.Detay ?? "-")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(log.HedefUrl))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width:320px;" title="@log.HedefUrl">
                                            <i class="fas fa-link mr-1"></i>@log.HedefUrl
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-light border text-muted px-2 py-1 font-weight-mono" style="font-size:12px;">
                                        <i class="fas fa-network-wired mr-1 text-secondary"></i>@(string.IsNullOrWhiteSpace(log.IpAddress) ? "127.0.0.1" : log.IpAddress)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-check fa-3x mb-3 text-muted" style="opacity:0.3;"></i>
                                <h5>Filtreye Uygun Denetim Kaydı Bulunamadı</h5>
                                <p class="small mb-0">Henüz aranan kriterlere uyan bir geçiş veya inceleme kaydı bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- SAYFALAMA -->
        @if (Model.TotalPages > 1)
        {
            <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                <span class="small text-muted">
                    Toplam <strong>@Model.TotalCount</strong> kayıttan <strong>@(((Model.PageIndex - 1) * Model.PageSize) + 1)</strong> - <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount))</strong> arası gösteriliyor.
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "SahtecilikLog", new { search = Model.Search, kaynak = Model.Kaynak, ulke = Model.Ulke, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = Model.PageIndex - 1 })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = Math.Max(1, Model.PageIndex - 3); i <= Math.Min(Model.TotalPages, Model.PageIndex + 3); i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", "SahtecilikLog", new { search = Model.Search, kaynak = Model.Kaynak, ulke = Model.Ulke, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "SahtecilikLog", new { search = Model.Search, kaynak = Model.Kaynak, ulke = Model.Ulke, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = Model.PageIndex + 1 })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
