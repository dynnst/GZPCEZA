@model gzpegm.Models.E_Exchange

@{
    Layout = "~/Views/Shared/_Master.cshtml";
}
<section class="card">
    <form method="post" action="/UpdateExchange">
        <header class="card-header">
            <h2 class="card-title">Döviz İşlemleri</h2>
        </header>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label for="AvroExchange">Avro</label>
                    <input onkeydown="Decimal(this,event)" type="text" maxlength="25" class="form-control" id="AvroExchange" value="@Model.fldEuro" name="AvroExchange" required>
                </div>
                <div class="form-group col-md-4">
                    <label for="DollarExchange">Amerikan Doları</label>
                    <input onkeydown="Decimal(this,event)" type="text" maxlength="25" class="form-control" id="DollarExchange" value="@Model.fldDollar" name="DollarExchange" required>
                </div>
                <div class="form-group col-md-4">
                    <label for="SterlinExchange">İngiliz Sterlini</label>
                    <input onkeydown="Decimal(this,event)" type="text" maxlength="25" class="form-control" id="SterlinExchange" value="@Model.fldPaund" name="SterlinExchange" required>
                </div>

            </div>
        </div>
        <footer class="card-footer">
            <div class="row">
                <div class="col-md-12 text-right">
                    <button type="submit" name="submit" value="Submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </footer>
    </form>
</section>


