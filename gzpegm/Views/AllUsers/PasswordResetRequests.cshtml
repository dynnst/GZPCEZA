@model List<gzpegm.Models.ViewModels.PasswordResetRequestViewModel>
@{
    ViewBag.Title = "Şifre Sıfırlama Talepleri";
    Layout = "~/Views/Shared/_Master.cshtml";
}

<div class="page-wrapper">
    <div class="page-heading mb-4">
        <h1 class="page-title"><i class="fas fa-key me-2"></i>Şifre Sıfırlama Talepleri</h1>
        <p class="text-muted">Personelin oluşturduğu talepleri onaylayarak yeni şifrelerini etkinleştirin.</p>
        <a href="@Url.Action("Index", "AllUsers")" class="btn btn-light"><i class="fas fa-arrow-left"></i> Kullanıcı Yönetimine Dön</a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Sicil</th><th>Ad Soyad</th><th>E-posta</th><th>Talep Tarihi</th><th class="text-right">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Sicil</td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.RequestedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-right">
                                    @using (Html.BeginForm("ApprovePasswordResetRequest", "AllUsers", FormMethod.Post, new { onsubmit = "return confirm('Bu talebi onaylayıp yeni şifreyi etkinleştirmek istiyor musunuz?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@item.RequestId" />
                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Onayla</button>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5 text-muted"><i class="fas fa-check-circle fa-2x mb-3"></i><p class="mb-0">Bekleyen şifre sıfırlama talebi bulunmuyor.</p></div>
            }
        </div>
    </div>
</div>
