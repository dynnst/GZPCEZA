@model List<gzpegm.Models.E_History>

@{
    ViewBag.Title = "Kullanıcı İşlem Geçmişi";
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseDataTables = true;
    ViewBag.UseDataTablesExport = true;
}

<div class="page-wrapper">
    <!-- BAŞLIK BÖLÜMÜ -->
    <div class="page-heading mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-history me-2"></i>@ViewBag.UserName Kullanıcısının İşlem Geçmişi
                </h1>
                <p class="text-muted">Kullanıcının tüm işlem kayıtları listelenmektedir</p>
            </div>
            <a href="@Url.Action("Index", "AllUsers")" class="btn btn-outline-secondary mt-2 mt-sm-0">
                <i class="fas fa-arrow-left me-1"></i> Geri Dön
            </a>
        </div>
    </div>

    <!-- İŞLEM TABLOSU KARTI -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>İşlem Kayıtları
                    </h4>
                    <p class="card-subtitle">Toplam @(Model?.Count ?? 0) kayıt bulundu</p>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="historyTable" class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>İşlem Tarihi</th>
                                    <th>Başlangıç</th>
                                    <th>Çıkış</th>
                                    <th>Doğum Tarihi</th>
                                    <th>Ülke</th>
                                    <th>Ceza</th>
                                    <th>Para</th>
                                    <th>Sınır</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Count > 0)
                                {
                                    int counter = 1;
                                    foreach (var h in Model)
                                    {
                                        <tr>
                                            <td>@counter</td>
                                            <td>@(h.fldDatetime.HasValue ? h.fldDatetime.Value.ToString("dd.MM.yyyy HH:mm") : "Bilinmiyor")</td>
                                            <td>@(h.fldStart.HasValue ? h.fldStart.Value.ToString("dd.MM.yyyy HH:mm") : "")</td>
                                            <td>@(h.fldShouldExit.HasValue ? h.fldShouldExit.Value.ToString("dd.MM.yyyy HH:mm") : "")</td>
                                            <td>@(h.fldBirthDate.HasValue ? h.fldBirthDate.Value.ToString("dd.MM.yyyy") : "")</td>
                                            <td>@h.fldCountry</td>
                                            <td>@h.fldPenalty</td>
                                            <td>@h.fldPMoney</td>
                                            <td>@h.fldBorder</td>
                                        </tr>
                                        counter++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">
                                            <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                            Hiç işlem bulunamadı
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/css/userhistory.css")?v=1.0" rel="stylesheet" />
}

@section Scripts {
    <script src="@Url.Content("~/js/userhistory.js")?v=1.1"></script>
}
