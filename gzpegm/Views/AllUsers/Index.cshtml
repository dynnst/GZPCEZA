                                </p>
                                <button type="button" id="btnDeleteOrphans" class="btn btn-danger btn-block font-weight-semibold">
                                    <i class="fas fa-user-times me-1"></i> Yetim Kullanıcıları Sil (Doğrudan Başlat)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- tab-content sonu -->
</div> <!-- page-wrapper sonu -->

