@model gzpegm.Models.Usermodel
@using System.Linq

@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Title = "Kullanıcı Yönetimi";
    ViewBag.UseDataTables = true;
    ViewBag.UseDataTablesExport = true;
    ViewBag.UseSelect2 = true;
    ViewBag.UseBootstrapMultiselect = true;
}

<div class="page-wrapper">
    <!-- BAŞLIK BÖLÜMÜ -->
    <div class="page-heading mb-4 d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h1 class="page-title">
                <i class="fas fa-users me-2"></i>Kullanıcı Yönetimi
            </h1>
            <p class="text-muted mb-0">Öğretmen başvuruları, online kullanıcılar, pasif/aktif kullanıcılar, tüm kullanıcılar ve sistem bakım işlemleri</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary shadow-sm me-2" onclick="openServerSyncModal()">
                <i class="fas fa-network-wired me-1"></i> Sunucu Eşitleme (10.7.202.75 / 76)
            </button>
            <a href="@Url.Action("PasswordResetRequests", "AllUsers")" class="btn btn-warning shadow-sm">
                <i class="fas fa-key me-1"></i> Şifre Sıfırlama Talepleri
            </a>
        </div>
    </div>

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i> @TempData["Info"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @Html.AntiForgeryToken()

    <!-- TAB NAVIGATION (MODERN) -->
    <ul class="nav nav-tabs custom-tabs mb-4" id="mainTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="teacher-tab" data-toggle="tab" href="#teacher-content" role="tab">
                <i class="fas fa-chalkboard-teacher me-1"></i> Öğretmen Başvuruları
                @if (Model.teacherRequests != null && Model.teacherRequests.Count > 0)
                {
                    <span class="badge badge-custom badge-danger-custom ms-1">@Model.teacherRequests.Count</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="online-tab" data-toggle="tab" href="#online-content" role="tab">
                <i class="fas fa-globe me-1"></i> Online Kullanıcılar
                @if (Model.onlineUsers != null && Model.onlineUsers.Count > 0)
                {
                    <span class="badge badge-custom badge-success-custom ms-1">@Model.onlineUsers.Count</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="inactive-tab" data-toggle="tab" href="#inactive-content" role="tab">
                <i class="fas fa-user-clock me-1"></i> Pasif/Aktif Kullanıcılar
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="pending-tab" data-toggle="tab" href="#pending-content" role="tab">
                <i class="fas fa-hourglass-half me-1"></i> Onay Bekleyenler
                @if (Model.tempuser != null && Model.tempuser.Count > 0)
                {
                    <span class="badge badge-custom badge-warning-custom ms-1">@Model.tempuser.Count</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="users-tab" data-toggle="tab" href="#users-content" role="tab">
                <i class="fas fa-database me-1"></i> Tüm Kullanıcılar
                <span class="badge badge-light border ms-1 font-weight-bold">@(Model.user?.Count ?? 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="maintenance-tab" data-toggle="tab" href="#maintenance-content" role="tab">
                <i class="fas fa-tools me-1"></i> Bakım İşlemleri
            </a>
        </li>
    </ul>

    <!-- TAB CONTENT -->
    <div class="tab-content" id="mainTabContent">

        <!-- TAB 1: ÖĞRETMEN BAŞVURULARI -->
        <div class="tab-pane fade show active" id="teacher-content" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0"><i class="fas fa-chalkboard-teacher me-2"></i>Öğretmen Başvuruları</h4>
                    <p class="card-subtitle">Onay veya red işlemi yapabilirsiniz</p>
                </div>
                <div class="card-body p-0">
                    @if (Model.teacherRequests != null && Model.teacherRequests.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sicil</th>
                                        <th>Ad Soyad</th>
                                        <th>Email</th>
                                        <th>Ünvan</th>
                                        <th>Durum</th>
                                        <th class="text-center">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.teacherRequests)
                                    {
                                        <tr>
                                            <td><span class="badge badge-light border font-monospace">@u.fldSicil</span></td>
                                            <td class="font-weight-semibold">@u.fldName @u.fldLastName</td>
                                            <td>@u.fldEmail</td>
                                            <td>@u.fldTitle</td>
                                            <td><span class="badge-custom badge-warning-custom">Beklemede</span></td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-success btn-action me-1" onclick="approveTeacher(@u.fldId)">
                                                    <i class="fas fa-check me-1"></i> Onayla
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger btn-action" onclick="rejectTeacher(@u.fldId)">
                                                    <i class="fas fa-times me-1"></i> Reddet
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">Beklemede olan öğretmen başvurusu bulunmuyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- TAB 2: ONLINE KULLANICILAR -->
        <div class="tab-pane fade" id="online-content" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0"><i class="fas fa-globe me-2"></i>Online Kullanıcılar</h4>
                    <p class="card-subtitle">Son 30 dakika içinde aktif oturum açmış kullanıcılar</p>
                </div>
                <div class="card-body">
                    @if (Model.onlineUsers != null && Model.onlineUsers.Count > 0)
                    {
                        <div class="row">
                            @foreach (var user in Model.onlineUsers)
                            {
                                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                                    <div class="online-user-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="user-avatar mb-2">
                                                <i class="fas fa-user-circle fa-4x text-success"></i>
                                            </div>
                                            <h5 class="mb-1 font-weight-bold text-dark">@user.fldName @user.fldLastName</h5>
                                            <p class="mb-1 text-muted small"><span class="badge badge-light border">Sicil: @user.fldSicil</span></p>
                                            <p class="mb-0 text-secondary small font-weight-semibold">@user.fldTitle</p>
                                            <p class="mb-0 text-muted small">@user.fldDeputy</p>
                                        </div>
                                        <div class="mt-3 pt-2 border-top d-flex justify-content-center align-items-center gap-2 flex-wrap">
                                            <span class="badge-custom badge-success-custom">
                                                <i class="fas fa-circle text-white me-1" style="font-size:7px;"></i> Online
                                            </span>
                                            @if (string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge-role badge-role-admin"><i class="fas fa-shield-alt me-1"></i> Admin</span>
                                            }
                                            else if (string.Equals(user.Role, "Teacher", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge-role badge-role-teacher"><i class="fas fa-chalkboard-teacher me-1"></i> Öğretmen</span>
                                            }
                                            else
                                            {
                                                <span class="badge-role badge-role-student"><i class="fas fa-user-graduate me-1"></i> Öğrenci</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-user-slash fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">Şu anda çevrimiçi kullanıcı bulunmuyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- TAB 3: PASIF/AKTIF KULLANICILAR -->
        <div class="tab-pane fade" id="inactive-content" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0"><i class="fas fa-user-clock me-2"></i>Pasif/Aktif Kullanıcılar</h4>
                    <p class="card-subtitle">Kullanıcıların aktiflik durumları, rolleri ve son giriş tarihleri</p>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">×</button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">×</button>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filterStatus" class="form-label fw-bold">Durum Filtrele</label>
                            <select id="filterStatus" class="form-control form-control-sm">
                                <option value="">Tümü</option>
                                <option value="Aktif">Aktif</option>
                                <option value="Pasif">Pasif</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="usersTable" class="table table-hover mb-0" style="width:100%;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;">#</th>
                                    <th style="width: 80px;" class="text-center">Durum</th>
                                    <th style="width: 100px;" class="text-center">Rol</th>
                                    <th style="width: 90px;" class="text-center">Sicil</th>
                                    <th>Ad</th>
                                    <th>Soyad</th>
                                    <th>Email</th>
                                    <th>Telefon</th>
                                    <th style="width: 80px;" class="text-center">Yetki</th>
                                    <th style="width: 70px;" class="text-center">PDF</th>
                                    <th style="width: 80px;" class="text-center">Geçmiş</th>
                                    <th>Kayıt Tarihi</th>
                                    <th>Son Giriş</th>
                                    <th style="width: 90px;" class="text-center">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.inactiveUsers != null && Model.inactiveUsers.Count > 0)
                                {
                                    int counter = 1;
                                    foreach (var user in Model.inactiveUsers)
                                    {
                                        <tr>
                                            <td class="text-muted font-weight-bold">@counter</td>
                                            <td class="text-center">
                                                <span class="badge-custom @(user.fldActive?.Trim() == "1" ? "badge-success-custom" : "badge-secondary-custom")">
                                                    @(user.fldActive?.Trim() == "1" ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-role badge-role-admin"><i class="fas fa-shield-alt me-1"></i> Admin</span>
                                                }
                                                else if (string.Equals(user.Role, "Teacher", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-role badge-role-teacher"><i class="fas fa-chalkboard-teacher me-1"></i> Öğretmen</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-role badge-role-student"><i class="fas fa-user-graduate me-1"></i> Öğrenci</span>
                                                }
                                            </td>
                                            <td class="text-center"><span class="badge badge-light border font-monospace">@user.fldSicil</span></td>
                                            <td class="font-weight-semibold">@user.fldName</td>
                                            <td class="font-weight-semibold">@user.fldLastName</td>
                                            <td>@user.fldEmail</td>
                                            <td>@user.fldPhone</td>
                                            <td class="text-center"><span class="badge badge-light border">@user.fldAuth</span></td>
                                            <td class="text-center">
                                                <a href="@Url.Action("ExportHistoryPDF", "AllUsers", new { userId = user.fldId })" class="btn btn-sm btn-outline-danger" title="PDF Çıktısı">
                                                    <i class="fas fa-file-pdf"></i>
                                                </a>
                                            </td>
                                            <td class="text-center">
                                                <a href="@Url.Action("UserHistory", "AllUsers", new { userId = user.fldId })" class="btn btn-sm btn-outline-info" title="İşlem Geçmişi">
                                                    <i class="fas fa-history"></i>
                                                </a>
                                            </td>
                                            <td>
                                                @(user.RegisterDate != null ? user.RegisterDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                                            </td>
                                            <td>
                                                @(user.LastLogin != null ? user.LastLogin.Value.ToString("dd.MM.yyyy HH:mm") : "<span class='text-muted'>Hiç giriş yapmamış</span>")
                                            </td>
                                            <td class="text-center">
                                                @using (Html.BeginForm(user.fldActive?.Trim() == "1" ? "SetInactive" : "SetActive", "AllUsers", new { id = user.fldId }, FormMethod.Post, new { onsubmit = "return confirm('Bu kullanıcının durumunu değiştirmek istediğinize emin misiniz?');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    if (user.fldActive?.Trim() == "1")
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-warning">Pasif Et</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-success">Aktif Et</button>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="14" class="text-center text-muted py-4">Kullanıcı bulunamadı</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 4: ONAY BEKLEYEN KULLANICILAR -->
        <div class="tab-pane fade" id="pending-content" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0"><i class="fas fa-hourglass-half me-2"></i>Onay Bekleyen Kullanıcılar</h4>
                    <p class="card-subtitle">Kayıt olup sistem onayı bekleyen geçici kullanıcılar</p>
                </div>
                <div class="card-body p-0">
                    @if (Model.tempuser != null && Model.tempuser.Count > 0)
                    {
                        <div class="table-responsive">
                            <table id="datatable-default2" class="table table-hover mb-0" style="width:100%;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sicil No</th>
                                        <th>Adı</th>
                                        <th>Soyadı</th>
                                        <th>Telefon</th>
                                        <th>E-Posta</th>
                                        <th>Ünvanı</th>
                                        <th>Görev Yeri</th>
                                        <th class="text-center" style="width: 100px;">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var data in Model.tempuser)
                                    {
                                        <tr>
                                            <td><span class="badge badge-light border font-monospace">@data.fldSicil</span></td>
                                            <td class="font-weight-semibold">@data.fldName</td>
                                            <td class="font-weight-semibold">@data.fldLastName</td>
                                            <td>@data.fldPhone</td>
                                            <td>@data.fldEmail</td>
                                            <td>@data.fldTitle</td>
                                            <td>@data.fldDeputy</td>
                                            <td class="text-center actions">
                                                <button type="button" onclick="onayver('@data.fldId')" class="btn btn-sm btn-success btn-action me-1" title="Onayla">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" onclick="deletetemp('@data.fldId')" class="btn btn-sm btn-danger btn-action" title="Reddet/Sil">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <p class="text-muted mb-0">Onay bekleyen kullanıcı bulunmuyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- TAB 5: TÜM KULLANICILAR -->
        <div class="tab-pane fade" id="users-content" role="tabpanel">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap">
                    <div>
                        <h4 class="card-title mb-0"><i class="fas fa-database me-2"></i>Tüm Kullanıcılar</h4>
                        <p class="card-subtitle">Kullanıcı oluşturma, düzenleme, şifre sıfırlama ve rol yönetimi</p>
                    </div>
                    <div class="mt-2 mt-sm-0">
                        <a class="btn btn-outline-info mr-2" href="@Url.Action("Index", "RolePermission")">
                            <i class="fas fa-user-shield me-1"></i> Rol / Yetki Yönetimi
                        </a>
                        <a class="btn btn-outline-secondary mr-2" href="@Url.Action("Matrix", "RolePermission")">
                            <i class="fas fa-shield-alt me-1"></i> Yetki Matrisi
                        </a>
                        <a class="btn btn-primary modal-with-form" href="#AddUsermodalForm">
                            <i class="fas fa-plus me-1"></i> Yeni Kullanıcı Ekle
                        </a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="datatable-default" class="table table-hover mb-0" style="width:100%;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 100px;" class="text-center">Sicil No</th>
                                    <th>Adı</th>
                                    <th>Soyadı</th>
                                    <th>Telefon</th>
                                    <th>E-Posta</th>
                                    <th>Ünvanı</th>
                                    <th style="width: 110px;" class="text-center">Rolü</th>
                                    <th>Görev Yeri</th>
                                    <th style="width: 130px;" class="text-center">Kayıt Tarihi</th>
                                    <th style="width: 100px;" class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.user != null && Model.user.Count > 0)
                                {
                                    foreach (var data in Model.user)
                                    {
                                        <tr>
                                            <td class="text-center"><span class="badge badge-light border font-monospace">@data.fldSicil</span></td>
                                            <td class="font-weight-semibold">@data.fldName</td>
                                            <td class="font-weight-semibold">@data.fldLastName</td>
                                            <td>@data.fldPhone</td>
                                            <td>@data.fldEmail</td>
                                            <td>@data.fldTitle</td>
                                            <td class="text-center">
                                                @if (string.Equals(data.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-role badge-role-admin"><i class="fas fa-shield-alt me-1"></i> Admin</span>
                                                }
                                                else if (string.Equals(data.Role, "Teacher", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-role badge-role-teacher"><i class="fas fa-chalkboard-teacher me-1"></i> Öğretmen</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-role badge-role-student"><i class="fas fa-user-graduate me-1"></i> Öğrenci</span>
                                                }
                                            </td>
                                            <td>@data.fldDeputy</td>
                                            <td class="text-center">@string.Format("{0:dd.MM.yyyy HH:mm}", data.fldDateTime)</td>
                                            <td class="text-center actions">
                                                <a href="#EditUsermodalForm"
                                                   onclick="getuserdata(@data.fldId)"
                                                   data-id="@data.fldId"
                                                   class="modal-with-form btn btn-sm btn-outline-primary me-1 btn-edit-user"
                                                   title="Kullanıcıyı Düzenle">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </a>
                                                <button type="button"
                                                        onclick="resetpass('@data.fldId')"
                                                        data-id="@data.fldId"
                                                        class="btn btn-sm btn-outline-warning me-1 btn-reset-password"
                                                        title="Şifreyi Sıfırla">
                                                    <i class="fas fa-key"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 6: BAKIM İŞLEMLERİ (PROFESYONEL YÖNETİCİ MERKEZİ) -->
        <div class="tab-pane fade" id="maintenance-content" role="tabpanel">
            <div class="row">
                <!-- KART 1: HESAP DURUMU VE OTURUM YÖNETİMİ -->
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 maintenance-card">
                        <div class="card-header bg-white border-bottom py-3">
                            <div class="d-flex align-items-center">
                                <div class="maintenance-icon-box bg-light-primary text-primary me-3">
                                    <i class="fas fa-user-clock fa-lg"></i>
                                </div>
                                <div>
                                    <h5 class="card-title mb-0 font-weight-bold text-dark">Kullanıcı Oturum & Durum Yönetimi</h5>
                                    <small class="text-muted">Personel giriş hareketlerine göre hesap durumunu düzenleyin (Veriler silinmez)</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <!-- 1. Bölüm: İnaktifleri Pasife Al -->
                            <div class="maintenance-section p-3 mb-3 rounded bg-light border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold text-danger mb-0">
                                        <i class="fas fa-user-slash me-1"></i> İnaktif Hesapları Pasife Al
                                    </h6>
