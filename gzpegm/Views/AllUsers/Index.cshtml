<div class="modal fade" id="serverSyncModal" tabindex="-1" role="dialog" aria-labelledby="serverSyncModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title font-weight-bold" id="serverSyncModalLabel">
                    <i class="fas fa-network-wired text-info me-2"></i>Çift Sunucu Kullanıcı Senkronizasyonu (10.7.202.75 ⮂ 10.7.202.76)
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <!-- Bilgilendirme -->
                <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="fas fa-info-circle fa-2x text-info me-3"></i>
                    <div>
                        <div class="font-weight-bold">Ana Sunucu (10.7.202.75) ve Yedek Sunucu (10.7.202.76) Kullanıcı Eşitleme Merkezi</div>
                        <div class="small text-muted">
                            Yedek sunucuda açılmış ancak ana sunucuya henüz aktarılmamış personelleri tespit eder, tek tıkla şifre hash'leri ve yetkileriyle beraber bu sunucuya aktarır.
                        </div>
                    </div>
                </div>

                <!-- İstatistik Paneli -->
                <div class="row g-3 mb-4" id="syncStatsRow" style="display:none;">
                    <div class="col-md-4">
                        <div class="card border-0 bg-light p-3 text-center rounded shadow-sm">
                            <span class="text-muted small font-weight-bold">YEREL SUNUCU KULLANICI</span>
                            <h3 class="font-weight-bold text-primary mb-0 mt-1" id="statLocalCount">-</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 bg-light p-3 text-center rounded shadow-sm">
                            <span class="text-muted small font-weight-bold">KARŞI SUNUCU KULLANICI</span>
                            <h3 class="font-weight-bold text-secondary mb-0 mt-1" id="statRemoteCount">-</h3>
                            <small class="text-muted" id="statRemoteUrl"></small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 bg-light p-3 text-center rounded shadow-sm">
                            <span class="text-muted small font-weight-bold">BU SUNUCUDA EKSİK OLAN</span>
                            <h3 class="font-weight-bold text-danger mb-0 mt-1" id="statMissingCount">-</h3>
                        </div>
                    </div>
                </div>

                <!-- Yükleniyor -->
                <div id="syncLoading" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <div class="mt-3 font-weight-semibold text-muted">Karşı sunucu ile bağlantı kuruluyor ve personeller karşılaştırılıyor...</div>
                </div>

                <!-- Hata Kutusu -->
                <div id="syncErrorAlert" class="alert alert-danger" style="display:none;">
                    <i class="fas fa-exclamation-triangle me-2"></i><span id="syncErrorText"></span>
                </div>

                <!-- Liste -->
                <div id="syncTableWrapper" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="font-weight-bold mb-0 text-dark">
                            <i class="fas fa-user-plus text-success me-1"></i> Karşı Sunucuda Olup Bu Sunucuda Bulunmayan Personeller:
                        </h6>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAllSyncCheckboxes(true)">Tümünü Seç</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="toggleAllSyncCheckboxes(false)">Seçimi Kaldır</button>
                        </div>
                    </div>

                    <div class="table-responsive border rounded" style="max-height: 380px; overflow-y: auto;">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox" id="chkSelectAllSync" checked onchange="toggleAllSyncCheckboxes(this.checked)" />
                                    </th>
                                    <th>Sicil</th>
                                    <th>Ad Soyad</th>
                                    <th>Ünvan</th>
                                    <th>Görev Yeri</th>
                                    <th>Rol / Yetki</th>
                                </tr>
                            </thead>
                            <tbody id="syncTableBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Zaten Senkronize -->
                <div id="syncSyncedAlert" class="alert alert-success text-center py-4" style="display:none;">
                    <i class="fas fa-check-circle fa-3x text-success mb-2"></i>
                    <h5 class="font-weight-bold">Tüm Kullanıcılar Senkronize!</h5>
                    <p class="mb-0 text-muted">Karşı sunucuda bulunup bu sunucuda eksik olan hiçbir personel kaydı bulunmamaktadır.</p>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="btnRunCompare" onclick="runServerComparison()">
                    <i class="fas fa-sync me-1"></i> Yeniden Karşılaştır
                </button>
                <button type="button" class="btn btn-success font-weight-bold" id="btnExecuteSync" style="display:none;" onclick="executeUserSync()">
                    <i class="fas fa-cloud-download-alt me-1"></i> Seçilen Personelleri Bu Sunucuya Aktar
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/css/allusers-index.css")?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

@section Scripts {
    <script src="@Url.Content("~/js/allusers-index.js")?v=@DateTime.Now.Ticks"></script>
    <script>
    function openServerSyncModal() {
        $('#serverSyncModal').modal('show');
        runServerComparison();
    }

    function runServerComparison() {
        $('#syncLoading').show();
        $('#syncStatsRow').hide();
        $('#syncTableWrapper').hide();
        $('#syncSyncedAlert').hide();
        $('#syncErrorAlert').hide();
        $('#btnExecuteSync').hide();
        $('#btnRunCompare').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("CompareWithRemoteServer", "AllUsers")',
            type: 'GET',
            dataType: 'json',
            cache: false,
            success: function (res) {
                $('#syncLoading').hide();
                $('#btnRunCompare').prop('disabled', false);

                if (!res.Success) {
                    $('#syncErrorText').text(res.ErrorMessage || 'Karşı sunucuya bağlanırken hata oluştu.');
                    $('#syncErrorAlert').show();
                    return;
                }

                $('#statLocalCount').text(res.LocalTotalCount);
                $('#statRemoteCount').text(res.RemoteTotalCount);
                $('#statRemoteUrl').text('(' + (res.RemoteServerUrl || '') + ')');
                $('#statMissingCount').text(res.MissingUsers ? res.MissingUsers.length : 0);
                $('#syncStatsRow').fadeIn();

                if (res.MissingUsers && res.MissingUsers.length > 0) {
                    var tbody = $('#syncTableBody');
                    tbody.empty();
                    $.each(res.MissingUsers, function (i, u) {
                        var tr = $('<tr></tr>');
                        tr.append('<td class="text-center"><input type="checkbox" class="chk-sync-user" value="' + u.Sicil + '" checked /></td>');
                        tr.append('<td><span class="badge badge-light border font-monospace font-weight-bold">' + (u.Sicil || '') + '</span></td>');
                        tr.append('<td class="font-weight-semibold">' + (u.FullName || '') + '</td>');
                        tr.append('<td>' + (u.Title || '-') + '</td>');
                        tr.append('<td>' + (u.Border || '-') + '</td>');
                        tr.append('<td><span class="badge badge-primary">' + (u.Role || 'Student') + '</span></td>');
                        tbody.append(tr);
                    });
                    $('#syncTableWrapper').fadeIn();
                    $('#btnExecuteSync').fadeIn();
                } else {
                    $('#syncSyncedAlert').fadeIn();
                }
            },
            error: function (xhr) {
                $('#syncLoading').hide();
                $('#btnRunCompare').prop('disabled', false);
                $('#syncErrorText').text('Sunucu karşılaştırma isteği başarısız: ' + (xhr.statusText || 'Bilinmeyen Hata'));
                $('#syncErrorAlert').show();
            }
        });
    }

    function toggleAllSyncCheckboxes(checked) {
        $('.chk-sync-user').prop('checked', checked);
        $('#chkSelectAllSync').prop('checked', checked);
    }

    function executeUserSync() {
        var selectedSicils = [];
        $('.chk-sync-user:checked').each(function () {
            selectedSicils.push($(this).val());
        });

        if (selectedSicils.length === 0) {
            alert('Lütfen aktarılacak en az bir personel seçiniz.');
            return;
        }

        if (!confirm(selectedSicils.length + ' adet personelin bu yerel sunucuya aktarılmasını onaylıyor musunuz?')) {
            return;
        }

        $('#btnExecuteSync').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Aktarılıyor...');

        $.ajax({
            url: '@Url.Action("SyncUsersFromRemoteServer", "AllUsers")',
            type: 'POST',
            data: JSON.stringify({ sicils: selectedSicils }),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (res) {
                $('#btnExecuteSync').prop('disabled', false).html('<i class="fas fa-cloud-download-alt me-1"></i> Seçilen Personelleri Bu Sunucuya Aktar');
                if (res.success) {
                    alert(res.message);
                    runServerComparison();
                } else {
                    alert('Aktarım hatası: ' + res.message);
                }
            },
            error: function (xhr) {
                $('#btnExecuteSync').prop('disabled', false).html('<i class="fas fa-cloud-download-alt me-1"></i> Seçilen Personelleri Bu Sunucuya Aktar');
                alert('Sunucu iletişim hatası: ' + (xhr.statusText || 'Bilinmeyen hata'));
            }
        });
    }
    </script>
}
