                            <option value="1">1 - Kullanıcı İşlemleri</option>
                            <option value="2">2 - Admin / Sistem Tanımları</option>
                            <option selected value="3">3 - Ceza, Tahdit ve Şartlı Vize İşlemleri</option>
                            <option value="4">4 - Eski İşlemler / Raporlar</option>
                            <option value="5">5 - Duyuru / Mesaj İşlemleri</option>
                            <option value="6">6 - Eğitim Düzenleme</option>
                        </select>
                        <small class="form-text text-muted mt-1">Rol seçildiğinde temel yetkiler otomatik işaretlenir.</small>
                    </div>
                </div>
            </div>
            <footer class="card-footer">
                <div class="row">
                    <div class="col-md-12 text-right">
                        <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                        <button type="button" class="btn btn-secondary modal-dismiss">Kapat</button>
                    </div>
                </div>
            </footer>
        </form>
    </section>
</div>

