                            <option value="Admin">Admin (Yönetici)</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Sınır Kapısı <span class="text-danger">*</span></label>
                        <select data-plugin-selectTwo class="form-control populate" name="BorderUser" required>
                            <option value="">Lütfen Seçiniz</option>
                            @foreach (var data in Model.borders)
                            {
                                <option value="@data.fldName">@data.fldName</option>
                            }
                        </select>
