@model gzpegm.Models.ViewModels.OldOperationsIndexViewModel
@{
    ViewBag.Title = "Eski İşlemler";
    Layout = "~/Views/Shared/_Master.cshtml";
}

<section class="card">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title"><i class="fas fa-history"></i> Eski İşlemler</h2>
        <span class="badge badge-info">Tek merkez</span>
    </header>
    <div class="card-body">
        <div class="alert alert-info">
            Genel eski işlemler ve yetkiniz varsa admin eski işlemleri bu sayfadan kontrol edebilirsiniz.
        </div>

        <h4 class="mb-3">Genel Eski İşlemler</h4>
        <div class="row">
            @foreach (var item in Model.GeneralOperations)
            {
                <div class="col-md-4 mb-3">
                    <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="card text-decoration-none h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <i class="@item.Icon fa-2x text-primary mr-3"></i>
                                <h5 class="mb-0">@item.Title</h5>
                            </div>
                            <p class="text-muted mb-0">@item.Description</p>
                        </div>
                    </a>
                </div>
            }
        </div>

        @if (Model.CanSeeAdminOperations)
        {
            <hr />
            <h4 class="mb-3">Admin Eski İşlemler</h4>
            <div class="row">
                @foreach (var item in Model.AdminOperations)
                {
                    <div class="col-md-4 mb-3">
                        <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="card text-decoration-none h-100 border-warning">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="@item.Icon fa-2x text-warning mr-3"></i>
                                    <h5 class="mb-0">@item.Title</h5>
                                </div>
                                <p class="text-muted mb-0">@item.Description</p>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary mt-3">
                Admin eski işlemleri yalnızca yetkili kullanıcılar için gösterilir.
            </div>
        }
    </div>
</section>
