var _cctvActiveGroup = 'all';
var _cctvLayout = 4;
var _cctvSubMode = 'matrix';
var _cctvMatrixTimer = null;
var _cctvMatrixLiveRunning = false;
var _cctvSingleTimer = null;
var _cctvSingleLiveRunning = false;
var _cctvInterval = 3000;
var _cctvFocusedIndex = 0;
var _cctvMasterCreds = {
    nvrIp: '10.7.202.200',
    port: 80,
    user: 'admin',
    pass: ''
};

function getCctvMasterCreds() {
    try {
        var saved = JSON.parse(localStorage.getItem('gzp_cctvMasterCreds') || '{}');
        if (saved && saved.nvrIp) {
            _cctvMasterCreds = Object.assign(_cctvMasterCreds, saved);
        }
    } catch(e) {}
    var nvrEl = document.getElementById('masterNvrIp'); if (nvrEl && _cctvMasterCreds.nvrIp) nvrEl.value = _cctvMasterCreds.nvrIp;
    var portEl = document.getElementById('masterPort'); if (portEl && _cctvMasterCreds.port) portEl.value = _cctvMasterCreds.port;
    var userEl = document.getElementById('masterUser'); if (userEl && _cctvMasterCreds.user) userEl.value = _cctvMasterCreds.user;
    var passEl = document.getElementById('masterPass'); if (passEl && _cctvMasterCreds.pass) passEl.value = _cctvMasterCreds.pass;
    return _cctvMasterCreds;
}

function applyMasterCredentials() {
    var nvrEl = document.getElementById('masterNvrIp');
    var portEl = document.getElementById('masterPort');
    var userEl = document.getElementById('masterUser');
    var passEl = document.getElementById('masterPass');

    _cctvMasterCreds = {
        nvrIp: nvrEl ? nvrEl.value.trim() : '10.7.202.200',
        port: portEl ? parseInt(portEl.value) || 80 : 80,
        user: userEl ? userEl.value.trim() : 'admin',
        pass: passEl ? passEl.value : ''
    };

    localStorage.setItem('gzp_cctvMasterCreds', JSON.stringify(_cctvMasterCreds));
    showToast('NVR ve kamera kimlik bilgileri başarıyla kaydedildi.');
    
    if (_cctvSubMode === 'matrix') {
        refreshAllCctvSnapshots();
    } else {
        refreshSingleCamSnapshot();
        queryFocusedCameraHardware();
    }
}

function buildSnapshotUrl(ip, channel) {
    var creds = _cctvMasterCreds;
    return '@Url.Action("GetSnapshot", "PCInfo")?ip=' + encodeURIComponent(ip) +
           '&port=' + creds.port +
           '&user=' + encodeURIComponent(creds.user) +
           '&pass=' + encodeURIComponent(creds.pass) +
           '&channel=' + channel +
           '&t=' + Date.now();
}

function buildRtspUrl(cam) {
    var creds = _cctvMasterCreds;
    var auth = creds.user ? (encodeURIComponent(creds.user) + (creds.pass ? ':' + encodeURIComponent(creds.pass) : '') + '@@') : '';
    return 'rtsp://' + auth + creds.nvrIp + ':554/Streaming/Channels/' + cam.channel;
}

function switchCctvSubMode(mode) {
    _cctvSubMode = mode;
    var btnMat = document.getElementById('btnCctvSubMatrix');
    var btnSng = document.getElementById('btnCctvSubSingle');
    var matCont = document.getElementById('cctvMatrixContainer');
    var sngCont = document.getElementById('cctvSingleContainer');

    if (mode === 'matrix') {
        if (btnMat) btnMat.classList.add('active');
        if (btnSng) btnSng.classList.remove('active');
        if (matCont) matCont.style.display = 'block';
        if (sngCont) sngCont.style.display = 'none';
        if (_cctvSingleLiveRunning) toggleSingleAutoLive();
    } else {
        if (btnMat) btnMat.classList.remove('active');
        if (btnSng) btnSng.classList.add('active');
        if (matCont) matCont.style.display = 'none';
        if (sngCont) sngCont.style.display = 'block';
        loadSingleCameraView(_cctvFocusedIndex);
    }
}

function setCctvLayout(cols) {
    _cctvLayout = cols;
    var grid = document.getElementById('cctvGrid');
    if (!grid) return;
    grid.className = 'cctv-grid cctv-grid-' + (cols === 4 ? '16' : (cols === 3 ? '9' : '4'));

    ['16', '9', '4'].forEach(function(l) {
        var b = document.getElementById('btnLayout' + l);
        if (b) {
            if ((cols === 4 && l === '16') || (cols === 3 && l === '9') || (cols === 2 && l === '4')) {
                b.className = 'btn btn-sm btn-dark border border-secondary text-white font-weight-bold active';
            } else {
                b.className = 'btn btn-sm btn-dark border border-secondary text-white-50';
            }
        }
    });
}

function filterCctvGroup(group) {
    _cctvActiveGroup = group;
    ['All', 'Entry', 'Exit'].forEach(function(g) {
        var b = document.getElementById('btnGroup' + g);
        if (b) {
            if (g.toLowerCase() === group) {
                b.classList.add('active');
            } else {
                b.classList.remove('active');
            }
        }
    });
    renderCctvGrid();
}

function renderCctvGrid() {
    var grid = document.getElementById('cctvGrid');
    if (!grid) return;
    grid.innerHTML = '';

    var filtered = CCTV_CAMERAS.filter(function(cam) {
        if (_cctvActiveGroup === 'entry') return cam.group === 'entry';
        if (_cctvActiveGroup === 'exit') return cam.group === 'exit';
        return true;
    });

    filtered.forEach(function(cam) {
        var originalIndex = CCTV_CAMERAS.findIndex(function(c) { return c.id === cam.id; });
        var tile = document.createElement('div');
        tile.className = 'cctv-tile';
        tile.id = 'cctvTile_' + cam.id;

        var snapUrl = buildSnapshotUrl(cam.ip, cam.channel);
        var rtspUrl = buildRtspUrl(cam);

        tile.innerHTML = 
            '<div class="cctv-tile-header">' +
                '<div>' +
                    '<span class="badge badge-danger mr-1" style="font-size:10px;">' + escH(cam.badge) + '</span>' +
                    '<strong class="text-white">' + escH(cam.name) + '</strong> ' +
                    '<small class="text-white-50 ml-1">(' + escH(cam.ip) + ')</small>' +
                '</div>' +
                '<div class="cctv-live-badge">' +
                    '<span class="cctv-live-dot"></span> CANLI' +
                '</div>' +
            '</div>' +
            '<div class="cctv-tile-body" ondblclick="focusCameraByIndex(' + originalIndex + ')">' +
                '<img id="cctvGridImg_' + cam.id + '" src="' + snapUrl + '" alt="' + escH(cam.name) + '" loading="lazy" />' +
                '<div class="cctv-tile-overlay">' +
                    '<button type="button" class="btn btn-sm btn-danger font-weight-bold" onclick="focusCameraByIndex(' + originalIndex + ')" title="Tekil Ekranda Büyüt">' +
                        '<i class="fas fa-expand mr-1"></i> Büyüt (Fokus)' +
                    '</button>' +
                    '<button type="button" class="btn btn-sm btn-dark border border-secondary text-white" onclick="refreshGridTileSnapshot(' + cam.id + ')" title="Yenile">' +
                        '<i class="fas fa-sync-alt"></i>' +
                    '</button>' +
                    '<a href="' + rtspUrl + '" class="btn btn-sm btn-outline-info text-white" target="_blank" title="RTSP Akışı Aç">' +
                        '<i class="fas fa-play"></i>' +
                    '</a>' +
                '</div>' +
            '</div>' +
            '<div class="cctv-tile-footer">' +
                '<span><i class="fas fa-video text-danger mr-1"></i>Kanal: ' + cam.channel + '</span>' +
                '<span><small class="text-white-50" id="cctvGridTime_' + cam.id + '">' + new Date().toLocaleTimeString('tr-TR') + '</small></span>' +
            '</div>';

        grid.appendChild(tile);
    });
}

function refreshGridTileSnapshot(camId) {
    var cam = CCTV_CAMERAS.find(function(c) { return c.id === camId; });
    if (!cam) return;
    var img = document.getElementById('cctvGridImg_' + cam.id);
    var timeEl = document.getElementById('cctvGridTime_' + cam.id);
    if (img) {
        img.src = buildSnapshotUrl(cam.ip, cam.channel);
    }
    if (timeEl) {
        timeEl.innerText = new Date().toLocaleTimeString('tr-TR');
    }
}

function refreshAllCctvSnapshots() {
    var visible = CCTV_CAMERAS.filter(function(cam) {
        if (_cctvActiveGroup === 'entry') return cam.group === 'entry';
        if (_cctvActiveGroup === 'exit') return cam.group === 'exit';
        return true;
    });

    visible.forEach(function(cam, i) {
        setTimeout(function() {
            refreshGridTileSnapshot(cam.id);
        }, i * 90);
    });
}

function toggleCctvMatrixAutoLive() {
    var btn = document.getElementById('btnCctvAutoLive');
    _cctvMatrixLiveRunning = !_cctvMatrixLiveRunning;

    if (_cctvMatrixLiveRunning) {
        if (btn) {
            btn.className = 'btn btn-sm btn-danger font-weight-bold';
            btn.innerHTML = '<i class="fas fa-stop mr-1"></i> Canlı Akışı Durdur';
        }
        refreshAllCctvSnapshots();
        _cctvMatrixTimer = setInterval(refreshAllCctvSnapshots, _cctvInterval);
    } else {
        if (btn) {
            btn.className = 'btn btn-sm btn-success font-weight-bold';
            btn.innerHTML = '<i class="fas fa-play mr-1"></i> Canlı Akışı Başlat';
        }
        clearInterval(_cctvMatrixTimer);
    }
}

function changeCctvInterval(val) {
    _cctvInterval = parseInt(val) || 3000;
    if (_cctvMatrixLiveRunning) {
        clearInterval(_cctvMatrixTimer);
        _cctvMatrixTimer = setInterval(refreshAllCctvSnapshots, _cctvInterval);
    }
    if (_cctvSingleLiveRunning) {
        clearInterval(_cctvSingleTimer);
        _cctvSingleTimer = setInterval(refreshSingleCamSnapshot, _cctvInterval);
    }
}

