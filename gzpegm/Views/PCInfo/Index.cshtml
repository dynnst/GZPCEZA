function openRemoteAssistModal(ip, host) {
    if (!ip) return;
    document.getElementById('raModalSubTitle').innerText = 'Hedef: ' + ip + (host ? ' (' + host + ')' : '');
    document.getElementById('btnLaunchMsra').href = '@Url.Action("ConnectAssist", "PCInfo")?ip=' + encodeURIComponent(ip) + '&mode=msra';
    document.getElementById('btnLaunchShadow').href = '@Url.Action("ConnectAssist", "PCInfo")?ip=' + encodeURIComponent(ip) + '&mode=shadow';
    document.getElementById('btnLaunchRdpClassic').href = '@Url.Action("ConnectRdp", "PCInfo")?ip=' + encodeURIComponent(ip);
    document.getElementById('cmdMsraText').value = 'msra.exe /offerRA ' + ip;
    document.getElementById('cmdShadowText').value = 'mstsc.exe /v:' + ip + ' /shadow:1 /control';
    showModalSafe('modalRemoteAssist');
}

// ===================================================
// PANOYA KOPYALA
// ===================================================
function copyToClipboard(elementId) {
    var el = document.getElementById(elementId);
    if (!el) return;
    el.select(); el.setSelectionRange(0, 99999);
    var val = el.value;
    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(val).then(function() { showToast('Panoya kopyalandı!'); })
        .catch(function() { try { document.execCommand('copy'); showToast('Panoya kopyalandı!'); } catch(e) {} });
    } else {
        try { document.execCommand('copy'); showToast('Panoya kopyalandı!'); }
        catch(e) { alert('Kopyalanamadı: ' + val); }
    }
}

