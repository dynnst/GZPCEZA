@model gzpegm.Models.PCInfo.ComputerInfo
@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Title = "PC & Donanım Denetimi ve Envanteri (CEZA Veritabanı)";
}

<style>
    .pcinfo-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: #fff;
        border-radius: 8px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }
    .mode-tab-btn {
        cursor: pointer;
        font-size: 13.5px;
        font-weight: 700;
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.25);
        background: rgba(255,255,255,0.08);
        color: #e2e8f0;
        transition: all .2s ease;
        display: inline-block;
        margin-right: 8px;
        margin-bottom: 6px;
    }
    .mode-tab-btn:hover, .mode-tab-btn.active {
        background: #0284c7;
        color: #fff;
        border-color: #0284c7;
        box-shadow: 0 2px 8px rgba(2, 132, 199, 0.4);
    }
    .stat-metric-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 18px;
        transition: transform .2s ease, box-shadow .2s ease;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .stat-metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.08);
    }
    .stat-metric-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }
    .preset-pill {
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 16px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        transition: all .15s ease;
        display: inline-block;
        margin-right: 6px;
        margin-bottom: 6px;
    }
    .preset-pill:hover, .preset-pill.active {
        background: #0284c7;
        color: #fff;
        border-color: #0284c7;
    }
    .disk-progress-bar {
        height: 12px;
        border-radius: 6px;
    }
    .table-pcinfo th {
        background: #f8fafc;
        font-weight: 600;
        color: #475569;
        font-size: 13px;
    }
    .nav-tabs .nav-link {
        font-weight: 600;
        color: #475569;
        border-radius: 6px 6px 0 0;
    }
    .nav-tabs .nav-link.active {
        color: #0284c7;
        border-bottom-color: #fff;
    }
    .badge-soft-success {
        background: #dcfce7;
        color: #15803d;
    }
    .badge-soft-danger {
        background: #fee2e2;
        color: #b91c1c;
    }
</style>

<div class="pcinfo-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <div>
            <h2 class="mb-1 text-white font-weight-bold" style="font-size: 23px;">
                <i class="fas fa-desktop text-info mr-2"></i> PC & Donanım Denetimi ve Envanteri (CEZA Veritabanı)
            </h2>
            <p class="mb-0 text-white-50 small">
                Hudut kapısı gişe terminalleri, sunucular, pasaport okuyucular, monitörler, kameralar ve CEZA veritabanı envanter arşivi.
            </p>
        </div>
        <div class="mt-2 mt-md-0 d-flex align-items-center">
            @if (Model != null && Model.IsOnline)
            {
                <span class="badge badge-soft-success p-2 mr-2"><i class="fas fa-check-circle"></i> Çevrimiçi</span>
            }
            else
            {
                <span class="badge badge-soft-danger p-2 mr-2"><i class="fas fa-times-circle"></i> Çevrimdışı / Hata</span>
            }

            <div class="btn-group">
                <a href="@Url.Action("ExportExcel", "PCInfo", new { target = Model?.Target })" class="btn btn-sm btn-success">
                    <i class="fas fa-file-excel mr-1"></i> Excel İndir
                </a>
                <a href="@Url.Action("ExportHtml", "PCInfo", new { target = Model?.Target })" target="_blank" class="btn btn-sm btn-outline-light">
                    <i class="fas fa-print mr-1"></i> Yazdır / Rapor
                </a>
                <a href="@Url.Action("ExportJson", "PCInfo", new { target = Model?.Target })" class="btn btn-sm btn-outline-light">
                    <i class="fas fa-download mr-1"></i> JSON
                </a>
            </div>
        </div>
    </div>

    <!-- MOD SEÇİCİ SEKMELERİ -->
    <div class="pt-2 border-top border-secondary">
        <span class="mode-tab-btn active" id="btnModeInspector" onclick="switchMainMode('inspector')">
            <i class="fas fa-microchip mr-1"></i> 1. Donanım & Sistem Teftişi
        </span>
        <span class="mode-tab-btn" id="btnModeScanner" onclick="switchMainMode('scanner')">
            <i class="fas fa-broadcast-tower mr-1"></i> 2. Akıllı Ağ Tarayıcısı
        </span>
        <span class="mode-tab-btn" id="btnModeCamera" onclick="switchMainMode('camera')">
            <i class="fas fa-video mr-1"></i> 3. Hikvision IP Kamera Merkezi
        </span>
        <span class="mode-tab-btn" id="btnModeInventory" onclick="switchMainMode('inventory')">
            <i class="fas fa-database text-warning mr-1"></i> 4. Cihaz Envanteri (CEZA Veritabanı)
        </span>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. BÖLÜM: DONANIM VE SİSTEM TEFTİŞİ        -->
<!-- ========================================== -->
<div id="sectionInspector">
    <!-- SORGULAMA KARTI -->
    <div class="card mb-4 border">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "PCInfo")" id="pcQueryForm">
                <div class="mb-3">
                    <span class="text-muted small font-weight-bold mr-2">Hızlı Seçim:</span>
                    <span class="preset-pill @(string.IsNullOrWhiteSpace(ViewBag.SelectedTarget) || ViewBag.SelectedTarget == "localhost" ? "active" : "")" onclick="setTarget('localhost')">
                        <i class="fas fa-server mr-1"></i> Yerel Sunucu (Localhost)
                    </span>
                    <span class="preset-pill @(ViewBag.SelectedTarget == "10.7.202.75" ? "active" : "")" onclick="setTarget('10.7.202.75')">
                        <i class="fas fa-network-wired mr-1"></i> Ana Sunucu (10.7.202.75)
                    </span>
                    <span class="preset-pill @(ViewBag.SelectedTarget == "10.7.202.76" ? "active" : "")" onclick="setTarget('10.7.202.76')">
                        <i class="fas fa-shield-alt mr-1"></i> Yedek Sunucu (10.7.202.76)
                    </span>
                </div>

                <div class="row align-items-end">
                    <div class="col-md-6 mb-2">
                        <label class="font-weight-bold small text-dark mb-1">Hedef IP veya Bilgisayar Adı:</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white"><i class="fas fa-laptop text-primary"></i></span>
                            </div>
                            <input type="text" name="target" id="targetInput" class="form-control" value="@(ViewBag.SelectedTarget ?? "localhost")" placeholder="Örn: 10.7.202.75 veya GZP-GISE-01" required />
                        </div>
                    </div>

                    <div class="col-md-6 mb-2 d-flex">
                        <button type="submit" id="btnSubmitQuery" class="btn btn-primary px-4 mr-2">
                            <i class="fas fa-search mr-1"></i> Donanımı Teftiş Et
                        </button>
                        @if (Model != null && Model.IsOnline)
                        {
                            <button type="button" class="btn btn-warning text-dark font-weight-bold mr-2" onclick="openSaveInventoryModal()">
                                <i class="fas fa-cloud-upload-alt mr-1"></i> Envantere Ekle
                            </button>
                        }
                        <button type="button" class="btn btn-outline-secondary" data-toggle="collapse" data-target="#remoteCreds">
                            <i class="fas fa-key mr-1"></i> Uzak Giriş
                        </button>
                    </div>
                </div>

                <div id="remoteCreds" class="collapse mt-3 pt-3 border-top">
                    <div class="alert alert-light border small text-muted mb-2">
                        <i class="fas fa-info-circle text-info"></i> Uzak bilgisayarda WMI yetkilendirme hatası alıyorsanız hedef bilgisayardaki Yönetici kullanıcı adı ve parolasını girin.
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label class="small font-weight-bold">Kullanıcı Adı (Opsiyonel):</label>
                            <input type="text" name="username" class="form-control form-control-sm" placeholder="Domain\Kullanıcı veya Administrator" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="small font-weight-bold">Parola (Opsiyonel):</label>
                            <input type="password" name="password" class="form-control form-control-sm" placeholder="••••••••" />
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && !Model.IsOnline && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4">
            <h5 class="alert-heading font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-2"></i> Bağlantı / Sorgu Hatası</h5>
            <p class="mb-2">@Model.ErrorMessage</p>
            <hr class="my-2" />
            <small class="d-block text-dark">
                <strong>Çözüm Önerileri:</strong><br />
                1. Hedef bilgisayarın açık ve ağa bağlı olduğunu doğrulayın.<br />
                2. Uzak makine ise 'Uzak Giriş Bilgileri' kısmına Yönetici hesabı girin.<br />
                3. Windows Firewall üzerinde 'Windows Management Instrumentation (WMI)' kuralının açık olduğundan emin olun.
            </small>
        </div>
    }

    @if (Model != null && Model.IsOnline)
    {
        <!-- ÜST METRİK KARTLARI -->
        <div class="row">
            <!-- CPU -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-metric-card d-flex align-items-center">
                    <div class="stat-metric-icon mr-3" style="background:#e0f2fe; color:#0284c7;">
                        <i class="fas fa-microchip"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="small text-muted font-weight-bold text-uppercase">İşlemci (CPU)</div>
                        <div class="font-weight-bold text-dark text-truncate" title="@(Model.Cpu?.Name)">
                            @(string.IsNullOrWhiteSpace(Model.Cpu?.Name) ? "Algılanamadı" : Model.Cpu.Name)
                        </div>
                        <div class="small text-secondary">
                            @(Model.Cpu?.Cores ?? 0) Çekirdek / @(Model.Cpu?.Threads ?? 0) İzlek
                        </div>
                    </div>
                </div>
            </div>

            <!-- RAM -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-metric-card d-flex align-items-center">
                    <div class="stat-metric-icon text-success mr-3" style="background:#dcfce7;">
                        <i class="fas fa-memory"></i>
                    </div>
                    <div>
                        <div class="small text-muted font-weight-bold text-uppercase">Toplam Bellek (RAM)</div>
                        <div class="font-weight-bold text-dark" style="font-size: 20px;">
                            @(Model.Memory?.TotalGb ?? 0) GB
                        </div>
                        <div class="small text-secondary">
                            @(Model.Memory?.Slots?.Count ?? 0) Slot Kullanımda
                        </div>
                    </div>
                </div>
            </div>

            <!-- DEPOLAMA -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-metric-card d-flex align-items-center">
                    <div class="stat-metric-icon text-warning mr-3" style="background:#fef3c7;">
                        <i class="fas fa-hdd"></i>
                    </div>
                    <div>
                        @{
                            var totalDiskGb = Model.Disks?.Sum(d => d.TotalSizeGb) ?? 0;
                            var totalLogicalDisks = Model.Disks?.SelectMany(d => d.LogicalDisks).Count() ?? 0;
                        }
                        <div class="small text-muted font-weight-bold text-uppercase">Toplam Depolama</div>
                        <div class="font-weight-bold text-dark" style="font-size: 20px;">
                            @totalDiskGb GB
                        </div>
                        <div class="small text-secondary">
                            @(Model.Disks?.Count ?? 0) Fiziksel / @totalLogicalDisks Sürücü
                        </div>
                    </div>
                </div>
            </div>

            <!-- MONİTÖR & ÇEVRE BİRİMİ -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-metric-card d-flex align-items-center">
                    <div class="stat-metric-icon text-primary mr-3" style="background:#e0e7ff;">
                        <i class="fas fa-tv"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="small text-muted font-weight-bold text-uppercase">Bağlı Donanımlar</div>
                        <div class="font-weight-bold text-dark" style="font-size: 18px;">
                            @(Model.Monitors?.Count ?? 0) Monitör / @(Model.UsbDevices?.Count ?? 0) USB
                        </div>
                        <div class="small text-secondary">
                            @(Model.Printers?.Count ?? 0) Yazıcı Tanımlı
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SEKMELİ DETAY KARTI -->
        <div class="card border">
            <div class="card-header bg-white pb-0 border-bottom-0">
                <ul class="nav nav-tabs card-header-tabs" id="pcInfoTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="tab-system-link" data-toggle="tab" href="#tab-system" role="tab">
                            <i class="fas fa-info-circle mr-1"></i> Sistem & Anakart
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-cpu-ram-link" data-toggle="tab" href="#tab-cpu-ram" role="tab">
                            <i class="fas fa-microchip mr-1"></i> CPU & RAM
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-disks-link" data-toggle="tab" href="#tab-disks" role="tab">
                            <i class="fas fa-hdd mr-1"></i> Diskler & Depolama
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold text-primary" id="tab-monitors-link" data-toggle="tab" href="#tab-monitors" role="tab">
                            <i class="fas fa-tv mr-1"></i> Bağlı Monitörler (@(Model.Monitors?.Count ?? 0))
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-peripherals-link" data-toggle="tab" href="#tab-peripherals" role="tab">
                            <i class="fas fa-usb mr-1"></i> USB & Yazıcılar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-network-link" data-toggle="tab" href="#tab-network" role="tab">
                            <i class="fas fa-network-wired mr-1"></i> Ağ Bağdaştırıcıları
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-gpu-link" data-toggle="tab" href="#tab-gpu" role="tab">
                            <i class="fas fa-palette mr-1"></i> Ekran Kartı
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-software-link" data-toggle="tab" href="#tab-software" role="tab">
                            <i class="fas fa-cube mr-1"></i> Kurulu Yazılımlar (@(Model.InstalledSoftware?.Count ?? 0))
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4">
                <div class="tab-content" id="pcInfoTabContent">

                    <!-- 1. SİSTEM & ANAKART / BIOS -->
                    <div class="tab-pane fade show active" id="tab-system" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-desktop text-primary mr-1"></i> Bilgisayar Kimliği
                                </h5>
                                <table class="table table-sm table-striped">
                                    <tbody>
                                        <tr><td class="font-weight-bold" style="width:40%;">Bilgisayar Adı:</td><td>@(Model.ComputerName)</td></tr>
                                        <tr><td class="font-weight-bold">Üretici:</td><td>@(Model.Manufacturer)</td></tr>
                                        <tr><td class="font-weight-bold">Model:</td><td>@(Model.Model)</td></tr>
                                        <tr><td class="font-weight-bold">Seri Numarası:</td><td><code>@(Model.SerialNumber)</code></td></tr>
                                        <tr><td class="font-weight-bold">Sistem Türü:</td><td>@(Model.SystemType)</td></tr>
                                        <tr><td class="font-weight-bold">Domain / Çalışma Grubu:</td><td>@(string.IsNullOrWhiteSpace(Model.Domain) ? Model.Workgroup : Model.Domain)</td></tr>
                                        <tr><td class="font-weight-bold">Aktif Kullanıcı:</td><td>@(Model.CurrentUser)</td></tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="col-md-6 mb-3">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-layer-group text-success mr-1"></i> Anakart & BIOS
                                </h5>
                                <table class="table table-sm table-striped">
                                    <tbody>
                                        <tr><td class="font-weight-bold" style="width:40%;">Anakart Üreticisi:</td><td>@(Model.Motherboard?.Manufacturer)</td></tr>
                                        <tr><td class="font-weight-bold">Anakart Modeli:</td><td>@(Model.Motherboard?.Product)</td></tr>
                                        <tr><td class="font-weight-bold">Anakart Seri No:</td><td><code>@(Model.Motherboard?.SerialNumber)</code></td></tr>
                                        <tr><td class="font-weight-bold">BIOS Üreticisi:</td><td>@(Model.Bios?.Manufacturer)</td></tr>
                                        <tr><td class="font-weight-bold">BIOS Sürümü:</td><td>@(Model.Bios?.Version)</td></tr>
                                        <tr><td class="font-weight-bold">BIOS Tarihi:</td><td>@(Model.Bios?.ReleaseDate)</td></tr>
                                        <tr><td class="font-weight-bold">Son Başlatma Zamanı:</td><td>@(Model.Windows?.LastBootTime)</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 2. CPU & RAM -->
                    <div class="tab-pane fade" id="tab-cpu-ram" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-microchip text-info mr-1"></i> İşlemci Ayrıntıları
                                </h5>
                                <table class="table table-sm table-striped">
                                    <tbody>
                                        <tr><td class="font-weight-bold" style="width:40%;">İşlemci Modeli:</td><td><strong>@(Model.Cpu?.Name)</strong></td></tr>
                                        <tr><td class="font-weight-bold">Üretici:</td><td>@(Model.Cpu?.Manufacturer)</td></tr>
                                        <tr><td class="font-weight-bold">Fiziksel Çekirdek:</td><td>@(Model.Cpu?.Cores)</td></tr>
                                        <tr><td class="font-weight-bold">Mantıksal İzlek (Thread):</td><td>@(Model.Cpu?.Threads)</td></tr>
                                        <tr><td class="font-weight-bold">Maksimum Frekans:</td><td>@(Model.Cpu?.MaxSpeedGhz)</td></tr>
                                        <tr><td class="font-weight-bold">Mevcut Frekans:</td><td>@(Model.Cpu?.CurrentSpeedGhz)</td></tr>
                                        <tr><td class="font-weight-bold">Mimari:</td><td>@(Model.Cpu?.Architecture)</td></tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="col-md-6 mb-4">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-memory text-success mr-1"></i> RAM Modül Yuvaları
                                </h5>
                                @if (Model.Memory?.Slots != null && Model.Memory.Slots.Count > 0)
                                {
                                    <div class="row">
                                        @foreach (var slot in Model.Memory.Slots)
                                        {
                                            <div class="col-sm-6 mb-2">
                                                <div class="p-2 border rounded bg-light">
                                                    <div class="font-weight-bold text-primary">@slot.Tag</div>
                                                    <div class="font-weight-bold" style="font-size: 16px;">@slot.CapacityGb GB @(slot.SpeedMhz > 0 ? $"({slot.SpeedMhz} MHz)" : "")</div>
                                                    <div class="small text-muted">@slot.Manufacturer - @slot.PartNumber</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border small text-muted">
                                        Fiziksel slot detayları alınamadı. Toplam bellek: <strong>@(Model.Memory?.TotalGb ?? 0) GB</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 3. DİSKLER & DEPOLAMA -->
                    <div class="tab-pane fade" id="tab-disks" role="tabpanel">
                        <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                            <i class="fas fa-hdd text-warning mr-1"></i> Fiziksel ve Mantıksal Sürücüler
                        </h5>
                        @if (Model.Disks != null && Model.Disks.Count > 0)
                        {
                            foreach (var disk in Model.Disks)
                            {
                                <div class="card mb-3 border">
                                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge badge-info mr-2">@disk.MediaType</span>
                                            <strong>@disk.Model</strong>
                                            @if (!string.IsNullOrWhiteSpace(disk.SerialNumber))
                                            {
                                                <small class="text-muted ml-2">(S/N: @disk.SerialNumber)</small>
                                            }
                                        </div>
                                        <span class="badge badge-secondary p-2">@disk.TotalSizeGb GB Toplam</span>
                                    </div>
                                    <div class="card-body p-3">
                                        @if (disk.LogicalDisks != null && disk.LogicalDisks.Count > 0)
                                        {
                                            <div class="row">
                                                @foreach (var lDisk in disk.LogicalDisks)
                                                {
                                                    var barColor = lDisk.UsedPercent > 85 ? "bg-danger" : lDisk.UsedPercent > 70 ? "bg-warning" : "bg-success";
                                                    <div class="col-md-6 mb-3">
                                                        <div class="p-2 border rounded">
                                                            <div class="d-flex justify-content-between font-weight-bold mb-1">
                                                                <span><i class="fas fa-folder text-primary mr-1"></i> Sürücü @lDisk.DriveLetter @(!string.IsNullOrWhiteSpace(lDisk.Label) ? $"({lDisk.Label})" : "")</span>
                                                                <span class="small text-muted">@lDisk.FileSystem</span>
                                                            </div>
                                                            <div class="progress disk-progress-bar mb-2">
                                                                <div class="progress-bar @barColor" role="progressbar" style="width: @lDisk.UsedPercent%;" aria-valuenow="@lDisk.UsedPercent" aria-valuemin="0" aria-valuemax="100">
                                                                    @lDisk.UsedPercent%
                                                                </div>
                                                            </div>
                                                            <div class="d-flex justify-content-between small text-muted">
                                                                <span>Kullanılan: <strong>@lDisk.UsedSpaceGb GB</strong></span>
                                                                <span>Boş Alan: <strong>@lDisk.FreeSpaceGb GB</strong> / @lDisk.TotalSizeGb GB</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- 4. BAĞLI MONİTÖRLER -->
                    <div class="tab-pane fade" id="tab-monitors" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h5 class="font-weight-bold text-dark mb-0">
                                <i class="fas fa-tv text-primary mr-1"></i> Bağlı Monitörler & EDID Kimlik Bilgileri
                            </h5>
                            <span class="badge badge-primary p-2">@(Model.Monitors?.Count ?? 0) Monitör Algılandı</span>
                        </div>
                        @if (Model.Monitors != null && Model.Monitors.Count > 0)
                        {
                            <div class="row">
                                @foreach (var m in Model.Monitors)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100 border border-primary">
                                            <div class="card-header bg-light py-2">
                                                <strong class="text-primary"><i class="fas fa-desktop mr-1"></i> @m.Model</strong>
                                                <span class="badge badge-success float-right">Aktif Ekran</span>
                                            </div>
                                            <div class="card-body">
                                                <table class="table table-sm table-striped mb-0">
                                                    <tbody>
                                                        <tr><td class="font-weight-bold" style="width:40%;">Üretici Marka:</td><td>@m.Manufacturer</td></tr>
                                                        <tr><td class="font-weight-bold">Seri Numarası:</td><td><strong class="text-danger">@m.SerialNumber</strong></td></tr>
                                                        <tr><td class="font-weight-bold">Üretim Yılı / Hafta:</td><td>@(m.YearOfManufacture > 0 ? $"{m.YearOfManufacture} (Hafta: {m.WeekOfManufacture})" : "Bilinmiyor")</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border small text-muted">
                                <i class="fas fa-info-circle mr-1"></i> Bağlı monitör EDID bilgisi WMI üzerinden alınamadı.
                            </div>
                        }
                    </div>

                    <!-- 5. USB AYGITLARI VE YAZICILAR -->
                    <div class="tab-pane fade" id="tab-peripherals" role="tabpanel">
                        <div class="row">
                            <div class="col-md-7 mb-4">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-usb text-info mr-1"></i> Bağlı USB / Pasaport / Optik Okuyucu Aygıtları
                                </h5>
                                @if (Model.UsbDevices != null && Model.UsbDevices.Count > 0)
                                {
                                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                        <table class="table table-sm table-hover table-pcinfo">
                                            <thead>
                                                <tr>
                                                    <th>Aygıt Adı</th>
                                                    <th>Üretici</th>
                                                    <th>Durum</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var u in Model.UsbDevices)
                                                {
                                                    <tr>
                                                        <td><strong>@u.Name</strong></td>
                                                        <td class="text-muted small">@u.Manufacturer</td>
                                                        <td><span class="badge badge-success">@u.Status</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <div class="col-md-5 mb-4">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-print text-warning mr-1"></i> Tanımlı Yazıcılar
                                </h5>
                                @if (Model.Printers != null && Model.Printers.Count > 0)
                                {
                                    <div class="list-group">
                                        @foreach (var p in Model.Printers)
                                        {
                                            <div class="list-group-item p-2 mb-2 border rounded">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <strong>@p.Name</strong>
                                                    @if (p.IsDefault)
                                                    {
                                                        <span class="badge badge-success">Varsayılan</span>
                                                    }
                                                </div>
                                                <div class="small text-muted mt-1">Sürücü: @p.DriverName | Port: @p.PortName</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 6. AĞ BAĞDAŞTIRICILARI -->
                    <div class="tab-pane fade" id="tab-network" role="tabpanel">
                        <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                            <i class="fas fa-network-wired text-info mr-1"></i> Aktif Ağ Kartları ve IP Yapılandırması
                        </h5>
                        @if (Model.NetworkAdapters != null && Model.NetworkAdapters.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-pcinfo">
                                    <thead>
                                        <tr>
                                            <th>Ağ Bağdaştırıcısı</th>
                                            <th>MAC Adresi</th>
                                            <th>IPv4 Adres(ler)i</th>
                                            <th>Varsayılan Ağ Geçidi</th>
                                            <th>DNS Sunucuları</th>
                                            <th>DHCP</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var net in Model.NetworkAdapters)
                                        {
                                            <tr>
                                                <td><strong>@net.Name</strong></td>
                                                <td><code>@net.MacAddress</code></td>
                                                <td>
                                                    @foreach (var ip in net.IpAddresses)
                                                    {
                                                        <span class="badge badge-info p-1 mr-1">@ip</span>
                                                    }
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(net.DefaultGateway) ? "-" : net.DefaultGateway)</td>
                                                <td>
                                                    @foreach (var dns in net.DnsServers)
                                                    {
                                                        <span class="badge badge-light border mr-1">@dns</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @(net.DhcpEnabled ? "badge-success" : "badge-secondary")">
                                                        @(net.DhcpEnabled ? "Açık" : "Statik")
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- 7. EKRAN KARTLARI (GPU) -->
                    <div class="tab-pane fade" id="tab-gpu" role="tabpanel">
                        <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                            <i class="fas fa-tv text-primary mr-1"></i> Ekran ve Grafik Kartları
                        </h5>
                        @if (Model.Gpus != null && Model.Gpus.Count > 0)
                        {
                            <div class="row">
                                @foreach (var gpu in Model.Gpus)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100 border">
                                            <div class="card-body">
                                                <h6 class="font-weight-bold text-dark"><i class="fas fa-microchip text-primary mr-1"></i> @gpu.Name</h6>
                                                <table class="table table-sm table-striped mt-2 mb-0">
                                                    <tbody>
                                                        <tr><td class="font-weight-bold" style="width:40%;">VRAM:</td><td><span class="badge badge-primary">@gpu.VramText</span></td></tr>
                                                        <tr><td class="font-weight-bold">Uyumluluk:</td><td>@gpu.AdapterType</td></tr>
                                                        <tr><td class="font-weight-bold">Sürücü Sürümü:</td><td><code>@gpu.DriverVersion</code></td></tr>
                                                        <tr><td class="font-weight-bold">Sürücü Tarihi:</td><td>@gpu.DriverDate</td></tr>
                                                        <tr><td class="font-weight-bold">Durum:</td><td><span class="badge badge-success">@gpu.Status</span></td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- 8. YÜKLÜ YAZILIMLAR -->
                    <div class="tab-pane fade" id="tab-software" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                            <h5 class="font-weight-bold text-dark mb-0">
                                <i class="fas fa-cube text-primary mr-1"></i> Sistemde Yüklü Programlar
                            </h5>
                            <div style="max-width: 300px;">
                                <input type="text" id="softwareSearch" class="form-control form-control-sm" placeholder="Program ara..." onkeyup="filterSoftware()" />
                            </div>
                        </div>

                        @if (Model.InstalledSoftware != null && Model.InstalledSoftware.Count > 0)
                        {
                            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                                <table class="table table-sm table-hover table-pcinfo" id="softwareTable">
                                    <thead>
                                        <tr>
                                            <th>Yazılım Adı</th>
                                            <th>Sürüm</th>
                                            <th>Yayıncı</th>
                                            <th>Yükleme Tarihi</th>
                                            <th>Mimari</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var soft in Model.InstalledSoftware)
                                        {
                                            <tr>
                                                <td class="font-weight-bold text-dark">@soft.Name</td>
                                                <td><code>@soft.Version</code></td>
                                                <td class="text-muted">@soft.Publisher</td>
                                                <td class="small">@soft.InstallDate</td>
                                                <td><span class="badge badge-light border">@soft.Architecture</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- 2. BÖLÜM: AKILLI AĞ TARAYICISI             -->
<!-- ========================================== -->
<div id="sectionScanner" style="display:none;">
    <div class="card mb-4 border">
        <div class="card-header bg-white py-3">
            <h4 class="font-weight-bold text-dark mb-1"><i class="fas fa-broadcast-tower text-primary mr-2"></i> Akıllı Ağ Tarayıcısı & Otomatik Keşif</h4>
            <p class="text-muted small mb-0">Havalimanı / hudut kapısı IP bloğundaki Windows PC'leri, Hikvision kameraları ve ağ yazıcılarını otomatik tespit eder.</p>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-5 mb-2">
                    <label class="font-weight-bold small">Taranacak IP Aralığı veya CIDR:</label>
                    <input type="text" id="scanRangeInput" class="form-control" value="10.7.202.1 - 10.7.202.100" placeholder="10.7.202.1 - 10.7.202.100 veya 10.7.202.0/24" />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="font-weight-bold small">Hassasiyet / Zaman Aşımı:</label>
                    <select id="scanTimeout" class="form-control">
                        <option value="600">600 ms (Çok Hızlı)</option>
                        <option value="1000" selected>1000 ms (Dengeli)</option>
                        <option value="1800">1800 ms (Hassas / Detaylı)</option>
                    </select>
                </div>
                <div class="col-md-4 mb-2 d-flex">
                    <button type="button" id="btnStartScan" class="btn btn-primary w-100" onclick="runNetworkScan()">
                        <i class="fas fa-play mr-1"></i> Taramayı Başlat
                    </button>
                </div>
            </div>

            <!-- Canlı İlerleme Çubuğu -->
            <div id="scanProgressBarArea" class="mt-4" style="display:none;">
                <div class="d-flex justify-content-between font-weight-bold small mb-1">
                    <span id="scanStatusText"><i class="fas fa-spinner fa-spin text-primary mr-1"></i> IP aralığı taranıyor...</span>
                    <span id="scanFoundCount" class="badge badge-info">0 Cihaz Bulundu</span>
                </div>
                <div class="progress" style="height: 12px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="scanBar" style="width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tarama Sonuç Tablosu -->
    <div class="card border" id="scanResultsCard" style="display:none;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="font-weight-bold text-dark mb-0">Keşfedilen Aktif Cihazlar</h5>
            <span class="badge badge-success p-2" id="discoveredBadge">0 Aktif Cihaz</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="scanTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Cihaz Türü</th>
                            <th>IP Adresi</th>
                            <th>Hostname / Cihaz Adı</th>
                            <th>Yanıt Süresi</th>
                            <th>Açık Portlar / Detay</th>
                            <th class="text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="scanTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 3. BÖLÜM: HIKVISION IP KAMERA MERKEZİ      -->
<!-- ========================================== -->
<div id="sectionCamera" style="display:none;">
    <div class="card mb-4 border">
        <div class="card-header bg-white py-3">
            <h4 class="font-weight-bold text-dark mb-1"><i class="fas fa-video text-danger mr-2"></i> Hikvision IP Kamera Yönetim Merkezi</h4>
            <p class="text-muted small mb-0">Kamera modeli, seri numarası, firmware sürümü, ISAPI ve RTSP canlı akış denetimi.</p>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-4 mb-2">
                    <label class="font-weight-bold small">Kamera IP Adresi:</label>
                    <input type="text" id="camIp" class="form-control" placeholder="Örn: 10.7.202.100" />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Port:</label>
                    <input type="number" id="camPort" class="form-control" value="80" />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Kullanıcı Adı:</label>
                    <input type="text" id="camUser" class="form-control" value="admin" />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Parola:</label>
                    <input type="password" id="camPass" class="form-control" placeholder="••••••••" />
                </div>
                <div class="col-md-2 mb-2">
                    <button type="button" class="btn btn-danger w-100" onclick="queryHikCamera()">
                        <i class="fas fa-plug mr-1"></i> Kameraya Bağlan
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Kamera Sonuç Kartı -->
    <div id="camResultCard" class="card border" style="display:none;">
        <div class="card-header bg-light py-2">
            <strong id="camDeviceNameHeader" class="text-dark">Kamera Bilgisi</strong>
            <span class="badge badge-success float-right" id="camOnlineBadge">Bağlantı Başarılı</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-sm table-striped">
                        <tbody>
                            <tr><th style="width:40%;">Model:</th><td id="camModel">—</td></tr>
                            <tr><th>Seri Numarası:</th><td id="camSerial" class="font-weight-bold text-danger">—</td></tr>
                            <tr><th>MAC Adresi:</th><td id="camMac">—</td></tr>
                            <tr><th>Firmware Sürümü:</th><td id="camFirmware">—</td></tr>
                            <tr><th>RTSP Portu:</th><td id="camRtspPort">554</td></tr>
                            <tr><th>RTSP Akış Adresi:</th><td><code id="camRtspUrl">—</code></td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6 text-center">
                    <div class="p-3 border rounded bg-light">
                        <i class="fas fa-video fa-4x text-muted mb-2"></i>
                        <p class="font-weight-bold mb-1">RTSP Canlı Akış Bağlantısı Hazır</p>
                        <p class="small text-muted mb-2">VLC Player veya CCTV İzleme Yazılımında URL'yi doğrudan oynatabilirsiniz.</p>
                        <a id="btnOpenRtsp" href="#" class="btn btn-sm btn-outline-danger" target="_blank">
                            <i class="fas fa-play mr-1"></i> Akışı Aç
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 4. BÖLÜM: CİHAZ ENVANTERİ (CEZA DB)        -->
<!-- ========================================== -->
<div id="sectionInventory" style="display:none;">
    <div class="card mb-4 border">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h4 class="font-weight-bold text-dark mb-1">
                    <i class="fas fa-database text-warning mr-2"></i> CEZA Veritabanı Donanım & Cihaz Envanteri
                </h4>
                <p class="text-muted small mb-0">CEZA veritabanındaki <code>dbo.tbl_PCInfoDevices</code> tablosuna kayıtlı tüm donanımlar.</p>
            </div>
            <div class="mt-2 mt-md-0 d-flex gap-2">
                <button class="btn btn-success btn-sm mr-2" onclick="downloadInventoryExcel()">
                    <i class="fas fa-file-excel mr-1"></i> Envanteri Excel'e Aktar
                </button>
                <button class="btn btn-primary btn-sm" onclick="openNewDeviceModal()">
                    <i class="fas fa-plus mr-1"></i> Yeni Cihaz Kaydet
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Filtreleme Çubuğu -->
            <div class="row align-items-end mb-3">
                <div class="col-md-4 mb-2">
                    <label class="small font-weight-bold">Arama:</label>
                    <input type="text" id="invSearch" class="form-control form-control-sm" placeholder="Marka, model, seri no, IP, gişe veya personel ara..." onkeyup="loadInventory()" />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold">Kategori:</label>
                    <select id="invCategory" class="form-control form-control-sm" onchange="loadInventory()">
                        <option value="">Tüm Kategoriler</option>
                        <option value="1">Masaüstü Bilgisayar</option>
                        <option value="2">Laptop (Dizüstü)</option>
                        <option value="3">Monitör</option>
                        <option value="4">IP Kamera</option>
                        <option value="5">Pasaport / Optik Okuyucu</option>
                        <option value="6">Parmak İzi / Biyometrik</option>
                        <option value="7">Yazıcı / Tarayıcı</option>
                        <option value="8">Kesintisiz Güç Kaynağı (UPS)</option>
                        <option value="9">Switch / Ağ Cihazı</option>
                        <option value="10">Sunucu</option>
                        <option value="99">Diğer</option>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold">Durum:</label>
                    <select id="invStatus" class="form-control form-control-sm" onchange="loadInventory()">
                        <option value="">Tüm Durumlar</option>
                        <option value="1">Kullanımda / Faal</option>
                        <option value="2">Depoda / Yedek</option>
                        <option value="3">Arızalı / Tamirde</option>
                        <option value="4">Hurda / HEK</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <button type="button" class="btn btn-secondary btn-sm w-100" onclick="loadInventory()">
                        <i class="fas fa-sync-alt mr-1"></i> Yenile
                    </button>
                </div>
            </div>

            <!-- Envanter Tablosu -->
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="inventoryTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Kategori</th>
                            <th>Marka / Model</th>
                            <th>Seri Numarası</th>
                            <th>Mevki / Gişe / Konum</th>
                            <th>Zimmetli Personel</th>
                            <th>Durum</th>
                            <th>IP Adresi</th>
                            <th class="text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="inventoryTableBody">
                        <tr><td colspan="8" class="text-center p-3 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Envanter yükleniyor...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: MEVCUT BİLGİSAYARI ENVANTERE KAYDET -->
<div class="modal fade" id="modalSaveCurrent" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-cloud-upload-alt mr-1"></i> CEZA Envanterine Kaydet</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">Bu bilgisayarın teftiş bilgileri (İşlemci, RAM, Disk, Monitörler ve Seri Numarası) CEZA veritabanına kaydedilecektir.</p>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Demirbaş No (İsteğe Bağlı):</label>
                    <input type="text" id="modalAssetTag" class="form-control form-control-sm" placeholder="Örn: GZP-EGM-PC-01" />
                </div>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Kategori:</label>
                    <select id="modalCategory" class="form-control form-control-sm">
                        <option value="1" selected>Masaüstü Bilgisayar</option>
                        <option value="2">Laptop (Dizüstü)</option>
                        <option value="10">Sunucu</option>
                    </select>
                </div>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Mevki / Kurulduğu Yer (Gişe / Büro):</label>
                    <input type="text" id="modalLocation" class="form-control form-control-sm" value="Gelen Yolcu Gişe" required />
                </div>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Zimmetli Personel (Sicil veya İsim):</label>
                    <input type="text" id="modalAssignedPerson" class="form-control form-control-sm" value="@(Model?.CurrentUser)" />
                </div>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Notlar / Açıklama:</label>
                    <textarea id="modalNotes" class="form-control form-control-sm" rows="2" placeholder="Cihaz durumu veya özel notlar..."></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success btn-sm" onclick="submitSaveCurrentInventory()">
                    <i class="fas fa-check mr-1"></i> CEZA Veritabanına Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function setTarget(target) {
        document.getElementById('targetInput').value = target;
        document.getElementById('pcQueryForm').submit();
    }

    function switchMainMode(mode) {
        document.getElementById('btnModeInspector').classList.remove('active');
        document.getElementById('btnModeScanner').classList.remove('active');
        document.getElementById('btnModeCamera').classList.remove('active');
        document.getElementById('btnModeInventory').classList.remove('active');

        document.getElementById('sectionInspector').style.display = 'none';
        document.getElementById('sectionScanner').style.display = 'none';
        document.getElementById('sectionCamera').style.display = 'none';
        document.getElementById('sectionInventory').style.display = 'none';

        if (mode === 'scanner') {
            document.getElementById('btnModeScanner').classList.add('active');
            document.getElementById('sectionScanner').style.display = 'block';
        } else if (mode === 'camera') {
            document.getElementById('btnModeCamera').classList.add('active');
            document.getElementById('sectionCamera').style.display = 'block';
        } else if (mode === 'inventory') {
            document.getElementById('btnModeInventory').classList.add('active');
            document.getElementById('sectionInventory').style.display = 'block';
            loadInventory();
        } else {
            document.getElementById('btnModeInspector').classList.add('active');
            document.getElementById('sectionInspector').style.display = 'block';
        }
    }

    function filterSoftware() {
        var input = document.getElementById("softwareSearch");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("softwareTable");
        if (!table) return;
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var rowText = tr[i].textContent || tr[i].innerText;
            tr[i].style.display = (rowText.toLowerCase().indexOf(filter) > -1) ? "" : "none";
        }
    }

    // Modal Aç
    function openSaveInventoryModal() {
        $('#modalSaveCurrent').modal('show');
    }

    function submitSaveCurrentInventory() {
        var target = '@(Model?.Target ?? "localhost")';
        var assetTag = document.getElementById('modalAssetTag').value;
        var category = document.getElementById('modalCategory').value;
        var location = document.getElementById('modalLocation').value;
        var assignedPerson = document.getElementById('modalAssignedPerson').value;
        var notes = document.getElementById('modalNotes').value;

        var body = new URLSearchParams();
        body.append('target', target);
        body.append('assetTag', assetTag);
        body.append('category', category);
        body.append('location', location);
        body.append('assignedPerson', assignedPerson);
        body.append('notes', notes);

        fetch('@Url.Action("SaveCurrentToInventory", "PCInfo")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            $('#modalSaveCurrent').modal('hide');
            if (data.success) {
                alert(data.message || 'Cihaz başarıyla CEZA veritabanına kaydedildi!');
            } else {
                alert('Hata: ' + data.message);
            }
        })
        .catch(function(err) {
            alert('Hata oluştu: ' + err);
        });
    }

    // Envanter Listesini Yükle (CEZA DB)
    function loadInventory() {
        var search = document.getElementById('invSearch').value;
        var category = document.getElementById('invCategory').value;
        var status = document.getElementById('invStatus').value;

        var url = '@Url.Action("GetInventory", "PCInfo")?search=' + encodeURIComponent(search) +
            '&category=' + encodeURIComponent(category) +
            '&status=' + encodeURIComponent(status);

        fetch(url)
        .then(function(res) { return res.json(); })
        .then(function(res) {
            var tbody = document.getElementById('inventoryTableBody');
            tbody.innerHTML = '';

            if (res.data && res.data.length > 0) {
                res.data.forEach(function(d) {
                    var tr = document.createElement('tr');
                    var catName = getCategoryName(d.Category);
                    var statusBadge = getStatusBadge(d.Status);

                    tr.innerHTML = '<td><strong>' + catName + '</strong>' + (d.AssetTag ? '<br><small class="text-muted">' + d.AssetTag + '</small>' : '') + '</td>' +
                        '<td><strong>' + (d.Brand || '') + ' ' + (d.Model || '') + '</strong></td>' +
                        '<td><code class="text-danger">' + (d.SerialNumber || '—') + '</code></td>' +
                        '<td>' + (d.Location || '—') + (d.RoomNumber ? ' (Oda: ' + d.RoomNumber + ')' : '') + '</td>' +
                        '<td>' + (d.AssignedPerson || '—') + '</td>' +
                        '<td>' + statusBadge + '</td>' +
                        '<td>' + (d.IpAddress ? '<code>' + d.IpAddress + '</code>' : '—') + '</td>' +
                        '<td class="text-right">' +
                            '<button class="btn btn-xs btn-primary mr-1" onclick="inspectDiscovered(\'' + (d.IpAddress || d.Model) + '\')"><i class="fas fa-search"></i></button>' +
                            '<button class="btn btn-xs btn-danger" onclick="deleteInventoryItem(' + d.Id + ')"><i class="fas fa-trash"></i></button>' +
                        '</td>';
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted p-4">CEZA veritabanında henüz kayıtlı envanter bulunmuyor. Teftiş ekranından veya Ağ Tarayıcısından cihazları kaydedebilirsiniz.</td></tr>';
            }
        })
        .catch(function(err) {
            document.getElementById('inventoryTableBody').innerHTML = '<tr><td colspan="8" class="text-center text-danger p-3">Veritabanından envanter yüklenirken hata: ' + err + '</td></tr>';
        });
    }

    function deleteInventoryItem(id) {
        if (!confirm('Bu envanter kaydını silmek istediğinize emin misiniz?')) return;

        var body = new URLSearchParams();
        body.append('id', id);

        fetch('@Url.Action("DeleteInventoryDevice", "PCInfo")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                loadInventory();
            } else {
                alert('Silinemedi.');
            }
        });
    }

    function downloadInventoryExcel() {
        var search = document.getElementById('invSearch').value;
        var category = document.getElementById('invCategory').value;
        var status = document.getElementById('invStatus').value;
        window.location.href = '@Url.Action("ExportInventoryExcel", "PCInfo")?search=' + encodeURIComponent(search) + '&category=' + encodeURIComponent(category) + '&status=' + encodeURIComponent(status);
    }

    function getCategoryName(c) {
        var cats = {
            1: "Masaüstü PC", 2: "Laptop", 3: "Monitör", 4: "IP Kamera",
            5: "Optik/Pasaport Okuyucu", 6: "Parmak İzi", 7: "Yazıcı",
            8: "UPS", 9: "Ağ Cihazı", 10: "Sunucu"
        };
        return cats[c] || "Diğer Donanım";
    }

    function getStatusBadge(s) {
        if (s === 1) return '<span class="badge badge-success">Faal</span>';
        if (s === 2) return '<span class="badge badge-primary">Depoda</span>';
        if (s === 3) return '<span class="badge badge-warning text-dark">Arızalı</span>';
        if (s === 4) return '<span class="badge badge-danger">Hurda</span>';
        return '<span class="badge badge-secondary">Bilinmiyor</span>';
    }

    // Akıllı Ağ Taraması
    function runNetworkScan() {
        var range = document.getElementById('scanRangeInput').value;
        var timeout = document.getElementById('scanTimeout').value;
        var btn = document.getElementById('btnStartScan');

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Taranıyor...';
        document.getElementById('scanProgressBarArea').style.display = 'block';
        document.getElementById('scanResultsCard').style.display = 'none';

        var body = new URLSearchParams();
        body.append('range', range);
        body.append('timeoutMs', timeout);

        fetch('@Url.Action("ScanNetwork", "PCInfo")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-play mr-1"></i> Taramayı Başlat';
            document.getElementById('scanProgressBarArea').style.display = 'none';
            document.getElementById('scanResultsCard').style.display = 'block';

            var tbody = document.getElementById('scanTableBody');
            tbody.innerHTML = '';
            document.getElementById('discoveredBadge').innerText = (data.count || 0) + ' Aktif Cihaz';

            if (data.devices && data.devices.length > 0) {
                data.devices.forEach(function(d) {
                    var tr = document.createElement('tr');
                    var inspectBtn = '<button class="btn btn-xs btn-primary mr-1" onclick="inspectDiscovered(\'' + d.IpAddress + '\')"><i class="fas fa-search"></i> İncele</button>';
                    inspectBtn += '<button class="btn btn-xs btn-warning mr-1 text-dark" onclick="saveScanItemToInventory(\'' + d.IpAddress + '\',\'' + (d.HostName || '') + '\',' + d.DeviceType + ',\'' + (d.Details || '') + '\')"><i class="fas fa-plus"></i> Envantere Ekle</button>';
                    if (d.DeviceType === 2) {
                        inspectBtn += '<button class="btn btn-xs btn-danger" onclick="openDiscoveredCamera(\'' + d.IpAddress + '\')"><i class="fas fa-video"></i> Kamera</button>';
                    }

                    tr.innerHTML = '<td><i class="' + d.DeviceIcon + ' mr-2"></i> <strong>' + d.DeviceTypeDisplay + '</strong></td>' +
                        '<td><code>' + d.IpAddress + '</code></td>' +
                        '<td>' + (d.HostName || '—') + '</td>' +
                        '<td><span class="badge badge-light border">' + d.ResponseTimeMs + ' ms</span></td>' +
                        '<td><small class="text-muted">' + (d.Details || 'Online') + '</small></td>' +
                        '<td class="text-right">' + inspectBtn + '</td>';
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted p-3">Bu IP aralığında açık cihaz bulunamadı.</td></tr>';
            }
        })
        .catch(function(err) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-play mr-1"></i> Taramayı Başlat';
            alert('Tarama sırasında hata oluştu: ' + err);
        });
    }

    function saveScanItemToInventory(ip, hostname, deviceType, details) {
        var loc = prompt('Bu cihaz için mevki / gişe / konum girin:', 'Hudut Kapısı');
        if (loc === null) return;

        var body = new URLSearchParams();
        body.append('ip', ip);
        body.append('hostname', hostname);
        body.append('deviceType', deviceType);
        body.append('location', loc);
        body.append('details', details);

        fetch('@Url.Action("SaveScanDeviceToInventory", "PCInfo")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert(data.message);
            } else {
                alert('Hata: ' + data.message);
            }
        });
    }

    function inspectDiscovered(ip) {
        switchMainMode('inspector');
        document.getElementById('targetInput').value = ip;
        document.getElementById('pcQueryForm').submit();
    }

    function openDiscoveredCamera(ip) {
        switchMainMode('camera');
        document.getElementById('camIp').value = ip;
        queryHikCamera();
    }

    // Hikvision Kamera Sorgulama
    function queryHikCamera() {
        var ip = document.getElementById('camIp').value;
        var port = document.getElementById('camPort').value;
        var user = document.getElementById('camUser').value;
        var pass = document.getElementById('camPass').value;

        if (!ip) {
            alert('Lütfen kamera IP adresi girin.');
            return;
        }

        var body = new URLSearchParams();
        body.append('ip', ip);
        body.append('port', port);
        body.append('username', user);
        body.append('password', pass);

        fetch('@Url.Action("QueryCamera", "PCInfo")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(res) { return res.json(); })
        .then(function(cam) {
            document.getElementById('camResultCard').style.display = 'block';
            document.getElementById('camDeviceNameHeader').innerText = cam.DeviceName || 'Hikvision IP Kamera';
            document.getElementById('camModel').innerText = cam.Model || '—';
            document.getElementById('camSerial').innerText = cam.SerialNumber || '—';
            document.getElementById('camMac').innerText = cam.MacAddress || '—';
            document.getElementById('camFirmware').innerText = cam.FirmwareVersion || '—';
            document.getElementById('camRtspPort').innerText = cam.RtspPort;
            document.getElementById('camRtspUrl').innerText = cam.RtspUrl;
            document.getElementById('btnOpenRtsp').href = cam.RtspUrl;

            if (cam.IsOnline) {
                document.getElementById('camOnlineBadge').className = 'badge badge-success float-right';
                document.getElementById('camOnlineBadge').innerText = 'Bağlantı Başarılı';
            } else {
                document.getElementById('camOnlineBadge').className = 'badge badge-danger float-right';
                document.getElementById('camOnlineBadge').innerText = 'Kameraya Ulaşılamadı';
            }
        })
        .catch(function(err) {
            alert('Kamera sorgulanamadı: ' + err);
        });
    }
</script>
