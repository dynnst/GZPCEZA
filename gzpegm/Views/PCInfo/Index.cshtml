@model gzpegm.Models.PCInfo.ComputerInfo
@{
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Title = "PC & Donanım Denetimi (PCInfo)";
}

<style>
    .pcinfo-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: #fff;
        border-radius: 8px;
        padding: 22px 26px;
        margin-bottom: 22px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }
    .stat-metric-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 18px 20px;
        margin-bottom: 20px;
        transition: transform .2s ease, box-shadow .2s ease;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .stat-metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.08);
    }
    .stat-metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }
    .preset-pill {
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        transition: all .15s ease;
        display: inline-block;
        margin-right: 6px;
        margin-bottom: 6px;
    }
    .preset-pill:hover, .preset-pill.active {
        background: #0284c7;
        color: #fff;
        border-color: #0284c7;
    }
    .disk-progress-bar {
        height: 14px;
        border-radius: 7px;
    }
    .table-pcinfo th {
        background: #f8fafc;
        font-weight: 600;
        color: #475569;
        font-size: 13px;
    }
    .nav-tabs .nav-link {
        font-weight: 600;
        color: #475569;
        border-radius: 6px 6px 0 0;
    }
    .nav-tabs .nav-link.active {
        color: #0284c7;
        border-bottom-color: #fff;
    }
    .badge-soft-success {
        background: #dcfce7;
        color: #15803d;
    }
    .badge-soft-danger {
        background: #fee2e2;
        color: #b91c1c;
    }
    .badge-soft-info {
        background: #e0f2fe;
        color: #0369a1;
    }
</style>

<div class="pcinfo-header d-flex justify-content-between align-items-center flex-wrap">
    <div>
        <h2 class="mb-1 text-white font-weight-bold" style="font-size: 24px;">
            <i class="fas fa-desktop text-info mr-2"></i> PC & Donanım Denetimi (PCInfo)
        </h2>
        <p class="mb-0 text-white-50 small">
            Yerel sunucu veya hudut kapısı gişe terminallerinin CPU, RAM, Disk, Ağ, Ekran Kartı ve Donanım Teşhis Paneli.
        </p>
    </div>
    <div class="mt-2 mt-md-0 d-flex align-items-center">
        @if (Model != null && Model.IsOnline)
        {
            <span class="badge badge-soft-success p-2 mr-2"><i class="fas fa-check-circle"></i> Çevrimiçi</span>
        }
        else
        {
            <span class="badge badge-soft-danger p-2 mr-2"><i class="fas fa-times-circle"></i> Çevrimdışı / Hata</span>
        }
        <a href="@Url.Action("ExportJson", "PCInfo", new { target = Model?.Target })" class="btn btn-sm btn-outline-light">
            <i class="fas fa-download mr-1"></i> JSON İndir
        </a>
    </div>
</div>

<!-- SORGULAMA KARTI -->
<div class="card mb-4 border">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "PCInfo")" id="pcQueryForm">
            <div class="mb-3">
                <span class="text-muted small font-weight-bold mr-2">Hızlı Seçim:</span>
                <span class="preset-pill @(string.IsNullOrWhiteSpace(ViewBag.SelectedTarget) || ViewBag.SelectedTarget == "localhost" ? "active" : "")" onclick="setTarget('localhost')">
                    <i class="fas fa-server mr-1"></i> Yerel Sunucu (Localhost)
                </span>
                <span class="preset-pill @(ViewBag.SelectedTarget == "10.7.202.75" ? "active" : "")" onclick="setTarget('10.7.202.75')">
                    <i class="fas fa-network-wired mr-1"></i> Ana Sunucu (10.7.202.75)
                </span>
                <span class="preset-pill @(ViewBag.SelectedTarget == "10.7.202.76" ? "active" : "")" onclick="setTarget('10.7.202.76')">
                    <i class="fas fa-shield-alt mr-1"></i> Yedek Sunucu (10.7.202.76)
                </span>
            </div>

            <div class="row align-items-end">
                <div class="col-md-6 mb-2">
                    <label class="font-weight-bold small text-dark mb-1">Hedef IP veya Bilgisayar Adı:</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white"><i class="fas fa-laptop text-primary"></i></span>
                        </div>
                        <input type="text" name="target" id="targetInput" class="form-control" value="@(ViewBag.SelectedTarget ?? "localhost")" placeholder="Örn: 10.7.202.75 veya GZP-GISE-01" required />
                    </div>
                </div>

                <div class="col-md-6 mb-2 d-flex">
                    <button type="submit" id="btnSubmitQuery" class="btn btn-primary px-4 mr-2">
                        <i class="fas fa-search mr-1"></i> Donanımı Sorgula
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-toggle="collapse" data-target="#remoteCreds">
                        <i class="fas fa-key mr-1"></i> Uzak Giriş Bilgileri
                    </button>
                </div>
            </div>

            <div id="remoteCreds" class="collapse mt-3 pt-3 border-top">
                <div class="alert alert-light border small text-muted mb-2">
                    <i class="fas fa-info-circle text-info"></i> Uzaktaki bir bilgisayarı sorgularken erişim yetkisi hatası alıyorsanız hedef bilgisayardaki yetkili kullanıcı adı ve parolasını belirtin.
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="small font-weight-bold">Kullanıcı Adı (Opsiyonel):</label>
                        <input type="text" name="username" class="form-control form-control-sm" placeholder="Domain\Kullanıcı veya Administrator" />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="small font-weight-bold">Parola (Opsiyonel):</label>
                        <input type="password" name="password" class="form-control form-control-sm" placeholder="••••••••" />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model != null && !Model.IsOnline && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger shadow-sm border-0 mb-4">
        <h5 class="alert-heading font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-2"></i> Bağlantı / Sorgu Hatası</h5>
        <p class="mb-2">@Model.ErrorMessage</p>
        <hr class="my-2" />
        <small class="d-block text-dark">
            <strong>Çözüm Önerileri:</strong><br />
            1. Hedef bilgisayarın açık ve ağa bağlı olduğunu doğrulayın.<br />
            2. Uzak makine ise 'Uzak Giriş Bilgileri' kısmına Yönetici hesabı girin.<br />
            3. Windows Firewall üzerinde 'Windows Management Instrumentation (WMI)' kuralının açık olduğundan emin olun.
        </small>
    </div>
}

@if (Model != null && Model.IsOnline)
{
    <!-- ÜST METRİK KARTLARI -->
    <div class="row">
        <!-- CPU METRİK -->
        <div class="col-lg-3 col-md-6">
            <div class="stat-metric-card d-flex align-items-center">
                <div class="stat-metric-icon bg-soft-info text-info mr-3">
                    <i class="fas fa-microchip"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="small text-muted font-weight-bold text-uppercase">İşlemci (CPU)</div>
                    <div class="font-weight-bold text-dark text-truncate" title="@(Model.Cpu?.Name)">
                        @(string.IsNullOrWhiteSpace(Model.Cpu?.Name) ? "Algılanamadı" : Model.Cpu.Name)
                    </div>
                    <div class="small text-secondary">
                        @(Model.Cpu?.Cores ?? 0) Çekirdek / @(Model.Cpu?.Threads ?? 0) İzlek
                    </div>
                </div>
            </div>
        </div>

        <!-- RAM METRİK -->
        <div class="col-lg-3 col-md-6">
            <div class="stat-metric-card d-flex align-items-center">
                <div class="stat-metric-icon text-success mr-3" style="background:#dcfce7;">
                    <i class="fas fa-memory"></i>
                </div>
                <div>
                    <div class="small text-muted font-weight-bold text-uppercase">Toplam Bellek (RAM)</div>
                    <div class="font-weight-bold text-dark" style="font-size: 20px;">
                        @(Model.Memory?.TotalGb ?? 0) GB
                    </div>
                    <div class="small text-secondary">
                        @(Model.Memory?.Slots?.Count ?? 0) Slot Kullanımda
                    </div>
                </div>
            </div>
        </div>

        <!-- DEPOLAMA METRİK -->
        <div class="col-lg-3 col-md-6">
            <div class="stat-metric-card d-flex align-items-center">
                <div class="stat-metric-icon text-warning mr-3" style="background:#fef3c7;">
                    <i class="fas fa-hdd"></i>
                </div>
                <div>
                    @{
                        var totalDiskGb = Model.Disks?.Sum(d => d.TotalSizeGb) ?? 0;
                        var totalLogicalDisks = Model.Disks?.SelectMany(d => d.LogicalDisks).Count() ?? 0;
                    }
                    <div class="small text-muted font-weight-bold text-uppercase">Toplam Depolama</div>
                    <div class="font-weight-bold text-dark" style="font-size: 20px;">
                        @totalDiskGb GB
                    </div>
                    <div class="small text-secondary">
                        @(Model.Disks?.Count ?? 0) Fiziksel / @totalLogicalDisks Sürücü
                    </div>
                </div>
            </div>
        </div>

        <!-- İŞLETİM SİSTEMİ METRİK -->
        <div class="col-lg-3 col-md-6">
            <div class="stat-metric-card d-flex align-items-center">
                <div class="stat-metric-icon text-primary mr-3" style="background:#e0e7ff;">
                    <i class="fab fa-windows"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="small text-muted font-weight-bold text-uppercase">İşletim Sistemi</div>
                    <div class="font-weight-bold text-dark text-truncate" title="@(Model.Windows?.Caption)">
                        @(string.IsNullOrWhiteSpace(Model.Windows?.Caption) ? "Windows" : Model.Windows.Caption)
                    </div>
                    <div class="small text-secondary">
                        @(Model.Windows?.Architecture) (Derleme: @(Model.Windows?.BuildNumber))
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SEKMELİ DETAY KARTI -->
    <div class="card border">
        <div class="card-header bg-white pb-0 border-bottom-0">
            <ul class="nav nav-tabs card-header-tabs" id="pcInfoTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="tab-system-link" data-toggle="tab" href="#tab-system" role="tab">
                        <i class="fas fa-info-circle mr-1"></i> Sistem & Anakart
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-cpu-ram-link" data-toggle="tab" href="#tab-cpu-ram" role="tab">
                        <i class="fas fa-microchip mr-1"></i> CPU & RAM Yuvaları
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-disks-link" data-toggle="tab" href="#tab-disks" role="tab">
                        <i class="fas fa-hdd mr-1"></i> Diskler & Depolama
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-gpu-link" data-toggle="tab" href="#tab-gpu" role="tab">
                        <i class="fas fa-tv mr-1"></i> Ekran Kartı (GPU)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-network-link" data-toggle="tab" href="#tab-network" role="tab">
                        <i class="fas fa-network-wired mr-1"></i> Ağ Bağdaştırıcıları
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-software-link" data-toggle="tab" href="#tab-software" role="tab">
                        <i class="fas fa-cube mr-1"></i> Yüklü Yazılımlar (@(Model.InstalledSoftware?.Count ?? 0))
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="pcInfoTabContent">

                <!-- 1. SİSTEM & ANAKART / BIOS -->
                <div class="tab-pane fade show active" id="tab-system" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                <i class="fas fa-desktop text-primary mr-1"></i> Bilgisayar Kimliği
                            </h5>
                            <table class="table table-sm table-striped">
                                <tbody>
                                    <tr><td class="font-weight-bold" style="width:40%;">Bilgisayar Adı:</td><td>@(Model.ComputerName)</td></tr>
                                    <tr><td class="font-weight-bold">Üretici:</td><td>@(Model.Manufacturer)</td></tr>
                                    <tr><td class="font-weight-bold">Model:</td><td>@(Model.Model)</td></tr>
                                    <tr><td class="font-weight-bold">Seri Numarası:</td><td><code>@(Model.SerialNumber)</code></td></tr>
                                    <tr><td class="font-weight-bold">Sistem Türü:</td><td>@(Model.SystemType)</td></tr>
                                    <tr><td class="font-weight-bold">Domain / Çalışma Grubu:</td><td>@(string.IsNullOrWhiteSpace(Model.Domain) ? Model.Workgroup : Model.Domain)</td></tr>
                                    <tr><td class="font-weight-bold">Aktif Kullanıcı:</td><td>@(Model.CurrentUser)</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-md-6 mb-3">
                            <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                <i class="fas fa-layer-group text-success mr-1"></i> Anakart & BIOS
                            </h5>
                            <table class="table table-sm table-striped">
                                <tbody>
                                    <tr><td class="font-weight-bold" style="width:40%;">Anakart Üreticisi:</td><td>@(Model.Motherboard?.Manufacturer)</td></tr>
                                    <tr><td class="font-weight-bold">Anakart Modeli:</td><td>@(Model.Motherboard?.Product)</td></tr>
                                    <tr><td class="font-weight-bold">Anakart Seri No:</td><td><code>@(Model.Motherboard?.SerialNumber)</code></td></tr>
                                    <tr><td class="font-weight-bold">BIOS Üreticisi:</td><td>@(Model.Bios?.Manufacturer)</td></tr>
                                    <tr><td class="font-weight-bold">BIOS Sürümü:</td><td>@(Model.Bios?.Version)</td></tr>
                                    <tr><td class="font-weight-bold">BIOS Tarihi:</td><td>@(Model.Bios?.ReleaseDate)</td></tr>
                                    <tr><td class="font-weight-bold">Son Başlatma Zamanı:</td><td>@(Model.Windows?.LastBootTime)</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 2. CPU & RAM -->
                <div class="tab-pane fade" id="tab-cpu-ram" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                <i class="fas fa-microchip text-info mr-1"></i> İşlemci Ayrıntıları
                            </h5>
                            <table class="table table-sm table-striped">
                                <tbody>
                                    <tr><td class="font-weight-bold" style="width:40%;">İşlemci Modeli:</td><td><strong>@(Model.Cpu?.Name)</strong></td></tr>
                                    <tr><td class="font-weight-bold">Üretici:</td><td>@(Model.Cpu?.Manufacturer)</td></tr>
                                    <tr><td class="font-weight-bold">Fiziksel Çekirdek:</td><td>@(Model.Cpu?.Cores)</td></tr>
                                    <tr><td class="font-weight-bold">Mantıksal İzlek (Thread):</td><td>@(Model.Cpu?.Threads)</td></tr>
                                    <tr><td class="font-weight-bold">Maksimum Frekans:</td><td>@(Model.Cpu?.MaxSpeedGhz)</td></tr>
                                    <tr><td class="font-weight-bold">Mevcut Frekans:</td><td>@(Model.Cpu?.CurrentSpeedGhz)</td></tr>
                                    <tr><td class="font-weight-bold">Mimari:</td><td>@(Model.Cpu?.Architecture)</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-md-6 mb-4">
                            <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                <i class="fas fa-memory text-success mr-1"></i> RAM Modül Yuvaları
                            </h5>
                            @if (Model.Memory?.Slots != null && Model.Memory.Slots.Count > 0)
                            {
                                <div class="row">
                                    @foreach (var slot in Model.Memory.Slots)
                                    {
                                        <div class="col-sm-6 mb-2">
                                            <div class="p-2 border rounded bg-light">
                                                <div class="font-weight-bold text-primary">@slot.Tag</div>
                                                <div class="font-weight-bold" style="font-size: 16px;">@slot.CapacityGb GB @(slot.SpeedMhz > 0 ? $"({slot.SpeedMhz} MHz)" : "")</div>
                                                <div class="small text-muted">@slot.Manufacturer - @slot.PartNumber</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border small text-muted">
                                    Fiziksel slot detayları alınamadı. Toplam bellek: <strong>@(Model.Memory?.TotalGb ?? 0) GB</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 3. DİSKLER & DEPOLAMA -->
                <div class="tab-pane fade" id="tab-disks" role="tabpanel">
                    <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                        <i class="fas fa-hdd text-warning mr-1"></i> Fiziksel ve Mantıksal Sürücüler
                    </h5>

                    @if (Model.Disks != null && Model.Disks.Count > 0)
                    {
                        foreach (var disk in Model.Disks)
                        {
                            <div class="card mb-3 border">
                                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge badge-info mr-2">@disk.MediaType</span>
                                        <strong>@disk.Model</strong>
                                        @if (!string.IsNullOrWhiteSpace(disk.SerialNumber))
                                        {
                                            <small class="text-muted ml-2">(S/N: @disk.SerialNumber)</small>
                                        }
                                    </div>
                                    <span class="badge badge-secondary p-2">@disk.TotalSizeGb GB Toplam</span>
                                </div>
                                <div class="card-body p-3">
                                    @if (disk.LogicalDisks != null && disk.LogicalDisks.Count > 0)
                                    {
                                        <div class="row">
                                            @foreach (var lDisk in disk.LogicalDisks)
                                            {
                                                var barColor = lDisk.UsedPercent > 85 ? "bg-danger" : lDisk.UsedPercent > 70 ? "bg-warning" : "bg-success";
                                                <div class="col-md-6 mb-3">
                                                    <div class="p-2 border rounded">
                                                        <div class="d-flex justify-content-between font-weight-bold mb-1">
                                                            <span><i class="fas fa-folder text-primary mr-1"></i> Sürücü @lDisk.DriveLetter @(!string.IsNullOrWhiteSpace(lDisk.Label) ? $"({lDisk.Label})" : "")</span>
                                                            <span class="small text-muted">@lDisk.FileSystem</span>
                                                        </div>
                                                        <div class="progress disk-progress-bar mb-2">
                                                            <div class="progress-bar @barColor" role="progressbar" style="width: @lDisk.UsedPercent%;" aria-valuenow="@lDisk.UsedPercent" aria-valuemin="0" aria-valuemax="100">
                                                                @lDisk.UsedPercent%
                                                            </div>
                                                        </div>
                                                        <div class="d-flex justify-content-between small text-muted">
                                                            <span>Kullanılan: <strong>@lDisk.UsedSpaceGb GB</strong></span>
                                                            <span>Boş Alan: <strong>@lDisk.FreeSpaceGb GB</strong> / @lDisk.TotalSizeGb GB</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Bu disk üzerinde mantıksal bölüm tanımlanmamış veya doğrudan eşleştirilemedi.</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted">Disk bilgisi bulunamadı.</div>
                    }
                </div>

                <!-- 4. EKRAN KARTLARI (GPU) -->
                <div class="tab-pane fade" id="tab-gpu" role="tabpanel">
                    <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                        <i class="fas fa-tv text-primary mr-1"></i> Ekran ve Grafik Kartları
                    </h5>
                    @if (Model.Gpus != null && Model.Gpus.Count > 0)
                    {
                        <div class="row">
                            @foreach (var gpu in Model.Gpus)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <h6 class="font-weight-bold text-dark"><i class="fas fa-microchip text-primary mr-1"></i> @gpu.Name</h6>
                                            <table class="table table-sm table-striped mt-2 mb-0">
                                                <tbody>
                                                    <tr><td class="font-weight-bold" style="width:40%;">VRAM (Bellek):</td><td><span class="badge badge-primary">@gpu.VramText</span></td></tr>
                                                    <tr><td class="font-weight-bold">Uyumluluk:</td><td>@gpu.AdapterType</td></tr>
                                                    <tr><td class="font-weight-bold">Sürücü Sürümü:</td><td><code>@gpu.DriverVersion</code></td></tr>
                                                    <tr><td class="font-weight-bold">Sürücü Tarihi:</td><td>@gpu.DriverDate</td></tr>
                                                    <tr><td class="font-weight-bold">Durum:</td><td><span class="badge badge-success">@gpu.Status</span></td></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted">Ekran kartı bilgisi alınamadı.</div>
                    }
                </div>

                <!-- 5. AĞ BAĞDAŞTIRICILARI -->
                <div class="tab-pane fade" id="tab-network" role="tabpanel">
                    <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                        <i class="fas fa-network-wired text-info mr-1"></i> Aktif Ağ Kartları ve IP Yapılandırması
                    </h5>
                    @if (Model.NetworkAdapters != null && Model.NetworkAdapters.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-pcinfo">
                                <thead>
                                    <tr>
                                        <th>Ağ Bağdaştırıcısı</th>
                                        <th>MAC Adresi</th>
                                        <th>IPv4 Adres(ler)i</th>
                                        <th>Varsayılan Ağ Geçidi</th>
                                        <th>DNS Sunucuları</th>
                                        <th>DHCP</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var net in Model.NetworkAdapters)
                                    {
                                        <tr>
                                            <td><strong>@net.Name</strong></td>
                                            <td><code>@net.MacAddress</code></td>
                                            <td>
                                                @foreach (var ip in net.IpAddresses)
                                                {
                                                    <span class="badge badge-info p-1 mr-1">@ip</span>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(net.DefaultGateway) ? "-" : net.DefaultGateway)</td>
                                            <td>
                                                @foreach (var dns in net.DnsServers)
                                                {
                                                    <span class="badge badge-light border mr-1">@dns</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @(net.DhcpEnabled ? "badge-success" : "badge-secondary")">
                                                    @(net.DhcpEnabled ? "Açık" : "Statik")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted">Aktif ağ bağdaştırıcısı tespit edilemedi.</div>
                    }
                </div>

                <!-- 6. YÜKLÜ YAZILIMLAR -->
                <div class="tab-pane fade" id="tab-software" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                        <h5 class="font-weight-bold text-dark mb-0">
                            <i class="fas fa-cube text-primary mr-1"></i> Sistemde Yüklü Programlar
                        </h5>
                        <div style="max-width: 300px;">
                            <input type="text" id="softwareSearch" class="form-control form-control-sm" placeholder="Program ara..." onkeyup="filterSoftware()" />
                        </div>
                    </div>

                    @if (Model.InstalledSoftware != null && Model.InstalledSoftware.Count > 0)
                    {
                        <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                            <table class="table table-sm table-hover table-pcinfo" id="softwareTable">
                                <thead>
                                    <tr>
                                        <th>Yazılım Adı</th>
                                        <th>Sürüm</th>
                                        <th>Yayıncı</th>
                                        <th>Yükleme Tarihi</th>
                                        <th>Mimari</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var soft in Model.InstalledSoftware)
                                    {
                                        <tr>
                                            <td class="font-weight-bold text-dark">@soft.Name</td>
                                            <td><code>@soft.Version</code></td>
                                            <td class="text-muted">@soft.Publisher</td>
                                            <td class="small">@soft.InstallDate</td>
                                            <td><span class="badge badge-light border">@soft.Architecture</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted">
                            Yüklü yazılım listesi sadece doğrudan yerel sunucu sorgularında Windows Kayıt Defteri üzerinden çekilmektedir.
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
}

<script>
    function setTarget(target) {
        document.getElementById('targetInput').value = target;
        document.getElementById('pcQueryForm').submit();
    }

    function filterSoftware() {
        var input = document.getElementById("softwareSearch");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("softwareTable");
        if (!table) return;
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var rowText = tr[i].textContent || tr[i].innerText;
            if (rowText.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>
