function initPCInfoPage() {
    var modeEl = document.getElementById('_activeMode');
    var activeMode = modeEl ? modeEl.value : 'inspector';
    if (activeMode && activeMode !== 'inspector') switchMainMode(activeMode);

    var btnCam = document.getElementById('btnModeCamera');
    if (btnCam) btnCam.addEventListener('click', function() { setTimeout(initCctvSystem, 50); });
    if (activeMode === 'camera') initCctvSystem();
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPCInfoPage);
} else {
    initPCInfoPage();
}
