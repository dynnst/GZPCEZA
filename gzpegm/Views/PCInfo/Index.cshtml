@section Scripts {
<script>
// ===================================================
// GÜVENLİ MODAL YÖNETİCİSİ (Bootstrap + Vanilla JS Fallback)
// ===================================================
function showModalSafe(modalId) {
    var el = document.getElementById(modalId);
    if (!el) return;

    // Porto Admin stacking context ve overflow sorununu kalıcı çözmek için modal elementini body'ye taşıyoruz
    if (el.parentNode !== document.body) {
        document.body.appendChild(el);
    }
    el.style.zIndex = '100050';

    try {
        if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(el).modal('show');
            setTimeout(function() {
                var bds = document.querySelectorAll('.modal-backdrop');
                for (var i = 0; i < bds.length; i++) bds[i].style.zIndex = '100040';
            }, 25);
            return;
        }
    } catch(e) {}

    // Vanilla JS Fallback
    el.classList.add('show');
    el.style.display = 'block';
    el.removeAttribute('aria-hidden');
    el.setAttribute('aria-modal', 'true');
    var bd = document.getElementById(modalId + '_backdrop');
    if (!bd) {
        bd = document.createElement('div');
        bd.className = 'modal-backdrop fade show';
        bd.id = modalId + '_backdrop';
        bd.style.zIndex = '100040';
        document.body.appendChild(bd);
    }
    document.body.classList.add('modal-open');
}

function hideModalSafe(modalId) {
    var el = document.getElementById(modalId);
    if (!el) return;
    try {
        if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(el).modal('hide');
        }
    } catch(e) {}
    el.classList.remove('show');
    el.style.display = 'none';
    el.setAttribute('aria-hidden', 'true');
    el.removeAttribute('aria-modal');
    var bd = document.getElementById(modalId + '_backdrop');
    if (bd) bd.remove();
    var bds = document.querySelectorAll('.modal-backdrop');
    for (var i = 0; i < bds.length; i++) bds[i].remove();
    document.body.classList.remove('modal-open');
}

// Modal Kapatma Butonları (X ve İptal) için Güvenli Olay Dinleyici
document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-dismiss="modal"]');
    if (btn) {
        var modal = btn.closest('.modal');
        if (modal) hideModalSafe(modal.id);
    }
});

// ===================================================
// MOD ANAHTARLAMA
// ===================================================
function switchMainMode(mode) {
    var modes = ['Inspector', 'Scanner', 'Inventory'];
    modes.forEach(function(m) {
        var btn = document.getElementById('btnMode' + m);
        if (btn) btn.classList.remove('active');
        var sec = document.getElementById('section' + m);
        if (sec) sec.style.display = 'none';
    });
    var capMode = mode.charAt(0).toUpperCase() + mode.slice(1);
    var activeBtn = document.getElementById('btnMode' + capMode);
    if (activeBtn) activeBtn.classList.add('active');
    var activeSec = document.getElementById('section' + capMode);
    if (activeSec) activeSec.style.display = 'block';

    var modeInput = document.getElementById('_activeMode');
    if (modeInput) modeInput.value = mode;

    if (mode === 'inventory') loadInventory();
}

// ===================================================
// HEDEF SORGULAMA & YÖNETİCİ KİMLİK BİLGİSİ KAYDETME
// ===================================================
function setTarget(target) {
    window.location.href = '@Url.Action("Index", "PCInfo")?target=' + encodeURIComponent(target);
}

function handleQueryFormSubmit(e) {
    var userEl = document.querySelector('input[name="username"]');
    var passEl = document.querySelector('input[name="password"]');
    var user = userEl ? userEl.value.trim() : '';
    var pass = passEl ? passEl.value : '';

    if (user || pass) {
        try {
            localStorage.setItem('gzp_remoteAdminAuth', JSON.stringify({ user: user, pass: pass, savedAt: new Date().toISOString() }));
        } catch(ex) {}
    }

    if (!pass) {
        e.preventDefault();
        window.location.href = '@Url.Action("Index", "PCInfo")?target=' + encodeURIComponent(document.getElementById('targetInput').value);
        return false;
    }
    return true;
}

// ===================================================
// YAZILIM ARAMA / FİLTRE
// ===================================================
function filterSoftware() {
    var filter = (document.getElementById("softwareSearch") ? document.getElementById("softwareSearch").value : '').toLowerCase();
    var table = document.getElementById("softwareTable");
    if (!table) return;
    var tr = table.getElementsByTagName("tr");
    for (var i = 1; i < tr.length; i++) {
        var rowText = tr[i].textContent || tr[i].innerText;
        tr[i].style.display = (rowText.toLowerCase().indexOf(filter) > -1) ? "" : "none";
    }
}

// ===================================================
// MEVCUT BİLGİSAYARI ENVANTERE KAYDET
// ===================================================
function openSaveInventoryModal() {
    var targetInput = document.getElementById('targetInput');
    var targetVal = (targetInput ? targetInput.value.trim() : '') || 'localhost';
    
    var assetEl = document.getElementById('modalAssetTag');
    if (assetEl && !assetEl.value) {
        assetEl.value = 'GZP-' + targetVal.replace(/[^a-zA-Z0-9]/g, '_');
    }
    showModalSafe('modalSaveCurrent');
}

function submitSaveCurrentInventory() {
    var btn = document.querySelector('#modalSaveCurrent .btn-success');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Kaydediliyor...';
    }

    var targetVal = (document.getElementById('targetInput') ? document.getElementById('targetInput').value : '') || 'localhost';
    var userEl = document.querySelector('input[name="username"]');
    var passEl = document.querySelector('input[name="password"]');
    var user = userEl ? userEl.value : '';
    var pass = passEl ? passEl.value : '';

    if (!user && !pass) {
        try {
            var saved = JSON.parse(localStorage.getItem('gzp_remoteAdminAuth') || '{}');
            user = saved.user || '';
            pass = saved.pass || '';
        } catch(e) {}
    }

    var assetTagEl = document.getElementById('modalAssetTag');
    var categoryEl = document.getElementById('modalCategory');
    var locationEl = document.getElementById('modalLocation');
    var assignedEl = document.getElementById('modalAssignedPerson');
    var notesEl = document.getElementById('modalNotes');

    var body = new URLSearchParams();
    body.append('target', targetVal);
    body.append('assetTag', assetTagEl ? assetTagEl.value : '');
    body.append('category', categoryEl ? categoryEl.value : '1');
    body.append('location', locationEl ? locationEl.value : 'Hudut Kapısı / Gişe');
    body.append('assignedPerson', assignedEl ? assignedEl.value : '');
    body.append('notes', notesEl ? notesEl.value : '');
    body.append('username', user);
    body.append('password', pass);

    fetch('@Url.Action("SaveCurrentToInventory", "PCInfo")', {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: body.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check mr-1"></i> CEZA Veritabanına Kaydet';
        }
        hideModalSafe('modalSaveCurrent');
        if (data.success) {
            showToast(data.message || 'Cihaz başarıyla CEZA veritabanına kaydedildi!');
            if (typeof loadInventory === 'function') loadInventory();
        } else {
            alert('Hata: ' + data.message);
        }
    })
    .catch(function(e) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check mr-1"></i> CEZA Veritabanına Kaydet';
        }
        alert('Kaydetme hatası: ' + e);
    });
}

// ===================================================
// ENVANTER — YÜKLE / SİL / İNDİR
// ===================================================
var _invTimer = null;
function debouncedLoadInventory() {
    clearTimeout(_invTimer);
    _invTimer = setTimeout(loadInventory, 350);
}

function loadInventory() {
    var searchEl = document.getElementById('invSearch');
    var catEl = document.getElementById('invCategory');
    var statusEl = document.getElementById('invStatus');
    var search = searchEl ? searchEl.value : '';
    var category = catEl ? catEl.value : '';
    var status = statusEl ? statusEl.value : '';

    var url = '@Url.Action("GetInventory", "PCInfo")?search=' + encodeURIComponent(search) + '&category=' + encodeURIComponent(category) + '&status=' + encodeURIComponent(status);
    var tbody = document.getElementById('inventoryTableBody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="8" class="text-center p-3 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Yükleniyor...</td></tr>';

    fetch(url, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (!tbody) return;
        tbody.innerHTML = '';
        if (res.data && res.data.length > 0) {
            res.data.forEach(function(d) {
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td><strong>' + getCategoryName(d.Category) + '</strong>' + (d.AssetTag ? '<br><small class="text-muted">' + escH(d.AssetTag) + '</small>' : '') + '</td>' +
                    '<td><strong>' + escH((d.Brand || '') + ' ' + (d.Model || '')) + '</strong></td>' +
                    '<td><code class="text-danger">' + escH(d.SerialNumber || '-') + '</code></td>' +
                    '<td>' + escH(d.Location || '-') + (d.RoomNumber ? ' <small class="text-muted">(Oda: ' + escH(d.RoomNumber) + ')</small>' : '') + '</td>' +
                    '<td>' + escH(d.AssignedPerson || '-') + '</td>' +
                    '<td>' + getStatusBadge(d.Status) + '</td>' +
                    '<td>' + (d.IpAddress ? '<code>' + escH(d.IpAddress) + '</code>' : '-') + '</td>' +
                    '<td class="text-right text-nowrap">' +
                        '<button class="btn btn-sm btn-primary mr-1 px-2 py-1" onclick="inspectDiscovered(\'' + escA(d.IpAddress || d.Model) + '\')" title="İncele"><i class="fas fa-search"></i></button>' +
                        '<button class="btn btn-sm btn-warning text-dark mr-1 px-2 py-1" onclick="openEditDeviceModal(' + d.Id + ')" title="Düzenle"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-sm btn-danger px-2 py-1" onclick="deleteInventoryItem(' + d.Id + ')" title="Sil"><i class="fas fa-trash"></i></button>' +
                    '</td>';
                tbody.appendChild(tr);
            });
        } else {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted p-4"><i class="fas fa-inbox fa-2x d-block mb-2"></i>Kayıtlı envanter yok. "Yeni Cihaz Kaydet" veya "Envantere Ekle" butonunu kullanın.</td></tr>';
        }
    })
    .catch(function(e) {
        if (tbody) tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger p-3"><i class="fas fa-exclamation-triangle mr-1"></i>Envanter yüklenemedi: ' + e + '</td></tr>';
    });
}

function deleteInventoryItem(id) {
    if (!confirm('Bu kaydı silmek istediğinize emin misiniz?')) return;
    var body = new URLSearchParams();
    body.append('id', id);
    fetch('@Url.Action("DeleteInventoryDevice", "PCInfo")', {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: body.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.success) {
            showToast('Kayıt silindi.');
            loadInventory();
        } else {
            alert('Silinemedi: ' + (d.message || ''));
        }
    });
}

function downloadInventoryExcel() {
    var search = (document.getElementById('invSearch') ? document.getElementById('invSearch').value : '');
    var cat = (document.getElementById('invCategory') ? document.getElementById('invCategory').value : '');
    var st = (document.getElementById('invStatus') ? document.getElementById('invStatus').value : '');
    window.location.href = '@Url.Action("ExportInventoryExcel", "PCInfo")?search=' + encodeURIComponent(search) + '&category=' + encodeURIComponent(cat) + '&status=' + encodeURIComponent(st);
}

// ===================================================
// YENİ / DÜZENLE CİHAZ MODALI
// ===================================================
function openNewDeviceModal() {
    var devIdEl = document.getElementById('ndDeviceId');
    if (devIdEl) devIdEl.value = '0';
    var titleEl = document.getElementById('ndModalTitle');
    if (titleEl) titleEl.innerText = 'Yeni Cihaz Kaydet';
    ['ndCategory','ndBrand','ndModel','ndSerial','ndIp','ndLocation','ndAssigned','ndAssetTag','ndNotes'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.value = '';
    });
    var catEl = document.getElementById('ndCategory');
    if (catEl) catEl.value = '1';
    var stEl = document.getElementById('ndStatus');
    if (stEl) stEl.value = '1';
    showModalSafe('modalNewDevice');
}

function openEditDeviceModal(id) {
    fetch('@Url.Action("GetDeviceById", "PCInfo")?id=' + id, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (!d || !d.Id) { alert('Kayıt bulunamadı.'); return; }
        document.getElementById('ndDeviceId').value = d.Id;
        document.getElementById('ndModalTitle').innerText = 'Cihaz Düzenle - #' + d.Id;
        document.getElementById('ndCategory').value = d.Category || '1';
        document.getElementById('ndBrand').value = d.Brand || '';
        document.getElementById('ndModel').value = d.Model || '';
        document.getElementById('ndSerial').value = d.SerialNumber || '';
        document.getElementById('ndIp').value = d.IpAddress || '';
        document.getElementById('ndLocation').value = d.Location || '';
        document.getElementById('ndAssigned').value = d.AssignedPerson || '';
        document.getElementById('ndStatus').value = d.Status || '1';
        document.getElementById('ndAssetTag').value = d.AssetTag || '';
        document.getElementById('ndNotes').value = d.Notes || '';
        showModalSafe('modalNewDevice');
    })
    .catch(function(e) { alert('Kayıt yüklenemedi: ' + e); });
}

function submitNewDevice() {
    var btn = document.getElementById('btnSubmitNewDevice');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Kaydediliyor...';
    }
    var device = {
        Id: parseInt(document.getElementById('ndDeviceId').value) || 0,
        Category: parseInt(document.getElementById('ndCategory').value),
        Brand: document.getElementById('ndBrand').value,
        Model: document.getElementById('ndModel').value,
        SerialNumber: document.getElementById('ndSerial').value,
        IpAddress: document.getElementById('ndIp').value,
        Location: document.getElementById('ndLocation').value,
        AssignedPerson: document.getElementById('ndAssigned').value,
        Status: parseInt(document.getElementById('ndStatus').value),
        AssetTag: document.getElementById('ndAssetTag').value,
        Notes: document.getElementById('ndNotes').value
    };
    fetch('@Url.Action("SaveDevice", "PCInfo")', {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(device)
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check mr-1"></i> Kaydet';
        }
        if (data.success) {
            hideModalSafe('modalNewDevice');
            showToast(data.id > 0 ? 'Kaydedildi! ID: ' + data.id : 'Güncellendi!');
            loadInventory();
        } else {
            alert('Hata: ' + data.message);
        }
    })
    .catch(function(e) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check mr-1"></i> Kaydet';
        }
        alert('Hata: ' + e);
    });
}

// ===================================================
// YARDIMCI BİÇİMLENDİRME FONKSİYONLARI
// ===================================================
function getCategoryName(c) {
    var cats = {1:'Masaüstü PC',2:'Laptop',3:'Monitör',4:'IP Kamera',5:'Optik/Pasaport',6:'Parmak İzi',7:'Yazıcı',8:'UPS',9:'Ağ Cihazı',10:'Sunucu'};
    return cats[c] || 'Diğer';
}

function getStatusBadge(s) {
    if (s===1) return '<span class="badge badge-success">Faal</span>';
    if (s===2) return '<span class="badge badge-primary">Depoda</span>';
    if (s===3) return '<span class="badge badge-warning text-dark">Arızalı</span>';
    if (s===4) return '<span class="badge badge-danger">Hurda</span>';
    return '<span class="badge badge-secondary">?</span>';
}

function escH(s) {
    if(!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function escA(s) {
    return String(s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
}

function showToast(msg) {
    var t = document.createElement('div');
    t.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#1e293b;color:#fff;padding:12px 24px;border-radius:8px;z-index:99999;font-size:14px;box-shadow:0 4px 16px rgba(0,0,0,.3);opacity:1;transition:opacity .3s;';
    t.innerHTML = '<i class="fas fa-check-circle text-success mr-2"></i>' + escH(msg);
    document.body.appendChild(t);
    setTimeout(function() {
        t.style.opacity = '0';
        setTimeout(function(){ t.remove(); }, 300);
    }, 2800);
}

// ===================================================
// AKILLI AĞ TARAMASI
// ===================================================
function setScanRange(range) {
    var rangeEl = document.getElementById('scanRangeInput');
    if (rangeEl) rangeEl.value = range;
    runNetworkScan();
}

function runNetworkScan() {
    var rangeEl = document.getElementById('scanRangeInput');
    var timeoutEl = document.getElementById('scanTimeout');
    var range = rangeEl ? rangeEl.value.trim() : '10.7.202.100 - 215';
    var timeout = timeoutEl ? timeoutEl.value : '1000';

    var btn = document.getElementById('btnStartScan');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Taranıyor...';
    }

    var prog = document.getElementById('scanProgressBarArea');
    if (prog) prog.style.display = 'block';
    var resCard = document.getElementById('scanResultsCard');
    if (resCard) resCard.style.display = 'none';

    var body = new URLSearchParams();
    body.append('range', range);
    body.append('timeoutMs', timeout);

    fetch('@Url.Action("ScanNetwork", "PCInfo")', {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: body.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-play mr-1"></i> Taramayı Başlat';
        }
        if (prog) prog.style.display = 'none';
        if (resCard) resCard.style.display = 'block';

        var tbody = document.getElementById('scanTableBody');
        if (tbody) tbody.innerHTML = '';

        var badge = document.getElementById('discoveredBadge');
        if (badge) badge.innerText = (data.count || 0) + ' Aktif Cihaz';

        if (data.devices && data.devices.length > 0) {
            data.devices.forEach(function(d) {
                var tr = document.createElement('tr');
                var btns = '<button class="btn btn-sm btn-primary mr-1 px-2 py-1" onclick="inspectDiscovered(\'' + escA(d.IpAddress) + '\')" title="İncele"><i class="fas fa-search"></i> İncele</button>';
                if (d.DeviceType === 1 || (d.OpenPorts && (d.OpenPorts.indexOf(3389) > -1 || d.OpenPorts.indexOf(135) > -1))) {
                    btns += '<button class="btn btn-sm btn-success mr-1 text-white px-2 py-1" onclick="openRemoteAssistModal(\'' + escA(d.IpAddress) + '\',\'' + escA(d.HostName || d.IpAddress) + '\')" title="Uzaktan Yardım"><i class="fas fa-hands-helping"></i> Uzak Yardım</button>';
                    btns += '<a href="@Url.Action("ConnectRdp", "PCInfo")?ip=' + encodeURIComponent(d.IpAddress) + '" class="btn btn-sm btn-info mr-1 text-white px-2 py-1" title="RDP Bağlantısı"><i class="fas fa-desktop"></i> RDP</a>';
                }
                btns += '<button class="btn btn-sm btn-warning mr-1 text-dark px-2 py-1 font-weight-bold" onclick="openNewDeviceFromScan(\'' + escA(d.IpAddress) + '\',\'' + escA(d.HostName || '') + '\',' + d.DeviceType + ',\'' + escA(d.Details || '') + '\')" title="Envantere Kaydet"><i class="fas fa-plus"></i> Envantere Ekle</button>';
                tr.innerHTML = '<td><i class="' + escH(d.DeviceIcon) + ' mr-2"></i><strong>' + escH(d.DeviceTypeDisplay) + '</strong></td>' +
                    '<td><code>' + escH(d.IpAddress) + '</code></td><td>' + escH(d.HostName || '-') + '</td>' +
                    '<td><span class="badge badge-light border">' + d.ResponseTimeMs + ' ms</span></td>' +
                    '<td><small class="text-muted">' + escH(d.Details || 'Online') + '</small></td>' +
                    '<td class="text-right text-nowrap">' + btns + '</td>';
                if (tbody) tbody.appendChild(tr);
            });
        } else {
            if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted p-3"><i class="fas fa-info-circle mr-1"></i> Bu IP aralığında açık cihaz bulunamadı. Lütfen yukarıdaki "Kameralar" veya "Gişe PC\'leri" butonlarına tıklayarak tekrar deneyin.</td></tr>';
        }
    })
    .catch(function(e) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-play mr-1"></i> Taramayı Başlat';
        }
        if (prog) prog.style.display = 'none';
        alert('Tarama hatası: ' + e);
    });
}

function openNewDeviceFromScan(ip, hostname, deviceType, details) {
    var devIdEl = document.getElementById('ndDeviceId');
    if (devIdEl) devIdEl.value = '0';
    var titleEl = document.getElementById('ndModalTitle');
    if (titleEl) titleEl.innerText = 'Keşfedilen Cihazı Envantere Kaydet (' + ip + ')';
    
    // Kategori eşleme: 1:PC, 2:Kamera, 3:Yazıcı, 4:Switch
    var catMap = { 1: 1, 2: 4, 3: 7, 4: 9, 0: 99 };
    var cat = catMap[deviceType] || 1;

    document.getElementById('ndCategory').value = cat;
    document.getElementById('ndBrand').value = (deviceType === 2) ? 'Hikvision' : '';
    document.getElementById('ndModel').value = hostname || '';
    document.getElementById('ndSerial').value = 'IP:' + ip;
    document.getElementById('ndIp').value = ip;
    document.getElementById('ndLocation').value = 'Hudut Kapısı / Gişe';
    document.getElementById('ndAssigned').value = '';
    document.getElementById('ndStatus').value = '1';
    document.getElementById('ndAssetTag').value = 'GZP-' + ip.replace(/\./g, '-');
    document.getElementById('ndNotes').value = details || 'Ağ tarayıcısı ile otomatik keşfedildi.';

    showModalSafe('modalNewDevice');
}

function saveScanItemToInventory(ip, hostname, deviceType, details) {
    openNewDeviceFromScan(ip, hostname, deviceType, details);
}

function inspectDiscovered(ip) {
    var f = document.createElement('form');
    f.method = 'get';
    f.action = '@Url.Action("Index", "PCInfo")';
    var i = document.createElement('input');
    i.type = 'hidden';
    i.name = 'target';
    i.value = ip;
    f.appendChild(i);
    document.body.appendChild(f);
    f.submit();
}

