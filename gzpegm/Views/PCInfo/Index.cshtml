// TEKİL İZLEME (FOKUS & DONANIM TEFTİŞİ)
// ----------------------------------------------------
function populateSingleCamSelect() {
    var sel = document.getElementById('cctvSingleCamSelect');
    if (!sel) return;
    sel.innerHTML = '';
    CCTV_CAMERAS.forEach(function(cam, idx) {
        var opt = document.createElement('option');
        opt.value = idx;
        opt.text = cam.badge + ': ' + cam.name + ' (' + cam.ip + ')';
        sel.appendChild(opt);
    });
}

function loadSingleCameraView(index) {
    if (index < 0) index = CCTV_CAMERAS.length - 1;
    if (index >= CCTV_CAMERAS.length) index = 0;
    _cctvFocusedIndex = index;

    var cam = CCTV_CAMERAS[index];
    if (!cam) return;

    var badgeEl = document.getElementById('cctvSingleBadge');
    var titleEl = document.getElementById('cctvSingleTitle');
    var selectEl = document.getElementById('cctvSingleCamSelect');
    var specName = document.getElementById('cctvSpecName');
    var specIpCh = document.getElementById('cctvSpecIpChannel');
    var specRtsp = document.getElementById('cctvSpecRtsp');
    var rtspInput = document.getElementById('rtspCopyInput');
    var btnRtsp = document.getElementById('btnSingleRtsp');

    if (badgeEl) badgeEl.innerText = cam.badge;
    if (titleEl) titleEl.innerText = cam.name + ' (' + cam.ip + ')';
    if (selectEl) selectEl.value = index;

    if (specName) specName.innerText = cam.badge + ' - ' + cam.name;
    if (specIpCh) specIpCh.innerText = 'IP: ' + cam.ip + ' | NVR Kanalı: ' + cam.channel;
    
    var rtspUrl = buildRtspUrl(cam);
    if (specRtsp) specRtsp.innerText = rtspUrl;
    if (rtspInput) rtspInput.value = rtspUrl;
    if (btnRtsp) btnRtsp.href = rtspUrl;

    refreshSingleCamSnapshot();
    queryFocusedCameraHardware();
}

function onSingleCamSelectChanged(val) {
    var idx = parseInt(val) || 0;
    loadSingleCameraView(idx);
}

function navSingleCam(delta) {
    loadSingleCameraView(_cctvFocusedIndex + delta);
}

function focusCameraByIndex(index) {
    _cctvFocusedIndex = index;
    switchCctvSubMode('single');
    loadSingleCameraView(index);
}

function focusCameraByPreset(ip, port, channel, name, badge) {
    var foundIdx = CCTV_CAMERAS.findIndex(function(c) { return c.ip === ip; });
    if (foundIdx > -1) {
        focusCameraByIndex(foundIdx);
    } else {
        switchCctvSubMode('single');
        var badgeEl = document.getElementById('cctvSingleBadge');
        var titleEl = document.getElementById('cctvSingleTitle');
        if (badgeEl) badgeEl.innerText = badge || 'CAM';
        if (titleEl) titleEl.innerText = name + ' (' + ip + ')';

        var cam = { id: 99, badge: badge || 'CAM', name: name, ip: ip, channel: channel };
        var rtspUrl = buildRtspUrl(cam);
        document.getElementById('cctvSpecName').innerText = name;
        document.getElementById('cctvSpecIpChannel').innerText = 'IP: ' + ip + ' | Kanal: ' + channel;
        document.getElementById('cctvSpecRtsp').innerText = rtspUrl;
        document.getElementById('rtspCopyInput').value = rtspUrl;
        document.getElementById('btnSingleRtsp').href = rtspUrl;

        var snapUrl = buildSnapshotUrl(ip, channel);
        var sImg = document.getElementById('cctvSingleImg');
        if (sImg) sImg.src = snapUrl;
        queryFocusedCameraHardware(ip, port);
    }
}

function refreshSingleCamSnapshot() {
    var cam = CCTV_CAMERAS[_cctvFocusedIndex];
    if (!cam) return;
    var snapEl = document.getElementById('cctvSingleImg');
    var timeEl = document.getElementById('cctvSingleTime');
    var dlEl = document.getElementById('btnSingleDownload');
    var url = buildSnapshotUrl(cam.ip, cam.channel);

    if (snapEl) snapEl.src = url;
    if (timeEl) timeEl.innerText = 'Son Kare: ' + new Date().toLocaleTimeString('tr-TR');
    if (dlEl) dlEl.href = url;
}

function toggleSingleAutoLive() {
    var btn = document.getElementById('btnSingleAutoLive');
    _cctvSingleLiveRunning = !_cctvSingleLiveRunning;

    if (_cctvSingleLiveRunning) {
        if (btn) {
            btn.className = 'btn btn-sm btn-primary text-white mr-2';
            btn.innerHTML = '<i class="fas fa-stop mr-1"></i> Durdur';
        }
        refreshSingleCamSnapshot();
        _cctvSingleTimer = setInterval(refreshSingleCamSnapshot, _cctvInterval);
    } else {
        if (btn) {
            btn.className = 'btn btn-sm btn-outline-primary mr-2';
            btn.innerHTML = '<i class="fas fa-clock mr-1"></i> Otomatik Yenile (' + (_cctvInterval/1000) + ' sn)';
        }
        clearInterval(_cctvSingleTimer);
    }
}

function queryFocusedCameraHardware(customIp, customPort) {
    var cam = CCTV_CAMERAS[_cctvFocusedIndex];
    var targetIp = customIp || (cam ? cam.ip : '10.7.202.201');
    var targetPort = customPort || _cctvMasterCreds.port || 80;
    var creds = _cctvMasterCreds;

    var btnQuery = document.getElementById('btnQuerySingleCam');
    if (btnQuery) {
        btnQuery.disabled = true;
        btnQuery.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Teftiş Ediliyor...';
    }

    var body = new URLSearchParams();
    body.append('ip', targetIp);
    body.append('port', targetPort);
    body.append('username', creds.user || 'admin');
    body.append('password', creds.pass || '');

    fetch('@Url.Action("QueryCamera", "PCInfo")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: body.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (btnQuery) {
            btnQuery.disabled = false;
            btnQuery.innerHTML = '<i class="fas fa-microchip mr-1"></i> ISAPI Donanım Teftişi Yap';
        }
        document.getElementById('cctvSpecModel').innerText = res.Model || '-';
        document.getElementById('cctvSpecSerial').innerText = res.SerialNumber || '-';
        document.getElementById('cctvSpecMac').innerText = res.MacAddress || '-';
        document.getElementById('cctvSpecFirmware').innerText = res.FirmwareVersion || '-';

        var badge = document.getElementById('cctvSingleOnlineBadge');
        if (badge) {
            if (res.IsOnline) {
                badge.className = 'badge badge-success';
                badge.innerText = 'Çevrimiçi (ISAPI Bağlantılı)';
            } else {
                badge.className = 'badge badge-danger';
                badge.innerText = 'Kameraya Ulaşılamadı';
            }
        }
    })
    .catch(function(e) {
        if (btnQuery) {
            btnQuery.disabled = false;
            btnQuery.innerHTML = '<i class="fas fa-microchip mr-1"></i> ISAPI Donanım Teftişi Yap';
        }
    });
}

function copyRtspUrl() {
    copyToClipboard('rtspCopyInput');
}

function toggleFullscreenSingle() {
    var elem = document.getElementById('cctvSingleDisplayWrapper');
    if (!elem) return;
    if (!document.fullscreenElement) {
        if (elem.requestFullscreen) elem.requestFullscreen();
        else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
        else if (elem.msRequestFullscreen) elem.msRequestFullscreen();
    } else {
        if (document.exitFullscreen) document.exitFullscreen();
    }
}

function initCctvSystem() {
    getCctvMasterCreds();
    populateSingleCamSelect();
    renderCctvGrid();
}

// Geriye Dönük Uyumluluk Fonksiyonları (Legacy Destek)
function saveCameraCredentials(ip, user, pass, port) {
    _cctvMasterCreds = { nvrIp: ip, port: port || 80, user: user || 'admin', pass: pass || '' };
    localStorage.setItem('gzp_cctvMasterCreds', JSON.stringify(_cctvMasterCreds));
}
function loadCameraCredentials(ip) { getCctvMasterCreds(); return true; }
function renderSavedCameras() { getCctvMasterCreds(); }
function clearSavedCameras() { localStorage.removeItem('gzp_cctvMasterCreds'); }
function refreshSnapshot() { refreshSingleCamSnapshot(); }
function toggleAutoRefresh() { toggleSingleAutoLive(); }
function queryHikCamera() { queryFocusedCameraHardware(); }
function selectPresetCam(ip, port, channel, name) { focusCameraByPreset(ip, port, channel, name, 'CAM'); }

