@model gzpegm.Models.E_Defter

@{
                /**/

                Layout = "~/Views/Shared/_Master.cshtml";
}
<section class="card">
    <form method="post" action="/UpdateDefter">
        <header class="card-header">
            <h2 class="card-title">Defter Bedeli</h2>
        </header>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="PriceDef">Tutar</label>
                    <input type="text" onchange="fiyat(elem)" class="form-control" id="PriceDef" value="@Model.fldPrice" name="PriceDef" required>
                </div>
                <div class="form-group col-md-6">
                    <label for="tomDef">Para Cinsi</label>
                    <select name="tomDef" id="tomDef" data-plugin-selectTwo class="form-control populate" required>
                        @{
                            if (Model.fldTypeofMoney.Trim() == "TRY")
                            {
                                <option selected value="TRY">Türk Lirası</option>
                            }
                            else
                            {
                                <option value="TRY">Türk Lirası</option>
                            }
                            if (Model.fldTypeofMoney.Trim() == "EUR")
                            {
                                <option selected value="EUR">Avro</option>
                            }
                            else
                            {
                                <option value="EUR">Avro</option>
                            }
                            if (Model.fldTypeofMoney.Trim() == "USD")
                            {
                                <option selected value="USD">Amerikan Doları</option>
                            }
                            else
                            {
                                <option value="USD">Amerikan Doları</option>
                            }
                        }


                    </select>
                </div>
            </div>
        </div>
        <footer class="card-footer">
            <div class="row">
                <div class="col-md-12 text-right">
                    <button type="submit" name="submit" value="Submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </footer>
    </form>
</section>

