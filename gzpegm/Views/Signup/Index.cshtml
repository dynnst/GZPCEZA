@model IEnumerable<gzpegm.Models.E_Border>
@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Kullanıcı Kayıt Talebi - Emniyet Eğitim Sistemi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="@Url.Content("~/files/logo/favicon-egm-32.png")" type="image/x-icon">
    <link rel="stylesheet" href="@Url.Content("~/vendor/bootstrap/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/vendor/font-awesome/css/fontawesome-all.min.css")" />

    <style>
        :root {
            --night-0: #020817;
            --night-1: #071426;
            --night-2: #102a43;
            --glass-border: rgba(255, 255, 255, .18);
            --gold: #f7c873;
            --cyan: #52d7ff;
            --green: #35f0a1;
            --red: #ff6b7f;
            --text-soft: rgba(255, 255, 255, .72);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Arial, Helvetica, sans-serif;
            color: #fff;
            background: var(--night-0);
        }

        body {
            overflow-x: hidden;
        }

        .register-scene {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 34px 18px;
            background:
                radial-gradient(circle at 14% 18%, rgba(82, 215, 255, .16), transparent 31%),
                radial-gradient(circle at 86% 14%, rgba(247, 200, 115, .16), transparent 34%),
                linear-gradient(135deg, #010510 0%, #071426 45%, #112b43 100%);
        }

        .bgvid {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .48;
            filter: saturate(1.08) contrast(1.08) brightness(.70);
            transform: scale(1.025);
            z-index: 0;
        }

        .scene-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background:
                linear-gradient(90deg, rgba(1, 5, 16, .90) 0%, rgba(1, 5, 16, .52) 42%, rgba(1, 5, 16, .88) 100%),
                radial-gradient(circle at 50% 48%, transparent 0%, rgba(0, 0, 0, .46) 72%);
        }

        .scene-overlay::before {
            content: "";
            position: absolute;
            inset: -18%;
            background:
                conic-gradient(from 145deg at 48% 54%, transparent 0 18%, rgba(82, 215, 255, .14) 21%, transparent 29% 54%, rgba(247, 200, 115, .12) 58%, transparent 68% 100%);
            animation: slowSweep 18s linear infinite;
            opacity: .72;
            will-change: transform;
        }

        .scene-overlay::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, .025) 1px, transparent 1px);
            background-size: 52px 52px;
            mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 82%, transparent);
            animation: gridDrift 12s ease-in-out infinite alternate;
            will-change: transform, opacity;
        }

        .cinema-beam {
            position: absolute;
            top: -40%;
            left: -28%;
            width: 44%;
            height: 190%;
            transform: rotate(22deg);
            z-index: 2;
            pointer-events: none;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .15), transparent);
            filter: blur(20px);
            animation: lightPass 8.5s ease-in-out infinite;
            will-change: transform, opacity;
        }

        .security-frame {
            position: absolute;
            inset: 24px;
            z-index: 2;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, .10);
            border-radius: 28px;
            box-shadow: inset 0 0 70px rgba(82, 215, 255, .06);
        }

        .security-frame::before,
        .security-frame::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            border-color: rgba(247, 200, 115, .55);
            border-style: solid;
        }

        .security-frame::before {
            top: -1px;
            left: -1px;
            border-width: 2px 0 0 2px;
            border-top-left-radius: 28px;
        }

        .security-frame::after {
            right: -1px;
            bottom: -1px;
            border-width: 0 2px 2px 0;
            border-bottom-right-radius: 28px;
        }

        .register-shell {
            position: relative;
            z-index: 5;
            width: min(1160px, 100%);
            display: grid;
            grid-template-columns: .9fr 560px;
            gap: 34px;
            align-items: center;
        }

        .hero-copy {
            padding: 28px;
            text-shadow: 0 10px 34px rgba(0, 0, 0, .46);
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 13px;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 999px;
            color: rgba(255, 255, 255, .82);
            background: rgba(255, 255, 255, .06);
            letter-spacing: .12em;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            backdrop-filter: blur(10px);
        }

        .eyebrow i {
            color: var(--gold);
        }

        .hero-copy h1 {
            margin: 24px 0 14px;
            font-size: clamp(34px, 4.8vw, 58px);
            line-height: .98;
            font-weight: 800;
            letter-spacing: -.055em;
        }

        .hero-copy h1 span {
            display: block;
            color: var(--gold);
        }

        .hero-copy p {
            max-width: 570px;
            margin: 0;
            color: var(--text-soft);
            font-size: 16px;
            line-height: 1.75;
        }

        .status-strip {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 28px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 13px;
            border-radius: 14px;
            background: rgba(1, 10, 23, .56);
            border: 1px solid rgba(255, 255, 255, .11);
            color: rgba(255, 255, 255, .76);
            backdrop-filter: blur(10px);
            font-size: 12px;
            font-weight: 600;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 18px rgba(53, 240, 161, .8);
        }

        .register-card {
            position: relative;
            overflow: hidden;
            padding: 28px;
            border-radius: 26px;
            background: linear-gradient(145deg, rgba(7, 18, 35, .92), rgba(7, 18, 35, .82));
            border: 1px solid var(--glass-border);
            box-shadow:
                0 28px 90px rgba(0, 0, 0, .52),
                inset 0 1px 0 rgba(255, 255, 255, .16);
            transform: translateZ(0);
            isolation: isolate;
        }

        .register-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(120deg, rgba(255, 255, 255, .17), transparent 26%),
                radial-gradient(circle at 92% 8%, rgba(82, 215, 255, .16), transparent 34%);
            pointer-events: none;
        }

        .register-card::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--cyan), var(--gold), transparent);
            animation: scanTop 4s ease-in-out infinite;
        }

        .card-content {
            position: relative;
            z-index: 1;
        }

        .brand-mark {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 18px;
        }

        .brand-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-emblem {
            width: 54px;
            height: 54px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            background: linear-gradient(145deg, rgba(247, 200, 115, .22), rgba(82, 215, 255, .10));
            border: 1px solid rgba(247, 200, 115, .36);
            box-shadow: 0 14px 28px rgba(0, 0, 0, .24);
        }

        .brand-emblem i {
            color: var(--gold);
            font-size: 22px;
        }

        .brand-text small {
            display: block;
            color: rgba(255, 255, 255, .58);
            font-size: 11px;
            letter-spacing: .10em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .brand-text strong {
            display: block;
            font-size: 18px;
            line-height: 1.15;
        }

        .back-login {
            color: rgba(255, 255, 255, .76);
            background: rgba(255, 255, 255, .07);
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 13px;
            padding: 10px 12px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            transition: transform .18s ease, background .18s ease, border-color .18s ease;
        }

        .back-login:hover,
        .back-login:focus {
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
            background: rgba(82, 215, 255, .12);
            border-color: rgba(82, 215, 255, .34);
            outline: none;
        }

        .register-title {
            margin-bottom: 18px;
        }

        .register-title h2 {
            margin: 0;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -.03em;
        }

        .register-title p {
            margin: 7px 0 0;
            color: rgba(255, 255, 255, .62);
            font-size: 13px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-field {
            margin-bottom: 0;
        }

        .form-field.full {
            grid-column: 1 / -1;
        }

        .form-field label {
            display: block;
            margin-bottom: 7px;
            color: rgba(255, 255, 255, .70);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .02em;
        }

        .input-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 48px;
            padding: 0 14px;
            border-radius: 15px;
            background: rgba(0, 0, 0, .28);
            border: 1px solid rgba(255, 255, 255, .13);
            transition: border-color .18s ease, box-shadow .18s ease;
            will-change: border-color, box-shadow;
        }

        .input-wrap:focus-within {
            border-color: rgba(82, 215, 255, .60);
            box-shadow: 0 0 0 4px rgba(82, 215, 255, .10);
        }

        .input-wrap i {
            color: rgba(255, 255, 255, .62);
            width: 18px;
            text-align: center;
        }

        .form-control,
        select.form-control {
            height: 48px;
            width: 100%;
            padding: 0;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 14px;
            box-shadow: none;
        }

        select.form-control option {
            color: #071426;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, .44);
        }

        .form-control:focus {
            background: transparent;
            color: #fff;
            box-shadow: none;
            outline: none;
        }

        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 16px 0 14px;
            color: rgba(255, 255, 255, .72);
            font-size: 13px;
            line-height: 1.45;
        }

        .terms-row input {
            margin-top: 3px;
            accent-color: var(--gold);
        }

        .terms-row a {
            color: #ffe2a6;
            text-decoration: none;
            border-bottom: 1px solid rgba(255, 226, 166, .35);
        }

        .btn-register {
            position: relative;
            width: 100%;
            border: none;
            border-radius: 16px;
            overflow: hidden;
            padding: 14px 18px;
            color: #071426;
            font-size: 15px;
            font-weight: 900;
            letter-spacing: .08em;
            background: linear-gradient(135deg, #ffe2a6, #f7c873 48%, #d99843);
            box-shadow: 0 16px 34px rgba(247, 200, 115, .22);
            cursor: pointer;
            transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
        }

        .btn-register::after {
            content: "";
            position: absolute;
            inset: 0;
            transform: translateX(-120%);
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .55), transparent);
            transition: transform .55s ease;
        }

        .btn-register:hover,
        .btn-register:focus {
            transform: translateY(-2px);
            box-shadow: 0 22px 44px rgba(247, 200, 115, .30);
            filter: brightness(1.04);
            outline: none;
        }

        .btn-register:hover::after,
        .btn-register:focus::after {
            transform: translateX(120%);
        }

        .message-box {
            min-height: 24px;
            margin-top: 14px;
            text-align: center;
            font-size: 13px;
            font-weight: 800;
        }

        .message-box .error {
            color: var(--red);
        }

        .message-box .success {
            color: var(--green);
        }

        .system-note {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, .10);
            color: rgba(255, 255, 255, .50);
            font-size: 11px;
            line-height: 1.5;
            text-align: center;
        }

        @@keyframes slowSweep {
            0% { transform: rotate(0deg) scale(1); }
            100% { transform: rotate(360deg) scale(1); }
        }

        @@keyframes lightPass {
            0%, 18% { transform: translateX(-30%) rotate(22deg); opacity: 0; }
            40%, 56% { opacity: .75; }
            100% { transform: translateX(340%) rotate(22deg); opacity: 0; }
        }

        @@keyframes gridDrift {
            from { transform: translate3d(0, 0, 0); opacity: .45; }
            to { transform: translate3d(18px, 14px, 0); opacity: .70; }
        }

        @@keyframes scanTop {
            0%, 100% { opacity: .35; transform: scaleX(.45); }
            50% { opacity: 1; transform: scaleX(1); }
        }

        @@media (max-width: 1040px) {
            .register-scene {
                align-items: flex-start;
                padding-top: 28px;
                padding-bottom: 28px;
            }

            .register-shell {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .hero-copy {
                padding: 10px 4px;
                text-align: center;
            }

            .hero-copy p {
                margin-left: auto;
                margin-right: auto;
            }

            .status-strip {
                justify-content: center;
            }

            .register-card {
                width: min(560px, 100%);
                margin: 0 auto;
            }
        }

        @@media (max-width: 620px) {
            .security-frame {
                inset: 12px;
                border-radius: 20px;
            }

            .register-card {
                padding: 22px;
                border-radius: 22px;
            }

            .brand-mark {
                align-items: flex-start;
                flex-direction: column;
            }

            .back-login {
                width: 100%;
                text-align: center;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
            }
        }
    </style>
</head>
<body>
    <main class="register-scene">
        <video class="bgvid" autoplay muted loop playsinline preload="metadata" poster="@Url.Content("~/img/bayrak3.jpg")">
            <source src="@Url.Content("~/files/girisvideo.mp4")" type="video/mp4">
        </video>

        <div class="scene-overlay"></div>
        <div class="cinema-beam"></div>
        <div class="security-frame"></div>

        <section class="register-shell" aria-label="Kullanıcı kayıt talebi ekranı">
            <div class="hero-copy">
                <div class="eyebrow">
                    <i class="fas fa-user-shield"></i>
                    Yetkili kullanıcı talebi
                </div>
                <h1>
                    Güvenli erişim için
                    <span>kayıt talebi oluşturun.</span>
                </h1>
                <p>
                    Kayıt talebiniz yönetici onayına gönderilir. Hesabınız aktif edildiğinde sisteme sicil numaranız ve şifrenizle giriş yapabilirsiniz.
                </p>
                <div class="status-strip" aria-hidden="true">
                    <span class="status-pill"><span class="status-dot"></span> Yönetici onaylı süreç</span>
                    <span class="status-pill"><i class="fas fa-envelope"></i> EGM e-posta zorunlu</span>
                    <span class="status-pill"><i class="fas fa-map-marker-alt"></i> Sınır kapısı bilgisi</span>
                </div>
            </div>

            <div class="register-card">
                <div class="card-content">
                    <div class="brand-mark">
                        <div class="brand-left">
                            <div class="brand-emblem">
                                <i class="fas fa-id-card"></i>
                            </div>
                            <div class="brand-text">
                                <small>Emniyet Eğitim Sistemi</small>
                                <strong>Kullanıcı Kayıt Talebi</strong>
                            </div>
                        </div>
                        <a href="@Url.Content("~/giris")" class="back-login">
                            <i class="fas fa-sign-in-alt"></i> Giriş Yap
                        </a>
                    </div>

                    <div class="register-title">
                        <h2>Kayıt Ol</h2>
                        <p>Bilgilerinizi eksiksiz doldurun; talep yönetici onayına düşecektir.</p>
                    </div>

                    <form action="@Url.Content("~/signup")" method="post" autocomplete="on">
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="sicil">Sicil No</label>
                                <div class="input-wrap">
                                    <i class="fas fa-hashtag"></i>
                                    <input id="sicil" name="sicil" type="text"
                                           class="form-control"
                                           placeholder="6 haneli sicil"
                                           required
                                           pattern="\d{6}"
                                           maxlength="6"
                                           autocomplete="username"
                                           oninput="this.value=this.value.replace(/[^0-9]/g,'');"
                                           title="Lütfen 6 haneli sicil numarası giriniz." />
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="phone">Telefon</label>
                                <div class="input-wrap">
                                    <i class="fas fa-phone"></i>
                                    <input id="phone" name="phone" type="text" class="form-control" placeholder="Telefon" required autocomplete="tel" />
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="name">Adı</label>
                                <div class="input-wrap">
                                    <i class="fas fa-user"></i>
                                    <input id="name" name="name" type="text" class="form-control" placeholder="Adınız" required autocomplete="given-name" />
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="lastname">Soyadı</label>
                                <div class="input-wrap">
                                    <i class="fas fa-user"></i>
                                    <input id="lastname" name="lastname" type="text" class="form-control" placeholder="Soyadınız" required autocomplete="family-name" />
                                </div>
                            </div>

                            <div class="form-field full">
                                <label for="email">E-posta</label>
                                <div class="input-wrap">
                                    <i class="fas fa-envelope"></i>
                                    <input id="email" name="email" type="email"
                                           class="form-control"
                                           placeholder="ornek@egm.gov.tr"
                                           required
                                           autocomplete="email"
                                           pattern="[a-zA-Z0-9._%+-]+&#64;egm\.gov\.tr$"
                                           title="Lütfen &#64;egm.gov.tr uzantılı bir e-posta giriniz." />
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="title">Ünvan</label>
                                <div class="input-wrap">
                                    <i class="fas fa-star"></i>
                                    <select id="title" name="title" class="form-control" required>
                                        <option value="">Lütfen Ünvan Seçiniz</option>
                                        <option selected value="Grup Amiri">Grup Amiri</option>
                                        <option value="Grup Amir V.">Grup Amir V.</option>
                                        <option value="Büro Amiri">Büro Amiri</option>
                                        <option value="Büro Amir V.">Büro Amir V.</option>
                                        <option value="Komiser">Komiser</option>
                                        <option value="Komiser Yardımcısı">Komiser Yardımcısı</option>
                                        <option value="Başkomiser">Başkomiser</option>
                                        <option value="Polis Memuru">Polis Memuru</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="deputy">Sınır Kapısı</label>
                                <div class="input-wrap">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <select id="deputy" name="deputy" class="form-control" required>
                                        <option value="">Lütfen Seçiniz</option>
                                        @foreach (var data in Model)
                                        {
                                            <option value="@data.fldName">@data.fldName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="terms-row">
                            <input id="AgreeTerms" name="agreeterms" type="checkbox" required />
                            <label for="AgreeTerms"><a href="@Url.Content("~/kosullar")" target="_blank">Kullanım koşullarını</a> kabul ediyorum.</label>
                        </div>

                        <button id="submit" type="submit" class="btn-register">
                            KAYIT TALEBİ GÖNDER
                        </button>
                    </form>

                    <div class="message-box">
                        @if (ViewBag.Error != null)
                        {
                            <div class="error">@ViewBag.Error</div>
                        }
                        @if (ViewBag.Success != null)
                        {
                            <div class="success">@ViewBag.Success</div>
                        }
                    </div>

                    <div class="system-note">
                        &copy; @DateTime.Now.Year Bütün hakları saklıdır. Kayıt talepleri yönetici kontrolünden sonra aktif edilir.
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/vendor/jquery/jquery.js")"></script>
    <script src="@Url.Content("~/vendor/bootstrap/js/bootstrap.js")"></script>
    <script type="text/javascript">
        $(function () {
            var isClicked = false;
            $('#submit').on('click', function () {
                if (isClicked) {
                    return false;
                }
                isClicked = true;
            });

            // Telefon numarasına otomatik 0 ekleme
            $('#phone').on('input', function () {
                var value = $(this).val().replace(/[^0-9]/g, ''); // Sadece rakamları al

                // Eğer değer boş değilse ve 0 ile başlamıyorsa, 0 ekle
                if (value && !value.startsWith('0')) {
                    value = '0' + value;
                }

                $(this).val(value);
            });

            // Paste event'i için de aynı işlem
            $('#phone').on('paste', function () {
                var self = $(this);
                setTimeout(function () {
                    var value = self.val().replace(/[^0-9]/g, '');
                    if (value && !value.startsWith('0')) {
                        value = '0' + value;
                    }
                    self.val(value);
                }, 10);
            });
        });
    </script>
</body>
</html>
