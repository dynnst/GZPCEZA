@section Scripts {
    <script>
        $(function () {
            var pageSize = 6;
            var currentPage = 1;
            var currentSearch = '';
            var currentCourse = '';
            var currentStatus = 'all';

            var $cardItems = $('.exam-card-wrapper');
            var $tableRows = $('.exam-table-row');

            function applyFilterAndPagination() {
                var visibleCards = [];
                var visibleRows = [];

                $cardItems.each(function () {
                    var $card = $(this);
                    var text = $card.attr('data-search') || '';
                    var course = $card.attr('data-course') || '';
                    var status = $card.attr('data-status') || '';

                    var matchSearch = !currentSearch || text.indexOf(currentSearch) >= 0;
                    var matchCourse = !currentCourse || course.toLowerCase() === currentCourse.toLowerCase();
                    var matchStatus = currentStatus === 'all' || status === currentStatus;

                    if (matchSearch && matchCourse && matchStatus) {
                        visibleCards.push($card);
                    } else {
                        $card.hide();
                    }
                });

                $tableRows.each(function () {
                    var $row = $(this);
                    var text = $row.attr('data-search') || '';
                    var course = $row.attr('data-course') || '';
                    var status = $row.attr('data-status') || '';

                    var matchSearch = !currentSearch || text.indexOf(currentSearch) >= 0;
                    var matchCourse = !currentCourse || course.toLowerCase() === currentCourse.toLowerCase();
                    var matchStatus = currentStatus === 'all' || status === currentStatus;

                    if (matchSearch && matchCourse && matchStatus) {
                        visibleRows.push($row);
                    } else {
                        $row.hide();
                    }
                });

                var totalVisible = visibleCards.length;
                $('#examEmptyAlert').toggleClass('d-none', totalVisible > 0);

                var totalPages = Math.max(1, Math.ceil(totalVisible / pageSize));
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                var startIndex = (currentPage - 1) * pageSize;
                var endIndex = startIndex + pageSize;

                // Kartları sayfala
                for (var i = 0; i < visibleCards.length; i++) {
                    if (i >= startIndex && i < endIndex) {
                        visibleCards[i].show();
                    } else {
                        visibleCards[i].hide();
                    }
                }

                // Tablo satırlarını sayfala
                for (var j = 0; j < visibleRows.length; j++) {
                    if (j >= startIndex && j < endIndex) {
                        visibleRows[j].show();
                    } else {
                        visibleRows[j].hide();
                    }
                }

                renderPaginationControls(totalPages, totalVisible);
            }

            function renderPaginationControls(totalPages, totalCount) {
                var $wrap = $('#examPagination');
                $wrap.empty();

                if (totalCount <= pageSize) return;

                $('<button type="button" class="exam-page-btn">‹</button>')
                    .prop('disabled', currentPage === 1)
                    .on('click', function () {
                        if (currentPage > 1) {
                            currentPage--;
                            applyFilterAndPagination();
                        }
                    })
                    .appendTo($wrap);

                for (var p = 1; p <= totalPages; p++) {
                    $('<button type="button" class="exam-page-btn"></button>')
                        .text(p)
                        .toggleClass('active', p === currentPage)
                        .on('click', (function (pageNum) {
                            return function () {
                                currentPage = pageNum;
                                applyFilterAndPagination();
                            };
                        })(p))
                        .appendTo($wrap);
                }

                $('<button type="button" class="exam-page-btn">›</button>')
                    .prop('disabled', currentPage === totalPages)
                    .on('click', function () {
                        if (currentPage < totalPages) {
                            currentPage++;
                            applyFilterAndPagination();
                        }
                    })
                    .appendTo($wrap);
            }

            // Arama ve Filtre Dinleyicileri
            $('#examSearchInput').on('input', function () {
                currentSearch = ($(this).val() || '').toLocaleLowerCase('tr-TR').trim();
                $('#clearSearchWrap').toggle(currentSearch.length > 0);
                currentPage = 1;
                applyFilterAndPagination();
            });

            $('#btnClearSearch').on('click', function () {
                $('#examSearchInput').val('');
                currentSearch = '';
                $(this).parent().hide();
                currentPage = 1;
                applyFilterAndPagination();
            });

            $('#courseFilter').on('change', function () {
                currentCourse = $(this).val() || '';
                currentPage = 1;
                applyFilterAndPagination();
            });

            $('input[name="statusFilter"]').on('change', function () {
                currentStatus = $(this).val();
                currentPage = 1;
                applyFilterAndPagination();
            });

            // Görünüm Değiştirici (Kart vs Tablo)
            $('#btnViewCards').on('click', function () {
                $(this).addClass('active');
                $('#btnViewTable').removeClass('active');
                $('#examCardsView').show();
                $('#examTableView').hide();
            });

            $('#btnViewTable').on('click', function () {
                $(this).addClass('active');
                $('#btnViewCards').removeClass('active');
                $('#examCardsView').hide();
                $('#examTableView').show();
            });

            // Sınav Durumunu Değiştirme (AJAX Toggle)
            $(document).on('click', '.btn-toggle-status-badge', function (e) {
                e.preventDefault();
                var btn = $(this);
                var examId = btn.data('id');
                var token = $('input[name="__RequestVerificationToken"]').first().val();

                btn.prop('disabled', true);

                $.post('@Url.Action("ToggleStatus", "Exam")', {
                    id: examId,
                    __RequestVerificationToken: token
                })
                .done(function (res) {
                    btn.prop('disabled', false);
                    if (res && res.success) {
                        var isActive = res.isActive;
                        var newStatus = isActive ? 'active' : 'passive';
                        var newText = isActive ? 'Aktif' : 'Pasif';

                        $('[data-id="' + examId + '"].btn-toggle-status-badge').each(function () {
                            var el = $(this);
                            el.removeClass('badge-status-active badge-status-passive btn-success btn-secondary')
                              .addClass(isActive ? 'badge-status-active' : 'badge-status-passive');
                            el.find('i').removeClass('fa-check fa-check-circle fa-ban')
                              .addClass(isActive ? 'fa-check-circle' : 'fa-ban');
                            el.find('.status-label').text(newText);
                        });

                        $('.exam-card-wrapper[data-search*="' + examId + '"], .exam-table-row[data-search*="' + examId + '"]').each(function () {
                            $(this).attr('data-status', newStatus);
                        });

                        applyFilterAndPagination();
                    } else {
                        alert((res && res.message) ? res.message : 'Durum değiştirilemedi.');
                    }
                })
                .fail(function () {
                    btn.prop('disabled', false);
                    alert('Sunucuyla iletişim kurulamadı.');
                });
            });

            // Tek Düzenleme Modalı Açılışı (AJAX ile GetExam)
            $(document).on('click', '.btn-edit-exam', function (e) {
                e.preventDefault();
                var examId = $(this).data('id');
                var $modal = $('#editExamModal');

                $('#editExamId').val(examId);
                $('#editLoadingSpinner').show();
                $('#editFormFields').hide();
                $modal.modal('show');

                $.getJSON('@Url.Action("GetExam", "Exam")', { id: examId })
                    .done(function (res) {
                        $('#editLoadingSpinner').hide();
                        if (res && res.success) {
                            $('#editExamTitle').val(res.examTitle || '');
                            $('#editExamDescription').val(res.examDescription || '');
                            $('#editCourseId').val(res.courseId || '');
                            $('#editDuration').val(res.duration || 20);
                            $('#editPassingScore').val(res.passingScore || 60);
                            $('#editFormFields').show();
                        } else {
                            alert((res && res.message) ? res.message : 'Sınav bilgileri yüklenemedi.');
                            $modal.modal('hide');
                        }
                    })
                    .fail(function () {
                        $('#editLoadingSpinner').hide();
                        alert('Sınav bilgileri alınamadı.');
                        $modal.modal('hide');
                    });
            });

            // Tablodan Silme Butonu Tetikleyici
            $(document).on('click', '.btn-delete-row', function (e) {
                e.preventDefault();
                var examId = $(this).data('id');
                if (confirm('Bu sınavı silmek istediğinize emin misiniz? Sınava ait sorular ve sonuçlar da etkilenecektir.')) {
                    var token = $('input[name="__RequestVerificationToken"]').first().val();
                    var $form = $('<form method="post" action="@Url.Action("Delete", "Exam")"></form>')
                        .append($('<input type="hidden" name="__RequestVerificationToken" />').val(token))
                        .append($('<input type="hidden" name="id" />').val(examId));
                    $('body').append($form);
                    $form.submit();
                }
            });

            // Başlangıç Filtresi
            applyFilterAndPagination();
        });
    </script>
}
