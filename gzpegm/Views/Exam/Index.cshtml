@model IEnumerable<gzpegm.Models.ViewModels.ExamViewModel>
@using System
@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Sınav Yönetimi";
    Layout = "~/Views/Shared/_Master.cshtml";

    var allExams = Model != null ? new List<gzpegm.Models.ViewModels.ExamViewModel>(Model) : new List<gzpegm.Models.ViewModels.ExamViewModel>();
    var exams = allExams.OrderByDescending(e => e.CreatedDate ?? DateTime.MinValue).ToList();
    var coursesList = ViewBag.Courses as List<gzpegm.Models.ViewModels.ExamViewModel> ?? new List<gzpegm.Models.ViewModels.ExamViewModel>();

    int totalExams = exams.Count;
    int activeExams = exams.Count(e => e.IsActive);
    int passiveExams = exams.Count(e => !e.IsActive);
    int totalQuestions = exams.Sum(e => e.QuestionCount);
    int distinctCourses = exams.Select(e => e.CourseId).Distinct().Count();
}

<div class="exam-management-container">

    <!-- ÜST BİLGİ VE AKSİYON BANNERI -->
    <div class="exam-hero-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-7">
                <div class="d-flex align-items-center">
                    <div class="hero-icon-box mr-3 d-none d-sm-flex">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <div>
                        <h2 class="hero-title mb-1">Sınav & Değerlendirme Yönetimi</h2>
                        <p class="hero-desc mb-0">Eğitim paketlerine ait değerlendirme sınavlarını oluşturun, soru havuzunu yönetin ve sonuçları inceleyin.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-5 text-md-right mt-3 mt-md-0">
                <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                    <a href="@Url.Action("Index", "Course")" class="btn btn-outline-light hero-action-btn mr-2" title="Eğitim Paketlerine Git">
                        <i class="fas fa-graduation-cap mr-1"></i> Tüm Dersler
                    </a>
                    <button type="button" class="btn btn-warning hero-action-btn font-weight-bold" data-toggle="modal" data-target="#addExamModal">
                        <i class="fas fa-plus-circle mr-1"></i> Yeni Sınav Ekle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BİLDİRİM MESAJLARI -->
    @if (TempData["msgSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle fa-lg mr-2 text-success"></i>
                <div>
                    <strong>İşlem Başarılı!</strong> @TempData["msgSuccess"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["msgError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-lg mr-2 text-danger"></i>
                <div>
                    <strong>Hata:</strong> @TempData["msgError"]
                </div>
            </div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- İSTATİSTİK METRİK KARTLARI (4 KART) -->
    <div class="row stat-cards-row mb-4">
        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-blue">
                <div class="metric-icon">
                    <i class="fas fa-file-signature"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@totalExams</div>
                    <div class="metric-label">Toplam Sınav</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-emerald">
                <div class="metric-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@activeExams</div>
                    <div class="metric-label">Aktif / Yayında</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-teal">
                <div class="metric-icon">
                    <i class="fas fa-question-circle"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@totalQuestions</div>
                    <div class="metric-label">Toplam Soru Havuzu</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3 mb-xl-0">
            <div class="metric-card stat-purple">
                <div class="metric-icon">
                    <i class="fas fa-book-reader"></i>
                </div>
                <div class="metric-body">
                    <div class="metric-value">@distinctCourses</div>
                    <div class="metric-label">Sınavı Olan Ders</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FİLTRELEME VE ARAÇ ÇUBUĞU -->
    <div class="card filter-toolbar-card mb-4 shadow-sm">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <!-- Arama Kutusu -->
                <div class="col-lg-4 col-md-6 mb-2 mb-lg-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                        </div>
                        <input type="text" id="examSearchInput" class="form-control border-left-0" placeholder="Sınav adı, kurs veya açıklama ara..." />
                        <div class="input-group-append" id="clearSearchWrap" style="display:none;">
                            <button class="btn btn-outline-secondary border-left-0" type="button" id="btnClearSearch">&times;</button>
                        </div>
                    </div>
                </div>

                <!-- Kurs Filtresi -->
                <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                    <select id="courseFilter" class="form-control custom-select">
                        <option value="">Tüm Kurslar (@distinctCourses)</option>
                        @foreach (var c in coursesList.OrderBy(x => x.CourseTitle))
                        {
                            <option value="@c.CourseTitle">@c.CourseTitle</option>
                        }
                    </select>
                </div>

                <!-- Durum Filtre Butonları (Aktif/Pasif) -->
                <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                    <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                        <label class="btn btn-outline-secondary btn-sm active">
                            <input type="radio" name="statusFilter" value="all" checked> Tümü (@totalExams)
                        </label>
                        <label class="btn btn-outline-secondary btn-sm">
                            <input type="radio" name="statusFilter" value="active"> Aktif (@activeExams)
                        </label>
                        <label class="btn btn-outline-secondary btn-sm">
                            <input type="radio" name="statusFilter" value="passive"> Pasif (@passiveExams)
                        </label>
                    </div>
                </div>

                <!-- Görünüm Değiştirici (Kart / Tablo) -->
                <div class="col-lg-2 col-md-6 text-md-right">
                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="btnViewCards" title="Kart Görünümü">
                            <i class="fas fa-th-large"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="btnViewTable" title="Tablo Görünümü">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KART GÖRÜNÜMÜ ALANI -->
    <div id="examCardsView">
        <div class="row" id="examCardsContainer">
            @if (exams.Count > 0)
            {
                foreach (var exam in exams)
                {
                    var coverImage = string.IsNullOrWhiteSpace(exam.CourseCoverImage)
                        ? Url.Content("~/files/Egitim/91a7dd7d-56dc-41d3-a9bf-296a421966e2_155.jpg")
                        : (exam.CourseCoverImage.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? exam.CourseCoverImage
                            : Url.Content("~/files/Egitim/" + exam.CourseCoverImage));

                    var searchText = ((exam.ExamTitle ?? "") + " " + (exam.ExamDescription ?? "") + " " + (exam.CourseTitle ?? "") + " " + (exam.CourseCreatorFullName ?? "")).ToLowerInvariant();
                    var statusClass = exam.IsActive ? "active" : "passive";

                    <div class="col-xl-4 col-md-6 mb-4 exam-card-wrapper" data-status="@statusClass" data-course="@(exam.CourseTitle ?? "")" data-search="@searchText">
                        <div class="exam-item-card h-100 shadow-sm d-flex flex-column">
                            <!-- KART ÜST RESİM VE ROZETLER -->
                            <div class="exam-cover-container position-relative">
                                <img src="@coverImage" alt="@exam.CourseTitle" class="exam-cover-img" loading="lazy" onerror="this.src='/files/Egitim/91a7dd7d-56dc-41d3-a9bf-296a421966e2_155.jpg';" />
                                <div class="exam-cover-gradient"></div>

                                <!-- Durum Butonu / Rozeti (Tek Tıkla Değiştirilebilir) -->
                                <button type="button" class="btn-toggle-status-badge @(exam.IsActive ? "badge-status-active" : "badge-status-passive")" data-id="@exam.ExamId" title="Durumu değiştirmek için tıklayın">
                                    <i class="fas @(exam.IsActive ? "fa-check-circle" : "fa-ban") mr-1"></i>
                                    <span class="status-label">@(exam.IsActive ? "Aktif" : "Pasif")</span>
                                </button>

                                <!-- Soru Sayısı ve Süre Hap Rozetleri -->
                                <div class="exam-quick-chips">
                                    <span class="quick-chip"><i class="fas fa-question-circle mr-1"></i> @exam.QuestionCount Soru</span>
                                    <span class="quick-chip"><i class="far fa-clock mr-1"></i> @exam.Duration dk</span>
                                </div>
                            </div>

                            <!-- KART GÖVDESİ -->
                            <div class="exam-card-body p-3 flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="exam-course-badge text-truncate mb-1" title="@exam.CourseTitle">
                                        <i class="fas fa-graduation-cap text-primary mr-1"></i> @exam.CourseTitle
                                    </div>
                                    <h5 class="exam-card-title font-weight-bold text-dark mb-2" title="@exam.ExamTitle">
                                        @exam.ExamTitle
                                    </h5>
                                    @if (!string.IsNullOrWhiteSpace(exam.ExamDescription))
                                    {
                                        <p class="exam-card-description small text-muted mb-2">
                                            @(exam.ExamDescription.Length > 90 ? exam.ExamDescription.Substring(0, 90) + "..." : exam.ExamDescription)
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="exam-card-description small text-muted font-italic mb-2">Açıklama girilmemiş.</p>
                                    }
                                </div>

                                <!-- META BİLGİ ŞERİDİ -->
                                <div class="exam-meta-strip py-2 px-3 rounded bg-light border my-2 small d-flex justify-content-between align-items-center">
                                    <span class="text-muted"><i class="fas fa-award text-warning mr-1"></i> Geçme: <strong class="text-dark">%@exam.PassingScore</strong></span>
                                    @if (!string.IsNullOrEmpty(exam.CourseCreatorFullName))
                                    {
                                        <span class="text-muted text-truncate ml-2" style="max-width: 140px;" title="@exam.CourseCreatorFullName">
                                            <i class="fas fa-user-edit mr-1"></i> @exam.CourseCreatorFullName
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- KART AKSİYON BUTONLARI -->
                            <div class="exam-card-footer p-3 bg-white border-top">
                                <div class="row no-gutters">
                                    <div class="col-6 pr-1">
                                        <a href="@Url.Action("Index", "Question", new { examId = exam.ExamId })" class="btn btn-primary btn-sm btn-block font-weight-bold shadow-sm" title="Soruları Görüntüle ve Düzenle">
                                            <i class="fas fa-question-circle mr-1"></i> Sorular (@exam.QuestionCount)
                                        </a>
                                    </div>
                                    <div class="col-6 pl-1">
                                        <a href="@Url.Action("Results", "Exam", new { id = exam.ExamId })" class="btn btn-info btn-sm btn-block font-weight-bold shadow-sm" title="Sınav Sonuçlarını Gör">
                                            <i class="fas fa-chart-pie mr-1"></i> Sonuçlar
                                        </a>
                                    </div>
                                </div>
                                <div class="row no-gutters mt-2">
                                    <div class="col-6 pr-1">
                                        <button type="button" class="btn btn-outline-secondary btn-sm btn-block btn-edit-exam" data-id="@exam.ExamId">
                                            <i class="fas fa-edit mr-1"></i> Düzenle
                                        </button>
                                    </div>
                                    <div class="col-6 pl-1">
                                        <form method="post" action="@Url.Action("Delete", "Exam")" class="delete-exam-form" onsubmit="return confirm('Bu sınavı silmek istediğinize emin misiniz? Sınava ait sorular ve sonuçlar da etkilenecektir.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@exam.ExamId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-block">
                                                <i class="fas fa-trash-alt mr-1"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- TABLO GÖRÜNÜMÜ ALANI (DEFAULT GİZLİ) -->
    <div id="examTableView" style="display:none;">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="thead-dark">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Sınav Başlığı</th>
                                <th>Bağlı Kurs</th>
                                <th class="text-center" style="width: 100px;">Soru</th>
                                <th class="text-center" style="width: 90px;">Süre</th>
                                <th class="text-center" style="width: 110px;">Geçme Notu</th>
                                <th class="text-center" style="width: 110px;">Durum</th>
                                <th class="text-right" style="width: 250px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="examTableBody">
                            @{ int rowIdx = 1; }
                            @foreach (var exam in exams)
                            {
                                var searchText = ((exam.ExamTitle ?? "") + " " + (exam.ExamDescription ?? "") + " " + (exam.CourseTitle ?? "") + " " + (exam.CourseCreatorFullName ?? "")).ToLowerInvariant();
                                var statusClass = exam.IsActive ? "active" : "passive";

                                <tr class="exam-table-row" data-status="@statusClass" data-course="@(exam.CourseTitle ?? "")" data-search="@searchText">
                                    <td class="font-weight-bold text-muted">@rowIdx</td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@exam.ExamTitle</div>
                                        @if (!string.IsNullOrWhiteSpace(exam.ExamDescription))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 320px;">@exam.ExamDescription</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-light border text-primary">
                                            <i class="fas fa-graduation-cap mr-1"></i> @exam.CourseTitle
                                        </span>
                                    </td>
                                    <td class="text-center font-weight-bold text-info">@exam.QuestionCount</td>
                                    <td class="text-center">@exam.Duration dk</td>
                                    <td class="text-center"><span class="badge badge-warning text-dark font-weight-bold">%@exam.PassingScore</span></td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-xs @(exam.IsActive ? "btn-success" : "btn-secondary") btn-toggle-status-badge" data-id="@exam.ExamId">
                                            <i class="fas @(exam.IsActive ? "fa-check" : "fa-ban") mr-1"></i>
                                            <span class="status-label">@(exam.IsActive ? "Aktif" : "Pasif")</span>
                                        </button>
                                    </td>
                                    <td class="text-right">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Index", "Question", new { examId = exam.ExamId })" class="btn btn-outline-primary" title="Sorular">
                                                <i class="fas fa-question-circle"></i>
                                            </a>
                                            <a href="@Url.Action("Results", "Exam", new { id = exam.ExamId })" class="btn btn-outline-info" title="Sonuçlar">
                                                <i class="fas fa-chart-pie"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-secondary btn-edit-exam" data-id="@exam.ExamId" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-delete-row" data-id="@exam.ExamId" title="Sil">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIdx++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- BOŞ DURUM (EMPTY STATE) -->
    <div id="examEmptyAlert" class="text-center py-5 @(exams.Count > 0 ? "d-none" : "")">
        <div class="mb-3 text-muted">
            <i class="fas fa-file-signature fa-4x text-secondary"></i>
        </div>
        <h5 class="font-weight-bold text-dark">Aramanızla Eşleşen Sınav Bulunamadı</h5>
        <p class="text-muted small mb-3">Filtreleri temizleyebilir veya yeni bir sınav tanımlayabilirsiniz.</p>
        <button type="button" class="btn btn-primary btn-sm font-weight-bold" data-toggle="modal" data-target="#addExamModal">
            <i class="fas fa-plus-circle mr-1"></i> Yeni Sınav Oluştur
        </button>
    </div>

    <!-- SAYFALAMA (PAGINATION) -->
    <div class="d-flex justify-content-center mt-4">
        <div class="exam-pagination-wrapper" id="examPagination"></div>
    </div>

</div>

<!-- ============================================================ -->
<!-- YENİ SINAV EKLEME MODALI (BOOTSTRAP 4 / PORTO UYUMLU & GENİŞ) -->
<!-- ============================================================ -->
<div class="modal fade" id="addExamModal" tabindex="-1" role="dialog" aria-labelledby="addExamModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header modal-hero-header text-white">
                <h5 class="modal-title font-weight-bold" id="addExamModalLabel">
                    <i class="fas fa-plus-circle mr-2"></i> Yeni Sınav Oluştur
                </h5>
                <button type="button" class="close text-white opacity-8" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" action="@Url.Action("Create", "Exam")" id="createExamForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold text-dark">Sınav Başlığı <span class="text-danger">*</span></label>
                        <input type="text" name="ExamTitle" class="form-control" placeholder="Örn: Pasaport Kanunu Değerlendirme Sınavı" required maxlength="200" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold text-dark">Bağlı Kurs / Eğitim Paketi <span class="text-danger">*</span></label>
                        <select name="CourseId" class="form-control custom-select" required>
                            <option value="">Kurs Seçiniz...</option>
                            @foreach (var course in coursesList.OrderBy(c => c.CourseTitle))
                            {
                                <option value="@course.CourseId">@course.CourseTitle</option>
                            }
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label class="form-label font-weight-bold text-dark">Sınav Süresi (Dakika) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" name="Duration" class="form-control" value="20" min="1" max="300" required />
                                <div class="input-group-append">
                                    <span class="input-group-text">dk</span>
                                </div>
                            </div>
                            <small class="text-muted">Kursiyerin sınavı bitirmesi için tanınan süre.</small>
                        </div>
                        <div class="form-group col-md-6 mb-3">
                            <label class="form-label font-weight-bold text-dark">Geçme Notu (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" name="PassingScore" class="form-control" value="60" min="0" max="100" required />
                                <div class="input-group-append">
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <small class="text-muted">Başarı sertifikası ve onay için minimum puan.</small>
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <label class="form-label font-weight-bold text-dark">Sınav Açıklaması ve Talimatlar</label>
                        <textarea name="ExamDescription" class="form-control" rows="3" maxlength="500" placeholder="Kursiyerlerin sınav başlamadan önce okuyacağı açıklamalar ve yönergeler..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Sınavı Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- TEK, TEKRAR KULLANILABİLİR DÜZENLEME MODALI (AJAX POPULATE)  -->
<!-- ============================================================ -->
<div class="modal fade" id="editExamModal" tabindex="-1" role="dialog" aria-labelledby="editExamModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header modal-hero-header text-white">
                <h5 class="modal-title font-weight-bold" id="editExamModalLabel">
                    <i class="fas fa-edit mr-2"></i> Sınavı Düzenle
                </h5>
                <button type="button" class="close text-white opacity-8" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" action="@Url.Action("Edit", "Exam")" id="editExamForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExamId" id="editExamId" value="" />

                <div class="modal-body p-4">
                    <div id="editLoadingSpinner" class="text-center py-4" style="display:none;">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted small mt-2">Sınav bilgileri yükleniyor...</p>
                    </div>

                    <div id="editFormFields">
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold text-dark">Sınav Başlığı <span class="text-danger">*</span></label>
                            <input type="text" name="ExamTitle" id="editExamTitle" class="form-control" required maxlength="200" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold text-dark">Bağlı Kurs / Eğitim Paketi <span class="text-danger">*</span></label>
                            <select name="CourseId" id="editCourseId" class="form-control custom-select" required>
                                <option value="">Kurs Seçiniz...</option>
                                @foreach (var course in coursesList.OrderBy(c => c.CourseTitle))
                                {
                                    <option value="@course.CourseId">@course.CourseTitle</option>
                                }
                            </select>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label class="form-label font-weight-bold text-dark">Sınav Süresi (Dakika) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" name="Duration" id="editDuration" class="form-control" min="1" max="300" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text">dk</span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label class="form-label font-weight-bold text-dark">Geçme Notu (%) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" name="PassingScore" id="editPassingScore" class="form-control" min="0" max="100" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label class="form-label font-weight-bold text-dark">Sınav Açıklaması ve Talimatlar</label>
                            <textarea name="ExamDescription" id="editExamDescription" class="form-control" rows="3" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                        <i class="fas fa-check mr-1"></i> Değişiklikleri Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

