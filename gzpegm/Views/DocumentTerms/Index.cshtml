@model IEnumerable<gzpegm.Models.DocumentTerms>
@{
    ViewBag.Title = "Document Terimler";
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseDataTables = true;
}


<head>
    <style>
        /* Card Header Düzeni */
        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem 1.5rem;
        }

            /* Sol taraftaki buton ve başlık hizası */
            .card-header > .d-flex {
                flex: 1;
            }

            /* Mavi Buton - Düzeltilmiş */
            .card-header .btn-primary {
                background-color: #007bff;
                border-color: #007bff;
                color: white;
                padding: 0.5rem 1rem;
                font-size: 0.875rem;
                font-weight: 500;
                border-radius: 4px;
                min-height: 36px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s ease;
                text-decoration: none;
            }

                .card-header .btn-primary:hover {
                    background-color: #0056b3;
                    border-color: #0056b3;
                    transform: translateY(-1px);
                    box-shadow: 0 3px 6px rgba(0, 123, 255, 0.2);
                    color: white;
                    text-decoration: none;
                }

                .card-header .btn-primary:active {
                    transform: translateY(0);
                    box-shadow: 0 1px 3px rgba(0, 123, 255, 0.2);
                }

                .card-header .btn-primary i {
                    margin-right: 5px;
                    font-size: 0.875rem;
                }

        /* Card Title */
        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #333;
            margin: 0;
        }

        /* Sağdaki toplam kayıt badge */
        .card-header .badge-info {
            background-color: #17a2b8;
            color: white;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .card-header {
                flex-direction: column;
                align-items: stretch;
                gap: 1rem;
            }

                .card-header > .d-flex {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 1rem;
                }

                .card-header .btn-primary {
                    width: 100%;
                    margin-bottom: 0.5rem;
                }

            .card-title {
                text-align: center;
            }

            .card-header .badge-info {
                align-self: center;
            }
        }
    </style>
</head>
<header class="page-header">
    <h2>Document Terimler</h2>
    <div class="right-wrapper text-right">
        <ol class="breadcrumbs">
            <li>
                <a href="@Url.Action("Index", "Home")">
                    <i class="fas fa-home"></i>
                </a>
            </li>
            <li><span>Tables</span></li>
            <li><span>Document Terimler</span></li>
        </ol>
    </div>
</header>

<div class="row">
    <div class="col-lg-12">
        <section class="card">
            <header class="card-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <a href="@Url.Action("Create","DocumentTerms")" class="btn btn-primary btn-sm mr-3">
                        <i class="fas fa-plus mr-1"></i> Yeni Terim Ekle
                    </a>
                    <h2 class="card-title mb-0">Document Terms Listesi</h2>
                </div>
                <div class="badge badge-info">Toplam: @Model.Count() kayıt</div>
            </header>

            <div class="card-body">

                @Html.AntiForgeryToken()

                <div class="row mb-3">
                    <div class="col-md-6">
                        <form method="get" action="@Url.Action("Index")" class="form-inline">
                            <div class="input-group">
                                <input type="text" name="q" class="form-control"
                                       placeholder="Ara..."
                                       value="@ViewContext.HttpContext.Request.QueryString["q"]">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="fas fa-times"></i>
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <table class="table table-bordered table-striped" id="datatable-document-terms">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Term</th>                           
                            <th>Category</th>
                            <th>Ekleyen</th>
                            <th>Aktif</th>
                            <th>Oluşturma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.Id">
                                <td>@item.Id</td>
                                <td>@item.Term</td>                            
                                <td>@item.Category</td>
                                <td>@(!string.IsNullOrWhiteSpace(item.AdSoyad) ? item.AdSoyad : "-")</td>
                                <td>
                                    <span class="badge @(item.IsActive == true ? "badge-success" : "badge-secondary")">
                                        @(item.IsActive == true ? "Evet" : "Hayır")
                                    </span>
                                </td>
                                <td>
                                    @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd.MM.yyyy") : "")
                                </td>
                                <td class="actions">
                                    <a href="@Url.Action("Edit","DocumentTerms",new {id=item.Id})"
                                       class="btn btn-warning btn-sm"
                                       title="Düzenle"
                                       aria-label="Düzenle">
                                        <i class="fas fa-edit"></i> Düzenle
                                    </a>
                                    <a href="@Url.Action("Details", "DocumentTerms", new { id = item.Id })"
                                       class="btn btn-sm btn-info"
                                       title="Detay"
                                       aria-label="Detay">
                                        <i class="fas fa-eye"></i> Detay
                                    </a>

                                    <button type="button"
                                            class="btn btn-danger btn-sm btn-delete"
                                            data-id="@item.Id"
                                            data-term="@item.Term"
                                            title="Sil"
                                            aria-label="Sil">
                                        <i class="fas fa-trash"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </section>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="deleteModal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Silme Onayı</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="deleteModalText"></p>
                <div class="alert alert-warning mb-0">Bu işlem geri alınamaz.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="fas fa-trash"></i> Sil
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
$(function () {

    /* =========================
       DataTable
    ========================= */
    var table = $('#datatable-document-terms').DataTable({
        pageLength: 25,
        responsive: true,
        language: { search: "Ara:" }
    });

    var deleteId = null;
    var deleteTerm = null;
    var $confirmBtn = $('#confirmDelete');

    function token() {
        return $('input[name="__RequestVerificationToken"]').val();
    }

    /* =========================
       Sil Butonu
    ========================= */
    $(document).on('click', '.btn-delete', function () {
        deleteId = $(this).data('id');
        deleteTerm = $(this).data('term');

        if (!deleteId) return;

        $('#deleteModalText').text('"' + deleteTerm + '" terimini silmek istediğinize emin misiniz?');
        $('#deleteModal').modal('show');
    });

    /* =========================
       Modal Kapanınca Reset
    ========================= */
    $('#deleteModal').on('hidden.bs.modal', function () {
        // Butonu resetle
        $confirmBtn
            .prop('disabled', false)
            .html('<i class="fas fa-trash"></i> Sil');

        deleteId = null;
        deleteTerm = null;
    });

    /* =========================
       Layout Modal'ını Açan Fonksiyon
    ========================= */
    function showLayoutModal(type, message) {
        if (type === 'success') {
            $('#modalGeneralSuccess .modal-text p').text(message);
            $.magnificPopup.open({
                items: { src: '#modalGeneralSuccess' },
                type: 'inline'
            });
        } else {
            $('#modalGeneralWarning .modal-text p').text(message);
            $.magnificPopup.open({
                items: { src: '#modalGeneralWarning' },
                type: 'inline'
            });
        }

        // 3 saniye sonra otomatik kapat
        setTimeout(function() {
            $.magnificPopup.close();
        }, 3000);
    }

    /* =========================
       Sil Onayı
    ========================= */
    $confirmBtn.on('click', function () {
        if (!deleteId || $confirmBtn.prop('disabled')) return;

        // Butonu disable et ve spinner ekle
        $confirmBtn
            .prop('disabled', true)
            .html('<i class="fas fa-spinner fa-spin"></i> Siliniyor...');

        var requestData = {
            id: deleteId,
            __RequestVerificationToken: token()
        };

        $.ajax({
            url: '@Url.Action("Delete","DocumentTerms")',
            type: 'POST',
            data: requestData,
            success: function (response) {
                // Modal'ı kapat
                $('#deleteModal').modal('hide');

                if (response && response.success) {
                    // Tablodan satırı kaldır
                    var row = $('#row-' + deleteId);
                    table.row(row[0]).remove().draw(false);

                    // Layout modal'ını aç (Başarılı)
                    showLayoutModal('success', response.message || 'Terim başarıyla silindi.');
                } else {
                    var msg = (response && response.message) ? response.message : 'Silme işlemi başarısız.';
                    // Layout modal'ını aç (Hata)
                    showLayoutModal('error', msg);
                }
            },
            error: function (xhr, status, error) {
                // Modal'ı kapat
                $('#deleteModal').modal('hide');

                var msg = 'Silme sırasında hata oluştu.';
                if (status === 'timeout') msg = 'Sunucu yanıt vermiyor (timeout).';

                // Layout modal'ını aç (Hata)
                showLayoutModal('error', msg);
            },
            complete: function () {
                // AJAX tamamlandığında buton zaten hidden.bs.modal event'inde resetlenecek
            }
        });
    });

});
    </script>
}
