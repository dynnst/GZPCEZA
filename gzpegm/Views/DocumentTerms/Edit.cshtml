@model gzpegm.Models.DocumentTerms
@{
    ViewBag.Title = "Terim Düzenle";
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.UseSummernote = true;
}

@section Styles {
    <style>
        .ibox {
            clear: both;
            margin-bottom: 25px;
            padding: 0;
            background: #fff;
            border: 1px solid #e3e3e3;
            border-radius: 4px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
        }

        .ibox-title {
            background-color: #f5f5f5;
            border-bottom: 1px solid #e3e3e3;
            padding: 14px 15px 7px;
            border-radius: 4px 4px 0 0;
        }

            .ibox-title h5 {
                display: inline-block;
                font-size: 14px;
                margin: 0 0 7px;
                padding: 0;
            }

        .ibox-tools {
            display: block;
            float: right;
            position: relative;
        }

            .ibox-tools a {
                color: #3c8dbc;
                cursor: pointer;
                margin-left: 5px;
            }

        .ibox-content {
            clear: both;
            display: block;
            padding: 15px;
            background-color: #fff;
        }

        .form-group {
            margin-bottom: 15px;
        }

            .form-group label {
                font-weight: 500;
                color: #333;
                margin-bottom: 5px;
                display: block;
            }

        .form-control {
            display: block;
            width: 100%;
            padding: 6px 12px;
            font-size: 14px;
            color: #555;
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

            .form-control:focus {
                border-color: #66afe9;
                outline: 0;
                box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.075), 0 0 8px rgba(102, 175, 233, 0.6);
            }

        .btn {
            display: inline-block;
            padding: 6px 12px;
            font-size: 14px;
            font-weight: normal;
            line-height: 1.42857143;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            cursor: pointer;
            border: 1px solid transparent;
            border-radius: 4px;
            margin-right: 5px;
        }

        .btn-primary {
            color: #fff;
            background-color: #1ab394;
            border-color: #1ab394;
        }

            .btn-primary:hover {
                background-color: #18a689;
            }

        .btn-default {
            color: #333;
            background-color: #fff;
            border-color: #ccc;
        }

            .btn-default:hover {
                background-color: #e6e6e6;
            }

        .btn-info {
            color: #fff;
            background-color: #17a2b8;
            border-color: #17a2b8;
        }

        .btn-block {
            display: block;
            width: 100%;
        }

        .image-preview {
            margin: 15px 0;
            padding: 15px;
            background-color: #f5f5f5;
            border: 1px solid #e3e3e3;
            border-radius: 4px;
            text-align: center;
        }

            .image-preview img {
                max-width: 100%;
                max-height: 300px;
                border-radius: 4px;
            }

        .image-preview-empty {
            color: #999;
            padding: 20px;
            font-size: 13px;
        }

        .checkbox {
            display: block;
            min-height: 20px;
            padding-left: 20px;
            margin-top: 10px;
            margin-bottom: 10px;
        }

            .checkbox label {
                display: inline;
                margin-bottom: 0;
                font-weight: 400;
                cursor: pointer;
            }

            .checkbox input[type="checkbox"] {
                margin-left: -20px;
                margin-top: 3px;
            }

        .field-validation-error {
            color: #a94442;
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }

        .form-row {
            display: flex;
            margin: -5px;
        }

        .form-col {
            flex: 1;
            padding: 5px;
        }

            .form-col.half {
                flex: 0 0 50%;
            }

        .form-control-static {
            padding: 6px 12px;
            color: #555;
            background-color: transparent;
            border: none;
        }

        .badge {
            display: inline-block;
            padding: 3px 7px;
            font-size: 12px;
            font-weight: bold;
            line-height: 1;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 10px;
        }

        .badge-success {
            background-color: #1ab394;
        }

        .badge-secondary {
            background-color: #6c757d;
        }

        .text-muted {
            color: #999;
        }

        small.form-text {
            display: block;
            margin-top: 5px;
        }

        .note-editor.note-frame {
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .custom-file {
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .custom-file-input {
            position: relative;
            z-index: 2;
            width: 100%;
            margin: 0;
            opacity: 0;
        }

        .custom-file-label {
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            z-index: 1;
            display: block;
            padding: 0.375rem 0.75rem;
            line-height: 1.5;
            color: #495057;
            background-color: #e9ecef;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }
    </style>
    <link href="~/css/Summernote/summernote-bs4.css" rel="stylesheet" />
}

<header class="page-header">
    <h2>Terim Düzenle</h2>
    <div class="right-wrapper text-right">
        <ol class="breadcrumbs">
            <li>
                <a href="@Url.Action("Index", "Home")">
                    <i class="fas fa-home"></i>
                </a>
            </li>
            <li><span>Document Terms</span></li>
            <li><span>Terim Düzenle</span></li>
        </ol>
    </div>
</header>

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-8">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>Terim Bilgileri</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    @using (Html.BeginForm("Edit", "DocumentTerms", FormMethod.Post, new { enctype = "multipart/form-data", id = "editForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)

                        <!-- Terim Adı -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.Term, "Terim Adı")
                            @Html.TextBoxFor(m => m.Term, new { @class = "form-control", placeholder = "Terim adını girin", required = "required" })
                            @Html.ValidationMessageFor(m => m.Term, "", new { @class = "field-validation-error" })
                        </div>

                        <!-- Slug ve Kategori -->
                        <div class="form-row">
                            <div class="form-col half">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Slug, "Slug")
                                    @Html.TextBoxFor(m => m.Slug, new { @class = "form-control", placeholder = "slug-formatında-terim" })
                                </div>
                            </div>
                            <div class="form-col half">
                                <div class="form-group">
                                    <label for="Category" class="control-label">Kategori</label>
                                    <select id="Category" name="Category" class="form-control" required>
                                        <option value="">-- Kategori Seçiniz --</option>
                                        @foreach (var cat in (List<string>)ViewBag.Categories ?? new List<string>())
                                        {
                                            <option value="@cat" @(Model.Category == cat ? "selected" : "")>@cat</option>
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                        </div>

                        <!-- Tanım -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.Definition, "Tanım")
                            @Html.TextAreaFor(m => m.Definition, 4, 80, new { @class = "form-control", placeholder = "Kısa tanım yazın", required = "required" })
                        </div>

                        <!-- Ayrıntılı Açıklama (Summernote) -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.DetailedDescription, "Ayrıntılı Açıklama (Resim + Metin)")
                            @Html.TextAreaFor(m => m.DetailedDescription, new
                            {
                                @class = "form-control summernote",
                                id = "DetailedDescription"
                            })
                            <small class="form-text text-muted d-block mt-2">
                                <i class="fa fa-info-circle"></i> Resim ve metin ekleyebilirsiniz.
                            </small>
                        </div>

                        <!-- İlişkili Terimler -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.RelatedTerms, "İlişkili Terimler")
                            @Html.TextBoxFor(m => m.RelatedTerms, new { @class = "form-control", placeholder = "Virgülle ayırarak yazın" })
                        </div>

                        <!-- Durum -->
                        <div class="form-group">
                            <div class="checkbox">
                                <label>
                                    <input type="checkbox"
                                           id="IsActive"
                                           name="IsActive"
                                           value="true"
                                           @(Model.IsActive == true ? "checked='checked'" : "") />
                                    Aktif
                                </label>
                                <input type="hidden" name="IsActive" value="false" />
                            </div>
                        </div>

                        <!-- Resim Yönetimi -->
                        <hr />
                        <h5 style="margin-top: 20px; margin-bottom: 15px;">Ana Resim (Başlık Resmi)</h5>

                        <!-- Mevcut Resim -->
                        if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <div class="image-preview">
                                <img src="@Model.ImageUrl" alt="@Model.Term" />
                            </div>
                            <div class="form-group">
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" name="removeImage" value="1" />
                                        Resmi Kaldır
                                    </label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="image-preview image-preview-empty">
                                <i class="fa fa-image" style="font-size: 48px; color: #ddd; margin-bottom: 10px;"></i>
                                <p>Resim Yok</p>
                            </div>
                        }

                        <!-- Dosya Yükle -->
                        <div class="form-group">
                            <label>Dosya ile Yükle</label>
                            <div class="custom-file">
                                <input type="file" name="imageFile" class="custom-file-input" id="imageFile" accept="image/*" />
                                <label class="custom-file-label" for="imageFile">Dosya seçin...</label>
                            </div>
                            <small class="text-muted">JPG, PNG, GIF desteklenmektedir</small>
                        </div>

                        <!-- URL ile Yükle -->
                        <div class="form-group">
                            <label>Veya URL Girin</label>
                            <div class="input-group">
                                <span class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="fa fa-globe"></i>
                                    </span>
                                </span>
                                <input type="text" name="ImageUrl" id="ImageUrl" class="form-control" placeholder="https://..." maxlength="500" />
                            </div>
                            <small class="text-muted">Maksimum 500 karakter</small>
                        </div>

                        <!-- Butonlar -->
                        <div class="form-group" style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #e3e3e3;">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Güncelle
                            </button>
                            <a href="@Url.Action("Index", "DocumentTerms")" class="btn btn-default">
                                <i class="fa fa-arrow-left"></i> Geri
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ Sütun -->
        <div class="col-lg-4">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>Bilgi Özeti</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="form-group">
                        <label>Terim ID</label>
                        <p class="form-control-static">@Model.Id</p>
                    </div>

                    <div class="form-group">
                        <label>Oluşturma Tarihi</label>
                        <p class="form-control-static">
                            @(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                        </p>
                    </div>

                    <div class="form-group">
                        <label>Güncelleme Tarihi</label>
                        <p class="form-control-static">
                            @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                        </p>
                    </div>

                    <div class="form-group">
                        <label>Durum</label>
                        <p class="form-control-static">
                            <span class="badge @(Model.IsActive == true ? "badge-success" : "badge-secondary")">
                                @(Model.IsActive == true ? "Aktif" : "Pasif")
                            </span>
                        </p>
                    </div>

                    <hr />

                    <a href="@Url.Action("Details", "DocumentTerms", new { id = Model.Id })" class="btn btn-info btn-block">
                        <i class="fa fa-eye"></i> Detayları Göster
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/css/Summernote/summernote-bs4.js"></script>
    <script src="~/css/Summernote/lang/summernote-tr-TR.js"></script>

    <script>
        $(document).ready(function () {
            $('#imageFile').on('change', function (e) {
                var fileName = e.target.files[0] ? e.target.files[0].name : "Dosya seçin...";
                $(this).next('.custom-file-label').text(fileName);
            });

            $('.summernote').summernote({
                lang: 'tr-TR',
                height: 300,
                minHeight: 200,
                maxHeight: 500,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                callbacks: {
                    onImageUpload: function (files) {
                        for (let i = 0; i < files.length; i++) {
                            uploadImage(files[i], this);
                        }
                    }
                }
            });

            function uploadImage(file, editor) {
                let data = new FormData();
                data.append("file", file);
                data.append("__RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());

                $.ajax({
                    data: data,
                    type: "POST",
                    url: '@Url.Action("UploadImage", "DocumentTerms")',
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        if (result.success) {
                            $(editor).summernote('insertImage', result.url);
                        } else {
                            alert('Resim yükleme başarısız: ' + result.message);
                        }
                    },
                    error: function () {
                        alert('Resim yükleme başarısız oldu!');
                    }
                });
            }

            $('#editForm').submit(function (e) {
                var term = $('#Term').val().trim();
                var category = $('#Category').val().trim();
                var definition = $('#Definition').val().trim();

                if (!term) {
                    e.preventDefault();
                    alert('Terim adı boş olamaz!');
                    $('#Term').focus();
                    return false;
                }

                if (!category) {
                    e.preventDefault();
                    alert('Kategori seçilmelidir!');
                    $('#Category').focus();
                    return false;
                }

                if (!definition) {
                    e.preventDefault();
                    alert('Tanım boş olamaz!');
                    $('#Definition').focus();
                    return false;
                }

                return true;
            });
        });
    </script>
}
