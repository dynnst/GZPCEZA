@model IEnumerable<gzpegm.Models.E_UVR>

@{
    string Calculate = "",
        Sahis = "",
        VH = "",
        Passport = "";
    Layout = "~/Views/Shared/_Master.cshtml";
}
<section class="card">
    <header class="card-header">
        <div class="card-actions">
            <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
        </div>
        <h2 class="card-title">Ülkeler Vize Rejmi Listesi</h2>
        <p class="card-subtitle">Bu bölümde ülkeler vize rejmi oluşturma ve düzenleme işlemi yapılabilir.</p>
    </header>
    <div class="card-body">
        <table class="table table-bordered table-striped mb-0" id="datatable-default">
            <thead>
                <tr>
                    <th>Ülke</th>
                    <th>Hesaplama Şekli</th>
                    <th>Pasaport Türü</th>
                    <th>Vize Durumu</th>
                    <th>Kaç Günde</th>
                    <th>Kalış Süresi</th>
                    <th>Bir Seferde</th>
                    <th>Vize Harcı</th>
                    <th>Eylemler</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var data in Model)
                {
                    if (data.fldHB == 0) { VH = "Alınmayacak"; }
                    else if (data.fldHB == 1) { VH = "Alınacak"; }

                    if (data.fldCalculateType == 1) { Calculate = "Normal Hesaplama"; }
                    else if (data.fldCalculateType == 2) { Calculate = "180 Uygulama Normal"; }
                    else if (data.fldCalculateType == 3) { Calculate = "30 Günlük (Tır Şoförleri) Uygulama"; }
                    else if (data.fldCalculateType == 5) { Calculate = "Beyaz Rusya Özel (365/90 – Tek Sefer 30 Gün)"; }

                    if (data.fldPassportType == 1) { Passport = "Umuma Mahsus Pasaport"; }
                    else if (data.fldPassportType == 2) { Passport = "Diplomatik Pasaport"; }
                    else if (data.fldPassportType == 3) { Passport = "Servis Pasaportu"; }
                    else if (data.fldPassportType == 4) { Passport = "Hizmet Pasaportu"; }
                    else if (data.fldPassportType == 5) { Passport = "Haymatlas"; }
                    else if (data.fldPassportType == 6) { Passport = "Gemi Adamı Cüzdanı"; }

                    if (data.fldVisaStatus == 1) { Sahis = "Vizeli"; }
                    else if (data.fldVisaStatus == 2) { Sahis = "Vizesiz"; }
                    else if (data.fldVisaStatus == 3) { Sahis = "Konsolosluk Vizeli"; }
                    else if (data.fldVisaStatus == 4) { Sahis = "İkamet Teskereli"; }
                    else if (data.fldVisaStatus == 5) { Sahis = "Türkiye'de Doğan"; }
                    else if (data.fldVisaStatus == 6) { Sahis = "Resmi Görevli"; }
                    else if (data.fldVisaStatus == 7) { Sahis = "İkamet Şartlı Giriş"; }
                    else if (data.fldVisaStatus == 8) { Sahis = "Çalışma İzni"; }
                    else if (data.fldVisaStatus == 9) { Sahis = "V-157 Tahditli Şahıslar,Tebliğ Tarihi Dışında Gelen"; }
                    else if (data.fldVisaStatus == 10) { Sahis = "V-69 Tahditli Şahıslar"; }
                    else if (data.fldVisaStatus == 11) { Sahis = "V-137 Vize Süresiz Tahditli Şahıslar"; }
                    else if (data.fldVisaStatus == 12) { Sahis = "V-88 Tahditli Şahıslar"; }
                    else if (data.fldVisaStatus == 13) { Sahis = "V-137 Vize Süreli"; }
                    else if (data.fldVisaStatus == 14) { Sahis = "İkamet Teskereli V-157 Tahditli"; }
                    else if (data.fldVisaStatus == 15) { Sahis = "V-69 Tebliğ Tarihi İçinde Gelen"; }

                    <tr>
                        <td>@data.fldCountry</td>
                        <td>@Calculate</td>
                        <td>@Passport</td>
                        <td>@Sahis</td>
                        <td>@data.fldDay</td>
                        <td>@data.fldLong</td>
                        <td>@data.fldOneTime</td>
                        <td>@VH</td>
                        <td class="actions">
                            <a onclick="edituvr('@data.fldId','@data.fldCountry','@data.fldCalculateType','@data.fldPassportType','@data.fldVisaStatus','@data.fldDay','@data.fldLong','@data.fldOneTime','@data.fldHB')" href="#EditUVRmodalForm" class="modal-with-form btn btn-default">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a onclick="deleteuvr('@data.fldId')" class="btn btn-default">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        <a class="modal-with-form btn btn-default" href="#AddUVRmodalForm">
            <i class="fas fa-plus"></i> Yeni Ekle
        </a>

    </div>
</section>
