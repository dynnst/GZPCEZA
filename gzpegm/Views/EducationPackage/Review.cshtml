@model gzpegm.Models.ViewModels.EducationReviewViewModel
@{
    ViewBag.Title = "Eğitim Son Kontrol & Yayın Onay Paneli";
    Layout = "~/Views/Shared/_Master.cshtml";
}

<style>
    .review-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(30, 60, 114, 0.12);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }
    .review-header h1 {
        font-size: 20px;
        font-weight: 700;
        margin: 0;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .review-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        padding: 24px;
        margin-bottom: 24px;
    }
    .status-pill {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 6px 16px;
        border-radius: 20px;
        text-transform: uppercase;
    }
    .pill-published {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }
    .pill-draft {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }
    .cover-thumbnail {
        width: 100%;
        max-width: 200px;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }
    .issue-row-error {
        background-color: #fef2f2 !important;
        border-left: 4px solid #ef4444 !important;
    }
    .issue-row-warning {
        background-color: #fffbeb !important;
        border-left: 4px solid #f59e0b !important;
    }
</style>

<div class="review-header">
    <div>
        <h1><i class="fas fa-clipboard-check"></i> Eğitim Son Kontrol & Yayın Onay Paneli</h1>
        <small style="color: rgba(255,255,255,0.85); font-size: 13px;">
            Eğitim, içerik modülleri, sınavlar ve soruların canlıya alınmadan önceki son bütünlük ve kalite denetimi.
        </small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="status-pill @(Model.IsPublished ? "pill-published" : "pill-draft")">
            <i class="fas @(Model.IsPublished ? "fa-check-circle" : "fa-clock") mr-1"></i>
            @(Model.IsPublished ? "YAYINDA" : "YAYIN BEKLEYEN TASLAK")
        </span>
        <a href="@Url.Action("Drafts")" class="btn btn-outline-light btn-sm ml-2">
            <i class="fas fa-arrow-left"></i> Taslaklara Dön
        </a>
    </div>
</div>

@if (TempData["msgError"] != null)
{
    <div class="alert alert-danger mb-4 shadow-sm border-0 rounded-lg">
        <i class="fas fa-exclamation-circle mr-2"></i> @TempData["msgError"]
    </div>
}

<!-- Kurs Genel Bilgisi & Hızlı Eylemler -->
<div class="review-card">
    <div class="row align-items-center">
        <div class="col-md-3 text-center mb-3 mb-md-0">
            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" class="cover-thumbnail shadow-sm" alt="Kurs kapağı" />
            }
            else
            {
                <div class="cover-thumbnail d-flex align-items-center justify-content-center bg-light text-muted mx-auto">
                    <i class="fas fa-image fa-2x"></i>
                </div>
            }
        </div>
        <div class="col-md-9">
            <h3 class="font-weight-bold text-dark mb-1">@Model.CourseTitle</h3>
            <p class="text-muted small mb-3">Kurs Kimliği: #@Model.CourseId</p>
            <div class="btn-group flex-wrap shadow-sm">
                <a href="@Url.Action("Index", "Course", new { editCourseId = Model.CourseId })" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-edit mr-1"></i> Kursu Düzenle
                </a>
                <a href="@Url.Action("ManageContents", "Course", new { courseId = Model.CourseId })" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-folder-open mr-1"></i> İçerikleri Yönet
                </a>
                <a href="@Url.Action("Details", "Course", new { id = Model.CourseId, preview = true })" class="btn btn-outline-secondary btn-sm" target="_blank">
                    <i class="fas fa-eye mr-1"></i> Kursu Önizle
                </a>
                <a href="@Url.Action("Index", "Exam")" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-graduation-cap mr-1"></i> Sınavları Düzenle
                </a>
                <a href="@Url.Action("Review", new { id = Model.CourseId })" class="btn btn-outline-dark btn-sm font-weight-bold">
                    <i class="fas fa-sync mr-1"></i> Yeniden Doğrula
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Otomatik Kontrol Bulguları -->
<div class="review-card">
    <h5 class="font-weight-bold text-dark mb-3">
        <i class="fas fa-tasks text-primary mr-2"></i> Otomatik Bütünlük Kontrol Sonuçları
    </h5>

    @if (!Model.Issues.Any())
    {
        <div class="alert alert-success border-0 rounded-lg p-3 d-flex align-items-center">
            <i class="fas fa-check-circle fa-2x text-success mr-3"></i>
            <div>
                <strong class="d-block font-weight-bold">Tebrikler! Zorunlu Hata veya Uyarı Bulunmadı.</strong>
                <span class="small">Eğitim, tüm içerik modülleri ve sınav yapılandırmalarıyla eksiksizdir; güvenle yayınlanabilir.</span>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 110px;">Önem</th>
                        <th style="width: 140px;">Bölüm</th>
                        <th>Açıklama</th>
                        <th style="width: 110px;" class="text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Issues)
                    {
                        <tr class="@(item.Severity == "Error" ? "issue-row-error" : "issue-row-warning")">
                            <td>
                                @if (item.Severity == "Error")
                                {
                                    <span class="badge badge-danger px-2 py-1"><i class="fas fa-times-circle mr-1"></i> HATA</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning px-2 py-1 text-dark"><i class="fas fa-exclamation-triangle mr-1"></i> UYARI</span>
                                }
                            </td>
                            <td><strong class="text-dark">@item.Area</strong></td>
                            <td>@item.Message</td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(item.EditUrl))
                                {
                                    <a href="@item.EditUrl" class="btn btn-sm btn-outline-dark font-weight-bold">
                                        <i class="fas fa-external-link-alt mr-1"></i> Düzelt
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Sınav ve Soru Özeti -->
<div class="review-card">
    <h5 class="font-weight-bold text-dark mb-3">
        <i class="fas fa-list-ol text-primary mr-2"></i> Bağlı Sınav ve Soru Durumu
    </h5>

    @if (Model.Exams != null && Model.Exams.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Sınav Başlığı</th>
                        <th style="width: 100px;" class="text-center">Süre</th>
                        <th style="width: 110px;" class="text-center">Geçme Notu</th>
                        <th style="width: 100px;" class="text-center">Soru</th>
                        <th style="width: 110px;" class="text-center">Medya/Görsel</th>
                        <th style="width: 220px;" class="text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model.Exams)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@exam.Title</strong>
                                <div class="text-muted small">Sınav Kimliği: #@exam.ExamId</div>
                            </td>
                            <td class="text-center">@exam.Duration dk</td>
                            <td class="text-center font-weight-bold text-success">@exam.PassingScore Puan</td>
                            <td class="text-center font-weight-bold">@exam.QuestionCount</td>
                            <td class="text-center">
                                <span class="badge badge-light border">@exam.MediaCount Dosya</span>
                            </td>
                            <td class="text-right">
                                <a href="@Url.Action("Index", "Exam", new { editExamId = exam.ExamId })" class="btn btn-outline-warning btn-sm mr-1">
                                    <i class="fas fa-edit"></i> Sınav
                                </a>
                                <a href="@Url.Action("Index", "Question", new { examId = exam.ExamId })" class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-question mr-1"></i> Sorular (@exam.QuestionCount)
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-0">Bu eğitime bağlı sınav bulunmamaktadır.</div>
    }
</div>

<!-- Yayınlama Onayı Bölümü -->
<div class="review-card" style="background: #f8fafc; border: 2px dashed #cbd5e1;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h5 class="font-weight-bold text-dark mb-1">
                <i class="fas fa-rocket text-success mr-2"></i> Canlıya Yayınlama İşlemi
            </h5>
            <small class="text-muted">
                Yayınla butonuna tıkladığınızda kurs, sınavlar ve sorular tek bir güvenli işlemde kursiyer erişimine açılır.
            </small>
        </div>

        <div>
            @if (!Model.IsPublished)
            {
                using (Html.BeginForm("Publish", "EducationPackage", FormMethod.Post, new { onsubmit = "return confirm('Bu eğitimi, bağlı sınavları ve soruları canlı yayına almak istediğinize emin misiniz?');", @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CourseId" />
                    <button type="submit" class="btn btn-success btn-lg px-4 font-weight-bold shadow-sm" @(!Model.CanPublish ? "disabled" : null)>
                        <i class="fas fa-check-circle mr-2"></i> Son Onayı Ver ve Canlıya Al
                    </button>
                }
                if (!Model.CanPublish)
                {
                    <div class="text-danger small font-weight-bold mt-1 text-right">
                        <i class="fas fa-ban mr-1"></i> Yayınlanabilmesi için önce yukarıdaki kırmızı hataları düzeltiniz.
                    </div>
                }
            }
            else
            {
                <span class="btn btn-outline-success btn-lg disabled font-weight-bold">
                    <i class="fas fa-check-double mr-2"></i> Eğitim Zaten Yayında
                </span>
            }
        </div>
    </div>
</div>
