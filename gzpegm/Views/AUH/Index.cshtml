@model IEnumerable <gzpegm.Models.E_AUH>

@{
    string Tom = "";
    Layout = "~/Views/Shared/_Master.cshtml";
}
<section class="card">
    <header class="card-header">
        <div class="card-actions">
            <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
        </div>
        <h2 class="card-title">Aylık Ülke Harçları Listesi</h2>
        <p class="card-subtitle">Bu bölümde aylık ülke harçları oluşturma ve düzenleme işlemi yapılabilir.</p>
    </header>
    <div class="card-body">
        <table class="table table-bordered table-striped mb-0" id="datatable-default">
            <thead>
                <tr>
                    <th>Ülke</th>
                    <th>İlk Ay</th>
                    <th>Katsayı</th>
                    <th>Günlük Başlangıç</th>
                    <th>Günlük Katsayısı</th>
                    <th>Para Cinsi</th>
                    <th>Eylemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var data in Model)
                {
                    if (data.fldToM == "TRY") { Tom = "Türk Lirası"; }
                    else if (data.fldToM == "EUR") { Tom = "Avro"; }
                    else if (data.fldToM == "USD") { Tom = "Amerikan Doları"; }
                    else if (data.fldToM == "GBP") { Tom = "İngiliz Sterlini"; }
                <tr>
                    <td>@data.fldCountry</td>
                    <td>@data.fldFirstMounth</td>
                    <td>@data.fldKat</td>
                    <td>@data.fldDayStart</td>
                    <td>@data.fldDayKat</td>
                    <td>@Tom</td>
                    <td class="actions">
                        <a onclick="editauh('@data.fldId','@data.fldCountry','@data.fldFirstMounth','@data.fldKat','@data.fldToM','@data.fldDayStart','@data.fldDayKat')" href="#EditAUHmodalForm" class="modal-with-form btn btn-default"><i class="fas fa-pencil-alt"></i></a>
                        <a onclick="deleteauh('@data.fldId')" class="btn btn-default"><i class="fas fa-trash-alt"></i></a>

                    </td>
                </tr>
                }
            </tbody>
        </table>
        <a class="modal-with-form btn btn-default" href="#AddAUHmodalForm"><i class="fas fa-plus"></i>  Yeni Ekle</a>
    </div>
</section>
